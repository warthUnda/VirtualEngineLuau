        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">CameraShake</string>
            <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

export type ShakeDirection = "Left" | "LeftDown" | "LeftUp" | "Up" | "Bottom" | "Right" | "RightDown" | "RightUp"

local DIRECTIONS: { [ShakeDirection]: Vector3 } = {
	Left = Vector3.new(-1, 0, 0),
	LeftDown = Vector3.new(-1, -1, 0).Unit,
	LeftUp = Vector3.new(-1, 1, 0).Unit,
	Up = Vector3.new(0, 1, 0),
	Bottom = Vector3.new(0, -1, 0),
	Right = Vector3.new(1, 0, 0),
	RightDown = Vector3.new(1, -1, 0).Unit,
	RightUp = Vector3.new(1, 1, 0).Unit,
}

local CameraShake = {}
CameraShake.__index = CameraShake

function CameraShake.new()
	local self = setmetatable({}, CameraShake)
	self._shakes = {}
	self._isActive = false
	-- Unique ID for RenderStep binding to allow multiple instances
	self._renderName = "CameraShakeSystem_" .. HttpService:GenerateGUID(false)
	self._lastCameraCFrame = nil
	self._lastOffset = CFrame.identity
	return self
end

function CameraShake:Start()
	if self._isActive then
		return
	end
	self._isActive = true

	-- Bind after the default camera update (Enum.RenderPriority.Camera.Value is 200)
	RunService:BindToRenderStep(self._renderName, Enum.RenderPriority.Camera.Value + 1, function(dt)
		self:_update(dt)
	end)
end

function CameraShake:Stop()
	if not self._isActive then
		return
	end
	self._isActive = false

	RunService:UnbindFromRenderStep(self._renderName)
	table.clear(self._shakes)
	
	-- Clean up any lingering offset if the camera hasn't been externally updated
	local camera = workspace.CurrentCamera
	if camera and self._lastCameraCFrame and camera.CFrame == self._lastCameraCFrame then
		camera.CFrame = camera.CFrame * self._lastOffset:Inverse()
	end
	self._lastCameraCFrame = nil
	self._lastOffset = CFrame.identity
end

-- Adds a new directional shake
function CameraShake:Shake(direction: ShakeDirection, intensity: number, fadeInTime: number, fadeOutTime: number)
	local dirVector = DIRECTIONS[direction]
	if not dirVector then
		warn(`[CameraShake] Invalid direction: {direction}`)
		return
	end

	table.insert(self._shakes, {
		directionVector = dirVector,
		intensity = intensity,
		fadeInTime = math.max(fadeInTime, 0.001), -- Prevent division by zero
		fadeOutTime = math.max(fadeOutTime, 0.001),
		elapsed = 0,
		totalTime = fadeInTime + fadeOutTime,
		seed = math.random() * 10000, -- Random seed for noise offset
	})

	-- Auto-start the render loop if it's the first shake
	if not self._isActive then
		self:Start()
	end
end

function CameraShake:_update(dt: number)
	if #self._shakes == 0 then
		self:Stop() -- Auto-stop when no shakes remain to save performance
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	-- Prevent permanent offset compounding by checking if the camera was modified externally
	if self._lastCameraCFrame and camera.CFrame == self._lastCameraCFrame then
		camera.CFrame = camera.CFrame * self._lastOffset:Inverse()
	end

	local totalPosOffset = Vector3.zero
	local totalRotOffset = Vector3.zero

	for i = #self._shakes, 1, -1 do
		local shake = self._shakes[i]
		shake.elapsed += dt

		if shake.elapsed >= shake.totalTime then
			table.remove(self._shakes, i)
			continue
		end

		-- Calculate fade multiplier based on elapsed time
		local multiplier = 0
		if shake.elapsed <= shake.fadeInTime then
			multiplier = shake.elapsed / shake.fadeInTime
		else
			local fadeOutElapsed = shake.elapsed - shake.fadeInTime
			multiplier = 1 - (fadeOutElapsed / shake.fadeOutTime)
			multiplier = multiplier ^ 2 -- Quadratic ease-out for a smoother decay
		end

		-- Procedural shake wave using a combination of sine and noise for a realistic jolt
		local timeValue = shake.elapsed * 35 + (shake.seed % 100)
		
		-- Use non-integer Y coordinate for math.noise to avoid 0 outputs at integer bounds
		local noiseVal = math.noise(timeValue * 0.4, shake.seed, 0)
		local wave = math.sin(timeValue) * noiseVal

		local amplitude = wave * shake.intensity * multiplier
		totalPosOffset += shake.directionVector * amplitude

		-- Translate linear direction into rotational pitch/yaw
		totalRotOffset += Vector3.new(-shake.directionVector.Y * amplitude, -shake.directionVector.X * amplitude, 0)
	end

	-- Apply the calculated shake offsets
	local newOffset = CFrame.new(totalPosOffset) 
		* CFrame.Angles(math.rad(totalRotOffset.X), math.rad(totalRotOffset.Y), math.rad(totalRotOffset.Z))

	camera.CFrame = camera.CFrame * newOffset
	self._lastCameraCFrame = camera.CFrame
	self._lastOffset = newOffset
end

return CameraShake
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="81">
          <Properties>
            <string name="Name">CameraSystem</string>
            <string name="Source"></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">CameraSystem</string>
            <string name="Source"><![CDATA[--[[
	CameraSystem.client.luau
	Place in: StarterPlayerScripts

	Merges:
	  • Camera Sway   – rolls camera based on mouse delta
	  • Head Bob      – procedural walk-cycle bobbing + lateral strafe tilt
	  • CameraShake   – requires the CameraShake ModuleScript so its render
	                    loop is active and ready for :Shake() calls

	RenderPriority order each frame:
	  Camera.Value      → "CameraSwayAndBob"  (this script)
	  Camera.Value + 1  → "CameraShakeSystem" (managed by CameraShake module)

	CombatClient creates its own CameraShake instance (unchanged).
	This script's `cameraShake` instance can be used for additional
	effects such as damage impacts, landing shakes, etc.
--]]

-- ─── Services ────────────────────────────────────────────────────────────────
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

-- ─── CameraShake Module ──────────────────────────────────────────────────────
-- Resolves to StarterPlayerScripts.CameraShake (ModuleScript)
local CameraShake = require(script.Parent.CameraShake)
local cameraShake = CameraShake.new() -- instance available for local use

-- ─── Shared references ───────────────────────────────────────────────────────
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Wait for character before hooking bob
local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = character:WaitForChild("Humanoid")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- Require the CameraShake module that lives alongside this script in StarterCharacterScripts
local CameraShakeModule = require(script.Parent.CameraShake)
local cameraShake = CameraShakeModule.new()

-- ─── Camera Sway state ───────────────────────────────────────────────────────
local swayTurn = 0

-- ─── Mouse Follow Camera State ───────────────────────────────────────────────
local mouseFollowActive = false

-- Angle-based smooth mouse following (radians)
local mouseDesiredYaw = 0 -- target horizontal angle offset from character forward
local mouseDesiredPitch = math.rad(-10) -- target pitch (default slight downward tilt)
local mouseCurrentYaw = 0 -- smoothed current horizontal angle
local mouseCurrentPitch = math.rad(-10) -- smoothed current pitch

-- Tuning constants
local MOUSE_SENSITIVITY = 0.0025 -- radians per pixel of mouse movement
local CAMERA_SMOOTH_SPEED = 6 -- exponential smoothing rate (higher = faster catch-up)
local MAX_YAW = math.rad(25) -- ±25° horizontal constraint from forward
local MAX_PITCH_UP = math.rad(0) -- max upward look (0° = level)
local MAX_PITCH_DOWN = math.rad(-25) -- max downward look
local HEAD_HEIGHT = 2.5 -- approximate height from rootPart to head
local SIDE_OFFSET = -3 -- 3 studs left of character
local BEHIND_OFFSET = -1.5 -- 1.5 studs behind character
local MOUSE_PAN_LIMIT_X = 2.0 -- Max horizontal pan shift in studs
local MOUSE_PAN_LIMIT_Y = 1.5 -- Max vertical pan shift in studs

--- Enables or disables the over-the-shoulder mouse-follow camera.
--- While active, normal camera sway and head bob are blocked.
--- @param active boolean
--- @return boolean  The current state (true = active, false = inactive)
local function setMouseFollow(active: boolean): boolean
	mouseFollowActive = active

	if active then
		UserInputService.MouseIconEnabled = true
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default

		-- Snap current angles to match the current camera orientation
		local rootPart = Humanoid and Humanoid.RootPart
		if rootPart then
			local rootCF = rootPart.CFrame
			local camForward = Camera.CFrame.LookVector
			local charForward = rootCF.LookVector
			-- Horizontal angle difference
			local flatCam = Vector3.new(camForward.X, 0, camForward.Z).Unit
			local flatChar = Vector3.new(charForward.X, 0, charForward.Z).Unit
			local cross = flatChar:Cross(flatCam)
			local dot = flatChar:Dot(flatCam)
			local currentYaw = math.atan2(cross.Y, dot)
			
			mouseCurrentYaw = math.clamp(currentYaw, -MAX_YAW, MAX_YAW)
			mouseDesiredYaw = mouseCurrentYaw

			-- Vertical angle difference
			local currentPitch = math.asin(math.clamp(camForward.Y, -1, 1))
			mouseCurrentPitch = math.clamp(currentPitch, MAX_PITCH_DOWN, MAX_PITCH_UP)
			mouseDesiredPitch = mouseCurrentPitch
		else
			mouseDesiredYaw = 0
			mouseDesiredPitch = math.rad(-10)
			mouseCurrentYaw = 0
			mouseCurrentPitch = math.rad(-10)
		end
		Camera.CameraType = Enum.CameraType.Scriptable
	else
		UserInputService.MouseIconEnabled = false
		Camera.CameraType = Enum.CameraType.Custom
	end

	return mouseFollowActive
end

--- Returns whether the mouse-follow camera is currently active.
--- @return boolean
local function getMouseFollowActive(): boolean
	return mouseFollowActive
end

-- ─── Head Bob state ──────────────────────────────────────────────────────────
local bobConnection = nil
local func1, func2 = 0, 0 -- micro-trauma random offsets
local func3 = 0 -- mouse-delta lean
local func4 = 0 -- vertical bob
local val = 0 -- horizontal bob
local val2 = 0 -- lateral strafe tilt
local int = 5 -- bob frequency
local int2 = 5 -- bob amplitude multiplier
local vect3 = Vector3.new()

local function lerp(a, b, c)
	return a + (b - a) * c
end

-- Hide OS cursor (matching original behaviour)
UserInputService.MouseIconEnabled = false

-- ─── Head-bob helpers ────────────────────────────────────────────────────────
local function disconnectBob()
	if bobConnection then
		bobConnection:Disconnect()
		bobConnection = nil
	end
end

local function connectBob()
	disconnectBob()

	-- Reset state on (re)connect so values don't carry over across respawns
	func1, func2, func3, func4 = 0, 0, 0, 0
	val, val2, int, int2 = 0, 0, 5, 5
	vect3 = Vector3.new()

	bobConnection = RunService.RenderStepped:Connect(function(deltaTime)
		local dt = deltaTime * 30 -- scale to match original tuning

		if mouseFollowActive then
			Camera.CameraType = Enum.CameraType.Scriptable
			return
		end

		if not Humanoid or Humanoid.Health <= 0 then
			disconnectBob()
			return
		end

		local rootPart = Humanoid.RootPart
		local velocity = rootPart and rootPart.Velocity or Vector3.new()
		local rootMagnitude = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		local calcRootMag = math.min(rootMagnitude, 25)

		-- Micro-trauma offsets (skipped on abnormally large dt to avoid spikes)
		if dt > 1.5 then
			func1 = 0
			func2 = 0
		else
			-- math.random requires integer bounds in Luau
			func1 =
				lerp(func1, math.cos(tick() * 0.5 * math.random(7, 10)) * (math.random(6, 10) / 100) * dt, 0.05 * dt)
			func2 = lerp(func2, math.cos(tick() * 0.5 * math.random(5, 9)) * (math.random(1, 5) / 100) * dt, 0.05 * dt)
		end

		-- Apply all procedural offsets
		Camera.CFrame = Camera.CFrame
			* (
				CFrame.fromEulerAnglesXYZ(0, 0, math.rad(func3))
				* CFrame.fromEulerAnglesXYZ(math.rad(func4 * dt), math.rad(val * dt), val2)
				* CFrame.Angles(0, 0, math.rad(func4 * dt * (calcRootMag / 5)))
				* CFrame.fromEulerAnglesXYZ(math.rad(func1), math.rad(func2), math.rad(func2 * 10))
			)

		-- Lateral strafe tilt
		val2 = math.clamp(
			lerp(
				val2,
				-Camera.CFrame:VectorToObjectSpace(velocity / math.max(Humanoid.WalkSpeed, 0.01)).X * 0.04,
				0.1 * dt
			),
			-0.12,
			0.1
		)

		-- Mouse-delta lean
		func3 = lerp(func3, math.clamp(UserInputService:GetMouseDelta().X, -2.5, 2.5), 0.25 * dt)

		-- Vertical bob
		func4 = lerp(func4, math.sin(tick() * int) / 5 * math.min(1, int2 / 10), 0.25 * dt)

		-- Horizontal bob (only while moving)
		if rootMagnitude > 1 then
			val = lerp(val, math.cos(tick() * 0.5 * math.floor(int)) * (int / 200), 0.25 * dt)
		else
			val = lerp(val, 0, 0.05 * dt)
		end

		-- Speed-based frequency / amplitude tuning
		if rootMagnitude > 6 then
			int = 10
			int2 = 9
		elseif rootMagnitude > 0.1 then
			int = 6
			int2 = 7
		else
			int2 = 0
		end

		-- Enforce zoom limits
		LocalPlayer.CameraMaxZoomDistance = 128
		LocalPlayer.CameraMinZoomDistance = 0.5

		-- Smooth look-vector tracker (available for use by this script)
		vect3 = lerp(vect3, Camera.CFrame.LookVector, 0.125 * dt)
	end)
end

-- ─── Camera Sway render step (runs BEFORE CameraShake at Camera.Value) ───────
RunService:BindToRenderStep("CameraSwayAndBob", Enum.RenderPriority.Camera.Value, function(deltaTime)
	if mouseFollowActive then
		local rootPart = Humanoid and Humanoid.RootPart
		if rootPart then
			local dt = math.min(deltaTime, 0.1) -- cap to avoid frame-spike jumps

			-- Calculate screen-space mouse offset from the center of the viewport
			local viewportSize = Camera.ViewportSize
			local screenCenter = viewportSize / 2
			local mouseLocation = UserInputService:GetMouseLocation()
			
			local nx, ny = 0, 0
			if screenCenter.X > 0 and screenCenter.Y > 0 then
				nx = math.clamp((mouseLocation.X - screenCenter.X) / screenCenter.X, -1, 1)
				ny = math.clamp((mouseLocation.Y - screenCenter.Y) / screenCenter.Y, -1, 1)
			end

			-- Set target yaw and pitch based on normalized mouse offset
			mouseDesiredYaw = nx * MAX_YAW
			
			-- Map ny [-1, 1] to [MAX_PITCH_UP, MAX_PITCH_DOWN]
			local t = (ny + 1) / 2
			mouseDesiredPitch = lerp(MAX_PITCH_UP, MAX_PITCH_DOWN, t)

			-- Exponential smoothing: frame-rate independent, smooth catch-up
			local lerpFactor = 1 - math.exp(-CAMERA_SMOOTH_SPEED * dt)
			mouseCurrentYaw = lerp(mouseCurrentYaw, mouseDesiredYaw, lerpFactor)
			mouseCurrentPitch = lerp(mouseCurrentPitch, mouseDesiredPitch, lerpFactor)

			local rootCF = rootPart.CFrame

			-- Dynamic position panning based on current smoothed yaw/pitch ratios
			local horizontalPanRatio = if MAX_YAW > 0.001 then mouseCurrentYaw / MAX_YAW else 0
			local pitchMid = (MAX_PITCH_UP + MAX_PITCH_DOWN) / 2
			local pitchRange = (MAX_PITCH_UP - MAX_PITCH_DOWN) / 2
			local verticalPanRatio = if pitchRange > 0.001 then (mouseCurrentPitch - pitchMid) / pitchRange else 0

			local panOffset = rootCF.RightVector * (horizontalPanRatio * MOUSE_PAN_LIMIT_X)
				+ Vector3.new(0, verticalPanRatio * MOUSE_PAN_LIMIT_Y, 0)

			-- Camera position: offset from rootPart plus the dynamic panning offset
			local camPos = rootPart.Position
				+ rootCF.RightVector * SIDE_OFFSET -- 3 studs left
				+ rootCF.LookVector * BEHIND_OFFSET -- 1.5 studs behind
				+ Vector3.new(0, HEAD_HEIGHT + 0.5, 0) -- head height + 0.5 up
				+ panOffset

			-- Build look direction starting from character forward, apply mouse angles
			local baseLook = rootCF.LookVector

			-- Horizontal rotation (yaw) around world Y axis
			local yawCF = CFrame.fromAxisAngle(Vector3.new(0, 1, 0), mouseCurrentYaw)
			local lookDir = yawCF * baseLook

			-- Vertical rotation (pitch) around the camera's local right axis
			local rightAxis = lookDir:Cross(Vector3.new(0, 1, 0)).Unit
			local pitchCF = CFrame.fromAxisAngle(rightAxis, mouseCurrentPitch)
			lookDir = pitchCF * lookDir

			-- Apply final CFrame
			Camera.CFrame = CFrame.lookAt(camPos, camPos + lookDir)
		end
	else
		local mouseDelta = UserInputService:GetMouseDelta()
		swayTurn = lerp(swayTurn, math.clamp(mouseDelta.X, -7.5, 7.5), 7 * deltaTime)
		Camera.CFrame = Camera.CFrame * CFrame.Angles(0, 0, math.rad(swayTurn))
	end
end)

-- ─── Start bob + wire up respawn ─────────────────────────────────────────────
connectBob()

LocalPlayer.CharacterAdded:Connect(function(newChar)
	character = newChar
	Humanoid = newChar:WaitForChild("Humanoid")
	connectBob()
end)

--[[
	──────────────────────────────────────────────────────────────────────────
	USAGE — triggering shakes from this script:

	  cameraShake:Shake("LeftUp",    0.5, 0.1, 0.3)  -- combat hit
	  cameraShake:Shake("Up",        0.3, 0.05, 0.2) -- landing
	  cameraShake:Shake("RightDown", 0.4, 0.1, 0.25) -- explosion

	CombatClient.client.luau manages its own separate CameraShake instance
	(already set up in that script) and does not need to be changed.
	──────────────────────────────────────────────────────────────────────────

	──────────────────────────────────────────────────────────────────────────
	MOUSE FOLLOW CAMERA — public API for other scripts:

	  -- Enable / disable the smooth orbit camera (returns the new state)
	  local active = cameraSystem:setMouseFollow(true)
	  local inactive = cameraSystem:setMouseFollow(false)

	  -- Check current state without changing it
	  local isActive = cameraSystem:getMouseFollowActive()
	──────────────────────────────────────────────────────────────────────────
--]]
return {
	setMouseFollow = setMouseFollow,
	getMouseFollowActive = getMouseFollowActive,
}
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="83">
          <Properties>
            <string name="Name">Combat</string>
          </Properties>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">AnimationLoader</string>
              <string name="Source"><![CDATA[local AnimationLoader = {}

local RIGHT_PUNCH_ID = "rbxassetid://101280902795434"
local LEFT_PUNCH_ID = "rbxassetid://99868868445423"

local ANIMATIONS = {
	Right = RIGHT_PUNCH_ID,
	Left = LEFT_PUNCH_ID,
}

function AnimationLoader.PlayAttack(character, attackType)
	local animId = ANIMATIONS[attackType]
	if not animId then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = animId

	local track = animator:LoadAnimation(animation)
	if track then
		track.Looped = false
		track:AdjustSpeed(1.5)
		track:Play()
		task.delay(track.Length / 1.5, function()
			track:Destroy()
		end)
	end

	return track
end

return AnimationLoader
]]></string>
            </Properties>
          </Item>
          <Item class="LocalScript" referent="85">
            <Properties>
              <string name="Name">BlockController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local CombatEvents = require(ReplicatedStorage.Shared.Combat.CombatEvents)
local localPlayer = Players.LocalPlayer

local BlockController = {}

local isBlocking = false
local BLOCK_COOLDOWN = 0.5
local lastBlockToggleTime = 0

function BlockController.IsBlocking()
	return isBlocking
end

local function getCharacter()
	local character = localPlayer.Character
	if not character or not character.Parent then
		return nil
	end
	return character
end

local function toggleBlock()
	local now = os.clock()
	if now - lastBlockToggleTime < BLOCK_COOLDOWN then
		return
	end
	lastBlockToggleTime = now

	isBlocking = not isBlocking
	print("Client: Blocking = " .. tostring(isBlocking))

	local character = getCharacter()
	if not character then
		return
	end

	CombatEvents.BlockToggle:FireServer(isBlocking)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Q then
		toggleBlock()
	end
end)

return BlockController
]]></string>
            </Properties>
          </Item>
          <Item class="LocalScript" referent="86">
            <Properties>
              <string name="Name">CombatClient</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local CombatEvents = require(ReplicatedStorage.Shared.Combat.CombatEvents)
local AnimationLoader = require(script.Parent.AnimationLoader)
local CameraShake = require(script.Parent.Parent.CameraShake)
local cameraShake = CameraShake.new()
local localPlayer = Players.LocalPlayer

local M1Normal = ReplicatedStorage:FindFirstChild("Remotes")
	and ReplicatedStorage.Remotes:FindFirstChild("Combat")
	and ReplicatedStorage.Remotes.Combat:FindFirstChild("M1")
	and ReplicatedStorage.Remotes.Combat.M1:FindFirstChild("Normal")

local CombatClient = {}

local HITBOX_SIZE = Vector3.new(4, 4, 4)
local HIGHLIGHT_FADE_DURATION = 0.25
local ATTACK_COOLDOWN = 0.8
local SWEEP_SAMPLES = 5
local REACH_DISTANCE = 5
local SWEEP_ARC = math.rad(60)

local lastAttackTime = 0

local mouseDeltaAccumulator = 0
local lastMouseClearTime = 0
local MOUSE_WINDOW = 0.15

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = UserInputService:GetMouseDelta()
		local now = os.clock()
		if now - lastMouseClearTime > MOUSE_WINDOW then
			mouseDeltaAccumulator = 0
		end
		mouseDeltaAccumulator = mouseDeltaAccumulator + delta.X
		lastMouseClearTime = now
	end
end)

local function getAttackDirection()
	local accumulated = mouseDeltaAccumulator
	mouseDeltaAccumulator = 0
	local THRESHOLD = 20
	if accumulated > THRESHOLD then
		return "Right"
	elseif accumulated < -THRESHOLD then
		return "Left"
	else
		return "Forward"
	end
end

local function SmoothSpeedPenalty(humanoid, penaltySpeed, normalSpeed, dropDuration, recoveryWait, recoveryDuration)
	local dropInfo = TweenInfo.new(dropDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local dropTween = TweenService:Create(humanoid, dropInfo, { WalkSpeed = penaltySpeed })

	local recoverInfo = TweenInfo.new(recoveryDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
	local recoverTween = TweenService:Create(humanoid, recoverInfo, { WalkSpeed = normalSpeed })

	dropTween:Play()

	task.delay(dropDuration + recoveryWait, function()
		if humanoid and humanoid.Parent then
			recoverTween:Play()
		end
	end)
end

local ATTACK_SHAKE_DIRECTION = {
	Right = "Right",
	Left = "Left",
	Forward = "Up",
}

local function generateSweepCFrames(rootCF, attackType)
	local rootPos = rootCF.Position
	local forward = rootCF.LookVector * REACH_DISTANCE
	local right = rootCF.RightVector * REACH_DISTANCE
	local up = rootCF.UpVector
	local halfArc = SWEEP_ARC / 2

	local startDir, endDir

	if attackType == "Right" then
		startDir = rootCF.LookVector + rootCF.RightVector * 0.5
		endDir = rootCF.RightVector - rootCF.LookVector * 0.5
	elseif attackType == "Left" then
		startDir = -rootCF.RightVector + rootCF.LookVector * 0.5
		endDir = rootCF.LookVector - rootCF.RightVector * 0.5
	else
		startDir = (forward - right).Unit
		endDir = (forward + right).Unit
	end

	local startCenter = rootPos + startDir.Unit * REACH_DISTANCE
	local endCenter = rootPos + endDir.Unit * REACH_DISTANCE
	local startCF = CFrame.lookAt(rootPos, startCenter, up)
	local endCF = CFrame.lookAt(rootPos, endCenter, up)

	return startCF, endCF
end

local function sweptBoxOverlap(startCFrame, endCFrame, boxSize, filterParams, samples)
	local distanceMoved = (endCFrame.Position - startCFrame.Position).Magnitude
	if distanceMoved < 0.01 then
		return Workspace:GetPartBoundsInBox(startCFrame, boxSize, filterParams)
	end

	local seenParts = {}
	local results = {}

	for i = 0, samples - 1 do
		local t = i / (samples - 1)
		local sampleCFrame = startCFrame:Lerp(endCFrame, t)

		local partsAtSample = Workspace:GetPartBoundsInBox(sampleCFrame, boxSize, filterParams)
		for _, part in ipairs(partsAtSample) do
			if not seenParts[part] then
				seenParts[part] = true
				table.insert(results, part)
			end
		end
	end

	return results
end

function CombatClient.HighlightModel(model, fillColor, outlineColor)
	local highlight = Instance.new("Highlight")
	highlight.Adornee = model
	highlight.FillColor = fillColor
	highlight.OutlineColor = outlineColor
	highlight.FillTransparency = 0
	highlight.OutlineTransparency = 0
	highlight.Parent = model

	local function Destroy()
		if not highlight or not highlight.Parent then
			return
		end

		local tweenInfo = TweenInfo.new(HIGHLIGHT_FADE_DURATION, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)

		local goal = {
			OutlineTransparency = 1,
			FillTransparency = 1,
		}

		local tween = TweenService:Create(highlight, tweenInfo, goal)
		tween.Completed:Connect(function()
			if highlight then
				highlight:Destroy()
			end
		end)
		tween:Play()
	end

	return {
		Highlight = highlight,
		Destroy = Destroy,
	}
end

local function performSweepCheck(character, startCFrame, endCFrame, attackType)
	if not startCFrame or not endCFrame then
		return {}
	end

	local overlapParams = OverlapParams.new()
	overlapParams.FilterDescendantsInstances = { character }
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude

	local partsInSweep = sweptBoxOverlap(startCFrame, endCFrame, HITBOX_SIZE, overlapParams, SWEEP_SAMPLES)

	local hitHumanoids = {}
	for _, part in ipairs(partsInSweep) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if humanoid and not hitHumanoids[humanoid] then
				hitHumanoids[humanoid] = true
				cameraShake:Shake(ATTACK_SHAKE_DIRECTION[attackType], 1, 0.05, 0.2)
				local flash = CombatClient.HighlightModel(model, Color3.new(1, 0, 0), Color3.new(1, 0.5, 0.5))
				task.delay(0.15, function()
					flash.Destroy()
				end)
				CombatEvents.AttackHit:FireServer(model, startCFrame, endCFrame)
			end
		end
	end

	return hitHumanoids
end

function CombatClient.Attack()
	local now = os.clock()
	if now - lastAttackTime < ATTACK_COOLDOWN then
		return
	end
	lastAttackTime = now

	local character = localPlayer.Character
	if not character then
		return
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return
	end

	local attackType = getAttackDirection()
	print("Client: Swinging sword! Direction: " .. attackType)

	local track = AnimationLoader.PlayAttack(character, attackType)

	if attackType == "Right" and track then
		local startTime = os.clock()
		track.Stopped:Connect(function()
			local elapsed = os.clock() - startTime
			print(`Right punch animation finished in {elapsed}s`)
		end)
	end

	local tool = character:FindFirstChildOfClass("Tool")
	local blade = tool:FindFirstChild("Handle")

	SmoothSpeedPenalty(character:WaitForChild("Humanoid"), 3, 8, 3, 1, 2)

	if blade then
		task.spawn(function()
			local Iteration = 0
			local Cache = {}
			local overlapParams = OverlapParams.new()
			overlapParams.FilterType = Enum.RaycastFilterType.Exclude
			overlapParams.FilterDescendantsInstances = { character }
			while true do
				task.wait(0.03)

				local GetParts = Workspace:GetPartBoundsInBox(blade.CFrame, blade.Size, overlapParams)

				for i = 1, #GetParts do
					local UnverifiedPart = GetParts[i]
					if UnverifiedPart.Parent:FindFirstChildOfClass("Humanoid") then
						table.insert(Cache, UnverifiedPart)

						print("Has touched things now")

						local hl = Instance.new("Highlight")
						hl.Parent = UnverifiedPart
						hl.FillColor = Color3.new(0.956862, 0.913725, 0.913725)
						hl.OutlineColor = Color3.new(0, 0, 0)
						hl.Adornee = UnverifiedPart

						local tween =
							TweenService:Create(hl, TweenInfo.new(4), { FillTransparency = 1, OutlineTransparency = 1 })

						tween.Completed:Connect(function()
							hl:Destroy()
						end)

						tween:Play()

						Iteration += 1
						if #Cache >= 2 or Iteration > 50 then
							print("Cache is done")
							return
						end
					end
				end

				if Iteration >= 10 then
					break
				end

				Iteration += 1
			end
		end)
	end

	local startCFrame, endCFrame = generateSweepCFrames(rootPart.CFrame, attackType)

	performSweepCheck(character, startCFrame, endCFrame, attackType)

	if M1Normal then
		M1Normal:FireServer(attackType)
	end
end

local function onToolAdded(tool)
	if tool:IsA("Tool") then
		tool.Activated:Connect(CombatClient.Attack)
	end
end

localPlayer.CharacterAdded:Connect(function(char)
	char.ChildAdded:Connect(onToolAdded)
	for _, child in ipairs(char:GetChildren()) do
		onToolAdded(child)
	end
end)

local currentChar = localPlayer.Character
if currentChar then
	currentChar.ChildAdded:Connect(onToolAdded)
	for _, child in ipairs(currentChar:GetChildren()) do
		onToolAdded(child)
	end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		CombatClient.Attack()
	end
end)

return CombatClient
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="87">
          <Properties>
            <string name="Name">DesperationCamera</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local TacticalSurvival = playerGui:WaitForChild("TacticalSurvival")
local BaseVignette = TacticalSurvival:WaitForChild("BaseVignette")
local AggressiveVignette = TacticalSurvival:WaitForChild("AggressiveVignette")

local colorCorrection = Lighting:FindFirstChild("DesperationColor")
if not colorCorrection then
	colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "DesperationColor"
	colorCorrection.Parent = Lighting
end

local char = player.Character or player.CharacterAdded:Wait()
local currentVignetteIntensity = 0

player.CharacterAdded:Connect(function(newChar)
	char = newChar
	currentVignetteIntensity = 0
end)

RunService.RenderStepped:Connect(function(deltaTime)
	if not char or not char.Parent then
		return
	end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end

	local DesperationMeter = char:GetAttribute("DesperationGain") or hrp:GetAttribute("DesperationGain") or 0

	currentVignetteIntensity = currentVignetteIntensity
		+ (DesperationMeter - currentVignetteIntensity) * math.clamp(deltaTime * 5, 0, 1)

	if currentVignetteIntensity <= 0.05 then
		AggressiveVignette.ImageTransparency = 1
		AggressiveVignette.Size = UDim2.new(1.5, 0, 1.5, 0)
		AggressiveVignette.Position = UDim2.new(-0.25, 0, -0.25, 0)
		BaseVignette.ImageTransparency = 0.7

		colorCorrection.Saturation = 0
		colorCorrection.Contrast = 0
		colorCorrection.TintColor = Color3.fromRGB(255, 255, 255)
	else
		local scale = 1.5 - (currentVignetteIntensity * 0.5)
		local offset = (1 - scale) / 2
		local colorVal = 255 - (currentVignetteIntensity * 255)
		local transparencyVal = math.clamp(1 - (currentVignetteIntensity * 0.9), 0.1, 1)

		AggressiveVignette.Size = UDim2.new(scale, 0, scale, 0)
		AggressiveVignette.Position = UDim2.new(offset, 0, offset, 0)
		AggressiveVignette.ImageColor3 = Color3.fromRGB(colorVal, colorVal, colorVal)
		AggressiveVignette.ImageTransparency = transparencyVal
		BaseVignette.ImageTransparency = math.clamp(0.7 - (currentVignetteIntensity * 0.4), 0.1, 0.7)

		colorCorrection.Saturation = -(currentVignetteIntensity * 0.85)
		colorCorrection.Contrast = currentVignetteIntensity * 0.35

		local r = 255 - (currentVignetteIntensity * 75)
		local g = 255 - (currentVignetteIntensity * 65)
		local b = 255 - (currentVignetteIntensity * 55)
		colorCorrection.TintColor = Color3.fromRGB(r, g, b)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="88">
          <Properties>
            <string name="Name">ExampleMouseFollow</string>
            <string name="Source"><![CDATA[--[[
	ExampleMouseFollow.client.luau
	Place in: StarterPlayerScripts.Client (via Rojo from src/client/)

	Requires: CameraSystem.luau (ModuleScript, sibling in the same folder)

	Press J to toggle the smooth mouse-follow camera on/off.
	The camera will orbit around your character following the mouse.
	Press J again to return to normal camera sway + head bob.
--]]

local UserInputService = game:GetService("UserInputService")

-- CameraSystem is a ModuleScript in the same Client folder
local CameraSystem = require(script.Parent.CameraSystem)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end

	if input.KeyCode == Enum.KeyCode.J then
		local newState = CameraSystem.setMouseFollow(not CameraSystem.getMouseFollowActive())
		print("Mouse-follow camera:", newState and "ON" or "OFF")
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="89">
          <Properties>
            <string name="Name">Hunger</string>
          </Properties>
          <Item class="LocalScript" referent="90">
            <Properties>
              <string name="Name">HungerClient</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local BAR_TWEEN = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "HungerGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.Parent = PlayerGui

local Container = Instance.new("Frame")
Container.Name = "HungerBar"
Container.Size = UDim2.new(0, 160, 0, 14)
Container.Position = UDim2.new(0.5, -80, 1, -52)
Container.BackgroundColor3 = Color3.fromRGB(30, 20, 10)
Container.BorderSizePixel = 0
Container.Parent = ScreenGui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(1, 0)
Corner.Parent = Container

local Fill = Instance.new("Frame")
Fill.Name = "Fill"
Fill.Size = UDim2.new(1, 0, 1, 0)
Fill.BackgroundColor3 = Color3.fromRGB(230, 160, 40)
Fill.BorderSizePixel = 0
Fill.Parent = Container

local FillCorner = Instance.new("UICorner")
FillCorner.CornerRadius = UDim.new(1, 0)
FillCorner.Parent = Fill

local Label = Instance.new("TextLabel")
Label.Size = UDim2.new(1, 0, 1, 0)
Label.BackgroundTransparency = 1
Label.Text = "Hunger"
Label.TextColor3 = Color3.fromRGB(255, 255, 255)
Label.TextSize = 9
Label.Font = Enum.Font.GothamBold
Label.ZIndex = 2
Label.Parent = Container

local function UpdateHunger()
	local Current = Player:GetAttribute("Hunger") or 100
	local Max = Player:GetAttribute("MaxHunger") or 100
	local Ratio = math.clamp(Current / Max, 0, 1)
	local Tween = TweenService:Create(Fill, BAR_TWEEN, { Size = UDim2.new(Ratio, 0, 1, 0) })
	Tween:Play()

	if Ratio < 0.25 then
		Fill.BackgroundColor3 = Color3.fromRGB(210, 60, 30)
	elseif Ratio < 0.5 then
		Fill.BackgroundColor3 = Color3.fromRGB(230, 140, 20)
	else
		Fill.BackgroundColor3 = Color3.fromRGB(230, 160, 40)
	end
end

Player:GetAttributeChangedSignal("Hunger"):Connect(UpdateHunger)
Player:GetAttributeChangedSignal("MaxHunger"):Connect(UpdateHunger)

UpdateHunger()
]]></string>
            </Properties>
          </Item>
        </Item>
