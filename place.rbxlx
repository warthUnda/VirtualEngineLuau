		E.Parent = Folder
	end
else
	Folder = ReplicatedStorage:WaitForChild("HungerEvents")
end

local HungerEvents = {
	HungerUpdate = Folder:WaitForChild("HungerUpdate"),
}

return HungerEvents
]]></string>
