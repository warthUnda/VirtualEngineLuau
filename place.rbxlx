        <Item class="Folder" referent="138">
          <Properties>
            <string name="Name">Render</string>
          </Properties>
          <Item class="Folder" referent="139">
            <Properties>
              <string name="Name">Camera</string>
            </Properties>
            <Item class="ModuleScript" referent="140">
              <Properties>
                <string name="Name">CameraHelper</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

local CameraHelper = {}

-- ============================================================================
-- 1. CAMERA BASIS MATRIX HELPER
-- ============================================================================

--[=[
	Constructs an orthonormal rotation CFrame from camera basis direction vectors.
	@param LookVector Vector3 -- Camera forward direction.
	@param UpVector Vector3 -- Camera upward direction.
	@param RightVector Vector3 -- Camera rightward direction.
	@return CFrame -- Rotation CFrame centered at Vector3.zero.
]=]
function CameraHelper.VectorsToRotation(LookVector: Vector3, UpVector: Vector3, RightVector: Vector3): CFrame
	const BackAxis = -LookVector.Unit :: Vector3
	const UpAxis = UpVector.Unit :: Vector3
	const RightAxis = RightVector.Unit :: Vector3
	return CFrame.fromMatrix(Vector3.zero, RightAxis, UpAxis, BackAxis)
end

return CameraHelper
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="141">
              <Properties>
                <string name="Name">CameraService</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2
--\\----- [CAMERA SERVICE] -----//--
--[[
    Open-sourced, custom camera system for Roblox experiences.
    Find more ease in implementing beautiful, breath-taking camera effects into your place.
	
	DevForums Post: https://devforum.roblox.com/t/cameraservice-a-new-camera-for-a-new-roblox/1988655/
	GitHub Link: https://github.com/rduoDevs/CameraService

    API REFERENCE:
    > :SetCameraView(__type: string)
    Sets the camera to a certain view, such as first person, shift-lock, or some other.
    Will error if CameraService cannot find the camera view.

    > :CreateNewCameraView(id: string, settingsArray: table)
    Adds a new camera view that the camera can be set to.
    settingsArray should have values for camera view properties as seen below.
    If no value is provided, a default one will be placed within.

    > :LockCameraPanning(xAxis: boolean, yAxis: boolean, lockAtX: number, lockAtY: number)
    Locks camera movement from right-to-left (x-axis) or up-down (y-axis)
	3rd and 4th parameters are optional. If the camera is locked, it'll lock at the rotation of those parameters.
	Input should be in degrees for that.

    > :SetCameraHost(newHost: BasePart)
    Has the camera focus in on the input part. Must be a BASEPART (not a model).
    To reset the host back to the player's character, you can leave the parameters blank.

    > :Change(property: string, val: any, changeDefaultProperty: boolean)
    Properties include:
        "CharacterVisibility" (string): Determines what part of the character is visible.
        when it's the host. "All" shows all parts, "Body" hides the head, & "None" hides the whole body.
        "MinZoom" (number): Determines how close the player can zoom in. In studs.
        "MaxZoom" (number): Determines how far the player can zoom out. In studs.
        "Zoom" (number): The current distance the camera is away from the host.
        "Smoothness" (number): Determines how smooth the camera movement is.
        	Intervals from 0-1 are suggested. Intervals higher could be used to create a "cinematic" effect.
        "Offset" (CFrame): Determines the offset/positioning away from the camera host.
        	Can be used to simulate shift-lock.
		"Wobble" (number): Adjusts the factor for dynamic wobbling. Same functionality as :SetWobbling
        "LockMouse" (boolean): Has the mouse locked in at the center.
		"AlignChar" (boolean): If set to true, the character will rotate itself based off the camera (highly advised for shift-locks and first person)
		"BodyFollow" (boolean): If AlignChar is NOT enabled, BodyFollow allows for an effect that has the upper body slightly rotate based off the mouse location.

    > :ChangeSensitivity(val: number)
    Changes the rate at which the camera moves. 
    Merely adjusts the UserInputServiceService.MouseDeltaSensitivity property. 
    NOTICE: Players CAN change this themselves manually through the Roblox menu.

    > :ChangeFOV(val: number, instant: boolean)
    Gradually changes the field-of-view of the current camera.
    If you want the change to be instantaneous, add a second parameter marked true. 
    Changing FOV directly with the actual camera object is still possible.

    > :Shake(intensity: number, duration: number) (YIELDING FUNCTION)
    Creates a shaking camera effect in which the screen is, well, shaking. Like an earthquake. 
    Intensity should be a number greater than 0, preferably in the 0-1 range. Duration is in seconds.

    > :Tilt(degree: number)
    Tilts the camera across the z-axis on whatever object it is currently focusing on. 
    Useful for creating camera effects. Input a number in degrees.

    > :TiltAllAxes(y: number, x: number, z: number)
    Like :Tilt, but allows you to adjust all 3 axes. Most likely use-case would be for creating camera effects.
    Inputs in Y, X, Z order.

    > :SetWobbling(value: number)
    Changes the wobble value of the given Camera property.  This is equivalent to - CameraService:Change("Wobble", value, false)
    Input a number.

    > :SetVerticalRange(angle: number)
    Changes the vertical range of motion (i.e. how far up and down a player can look).
    Input a number in degrees from 0 (least range of motion) to 89 (most).

    Created by @Lugical | Relased September, 2022
    Version 2.4.0 | April 2026
--]]

math.randomseed(tick())
-- > Services < --
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

-- > Player Objects < --
local player = Players.LocalPlayer :: Player
local mouse = player:GetMouse()

-- > Camera System Variables < --
local TWEEN_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local currentCamPosition = Vector3.zero
local cameraRotation = Vector2.zero
local currentCharacter = player.Character or player.CharacterAdded:Wait()
local offset = Vector3.zero
local updateShake = 0
local delta = Vector3.zero
local differenceVector = Vector2.zero
local waistCache: CFrame? = nil
local _wobbleAngle = 0
local neckCache: CFrame? = nil

-- > MUNCHMALS INTERVENTION < --
local CameraStore = require(script.Parent.CameraStore)
local CamTable = CameraStore.GetCameraTable()

--> Built-in camera views
local cameraSettings: { [string]: { [string]: any } } = {
	["Default"] = {},
	["FirstPerson"] = {
		Wobble = 0.45,
		CharacterVisibility = "None",
		Smoothness = 1,
		RotSmoothness = 0,
		Zoom = 0,
		AlignChar = true,
		Offset = CFrame.new(0, 0, 0),
		LockMouse = true,
		MinZoom = 0,
		MaxZoom = 0,
		BodyFollow = true,
	},

	["FirstPersonVariant"] = {
		Wobble = 2,
		CharacterVisibility = "Body",
		Smoothness = 0.35,
		RotSmoothness = 0,
		Zoom = 0,
		AlignChar = true,
		Offset = CFrame.new(0, 0.2, 0.75),
		LockMouse = true,
		MinZoom = 0,
		MaxZoom = 0,
		BodyFollow = true,
	},

	["ThirdPerson"] = {
		Wobble = 0.4,
		CharacterVisibility = "All",
		Smoothness = 0.7,
		Zoom = 10,
		AlignChar = false,
		Offset = CFrame.new(0, 0, 0),
		LockMouse = false,
		MinZoom = 5,
		MaxZoom = 15,
		BodyFollow = true,
	},

	["ShiftLock"] = {
		Wobble = 0,
		CharacterVisibility = "All",
		Smoothness = 0.7,
		Zoom = 7.5,
		Offset = CFrame.new(1.75, 0.5, 1),
		LockMouse = true,
		AlignChar = true,
		MinZoom = 2,
		MaxZoom = 15,
		BodyFollow = true,
	},

	["Cinematic"] = {
		Smoothness = 5,
		CharacterVisibility = "All",
		MinZoom = 10,
		MaxZoom = 10,
		Zoom = 10,
		AlignChar = false,
		Offset = CFrame.new(),
		LockMouse = false,
		BodyFollow = false,
		Wobble = 0,
	},
}

local connectionList: { RBXScriptConnection } = {}

--> For camera views
local propertyTypes: { [string]: any } = {
	["CharacterVisibility"] = "All",
	["Smoothness"] = 0.5, --> If you're looking to get a smooth effect, I HIGHLY suggest values of 0.3+
	["Zoom"] = 10,
	["RotSmoothness"] = 1,
	["AlignChar"] = false,
	["Offset"] = CFrame.new(),
	["MinZoom"] = 5,
	["MaxZoom"] = 15,
	["LockMouse"] = false,
	["BodyFollow"] = true,
	["Wobble"] = 0,
}

--- @class CameraService
--- Structured as a singleton, CameraService operates by implementing its own base camera system
--- with various properties and methods you can use to customize it how you wish, or to enable a prebuilt camera.
---
--- Some of the API is not the cleanest. A cleanup + conversion to Luau is planned!
local CameraService = {
	CameraView = "Default" :: string,
	CharacterVisibility = "All" :: string,
	Smoothness = 0.5 :: number,
	Zoom = 10 :: number,
	RotSmoothness = 1 :: number,
	AlignChar = false :: boolean,
	Offset = CFrame.new() :: CFrame,
	MinZoom = 5 :: number,
	MaxZoom = 15 :: number,
	LockMouse = false :: boolean,
	BodyFollow = true :: boolean,
	Wobble = 0 :: number,
	TiltFactor = CFrame.fromEulerAnglesYXZ(0, 0, 0) :: CFrame,
	Angle = 60 :: number,
	Host = currentCharacter:WaitForChild("HumanoidRootPart") :: BasePart,
	xLock = false :: boolean,
	yLock = false :: boolean,
	atX = 0 :: number,
	atY = 0 :: number,
	Shaking = false :: boolean,
	ShakingIntensity = 0 :: number,
}

--[=[
	@within CameraService
	@prop CameraView string
	@readonly

	The current camera view CameraService is applying. To adjust the current view,
	do so via [CameraService:SetCameraView]
	(e.g. `"FirstPerson"`, `"ThirdPerson"`).
]=]

--[=[
	@within CameraService
	@prop Host BasePart

	The part the camera focuses on. Defaults to the player's
	`HumanoidRootPart`. Point it elsewhere with [CameraService:SetCameraHost],
	which validates the value and resets cleanly on respawn.
]=]

--[=[
	@within CameraService
	@prop Smoothness number

	Value representing how "smooth" camera motion is perceived. `0` is instant, while higher values create smoother, flow motion.
]=]

--[=[
	@within CameraService
	@prop RotSmoothness number
	@tag Restricted

	Smoothing applied to camera *rotation* only, independent of `Smoothness`.
	Applied only when the active view has no zoom range (e.g. first-person).
]=]

--[=[
	@within CameraService
	@prop Zoom number

	Current distance, in studs, between the camera and its host.
]=]

--[=[
	@within CameraService
	@prop MinZoom number

	Closest the player may zoom in, in studs.
]=]

--[=[
	@within CameraService
	@prop MaxZoom number
	Furthest the player may zoom out, in studs.
]=]

--[=[
	@within CameraService
	@prop Offset CFrame

	Positional & rotational offset from the host, applied before zoom. Useful
	for over-the-shoulder or shift-lock framing.
]=]

--[=[
	@within CameraService
	@prop CharacterVisibility string

	Which parts of the host character are visible when it is the host:
	`"All"` shows everything, `"Body"` hides the head, `"None"` hides the
	whole character. Defaults to `"All"`.
]=]

--[=[
	@within CameraService
	@prop AlignChar boolean

	When `true`, the character rotates to face the camera. Good for
	shift-lock and first-person views. Defaults to `false`.
]=]

--[=[
	@within CameraService
	@prop BodyFollow boolean
	@tag Restricted
	@tag R15-Only

	When `true`, the upper body leans toward the
	mouse for a subtle look-at effect. This property
	is *ignored* if `AlignChar` is true, as they are conflicting behaviors.
]=]

--[=[
	@within CameraService
	@prop LockMouse boolean

	When `true`, the mouse is locked to the center of the screen.
	Defaults to `false`.
]=]

--[=[
	@within CameraService
	@prop Wobble number

	Intensity of the avatar-aware wobbling when walking; `0` disables it. Can be changed 
	with [CameraService:SetWobbling].
]=]

--[=[
	@within CameraService
	@prop Angle number

	Maximum vertical look angle, in degrees (how far up/down the player can
	look). Set it through [CameraService:SetVerticalRange], which clamps to
	`0`–`89`.
]=]

--[=[
	@within CameraService
	@prop TiltFactor CFrame

	Accumulated camera tilt applied on top of the view.
]=]

-- > Camera System Functions < --

--> @hideBodyParts: helper function setting up CharacterVisibility
local function hideBodyParts(__type: string?)
	if currentCharacter then
		--> Set-up the rotation for shift-locking
		local hum = currentCharacter:FindFirstChildWhichIsA("Humanoid")
		if hum then
			hum.AutoRotate = not CameraService.AlignChar and true or false
		end

		--> Hide/unhide body parts when changing between views
		for _, v in ipairs(currentCharacter:GetChildren()) do
			if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
				--> Run logic for parts within parts
				if v:GetDescendants() then
					for _, child in ipairs(v:GetDescendants()) do
						if child:IsA("BasePart") then
							child.LocalTransparencyModifier = __type and __type == "All" and 0 or 1
						elseif child:IsA("Decal") then
							child.LocalTransparencyModifier = __type and __type == "All" and 0 or 1
						end
					end
				end

				--> If no __type, hide everything
				if __type then
					v.LocalTransparencyModifier = __type == "All" and 0
						or __type == "Body" and v.Name == "Head" and 1
						or 0
				else
					v.LocalTransparencyModifier = 1
				end
			elseif v:IsA("Accessory") and v:FindFirstChildWhichIsA("BasePart") then
				--> Set the hiding logic
				for _, child in ipairs(v:GetDescendants()) do
					if child:IsA("BasePart") then
						child.LocalTransparencyModifier = __type and __type == "All" and 0 or 1
					elseif child:IsA("Decal") then
						child.LocalTransparencyModifier = __type and __type == "All" and 0 or 1
					end
				end
			end
		end
	else
		warn("[CameraService] Cannot find a host that is a Character model.")
	end
end

--> @calculateShakingOffset: shakes the camera each frame w/an offset
local function calculateShakingOffset(intensity: number): Vector3
	local multipliers = { -1, 1 }
	--> Use sin/cos for sense of randomness
	local currentSeed = math.random(1, os.time()) * multipliers[math.random(1, #multipliers)]
	local x = math.sin(currentSeed) * (intensity * 1.5 ^ 2) / 3
	local y = math.clamp(math.cos(currentSeed) * (intensity * 1.5 ^ 1.5), 0, 10) / 3
	--> Only offset Z in non-first-person views
	local z = CameraService.CharacterVisibility == "All" and (math.cos(currentSeed) / 2) * intensity / 5 or 0

	return Vector3.new(x, y, z) * math.max(CameraService.Smoothness ^ 2 * 0.5, 1)
end

--> @raycastWorld: correct zooms to avoid clipping parts
local function raycastWorld(origin: Vector3, direction: Vector3): Vector3
	--> Set params w/blacklist
	local params = RaycastParams.new()
	params.IgnoreWater = true
	if
		CameraService.Host.Parent
		and CameraService.Host.Parent ~= workspace
		and CameraService.Host.Parent:IsA("Model")
	then
		params.FilterDescendantsInstances = { currentCharacter, CameraService.Host.Parent } :: { Instance }
	else
		params.FilterDescendantsInstances = { currentCharacter, CameraService.Host } :: { Instance }
	end
	local _pos = (currentCamPosition + offset) -- no Offset property applied yet
	--> Allow clipping through transluscent parts
	local landRay = workspace:Raycast(origin, direction, params)
	if landRay and landRay.Distance and landRay.Instance then
		if landRay.Instance:IsA("BasePart") or landRay.Instance:IsA("UnionOperation") then
			direction *= (landRay.Distance * 0.9 / direction.Magnitude)
		else
			direction *= (landRay.Distance * 0.95 / direction.Magnitude)
		end
	end

	--> Cframe * Vector3 to zoom out in proper direction.
	return origin + direction
end

--> @updateCamera: update camera orientation + pos @ each frame
local lapsed = 1000 --> Used for dampening while jumping/falling
local arrowKeyAngle = 0
local pastCamRot = CFrame.Angles(0, 0, 0)
function updateCamera(deltaTime: number)
	local self = CameraService
	--> Console has different inputs + logic. This helps set up CONSOLE camera movement
	if UserInputService.GamepadEnabled then
		cameraRotation -= differenceVector
	else
		differenceVector = Vector2.zero
	end
	--> Clamp the y-vals for camera rotating
	cameraRotation = Vector2.new(
		self.xLock and self.atX or cameraRotation.X,
		self.yLock and self.atY or math.clamp(cameraRotation.Y, math.rad(-self.Angle), math.rad(self.Angle))
	)

	currentCamPosition = self.Host.Position
		+ Vector3.new(0, self.Host.Parent and self.Host.Parent == currentCharacter and 2.5 or 0, 0)

	--> rotate camera via arrow keys on PC
	if UserInputService:IsKeyDown(Enum.KeyCode.Right) then
		arrowKeyAngle += 3 * deltaTime
	elseif UserInputService:IsKeyDown(Enum.KeyCode.Left) then
		arrowKeyAngle -= 3 * deltaTime
	end

	--> Convert cameraRotation into an angle CFrame (YXZ = Angles)
	local rotationCFrame = CFrame.fromEulerAnglesYXZ(cameraRotation.Y, cameraRotation.X - arrowKeyAngle, 0)
	updateShake = updateShake < math.random(2, 3) and updateShake + 1 or 0
	offset = self.Shaking and offset and updateShake == 0 and calculateShakingOffset(self.ShakingIntensity)
		or self.Shaking and offset
		or Vector3.new(0, 0, 0)
	local yCFOffset = CFrame.fromEulerAnglesYXZ(0, 0, 0)

	--> Dynamic wobble based on character's movement
	if self.Wobble and self.Wobble > 0 and self.Host.Parent and self.Host.Parent == currentCharacter then
		pcall(function()
			local charAny = currentCharacter :: any
			local yOff = charAny.Humanoid.RigType == Enum.HumanoidRigType.R15
					and (charAny["LeftFoot"].Position.Y - charAny["RightFoot"].Position.Y) / 1.5
				or charAny.Humanoid.RigType == Enum.HumanoidRigType.R6 and (charAny["Left Leg"].Position.Y - charAny["Right Leg"].Position.Y)
				or 0
			local target = math.rad(yOff * (self.Wobble ^ 1.5))
			yCFOffset = CFrame.fromEulerAnglesYXZ(0, 0, target)
		end)
	end

	--> Damping the motion of the camera for smoothing
	local desiredTime = self.Smoothness ^ 2 * 0.05 + 0.02 * self.Smoothness + 0.005
	local lerpFactor = 1 - math.exp(-deltaTime / desiredTime) --math.min(1, deltaTime / desiredTime)

	if self.MinZoom == 0 and self.MaxZoom == 0 and self.RotSmoothness > self.Smoothness then
		local desiredTime2 = self.RotSmoothness ^ 2 * 0.05 + 0.02 * self.RotSmoothness + 0.005
		local lerpFactor2 = 1 - math.exp(-deltaTime / desiredTime2) --math.min(1, deltaTime / desiredTime2)
		rotationCFrame = self.RotSmoothness > 0 and pastCamRot:Lerp(rotationCFrame, lerpFactor2) or rotationCFrame
	end

	pastCamRot = rotationCFrame
	local camCFrame = (rotationCFrame * self.Offset * self.TiltFactor)
		+ currentCamPosition
		+ offset
		+ (rotationCFrame * Vector3.new(0, 0, self.Zoom))
	local camPos = raycastWorld(currentCamPosition + offset, camCFrame.Position - offset - currentCamPosition)
	camCFrame = (camCFrame - camCFrame.Position) + camPos
	local targetCFrame = CamTable.CameraCFrame:Lerp(camCFrame, lerpFactor)

	local desired2 = desiredTime
	local lerp2: CFrame? = nil
	if self.Zoom > 0 and self.Smoothness > 0 then
		--> @damper: Increases damping factor for vertical motion
		local function damper()
			local hum = currentCharacter:FindFirstChildWhichIsA("Humanoid")
			local humState: Enum.HumanoidStateType? = nil

			if hum then
				humState = hum:GetState()
			end

			if (humState == Enum.HumanoidStateType.Jumping) or (humState == Enum.HumanoidStateType.Freefall) then
				lapsed = 0
				return desiredTime * 3.33
			end
			lapsed += 1
			if lapsed < 1 / deltaTime then
				return desiredTime * 3.33
			else
				return math.max(desiredTime, desiredTime * (3.33 - (lapsed - (1 / deltaTime)) * 0.03))
			end
		end
		desired2 = damper()
	end

	lerp2 = desired2 ~= desiredTime and CamTable.CameraCFrame:Lerp(camCFrame, 1 - math.exp(-deltaTime / desired2))
		or nil

	--> Store the final computed CFrame inside of the camera store table
	CamTable.CameraCFrame = self.Smoothness <= 0 and camCFrame
		or CFrame.new(targetCFrame.X, lerp2 and lerp2.Y or targetCFrame.Y, targetCFrame.Z)
			* targetCFrame.Rotation
			* yCFOffset

	--> Extraneous character alignment features if needed
	if self.Host.Parent == currentCharacter then
		workspace.Retargeting = Enum.AnimatorRetargetingMode.Disabled
		local humanoid = currentCharacter:FindFirstChildWhichIsA("Humanoid")
		local root = currentCharacter:FindFirstChild("HumanoidRootPart") :: BasePart?
		if humanoid and humanoid.Health > 0 and root then
			local upperTorso = currentCharacter:FindFirstChild("UpperTorso")
			local head = currentCharacter:FindFirstChild("Head")
			local waist = if humanoid.RigType == Enum.HumanoidRigType.R15 and upperTorso
				then upperTorso:FindFirstChildWhichIsA("Motor6D")
				else nil
			local neck = if humanoid.RigType == Enum.HumanoidRigType.R15 and head
				then head:FindFirstChildWhichIsA("Motor6D")
				else nil
			if waist and not waistCache then
				waistCache = waist.C0
			end
			if neck and not neckCache then
				neckCache = neck.C0
			end
			if self.AlignChar and humanoid.FloorMaterial ~= Enum.Material.Water then
				if waist and waistCache and waist.C0 ~= waistCache then
					waist.C0 = waistCache
				end
				if neck and neckCache and neck.C0 ~= neckCache then
					neck.C0 = neckCache
				end
				local _, x, _ = camCFrame:ToEulerAnglesYXZ()
				root.CFrame = CFrame.fromEulerAnglesYXZ(0, x + math.rad(self.Offset.X == 0 and 0 or -6), 0)
					+ root.Position
			elseif humanoid.RigType == Enum.HumanoidRigType.R15 then
				if self.BodyFollow and waist and neck and waistCache and neckCache then
					waist.C0 = waist.C0:Lerp(
						(
							CFrame.fromEulerAnglesYXZ(
								math.rad(mouse.Hit.LookVector:Dot(Vector3.new(0, 1, 0)) * 10),
								math.rad(
									mouse.Hit.LookVector:Dot(
										(CFrame.Angles(root.CFrame:ToEulerAnglesYXZ()) * CFrame.new(-1, 0, 0)).Position.Unit
									) * 40
								),
								0
							) + waistCache.Position
						),
						0.25
					)
					neck.C0 = neck.C0:Lerp(
						(
							CFrame.fromEulerAnglesYXZ(
								math.rad(mouse.Hit.LookVector:Dot(Vector3.new(0, 1, 0)) * 30),
								0,
								0
							) + neckCache.Position
						),
						0.25
					)
					if waist and not waistCache then
						waistCache = waist.C0
					end
					if neck and not neckCache then
						neckCache = neck.C0
					end
				else
					if waist and waistCache and waist.C0 ~= waistCache then
						waist.C0 = waistCache
					end
					if neck and neckCache and neck.C0 ~= neckCache then
						neck.C0 = neckCache
					end
				end
			end
		end
	end
end

--- Sets the camera to a built-in or custom view, disconnecting the previous one.
--- Will error if the given view ID does not exist.
--- @within CameraService
--- @param __type string -- The view to apply (e.g. `"FirstPerson"`, `"ThirdPerson"`, `"ShiftLock"`, `"Cinematic"`, `"Default"`).
function CameraService:SetCameraView(__type: string)
	assert(cameraSettings[__type] ~= nil, "[CameraService] Camera view not found for ID: " .. tostring(__type))

	local svc = CameraService
	local selfTable = svc :: { [string]: any }
	svc.CameraView = __type
	for i, v in pairs(cameraSettings[__type]) do
		selfTable[i] = v
	end
	for _, connection in pairs(connectionList) do
		connection:Disconnect()
	end

	--> Check what camera view the user wants
	if __type == "Default" then
		--> Resets it back to non-scriptable, Roblox default camera
		svc.LockMouse = false
		local defaultHum = currentCharacter:WaitForChild("Humanoid") :: Humanoid
		CamTable.CameraSubject = defaultHum
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		CamTable.CameraType = Enum.CameraType.Custom
		workspace.Retargeting = Enum.AnimatorRetargetingMode.Default
		defaultHum.AutoRotate = true
	elseif cameraSettings[__type] then
		--> Add in settings
		workspace.Retargeting = Enum.AnimatorRetargetingMode.Disabled
		if svc.Host.Parent and svc.Host.Parent == currentCharacter then
			hideBodyParts(if svc.CharacterVisibility ~= "None" then svc.CharacterVisibility else nil)
		end
		UserInputService.MouseBehavior = svc.LockMouse and __type ~= "Default" and Enum.MouseBehavior.LockCenter
			or Enum.MouseBehavior.Default
		CamTable.CameraType = Enum.CameraType.Scriptable
		CamTable.CameraSubject = nil

		--> @updateZoom: for camera zooming in/out
		local function updateZoom(input: InputObject, gpe: boolean)
			if not gpe then
				if input.UserInputType == Enum.UserInputType.MouseWheel then --> Computer (mouse)
					local multiplier = input.Position.Z
					svc.Zoom = math.clamp(
						svc.Zoom - (multiplier * (svc.MaxZoom - svc.MinZoom) / 4),
						svc.MinZoom,
						svc.MaxZoom
					)
				elseif
					input.UserInputState == Enum.UserInputState.Begin
					and (input.KeyCode == Enum.KeyCode.I or input.KeyCode == Enum.KeyCode.O)
				then --> Computer (I/O)
					local multiplier = input.KeyCode == Enum.KeyCode.I and 1 or -1
					svc.Zoom = math.clamp(
						svc.Zoom - (multiplier * (svc.MaxZoom - svc.MinZoom) / 4),
						svc.MinZoom,
						svc.MaxZoom
					)
				elseif input.KeyCode == Enum.KeyCode.ButtonR3 and input.UserInputState == Enum.UserInputState.Begin then --> Console Joystick Press
					svc.Zoom = svc.Zoom - ((svc.MaxZoom - svc.MinZoom) / 4) < svc.MinZoom and svc.MaxZoom
						or svc.Zoom - ((svc.MaxZoom - svc.MinZoom) / 4)
				end
			end
		end

		--> @onInputChange: stores input, convert to Vector2 with rotation data
		local function onInputChange(input: InputObject, gpe: boolean)
			updateZoom(input, gpe)
			local rightHold = svc.LockMouse or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
			local mobile = input.UserInputType == Enum.UserInputType.Touch
			local console = input.UserInputType == Enum.UserInputType.Gamepad1
				and input.KeyCode == Enum.KeyCode.Thumbstick2
			if
				(not gpe or (not mobile and not console))
				and (rightHold or mobile or console)
				and input.UserInputState == Enum.UserInputState.Change
			then
				delta = console and input.Position / 15 * math.sqrt(UserInputService.MouseDeltaSensitivity)
					or input.Delta --> Get mouse position
				differenceVector = if console
					then Vector2.new(delta.X, -delta.Y)
					else Vector2.new(
						math.sqrt(math.abs(delta.X)) / (mobile and 27 or 50),
						math.sqrt(math.abs(delta.Y)) / (mobile and 27 or 50)
					)
				--> Adjust the positions
				if console then
					differenceVector = Vector2.new(
						if delta.X < 0.2 / 15 * math.sqrt(UserInputService.MouseDeltaSensitivity)
								and delta.X > -0.2 / 15 * math.sqrt(UserInputService.MouseDeltaSensitivity)
							then 0
							else delta.X,
						if -delta.Y < 0.2 / 15 * math.sqrt(UserInputService.MouseDeltaSensitivity)
								and -delta.Y > -0.2 / 15 * math.sqrt(UserInputService.MouseDeltaSensitivity)
							then 0
							else -delta.Y
					)
				else
					differenceVector = Vector2.new(
						if delta.X > 0 then 1 * differenceVector.X else -1 * differenceVector.X,
						if delta.Y > 0 then 1 * differenceVector.Y else -1 * differenceVector.Y
					)
				end
				--> Update rotation once if not console; console updates rotation on each frame
				if not console then
					cameraRotation -= differenceVector
					cameraRotation = Vector2.new(
						svc.xLock and svc.atX or cameraRotation.X,
						svc.yLock and svc.atY
							or math.clamp(cameraRotation.Y, math.rad(-svc.Angle), math.rad(svc.Angle))
					)
				end
			end
			UserInputService.MouseBehavior = svc.LockMouse and Enum.MouseBehavior.LockCenter
				or rightHold and Enum.MouseBehavior.LockCurrentPosition
				or Enum.MouseBehavior.Default
		end

		--> Disconnect any active connections
		for _, connection in pairs(connectionList) do
			connection:Disconnect()
		end

		--> Mobile Compatibility
		if UserInputService.TouchEnabled then
			table.insert(connectionList, UserInputService.TouchPan:Connect(onInputChange :: any))
			table.insert(connectionList, UserInputService.TouchRotate:Connect(onInputChange :: any))
			local pinchDelta = 0
			table.insert(
				connectionList,
				UserInputService.TouchPinch:Connect(function(_, scale: number, _, state: Enum.UserInputState, gpe: boolean)
					svc.Zoom = gpe and svc.Zoom
						or state == Enum.UserInputState.Begin and svc.Zoom
						or math.clamp(
							svc.Zoom - ((pinchDelta and scale - pinchDelta or 0) * 20),
							svc.MinZoom,
							svc.MaxZoom
						)
					pinchDelta = scale
				end)
			)
		end

		--> Set up the input connections
		table.insert(connectionList, UserInputService.InputBegan:Connect(onInputChange))
		table.insert(connectionList, UserInputService.InputChanged:Connect(onInputChange))
		table.insert(connectionList, UserInputService.InputEnded:Connect(onInputChange))
		--> Set up the actual system to run
		table.insert(connectionList, RunService.PostSimulation:Connect(updateCamera))

		--> Special effects for the CINEMATIC VIEW
		if __type == "Cinematic" then
			local ui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
			ui.Name = "CameraService_Cinematic_Effect"
			ui.Enabled = true
			ui.ResetOnSpawn = false
			ui.IgnoreGuiInset = true
			local uiFrame1 = Instance.new("Frame", ui)
			uiFrame1.BackgroundColor3 = Color3.new(0, 0, 0)
			uiFrame1.Name = "Frame1"
			uiFrame1.BorderSizePixel = 0
			uiFrame1.Size = UDim2.new(1, 0, 0.135, 0)
			local uiFrame2 = uiFrame1:Clone()
			uiFrame2.Parent = ui
			uiFrame2.Name = "Frame2"

			uiFrame1.Position = UDim2.new(0, 0, -0.136, 0)
			uiFrame2.Position = UDim2.new(0, 0, 1, 0)

			uiFrame1:TweenPosition(UDim2.new(0, 0, 0, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 0.25, true)
			uiFrame2:TweenPosition(UDim2.new(0, 0, 0.865, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 0.25, true)
		end
	end

	if __type ~= "Cinematic" then
		local ui = player:WaitForChild("PlayerGui"):FindFirstChild("CameraService_Cinematic_Effect")
		if ui then
			local uiFrame1 = ui:FindFirstChild("Frame1") :: Frame?
			local uiFrame2 = ui:FindFirstChild("Frame2") :: Frame?
			if uiFrame1 then
				uiFrame1:TweenPosition(UDim2.new(0, 0, -0.1360, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 0.25, true)
			end
			if uiFrame2 then
				uiFrame2:TweenPosition(UDim2.new(0, 0, 1, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Sine, 0.25, true)
			end
			task.wait(0.25)
			ui:Destroy()
		end
	end
end

--- Registers a new camera view that can later be activated via `:SetCameraView`.
--- Any omitted property falls back to the default value and logs a warning.
--- @within CameraService
--- @param id string -- Unique identifier for the new view.
--- @param settingsArray table -- Table of camera property overrides (see `:Change` for valid keys).
function CameraService:CreateNewCameraView(id: string, settingsArray: { [string]: any })
	--> Make sure that settingsArray is a table to ensure all runs well
	assert(
		typeof(settingsArray) == "table",
		"[CameraService] 2nd parameter should be a table for :CreateNewCameraView()"
	)

	--> Register the new view
	cameraSettings[id] = settingsArray
	for property: string, default: any in pairs(propertyTypes) do
		if cameraSettings[id][property] == nil then
			warn(
				'[CameraService] The "' .. property .. '" property was set to the default value: ' .. tostring(default)
			)
			cameraSettings[id][property] = default
		end
	end
end

--- Locks camera movement along the X axis (left/right) or Y axis (up/down).
--- Useful for 2D or isotropic cameras.
--- @within CameraService
--- @param lockXAxis boolean -- Lock horizontal rotation.
--- @param lockYAxis boolean -- Lock vertical rotation.
--- @param lockAtX number? -- Angle in degrees to lock horizontal rotation at.
--- @param lockAtY number? -- Angle in degrees to lock vertical rotation at.
function CameraService:LockCameraPanning(lockXAxis: boolean, lockYAxis: boolean, lockAtX: number?, lockAtY: number?)
	--> Set up the camera orientation
	self.atX = lockAtX and math.rad(lockAtX) or 0
	self.atY = lockAtY and math.rad(lockAtY) or 0
	--> Lock if necessary
	self.xLock = lockXAxis
	self.yLock = lockYAxis
end

--- Redirects the camera to focus on an input BasePart instead of the player character.
--- Pass no argument (or nil) to reset back to the player's HumanoidRootPart.
--- @within CameraService
--- @param newHost BasePart? -- The part to focus on, or nil to reset to the character.
function CameraService:SetCameraHost(newHost: BasePart?)
	assert(
		not newHost or typeof(newHost) == "Instance" and newHost:IsA("BasePart"),
		"[CameraService] :SetCameraHost() only accepts a BasePart parameter, or none at all. "
	)
	self.Host = (newHost or currentCharacter:FindFirstChild("HumanoidRootPart")) :: BasePart
end

--- Changes a live camera property. Optionally persists the change into the current view's defaults.
---
--- Valid properties:
--- - `CharacterVisibility` (string): `"All"`, `"Body"` (hides head), or `"None"` (hides whole body).
--- - `MinZoom` (number): Closest zoom distance in studs.
--- - `MaxZoom` (number): Furthest zoom distance in studs.
--- - `Zoom` (number): Current camera distance in studs.
--- - `Smoothness` (number): Camera lag factor; 0–1 recommended, higher = cinematic.
--- - `Offset` (CFrame): Positional offset from the camera host.
--- - `Wobble` (number): Dynamic wobble intensity.
--- - `LockMouse` (boolean): Keep the mouse locked at screen center.
--- - `AlignChar` (boolean): Rotate the character to match the camera (required for shift-lock / first-person).
--- - `BodyFollow` (boolean): Upper-body rotates toward mouse when `AlignChar` is off.
--- @within CameraService
--- @param property string -- Name of the property to change.
--- @param newVal any -- New value for the property.
--- @param changeDefaultProperty boolean -- If true, also updates the active view's saved default.
function CameraService:Change(property: string, newVal: any, changeDefaultProperty: boolean?)
	--> Make sure the requested property to change is valid
	assert(
		propertyTypes[property] ~= nil,
		'[CameraService] "' .. tostring(property) .. '" is not a valid property to change.'
	)

	local selfTable = CameraService :: { [string]: any }
	selfTable[property] = newVal
	if changeDefaultProperty then --> Change the camera view's default setting, if wanted
		cameraSettings[CameraService.CameraView][property] = newVal
	end
end

--- Adjusts mouse/input sensitivity by setting `UserInputService.MouseDeltaSensitivity`.
--- Note: players can override this themselves via the Roblox settings menu.
--- @within CameraService
--- @param val number -- Sensitivity multiplier; must be greater than 0.
function CameraService:ChangeSensitivity(val: number)
	--> Make sure that "val" is positive before doing anything
	assert(type(val) == "number" and val > 0, "[CameraService] Sensitivity should be greater than 0.")
	UserInputService.MouseDeltaSensitivity = val
end

--- Smoothly tweens the camera's field of view to the given value.
--- Pass `true` as the second argument to skip the tween and change it instantly.
--- This function yields until the tween completes (unless `instant` is true).
--- @within CameraService
--- @yields
--- @param val number -- Target field of view; must be greater than 0.
--- @param instant boolean? -- If true, changes FOV immediately with no tween.
function CameraService:ChangeFOV(val: number, instant: boolean?)
	--> Make sure that "val" is positive before doing anything
	assert(type(val) == "number" and val > 0, "[CameraService] FieldOfView should be greater than 0.")

	--> Set up FOV logic
	if instant then
		CamTable.CameraFOV = val
	else
		local startFOV = CamTable.CameraFOV
		local startTime = os.clock()
		local duration = TWEEN_INFO.Time
		while os.clock() - startTime < duration do
			local alpha = math.min(1, (os.clock() - startTime) / duration)
			local eased = TweenService:GetValue(alpha, TWEEN_INFO.EasingStyle, TWEEN_INFO.EasingDirection)
			CamTable.CameraFOV = startFOV + (val - startFOV) * eased
			task.wait()
		end
		CamTable.CameraFOV = val
	end
end

--- Applies a shaking effect to the camera for the given duration, then stops.
--- @within CameraService
--- @yields
--- @param intensity number -- Strength of the shake; values in the 0–1 range are recommended.
--- @param duration number -- How long the shake lasts in seconds; must be greater than 0.
function CameraService:Shake(intensity: number, duration: number)
	--> Make sure that arguments are positive before doing anything
	assert(duration > 0 and intensity > 0, "[CameraService] Inputs for :Shake() must be positive")

	--> Logic
	self.ShakingIntensity = intensity --> Property for shake
	self.Shaking = true --> Actively shaking or not
	task.wait(tonumber(duration) :: number)
	self.Shaking = false
end

--- Tilts the camera along the Z axis by the given number of degrees.
--- @within CameraService
--- @param degree number -- Tilt angle in degrees.
function CameraService:Tilt(degree: number)
	self.TiltFactor = CFrame.fromEulerAnglesYXZ(0, 0, math.rad(degree) or 0)
end

--- Tilts the camera across all three axes simultaneously. Inputs are in degrees.
--- Arguments follow Y, X, Z order to match `CFrame.fromEulerAnglesYXZ`.
--- @within CameraService
--- @param x number -- Tilt on the X axis in degrees.
--- @param y number -- Tilt on the Y axis in degrees.
--- @param z number -- Tilt on the Z axis in degrees.
function CameraService:TiltAllAxes(x: number, y: number, z: number)
	self.TiltFactor = CFrame.fromEulerAnglesYXZ(y and math.rad(y) or 0, x and math.rad(x) or 0, z and math.rad(z) or 0)
end

--- Sets the avatar-aware wobble intensity. Equivalent to `CameraService:Change("Wobble", value, false)`.
--- @within CameraService
--- @param value number -- Wobble strength; 0 disables wobble.
function CameraService:SetWobbling(value: number)
	self.Wobble = value
end

--- Sets how far up and down the player can look. Input is clamped to 0–89 degrees.
--- @within CameraService
--- @param angle number -- Maximum vertical look angle in degrees (0 = locked horizontal, 89 = nearly vertical).
function CameraService:SetVerticalRange(angle: number)
	self.Angle = math.clamp(math.abs(angle), 0, 89)
end

--> Have camera reset focus to new character.
player.CharacterAdded:Connect(function(char)
	if
		not CameraService.Host
		or (not CameraService.Host:IsDescendantOf(workspace))
		or (tostring(CameraService.Host.Parent) == player.Name)
	then
		currentCharacter = char
		CameraService:SetCameraHost()
	end
end)

return CameraService
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="142">
              <Properties>
                <string name="Name">CameraStore</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")
const RunService = game:GetService("RunService")

-- Static References --
const CurrentCamera = workspace.CurrentCamera :: Camera

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))
const CameraHelper = require(script.Parent.CameraHelper)

-- Configs --
const FIXED_POSITION = SystemsConfigs.CameraFixedPosition :: Vector3
const DEFAULT_CAMERA_CFRAME = SystemsConfigs.DefaultCameraCFrame :: CFrame
const DEFAULT_CAMERA_FOV = SystemsConfigs.DefaultCameraFOV :: number

-- Tables --
local CameraTable = {
	CameraCFrame = DEFAULT_CAMERA_CFRAME,
	CameraFOV = DEFAULT_CAMERA_FOV,
	CameraType = Enum.CameraType.Scriptable,
	CameraSubject = nil :: Instance?,
}

local CameraPosition = Vector3.new(0, 0, 0) :: Vector3
local CameraRight = Vector3.new(1, 0, 0) :: Vector3
local CameraUp = Vector3.new(0, 1, 0) :: Vector3
local CameraLook = Vector3.new(0, 0, 1) :: Vector3

local CameraStore = {}

-- ============================================================================
-- 1. CAMERA SYNC - UPDATES CAMERA STATE EACH FRAME
-- ============================================================================

RunService.RenderStepped:Connect(function()
	const CameraCFrame = CameraTable.CameraCFrame :: CFrame

	CameraPosition = CameraCFrame.Position
	CameraRight = CameraCFrame.RightVector
	CameraUp = CameraCFrame.UpVector
	CameraLook = CameraCFrame.LookVector

	const TargetRotation = CameraHelper.VectorsToRotation(CameraLook, CameraUp, CameraRight)
	CurrentCamera.CFrame = CFrame.new(FIXED_POSITION) * TargetRotation
end)

--[=[
	Returns the shared camera configuration and state table.
	@return table -- Camera state dictionary containing CameraCFrame and CameraFOV.
]=]
function CameraStore.GetCameraTable()
	return CameraTable
end

--[=[
	Returns the latest cached camera world position.
	@return Vector3 -- Current camera world position.
]=]
function CameraStore.GetCameraPosition(): Vector3
	return CameraPosition
end

--[=[
	Returns the current camera RightVector basis vector.
	@return Vector3 -- Current camera right direction.
]=]
function CameraStore.GetCameraRight(): Vector3
	return CameraRight
end

--[=[
	Returns the current camera UpVector basis vector.
	@return Vector3 -- Current camera up direction.
]=]
function CameraStore.GetCameraUp(): Vector3
	return CameraUp
end

--[=[
	Returns the current camera LookVector basis vector.
	@return Vector3 -- Current camera look direction.
]=]
function CameraStore.GetCameraLook(): Vector3
	return CameraLook
end

return CameraStore
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="143">
            <Properties>
              <string name="Name">Controller</string>
            </Properties>
            <Item class="ModuleScript" referent="144">
              <Properties>
                <string name="Name">RenderController</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const Players = game:GetService("Players")
const ReplicatedStorage = game:GetService("ReplicatedStorage")
const AssetService = game:GetService("AssetService")

-- Static References --
const Player = Players.LocalPlayer :: Player
const PlayerGui = Player:WaitForChild("PlayerGui") :: PlayerGui
const PlayerScripts = Player:WaitForChild("PlayerScripts")

const Camera = workspace.CurrentCamera :: Camera

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))
const ECSMain = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ECSMain"))
const RenderMath = require(ReplicatedStorage.Shared.Utilities.Render.Core.RenderMath)
const TextureTable = require(ReplicatedStorage.Shared.Utilities.Render.Core.TextureTable)
const RenderControllerHelper = require(script.Parent.RenderControllerHelper)

const CameraStore = require(
	ReplicatedStorage:WaitForChild("Shared")
		:WaitForChild("Utilities")
		:WaitForChild("Render")
		:WaitForChild("Camera")
		:WaitForChild("CameraStore")
)

const CameraService = require(
	ReplicatedStorage:WaitForChild("Shared")
		:WaitForChild("Utilities")
		:WaitForChild("Render")
		:WaitForChild("Camera")
		:WaitForChild("CameraService")
)

-- The controller renders from the active Render ECSStorage populated by RendererCleaner.
const ECSStorage = require(
	ReplicatedStorage:WaitForChild("Shared")
		:WaitForChild("Utilities")
		:WaitForChild("Render")
		:WaitForChild("ECSStorage")
)
const ECSData = ECSStorage.ECSData
const PositionData = ECSStorage.PositionData
const SizeData = ECSStorage.SizeData
const DirectionsData = ECSStorage.DirectionsData
const VisualData = ECSStorage.VisualData
const PropertiesData = ECSStorage.PropertiesData

-- Configs --
const WIDTH = SystemsConfigs.RenderWidth :: number
const HEIGHT = SystemsConfigs.RenderHeight :: number
const IMAGE_SIZE = Vector2.new(WIDTH, HEIGHT) :: Vector2
const TOTAL_PIXELS = WIDTH * HEIGHT :: number
const SUN_DIRECTION = SystemsConfigs.SunDirection :: Vector3
const SUN_VEC = vector.create(SUN_DIRECTION.X, SUN_DIRECTION.Y, SUN_DIRECTION.Z)
const AMBIENT_LIGHT = SystemsConfigs.AmbientLight :: number
const DIFFUSE_LIGHT = 1 - AMBIENT_LIGHT :: number
const ACTOR_COUNT = SystemsConfigs.ActorCount :: number
const WORKER_BUFFER_MULTIPLIER = SystemsConfigs.WorkerBufferMultiplier :: number
const WORKER_BUFFER_CAPACITY = TOTAL_PIXELS * WORKER_BUFFER_MULTIPLIER :: number
const SCRIPTABLE_CAMERA_PARK_POSITION = SystemsConfigs.ScriptableCameraParkPosition :: Vector3
const DEFAULT_CAMERA_VIEW = SystemsConfigs.DefaultCameraView :: string

const ECS_COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number
const ECS_DIRECTION_STRIDE = SystemsConfigs.ECSDirectionStride :: number
const ECS_PROPERTIES_STRIDE = SystemsConfigs.ECSPropertiesStride :: number
const TEXTURE_SIZE = SystemsConfigs.TextureSize :: number
const TEXTURE_STUDS_PER_TILE = SystemsConfigs.TextureStudsPerTile :: number
const INV_TEXTURE_STUDS_PER_TILE = if TEXTURE_STUDS_PER_TILE > 0 then 1 / TEXTURE_STUDS_PER_TILE else 0 :: number
const TEXTURE_REGISTRY_FOLDER_NAME = SystemsConfigs.TextureRegistryFolderName :: string

local Initialized = false :: boolean
local Received = 0 :: number
local CurrentFrame = 0 :: number
local PendingTextureSyncFrames = 0 :: number
local LoadedTextureBuffers: { [number]: buffer }? = nil

-- Tables --
local WorkerActors = {} :: { Actor }
local WorkerOffsets = table.create(ACTOR_COUNT, 0) :: { number }
local WorkerScores = table.create(ACTOR_COUNT, 0) :: { number }
local BufferTable = {} :: { buffer }

-- Buffers
const EmptyPayload = buffer.create(0) :: buffer
const FinalPixel = buffer.create(TOTAL_PIXELS * 4) :: buffer
const FinalZ = buffer.create(TOTAL_PIXELS * 4) :: buffer
const ECSPositionBuffer = PositionData.GetData() :: buffer
const ECSSizeBuffer = SizeData.GetData() :: buffer
const ECSDirectionsBuffer = DirectionsData.GetData() :: buffer
const ECSVisualBuffer = VisualData.GetData() :: buffer
const ECSPropertiesBuffer = PropertiesData.GetData() :: buffer
local ScreenVertices = buffer.create(8 * 12) :: buffer
local ProjectedVertices = buffer.create(12 * 20) :: buffer
local ClipBufferA = buffer.create(12 * 20) :: buffer
local ClipBufferB = buffer.create(12 * 20) :: buffer

local Renderer = {}

-- ============================================================================
-- 1. INITIALIZATION & WORKER MESSAGE LISTENER
-- ============================================================================

-- Starter function
function Renderer.Init()
	if Initialized then
		return
	end

	const ImageLabel = PlayerGui:WaitForChild("ScreenGui"):WaitForChild("ImageLabel") :: ImageLabel
	const SelfActor = PlayerScripts:WaitForChild("Controller") :: Actor
	WorkerActors = (PlayerScripts:WaitForChild("WorkerFolder"):GetChildren() :: any) :: { Actor }

	-- Create Information Data for workers
	for i = 1, ACTOR_COUNT do
		BufferTable[i] = buffer.create(WORKER_BUFFER_CAPACITY)
		WorkerScores[i] = 0
		WorkerOffsets[i] = 0
	end

	-- Connecting Editable image to ImageLabel --
	const EditableImage = AssetService:CreateEditableImage({ Size = IMAGE_SIZE }) :: EditableImage
	ImageLabel.ImageContent = Content.fromObject(EditableImage) :: Content

	CameraService:SetCameraHost()
	CameraService:SetCameraView(DEFAULT_CAMERA_VIEW)

	-- Wait for the camera to initialize
	task.spawn(function()
		-- Switch camera to scriptable so default controls don't override it
		Camera.CameraType = Enum.CameraType.Scriptable

		-- Set position: Y = -50000 (underground) or 50000 (sky)
		-- Looking straight ahead or down
		Camera.CFrame = CFrame.new(SCRIPTABLE_CAMERA_PARK_POSITION)
	end)

	SelfActor:BindToMessage(
		"Return Render Calculations",
		function(PixelBuffer: buffer, ZBuffer: buffer, FrameId: number)
			if FrameId ~= CurrentFrame then -- ignore stale frames
				return
			end

			if Received == 0 then
				buffer.copy(FinalPixel, 0, PixelBuffer, 0, TOTAL_PIXELS * 4)
				buffer.copy(FinalZ, 0, ZBuffer, 0, TOTAL_PIXELS * 4)
			else
				for i = 0, (TOTAL_PIXELS - 1) * 4, 4 do -- Overwrites the FinalZ and FinalPixel buffers
					const IncomingInverseZ = buffer.readf32(ZBuffer, i) :: number
					if IncomingInverseZ > buffer.readf32(FinalZ, i) then
						buffer.writef32(FinalZ, i, IncomingInverseZ)
						buffer.writeu32(FinalPixel, i, buffer.readu32(PixelBuffer, i))
					end
				end
			end

			Received += 1

			-- If all workers have returned their data, write it to the image
			if Received == ACTOR_COUNT then
				EditableImage:WritePixelsBuffer(Vector2.zero, IMAGE_SIZE, FinalPixel)
				Received = 0
			end
		end
	)

	-- Decode replicated Decal URLs from TextureRegistry into 64x64 buffers inside TextureTable and push them to workers
	local function DecodeRegistryEntry(Entry: Instance)
		if not Entry:IsA("StringValue") then
			return
		end

		const TextureId = tonumber(Entry.Name) :: number?
		if not TextureId then
			return
		end

		const RawUrl = Entry.Value :: string
		const TextureNameAttr = Entry:GetAttribute("TextureName")
		const TextureName = if typeof(TextureNameAttr) == "string" then TextureNameAttr else nil

		task.spawn(function()
			const _Buf: buffer, Updated: boolean = TextureTable.RegisterEntryWithId(TextureId, RawUrl, TextureName)
			if Updated or not LoadedTextureBuffers then
				LoadedTextureBuffers = TextureTable.GetAllCachedBuffers()
				PendingTextureSyncFrames = 3
			end
		end)
	end

	local function HookTextureRegistry(RegistryFolder: Instance)
		for _, Entry: Instance in ipairs(RegistryFolder:GetChildren()) do
			DecodeRegistryEntry(Entry)
		end

		RegistryFolder.ChildAdded:Connect(DecodeRegistryEntry)
	end

	const ExistingRegistry = ReplicatedStorage:FindFirstChild(TEXTURE_REGISTRY_FOLDER_NAME)
	if ExistingRegistry then
		HookTextureRegistry(ExistingRegistry)
	else
		ReplicatedStorage.ChildAdded:Connect(function(Child: Instance)
			if Child.Name == TEXTURE_REGISTRY_FOLDER_NAME then
				HookTextureRegistry(Child)
			end
		end)
	end

	LoadedTextureBuffers = TextureTable.GetAllCachedBuffers()
	PendingTextureSyncFrames = 3

	Initialized = true
end

-- ============================================================================
-- 2. GATHER DATA - SEND DATA TO WORKERS
-- ============================================================================

function Renderer.DrawFrame()
	if not Initialized then
		Renderer.Init()
	end

	-- Tables
	local EntityCount = ECSData.GetCounts().EntityECSCount :: number

	const CamTable = CameraStore.GetCameraTable()

	const CamPosition = CameraStore.GetCameraPosition() :: Vector3
	const CamRight = CameraStore.GetCameraRight() :: Vector3
	const CamUp = CameraStore.GetCameraUp() :: Vector3
	const CamLook = CameraStore.GetCameraLook() :: Vector3

	const CamPosVec = vector.create(CamPosition.X, CamPosition.Y, CamPosition.Z)
	const CamRightVec = vector.create(CamRight.X, CamRight.Y, CamRight.Z)
	const CamUpVec = vector.create(CamUp.X, CamUp.Y, CamUp.Z)
	const CamLookVec = vector.create(CamLook.X, CamLook.Y, CamLook.Z)

	-- Configs
	const CamFOV = CamTable.CameraFOV :: number
	const FocalLength: number, GuardBandX: number, GuardBandY: number =
		RenderMath.GetProjectionParameters(CamFOV, WIDTH, HEIGHT)

	-- Pre loop Updates --
	CurrentFrame += 1
	Received = 0

	if PendingTextureSyncFrames > 0 and LoadedTextureBuffers then
		PendingTextureSyncFrames -= 1
		for _, TargetActor: Actor in ipairs(WorkerActors) do
			TargetActor:SendMessage("Set Texture Table", LoadedTextureBuffers :: { [number]: buffer }, TEXTURE_SIZE, TEXTURE_SIZE)
		end
	end

	for i = 1, ACTOR_COUNT do
		WorkerScores[i] = 0
		WorkerOffsets[i] = 0
	end

	-- Loop through all parts
	for i = 1, EntityCount do
		const ComponentOffset = (i - 1) * ECS_COMPONENT_STRIDE :: number
		const DirectionOffset = (i - 1) * ECS_DIRECTION_STRIDE :: number
		const PropertiesOffset = (i - 1) * ECS_PROPERTIES_STRIDE :: number

		const FaceMask = RenderMath.GetPartCameraVertices(
			ECSPositionBuffer,
			ECSDirectionsBuffer,
			ECSSizeBuffer,
			ComponentOffset,
			DirectionOffset,
			ScreenVertices,
			CamPosVec,
			CamRightVec,
			CamUpVec,
			CamLookVec
		) :: number

		if FaceMask == 0 then
			continue
		end

		const PropertiesRegister = buffer.readu32(ECSPropertiesBuffer, PropertiesOffset) :: number
		const EntityTextureId = ECSMain.GetEntityTextureId(PropertiesRegister) :: number

		-- If untextured (EntityTextureId == 0), shade with the part's color; if textured, use white base so the decal's colors are preserved
		local PartColorR = 255 :: number
		local PartColorG = 255 :: number
		local PartColorB = 255 :: number
		if EntityTextureId == 0 then
			PartColorR = buffer.readu8(ECSVisualBuffer, ComponentOffset) :: number
			PartColorG = buffer.readu8(ECSVisualBuffer, ComponentOffset + 1) :: number
			PartColorB = buffer.readu8(ECSVisualBuffer, ComponentOffset + 2) :: number
		end

		local TileScaleX = 1 :: number
		local TileScaleY = 1 :: number
		local TileScaleZ = 1 :: number
		if INV_TEXTURE_STUDS_PER_TILE > 0 then
			TileScaleX = math.clamp(math.floor(buffer.readf32(ECSSizeBuffer, ComponentOffset) * INV_TEXTURE_STUDS_PER_TILE + 0.5), 1, 8)
			TileScaleY = math.clamp(math.floor(buffer.readf32(ECSSizeBuffer, ComponentOffset + 4) * INV_TEXTURE_STUDS_PER_TILE + 0.5), 1, 8)
			TileScaleZ = math.clamp(math.floor(buffer.readf32(ECSSizeBuffer, ComponentOffset + 8) * INV_TEXTURE_STUDS_PER_TILE + 0.5), 1, 8)
		end

		-- Back (+Look, bit 0) or Front (-Look, bit 1)
		if bit32.btest(FaceMask, 3) then
			const LookSunDot = vector.dot(
				RenderControllerHelper.ReadDirectionVec(ECSDirectionsBuffer, DirectionOffset),
				SUN_VEC
			) :: number
			if bit32.btest(FaceMask, 1) then
				const Color = RenderControllerHelper.PackShadedColor(
					PartColorR,
					PartColorG,
					PartColorB,
					AMBIENT_LIGHT + DIFFUSE_LIGHT * math.max(0, LookSunDot)
				)
				RenderControllerHelper.SubmitFaceQuad(
					ScreenVertices,
					ProjectedVertices,
					ClipBufferA,
					ClipBufferB,
					WorkerScores,
					WorkerOffsets,
					BufferTable,
					0,
					36,
					24,
					12,
					TileScaleX,
					TileScaleY,
					Color,
					EntityTextureId,
					FocalLength,
					GuardBandX,
					GuardBandY
				)
			else
				const Color = RenderControllerHelper.PackShadedColor(
					PartColorR,
					PartColorG,
					PartColorB,
					AMBIENT_LIGHT + DIFFUSE_LIGHT * math.max(0, -LookSunDot)
				)
				RenderControllerHelper.SubmitFaceQuad(
					ScreenVertices,
					ProjectedVertices,
					ClipBufferA,
					ClipBufferB,
					WorkerScores,
					WorkerOffsets,
					BufferTable,
					48,
					60,
					72,
					84,
					TileScaleX,
					TileScaleY,
					Color,
					EntityTextureId,
					FocalLength,
					GuardBandX,
					GuardBandY
				)
			end
		end

		-- Bottom (-Up, bit 2) or Top (+Up, bit 3)
		if bit32.btest(FaceMask, 12) then
			const UpSunDot = vector.dot(
				RenderControllerHelper.ReadDirectionVec(ECSDirectionsBuffer, DirectionOffset + 12),
				SUN_VEC
			) :: number
			if bit32.btest(FaceMask, 4) then
				const Color = RenderControllerHelper.PackShadedColor(
					PartColorR,
					PartColorG,
					PartColorB,
					AMBIENT_LIGHT + DIFFUSE_LIGHT * math.max(0, -UpSunDot)
				)
				RenderControllerHelper.SubmitFaceQuad(
					ScreenVertices,
					ProjectedVertices,
					ClipBufferA,
					ClipBufferB,
					WorkerScores,
					WorkerOffsets,
					BufferTable,
					0,
					12,
					60,
					48,
					TileScaleZ,
					TileScaleX,
					Color,
					EntityTextureId,
					FocalLength,
					GuardBandX,
					GuardBandY
				)
			else
				const Color = RenderControllerHelper.PackShadedColor(
					PartColorR,
					PartColorG,
					PartColorB,
					AMBIENT_LIGHT + DIFFUSE_LIGHT * math.max(0, UpSunDot)
				)
				RenderControllerHelper.SubmitFaceQuad(
					ScreenVertices,
					ProjectedVertices,
					ClipBufferA,
					ClipBufferB,
					WorkerScores,
					WorkerOffsets,
					BufferTable,
					24,
					36,
					84,
					72,
					TileScaleZ,
					TileScaleX,
					Color,
					EntityTextureId,
					FocalLength,
					GuardBandX,
					GuardBandY
				)
			end
		end

		-- Left (-Right, bit 4) or Right (+Right, bit 5)
		if bit32.btest(FaceMask, 48) then
			const RightSunDot = vector.dot(
				RenderControllerHelper.ReadDirectionVec(ECSDirectionsBuffer, DirectionOffset + 24),
				SUN_VEC
			) :: number
			if bit32.btest(FaceMask, 16) then
				const Color = RenderControllerHelper.PackShadedColor(
					PartColorR,
					PartColorG,
					PartColorB,
					AMBIENT_LIGHT + DIFFUSE_LIGHT * math.max(0, -RightSunDot)
				)
				RenderControllerHelper.SubmitFaceQuad(
					ScreenVertices,
					ProjectedVertices,
					ClipBufferA,
					ClipBufferB,
					WorkerScores,
					WorkerOffsets,
					BufferTable,
					0,
					48,
					84,
					36,
					TileScaleY,
					TileScaleZ,
					Color,
					EntityTextureId,
					FocalLength,
					GuardBandX,
					GuardBandY
				)
			else
				const Color = RenderControllerHelper.PackShadedColor(
					PartColorR,
					PartColorG,
					PartColorB,
					AMBIENT_LIGHT + DIFFUSE_LIGHT * math.max(0, RightSunDot)
				)
				RenderControllerHelper.SubmitFaceQuad(
					ScreenVertices,
					ProjectedVertices,
					ClipBufferA,
					ClipBufferB,
					WorkerScores,
					WorkerOffsets,
					BufferTable,
					12,
					24,
					72,
					60,
					TileScaleZ,
					TileScaleY,
					Color,
					EntityTextureId,
					FocalLength,
					GuardBandX,
					GuardBandY
				)
			end
		end
	end

	-- Sends the information to all workers
	for i, TargetActor: Actor in ipairs(WorkerActors) do
		const ByteCount = WorkerOffsets[i] :: number
		local PayloadBuffer = EmptyPayload
		if ByteCount > 0 then
			PayloadBuffer = buffer.create(ByteCount)
			buffer.copy(PayloadBuffer, 0, BufferTable[i], 0, ByteCount)
		end

		TargetActor:SendMessage(
			"Execute Rendering",
			PayloadBuffer,
			ByteCount,
			CurrentFrame
		)
	end
end

Renderer.RenderFrame = Renderer.DrawFrame

return Renderer
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="145">
              <Properties>
                <string name="Name">RenderControllerHelper</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))
const BufferHelper = require(ReplicatedStorage.Shared.Utilities.Render.Core.BufferHelper)
const RenderMath = require(ReplicatedStorage.Shared.Utilities.Render.Core.RenderMath)

-- Configs --
const WIDTH = SystemsConfigs.RenderWidth :: number
const HEIGHT = SystemsConfigs.RenderHeight :: number
const HALF_WIDTH = WIDTH * 0.5 :: number
const HALF_HEIGHT = HEIGHT * 0.5 :: number
const TOTAL_PIXELS = WIDTH * HEIGHT :: number
const ACTOR_COUNT = SystemsConfigs.ActorCount :: number
const WORKER_BUFFER_MULTIPLIER = SystemsConfigs.WorkerBufferMultiplier :: number
const WORKER_BUFFER_CAPACITY = TOTAL_PIXELS * WORKER_BUFFER_MULTIPLIER :: number
const RENDER_BUFFER_LAYOUT_SIZE = BufferHelper.RenderBufferLayoutSize :: number
const MIN_TRIANGLE_AREA = SystemsConfigs.MinTriangleArea :: number

local RenderControllerHelper = {}

-- ============================================================================
-- 1. DIRECTION READING, COLOR SHADING & FACE QUAD SUBMISSION
-- ============================================================================

--[=[
	Reads a 3-component float direction vector from the directions buffer into a SIMD vector.
	@param DirectionsBuffer buffer -- Basis directions buffer.
	@param Offset number -- Byte offset to read from.
	@return vector -- Direction SIMD vector.
]=]
function RenderControllerHelper.ReadDirectionVec(DirectionsBuffer: buffer, Offset: number): vector
	return vector.create(
		buffer.readf32(DirectionsBuffer, Offset),
		buffer.readf32(DirectionsBuffer, Offset + 4),
		buffer.readf32(DirectionsBuffer, Offset + 8)
	)
end

--[=[
	Packs shaded RGB channels and illumination into a 32-bit integer color.
	@param RedChannel number -- Base red color channel (0-255).
	@param GreenChannel number -- Base green color channel (0-255).
	@param BlueChannel number -- Base blue color channel (0-255).
	@param Illumination number -- Illumination scalar factor.
	@return number -- Packed 32-bit RGBA color.
]=]
function RenderControllerHelper.PackShadedColor(
	RedChannel: number,
	GreenChannel: number,
	BlueChannel: number,
	Illumination: number
): number
	return bit32.bor(
		math.floor(RedChannel * Illumination),
		bit32.lshift(math.floor(GreenChannel * Illumination), 8),
		bit32.lshift(math.floor(BlueChannel * Illumination), 16),
		0xFF000000
	)
end

--[=[
	Clips a quad face, tessellates it into triangles, and dispatches them to parallel worker queues based on lowest estimated raster work.
	@param ScreenVertices buffer -- Camera-space box vertex buffer.
	@param ProjectedVertices buffer -- Scratch buffer for projected 2D coordinates.
	@param ClipBufferA buffer -- First polygon clipping scratch buffer.
	@param ClipBufferB buffer -- Second polygon clipping scratch buffer.
	@param WorkerScores { number } -- Workload score tracking per worker.
	@param WorkerOffsets { number } -- Buffer write offsets per worker.
	@param BufferTable { buffer } -- Array of worker render command buffers.
	@param V0ByteOffset number -- Byte offset for vertex 0.
	@param V1ByteOffset number -- Byte offset for vertex 1.
	@param V2ByteOffset number -- Byte offset for vertex 2.
	@param V3ByteOffset number -- Byte offset for vertex 3.
	@param ScaleU number -- Horizontal UV tile scale for the face quad.
	@param ScaleV number -- Vertical UV tile scale for the face quad.
	@param PackedColor number -- Shaded 32-bit RGBA color.
	@param TextureId number -- TextureTable numeric ID.
	@param FocalLength number -- Camera focal length.
	@param GuardBandX number -- Horizontal guardband slope factor.
	@param GuardBandY number -- Vertical guardband slope factor.
]=]
function RenderControllerHelper.SubmitFaceQuad(
	ScreenVertices: buffer,
	ProjectedVertices: buffer,
	ClipBufferA: buffer,
	ClipBufferB: buffer,
	WorkerScores: { number },
	WorkerOffsets: { number },
	BufferTable: { buffer },
	V0ByteOffset: number,
	V1ByteOffset: number,
	V2ByteOffset: number,
	V3ByteOffset: number,
	ScaleU: number,
	ScaleV: number,
	PackedColor: number,
	TextureId: number,
	FocalLength: number,
	GuardBandX: number,
	GuardBandY: number
)
	const ClippedVertexCount = RenderMath.ClipAndProjectQuad(
		ScreenVertices,
		V0ByteOffset,
		V1ByteOffset,
		V2ByteOffset,
		V3ByteOffset,
		ScaleU,
		ScaleV,
		ProjectedVertices,
		ClipBufferA,
		ClipBufferB,
		FocalLength,
		GuardBandX,
		GuardBandY,
		HALF_WIDTH,
		HALF_HEIGHT
	) :: number

	if ClippedVertexCount < 3 then
		return
	end

	const Vertex0X = buffer.readf32(ProjectedVertices, 0) :: number
	const Vertex0Y = buffer.readf32(ProjectedVertices, 4) :: number
	const InverseZ0 = buffer.readf32(ProjectedVertices, 8) :: number
	const TexCoordU0 = buffer.readf32(ProjectedVertices, 12) :: number
	const TexCoordV0 = buffer.readf32(ProjectedVertices, 16) :: number

	for ClippedTriangleIndex = 2, ClippedVertexCount - 1 do
		const V1Offset = (ClippedTriangleIndex - 1) * 20 :: number
		const V2Offset = V1Offset + 20 :: number

		const Vertex1X = buffer.readf32(ProjectedVertices, V1Offset) :: number
		const Vertex1Y = buffer.readf32(ProjectedVertices, V1Offset + 4) :: number
		const InverseZ1 = buffer.readf32(ProjectedVertices, V1Offset + 8) :: number
		const TexCoordU1 = buffer.readf32(ProjectedVertices, V1Offset + 12) :: number
		const TexCoordV1 = buffer.readf32(ProjectedVertices, V1Offset + 16) :: number

		const Vertex2X = buffer.readf32(ProjectedVertices, V2Offset) :: number
		const Vertex2Y = buffer.readf32(ProjectedVertices, V2Offset + 4) :: number
		const InverseZ2 = buffer.readf32(ProjectedVertices, V2Offset + 8) :: number
		const TexCoordU2 = buffer.readf32(ProjectedVertices, V2Offset + 12) :: number
		const TexCoordV2 = buffer.readf32(ProjectedVertices, V2Offset + 16) :: number

		const SignedDoubleTriangleArea = (Vertex2X - Vertex0X) * (Vertex1Y - Vertex0Y)
			- (Vertex2Y - Vertex0Y) * (Vertex1X - Vertex0X) :: number
		if SignedDoubleTriangleArea <= MIN_TRIANGLE_AREA then
			continue
		end

		const MinX = math.max(0, math.min(Vertex0X, Vertex1X, Vertex2X)) :: number
		const MaxX = math.min(WIDTH - 1, math.max(Vertex0X, Vertex1X, Vertex2X)) :: number
		const MinY = math.max(0, math.min(Vertex0Y, Vertex1Y, Vertex2Y)) :: number
		const MaxY = math.min(HEIGHT - 1, math.max(Vertex0Y, Vertex1Y, Vertex2Y)) :: number

		if MinX > MaxX or MinY > MaxY then
			continue
		end

		const SpanHeightY = MaxY - MinY + 1 :: number
		const TriangleCost = SignedDoubleTriangleArea * 0.5 + SpanHeightY * 6 + 24 :: number

		local SmallestScore = WorkerScores[1] :: number
		local BestWorkerIdx = 1 :: number

		for WorkerIdx = 2, ACTOR_COUNT do
			const CandidateScore = WorkerScores[WorkerIdx] :: number
			if CandidateScore < SmallestScore then
				SmallestScore = CandidateScore
				BestWorkerIdx = WorkerIdx
			end
		end

		const RenderBufferOffset = WorkerOffsets[BestWorkerIdx] :: number
		if RenderBufferOffset + RENDER_BUFFER_LAYOUT_SIZE > WORKER_BUFFER_CAPACITY then
			continue
		end

		WorkerScores[BestWorkerIdx] = SmallestScore + TriangleCost
		WorkerOffsets[BestWorkerIdx] = RenderBufferOffset + RENDER_BUFFER_LAYOUT_SIZE

		const RenderBuffer = BufferTable[BestWorkerIdx] :: buffer
		const InverseTriangleArea = 1 / SignedDoubleTriangleArea :: number

		const ScaledInverseZ0 = InverseZ0 * InverseTriangleArea :: number
		const ScaledInverseZ1 = InverseZ1 * InverseTriangleArea :: number
		const ScaledInverseZ2 = InverseZ2 * InverseTriangleArea :: number

		buffer.writei16(RenderBuffer, RenderBufferOffset, Vertex0X)
		buffer.writei16(RenderBuffer, RenderBufferOffset + 2, Vertex0Y)
		buffer.writef32(RenderBuffer, RenderBufferOffset + 4, ScaledInverseZ0)
		buffer.writef32(RenderBuffer, RenderBufferOffset + 8, ScaledInverseZ0 * TexCoordU0)
		buffer.writef32(RenderBuffer, RenderBufferOffset + 12, ScaledInverseZ0 * TexCoordV0)

		buffer.writei16(RenderBuffer, RenderBufferOffset + 16, Vertex1X)
		buffer.writei16(RenderBuffer, RenderBufferOffset + 18, Vertex1Y)
		buffer.writef32(RenderBuffer, RenderBufferOffset + 20, ScaledInverseZ1)
		buffer.writef32(RenderBuffer, RenderBufferOffset + 24, ScaledInverseZ1 * TexCoordU1)
		buffer.writef32(RenderBuffer, RenderBufferOffset + 28, ScaledInverseZ1 * TexCoordV1)

		buffer.writei16(RenderBuffer, RenderBufferOffset + 32, Vertex2X)
		buffer.writei16(RenderBuffer, RenderBufferOffset + 34, Vertex2Y)
		buffer.writef32(RenderBuffer, RenderBufferOffset + 36, ScaledInverseZ2)
		buffer.writef32(RenderBuffer, RenderBufferOffset + 40, ScaledInverseZ2 * TexCoordU2)
		buffer.writef32(RenderBuffer, RenderBufferOffset + 44, ScaledInverseZ2 * TexCoordV2)

		buffer.writeu32(RenderBuffer, RenderBufferOffset + 48, PackedColor)
		buffer.writeu32(RenderBuffer, RenderBufferOffset + 52, TextureId)
	end
end

return RenderControllerHelper
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="146">
            <Properties>
              <string name="Name">Core</string>
            </Properties>
            <Item class="ModuleScript" referent="147">
              <Properties>
                <string name="Name">BufferHelper</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))

-- Configs --
const CLEAR_R = SystemsConfigs.ClearColorR :: number
const CLEAR_G = SystemsConfigs.ClearColorG :: number
const CLEAR_B = SystemsConfigs.ClearColorB :: number
const RENDER_BUFFER_LAYOUT_SIZE = SystemsConfigs.RenderBufferLayoutSize :: number
const PACKED_CLEAR_COLOR = bit32.bor(CLEAR_R, bit32.lshift(CLEAR_G, 8), bit32.lshift(CLEAR_B, 16), 0xFF000000) :: number

-- Buffers
local ClearTemplateSize = 0 :: number
local ClearPixelTemplate: buffer? = nil

local BufferHelper = {}

BufferHelper.RenderBufferLayoutSize = RENDER_BUFFER_LAYOUT_SIZE :: number

-- ============================================================================
-- 1. BUFFER READ / WRITE & FRAME CLEAR HELPERS
-- ============================================================================

--[=[
	Reads 3 consecutive f32 numbers from a buffer into a Luau SIMD vector.
	@param TargetBuffer buffer -- Source memory buffer.
	@param Offset number -- Byte offset to read from.
	@return vector -- SIMD vector containing (X, Y, Z).
]=]
function BufferHelper.ReadVec3(TargetBuffer: buffer, Offset: number): vector
	return vector.create(
		buffer.readf32(TargetBuffer, Offset),
		buffer.readf32(TargetBuffer, Offset + 4),
		buffer.readf32(TargetBuffer, Offset + 8)
	)
end

--[=[
	Writes a Luau SIMD vector's (X, Y, Z) components as 3 consecutive f32 floats into a buffer.
	@param TargetBuffer buffer -- Target destination buffer.
	@param Offset number -- Byte offset to write at.
	@param Value vector -- Source SIMD vector.
]=]
function BufferHelper.WriteVec3(TargetBuffer: buffer, Offset: number, Value: vector)
	buffer.writef32(TargetBuffer, Offset, Value.x)
	buffer.writef32(TargetBuffer, Offset + 4, Value.y)
	buffer.writef32(TargetBuffer, Offset + 8, Value.z)
end

--[=[
	Ensures the pre-filled background clear pixel template buffer is allocated and sized.
	@param ByteLength number -- Total required byte capacity.
	@return buffer -- Pre-filled template buffer.
]=]
function BufferHelper.EnsureClearTemplate(ByteLength: number): buffer
	if ClearTemplateSize < ByteLength then
		local NewPixelTemplate = buffer.create(ByteLength) :: buffer
		for i = 0, ByteLength - 4, 4 do
			buffer.writeu32(NewPixelTemplate, i, PACKED_CLEAR_COLOR)
		end
		ClearPixelTemplate = NewPixelTemplate
		ClearTemplateSize = ByteLength
	end

	return ClearPixelTemplate :: buffer
end

--[=[
	Packs 3 projected textured triangle vertices and a 32-bit packed color into the worker render queue buffer.
	@param TargetBuffer buffer -- Destination render command buffer.
	@param MemoryOffset number -- Current byte offset in render command buffer.
	@param Vertex0X number -- Screen vertex 0 X coordinate.
	@param Vertex0Y number -- Screen vertex 0 Y coordinate.
	@param ScaledInverseZ0 number -- Pre-scaled 1/Z depth for vertex 0.
	@param ScaledUOverZ0 number -- Pre-scaled U/Z coordinate for vertex 0.
	@param ScaledVOverZ0 number -- Pre-scaled V/Z coordinate for vertex 0.
	@param Vertex1X number -- Screen vertex 1 X coordinate.
	@param Vertex1Y number -- Screen vertex 1 Y coordinate.
	@param ScaledInverseZ1 number -- Pre-scaled 1/Z depth for vertex 1.
	@param ScaledUOverZ1 number -- Pre-scaled U/Z coordinate for vertex 1.
	@param ScaledVOverZ1 number -- Pre-scaled V/Z coordinate for vertex 1.
	@param Vertex2X number -- Screen vertex 2 X coordinate.
	@param Vertex2Y number -- Screen vertex 2 Y coordinate.
	@param ScaledInverseZ2 number -- Pre-scaled 1/Z depth for vertex 2.
	@param ScaledUOverZ2 number -- Pre-scaled U/Z coordinate for vertex 2.
	@param ScaledVOverZ2 number -- Pre-scaled V/Z coordinate for vertex 2.
	@param PackedColor number -- Packed 32-bit RGBA color.
	@param TextureId number -- TextureTable numeric ID.
	@return number -- Next byte offset in render command buffer.
]=]
function BufferHelper.CreateRenderBuffer(
	TargetBuffer: buffer,
	MemoryOffset: number,
	Vertex0X: number,
	Vertex0Y: number,
	ScaledInverseZ0: number,
	ScaledUOverZ0: number,
	ScaledVOverZ0: number,
	Vertex1X: number,
	Vertex1Y: number,
	ScaledInverseZ1: number,
	ScaledUOverZ1: number,
	ScaledVOverZ1: number,
	Vertex2X: number,
	Vertex2Y: number,
	ScaledInverseZ2: number,
	ScaledUOverZ2: number,
	ScaledVOverZ2: number,
	PackedColor: number,
	TextureId: number
): number
	-- Three 16-byte vertices (X, Y, InvZ, U/Z, V/Z), one 4-byte packed RGBA u32 color, and one 4-byte u32 TextureId (56 bytes total).
	buffer.writei16(TargetBuffer, MemoryOffset, Vertex0X)
	buffer.writei16(TargetBuffer, MemoryOffset + 2, Vertex0Y)
	buffer.writef32(TargetBuffer, MemoryOffset + 4, ScaledInverseZ0)
	buffer.writef32(TargetBuffer, MemoryOffset + 8, ScaledUOverZ0)
	buffer.writef32(TargetBuffer, MemoryOffset + 12, ScaledVOverZ0)

	buffer.writei16(TargetBuffer, MemoryOffset + 16, Vertex1X)
	buffer.writei16(TargetBuffer, MemoryOffset + 18, Vertex1Y)
	buffer.writef32(TargetBuffer, MemoryOffset + 20, ScaledInverseZ1)
	buffer.writef32(TargetBuffer, MemoryOffset + 24, ScaledUOverZ1)
	buffer.writef32(TargetBuffer, MemoryOffset + 28, ScaledVOverZ1)

	buffer.writei16(TargetBuffer, MemoryOffset + 32, Vertex2X)
	buffer.writei16(TargetBuffer, MemoryOffset + 34, Vertex2Y)
	buffer.writef32(TargetBuffer, MemoryOffset + 36, ScaledInverseZ2)
	buffer.writef32(TargetBuffer, MemoryOffset + 40, ScaledUOverZ2)
	buffer.writef32(TargetBuffer, MemoryOffset + 44, ScaledVOverZ2)

	buffer.writeu32(TargetBuffer, MemoryOffset + 48, PackedColor)
	buffer.writeu32(TargetBuffer, MemoryOffset + 52, TextureId)

	return MemoryOffset + RENDER_BUFFER_LAYOUT_SIZE
end

--[=[
	Clears the entire pixel and Z buffer to the default background state.
	@param TotalPixels number -- Total screen pixel count (Width * Height).
	@param PixelBuffer buffer -- Destination color pixel buffer.
	@param ZBuffer buffer -- Destination 32-bit depth buffer.
]=]
function BufferHelper.ClearBuffers(TotalPixels: number, PixelBuffer: buffer, ZBuffer: buffer)
	const ByteLength = TotalPixels * 4 :: number
	const Template = BufferHelper.EnsureClearTemplate(ByteLength)

	buffer.copy(PixelBuffer, 0, Template, 0, ByteLength)
	buffer.fill(ZBuffer, 0, 0, ByteLength)
end

--[=[
	Clears only the scanline rows marked dirty between MinY and MaxY.
	@param Width number -- Screen width in pixels.
	@param MinY number -- Minimum modified scanline Y index.
	@param MaxY number -- Maximum modified scanline Y index.
	@param TotalPixels number -- Total screen pixel count.
	@param PixelBuffer buffer -- Destination color pixel buffer.
	@param ZBuffer buffer -- Destination 32-bit depth buffer.
]=]
function BufferHelper.ClearDirtyRows(
	Width: number,
	MinY: number,
	MaxY: number,
	TotalPixels: number,
	PixelBuffer: buffer,
	ZBuffer: buffer
)
	if MinY > MaxY then
		return
	end

	const Template = BufferHelper.EnsureClearTemplate(TotalPixels * 4)
	const RowStride = Width * 4 :: number
	const StartOffset = MinY * RowStride :: number
	const DirtyByteLength = (MaxY - MinY + 1) * RowStride :: number

	buffer.copy(PixelBuffer, StartOffset, Template, 0, DirtyByteLength)
	buffer.fill(ZBuffer, StartOffset, 0, DirtyByteLength)
end

return BufferHelper
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="148">
              <Properties>
                <string name="Name">MathModule</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))
const BufferHelper = require(script.Parent.BufferHelper)

-- Configs --
const NEAR_CLIP = SystemsConfigs.RenderNearClip :: number
const FAR_CLIP = SystemsConfigs.RenderFarClip :: number

local MathModule = {}

-- ============================================================================
-- 1. FUNCTIONS - VERTEX PROJECTION & CLIPPING MATH
-- ============================================================================

--[=[
	Calculates the signed 2D edge function value for point relative to directed edge AB.
	@param VertexAX number -- Vertex A X.
	@param VertexAY number -- Vertex A Y.
	@param VertexBX number -- Vertex B X.
	@param VertexBY number -- Vertex B Y.
	@param PointX number -- Sample point X.
	@param PointY number -- Sample point Y.
	@return number -- Cross product / signed determinant value.
]=]
function MathModule.EdgeFunction(
	VertexAX: number,
	VertexAY: number,
	VertexBX: number,
	VertexBY: number,
	PointX: number,
	PointY: number
): number
	return (PointX - VertexAX) * (VertexBY - VertexAY) - (PointY - VertexAY) * (VertexBX - VertexAX)
end

--[=[
	Tests whether a camera-space vertex is inside the near/far planes and frustum guardband.
	@param Vertex vector -- Camera-space vertex.
	@param GuardBandX number -- Horizontal guardband slope factor.
	@param GuardBandY number -- Vertical guardband slope factor.
	@return boolean -- True if vertex lies within the safe frustum bounds.
]=]
function MathModule.IsVertexInside(Vertex: vector, GuardBandX: number, GuardBandY: number): boolean
	const DepthZ = Vertex.z :: number
	if DepthZ < NEAR_CLIP or DepthZ > FAR_CLIP then
		return false
	end

	return math.abs(Vertex.x) <= GuardBandX * DepthZ and math.abs(Vertex.y) <= GuardBandY * DepthZ
end

--[=[
	Projects a 3D camera-space vertex onto the 2D integer screen coordinate plane.
	@param ProjectedVertices buffer -- Buffer to receive projected vertex data.
	@param Offset number -- Byte offset in output buffer.
	@param Vertex vector -- Camera-space 3D vertex.
	@param FocalLength number -- Camera focal length scalar.
	@param HalfWidth number -- Half screen width in pixels.
	@param HalfHeight number -- Half screen height in pixels.
]=]
function MathModule.ProjectVertex(
	ProjectedVertices: buffer,
	Offset: number,
	Vertex: vector,
	FocalLength: number,
	HalfWidth: number,
	HalfHeight: number
)
	const InverseZ = 1 / Vertex.z :: number
	buffer.writef32(ProjectedVertices, Offset, math.floor(Vertex.x * InverseZ * FocalLength + HalfWidth))
	buffer.writef32(ProjectedVertices, Offset + 4, math.floor(-Vertex.y * InverseZ * FocalLength + HalfHeight))
	buffer.writef32(ProjectedVertices, Offset + 8, InverseZ)
end

--[=[
	Projects a 3D camera-space vertex and its texture coordinates into a 20-byte projected vertex slot.
	@param ProjectedVertices buffer -- Buffer to receive projected vertex data.
	@param Offset number -- Byte offset in output buffer (20-byte stride).
	@param Vertex vector -- Camera-space 3D vertex.
	@param TexCoordU number -- Horizontal texture coordinate.
	@param TexCoordV number -- Vertical texture coordinate.
	@param FocalLength number -- Camera focal length scalar.
	@param HalfWidth number -- Half screen width in pixels.
	@param HalfHeight number -- Half screen height in pixels.
]=]
function MathModule.ProjectVertexUV(
	ProjectedVertices: buffer,
	Offset: number,
	Vertex: vector,
	TexCoordU: number,
	TexCoordV: number,
	FocalLength: number,
	HalfWidth: number,
	HalfHeight: number
)
	const InverseZ = 1 / Vertex.z :: number
	buffer.writef32(ProjectedVertices, Offset, math.floor(Vertex.x * InverseZ * FocalLength + HalfWidth))
	buffer.writef32(ProjectedVertices, Offset + 4, math.floor(-Vertex.y * InverseZ * FocalLength + HalfHeight))
	buffer.writef32(ProjectedVertices, Offset + 8, InverseZ)
	buffer.writef32(ProjectedVertices, Offset + 12, TexCoordU)
	buffer.writef32(ProjectedVertices, Offset + 16, TexCoordV)
end

--[=[
	Clips an input polygon against an arbitrary half-space plane using Sutherland-Hodgman.
	@param Input buffer -- Buffer of input 3D vector vertices.
	@param InputCount number -- Number of input vertices.
	@param Output buffer -- Buffer to receive clipped 3D vertices.
	@param PlaneNormal vector -- Inward-pointing clipping plane normal.
	@param PlaneOffset number -- Plane distance constant.
	@return number -- Number of output vertices after clipping.
]=]
function MathModule.ClipPolygon(
	Input: buffer,
	InputCount: number,
	Output: buffer,
	PlaneNormal: vector,
	PlaneOffset: number
): number
	if InputCount == 0 then
		return 0
	end

	local OutputCount = 0 :: number
	local PreviousVertex = BufferHelper.ReadVec3(Input, (InputCount - 1) * 12)
	local PreviousDistance = vector.dot(PreviousVertex, PlaneNormal) + PlaneOffset :: number

	for i = 1, InputCount do
		const CurrentVertex = BufferHelper.ReadVec3(Input, (i - 1) * 12)
		const CurrentDistance = vector.dot(CurrentVertex, PlaneNormal) + PlaneOffset :: number
		const PreviousInside = (PreviousDistance >= 0) :: boolean
		const CurrentInside = (CurrentDistance >= 0) :: boolean

		if PreviousInside ~= CurrentInside then
			const IntersectionFactor = PreviousDistance / (PreviousDistance - CurrentDistance) :: number
			BufferHelper.WriteVec3(
				Output,
				OutputCount * 12,
				PreviousVertex + (CurrentVertex - PreviousVertex) * IntersectionFactor
			)
			OutputCount += 1
		end

		if CurrentInside then
			BufferHelper.WriteVec3(Output, OutputCount * 12, CurrentVertex)
			OutputCount += 1
		end

		PreviousVertex = CurrentVertex
		PreviousDistance = CurrentDistance
	end

	return OutputCount
end

--[=[
	Clips a UV-attributed polygon (20-byte stride: X, Y, Z, U, V) against an arbitrary half-space plane using Sutherland-Hodgman.
	@param Input buffer -- Buffer of input 20-byte vertices (Vec3 + UV).
	@param InputCount number -- Number of input vertices.
	@param Output buffer -- Buffer to receive clipped 20-byte vertices.
	@param PlaneNormal vector -- Inward-pointing clipping plane normal.
	@param PlaneOffset number -- Plane distance constant.
	@return number -- Number of output vertices after clipping.
]=]
function MathModule.ClipPolygonUV(
	Input: buffer,
	InputCount: number,
	Output: buffer,
	PlaneNormal: vector,
	PlaneOffset: number
): number
	if InputCount == 0 then
		return 0
	end

	local OutputCount = 0 :: number
	const LastOffset = (InputCount - 1) * 20 :: number
	local PreviousVertex = BufferHelper.ReadVec3(Input, LastOffset)
	local PreviousU = buffer.readf32(Input, LastOffset + 12) :: number
	local PreviousV = buffer.readf32(Input, LastOffset + 16) :: number
	local PreviousDistance = vector.dot(PreviousVertex, PlaneNormal) + PlaneOffset :: number

	for i = 1, InputCount do
		const ReadBaseOffset = (i - 1) * 20 :: number
		const CurrentVertex = BufferHelper.ReadVec3(Input, ReadBaseOffset)
		const CurrentU = buffer.readf32(Input, ReadBaseOffset + 12) :: number
		const CurrentV = buffer.readf32(Input, ReadBaseOffset + 16) :: number
		const CurrentDistance = vector.dot(CurrentVertex, PlaneNormal) + PlaneOffset :: number
		const PreviousInside = (PreviousDistance >= 0) :: boolean
		const CurrentInside = (CurrentDistance >= 0) :: boolean

		if PreviousInside ~= CurrentInside then
			const IntersectionFactor = PreviousDistance / (PreviousDistance - CurrentDistance) :: number
			const WriteBaseOffset = OutputCount * 20 :: number
			BufferHelper.WriteVec3(
				Output,
				WriteBaseOffset,
				PreviousVertex + (CurrentVertex - PreviousVertex) * IntersectionFactor
			)
			buffer.writef32(Output, WriteBaseOffset + 12, PreviousU + (CurrentU - PreviousU) * IntersectionFactor)
			buffer.writef32(Output, WriteBaseOffset + 16, PreviousV + (CurrentV - PreviousV) * IntersectionFactor)
			OutputCount += 1
		end

		if CurrentInside then
			const WriteBaseOffset = OutputCount * 20 :: number
			BufferHelper.WriteVec3(Output, WriteBaseOffset, CurrentVertex)
			buffer.writef32(Output, WriteBaseOffset + 12, CurrentU)
			buffer.writef32(Output, WriteBaseOffset + 16, CurrentV)
			OutputCount += 1
		end

		PreviousVertex = CurrentVertex
		PreviousU = CurrentU
		PreviousV = CurrentV
		PreviousDistance = CurrentDistance
	end

	return OutputCount
end

-- ============================================================================
-- 2. FUNCTIONS - EXACT SPAN RASTERIZATION MATH
-- ============================================================================

--[=[
	Clips an active horizontal raster scanline span against a single linear edge function.
	@param RowEdgeWeight number -- Initial edge value at span start.
	@param EdgeStepX number -- Edge value differential per horizontal pixel step.
	@param SpanStartOffsetX number -- Current span start pixel offset.
	@param SpanEndOffsetX number -- Current span end pixel offset.
	@return (number, number) -- Clipped (SpanStartOffsetX, SpanEndOffsetX).
]=]
function MathModule.ClipSpanEdge(
	RowEdgeWeight: number,
	EdgeStepX: number,
	SpanStartOffsetX: number,
	SpanEndOffsetX: number
): (number, number)
	if EdgeStepX == 0 then
		if RowEdgeWeight < 0 then
			return 1, 0
		end
		return SpanStartOffsetX, SpanEndOffsetX
	end

	if EdgeStepX > 0 then
		if RowEdgeWeight < 0 then
			return math.max(SpanStartOffsetX, (-RowEdgeWeight + EdgeStepX - 1) // EdgeStepX), SpanEndOffsetX
		end
		return SpanStartOffsetX, SpanEndOffsetX
	end

	if RowEdgeWeight < 0 then
		return 1, 0
	end

	return SpanStartOffsetX, math.min(SpanEndOffsetX, RowEdgeWeight // -EdgeStepX)
end

--[=[
	Rasterizes a 2D screen-space triangle with perspective-correct texture mapping into the color pixel and Z depth buffers.
	@param Vertex0X number -- Screen vertex 0 X.
	@param Vertex0Y number -- Screen vertex 0 Y.
	@param ScaledInverseZ0 number -- Pre-scaled 1/Z depth for vertex 0.
	@param ScaledUOverZ0 number -- Pre-scaled U/Z coordinate for vertex 0.
	@param ScaledVOverZ0 number -- Pre-scaled V/Z coordinate for vertex 0.
	@param Vertex1X number -- Screen vertex 1 X.
	@param Vertex1Y number -- Screen vertex 1 Y.
	@param ScaledInverseZ1 number -- Pre-scaled 1/Z depth for vertex 1.
	@param ScaledUOverZ1 number -- Pre-scaled U/Z coordinate for vertex 1.
	@param ScaledVOverZ1 number -- Pre-scaled V/Z coordinate for vertex 1.
	@param Vertex2X number -- Screen vertex 2 X.
	@param Vertex2Y number -- Screen vertex 2 Y.
	@param ScaledInverseZ2 number -- Pre-scaled 1/Z depth for vertex 2.
	@param ScaledUOverZ2 number -- Pre-scaled U/Z coordinate for vertex 2.
	@param ScaledVOverZ2 number -- Pre-scaled V/Z coordinate for vertex 2.
	@param PackedColor number -- Packed 32-bit RGBA shade/tint color.
	@param TextureBuffer buffer? -- Optional source RGBA texture buffer (nil renders untextured solid PackedColor).
	@param TextureWidth number -- Texture width in texels.
	@param TextureHeight number -- Texture height in texels.
	@param WIDTH number -- Target framebuffer width.
	@param HEIGHT number -- Target framebuffer height.
	@param RowStride number -- Byte stride per horizontal scanline row.
	@param PixelBuffer buffer -- Destination color pixel buffer.
	@param ZBuffer buffer -- Destination 32-bit float Z-buffer.
	@return (number, number) -- Modified scanline row range (MinY, MaxY).
]=]
function MathModule.RasterizeTriangleSpan(
	Vertex0X: number,
	Vertex0Y: number,
	ScaledInverseZ0: number,
	ScaledUOverZ0: number,
	ScaledVOverZ0: number,
	Vertex1X: number,
	Vertex1Y: number,
	ScaledInverseZ1: number,
	ScaledUOverZ1: number,
	ScaledVOverZ1: number,
	Vertex2X: number,
	Vertex2Y: number,
	ScaledInverseZ2: number,
	ScaledUOverZ2: number,
	ScaledVOverZ2: number,
	PackedColor: number,
	TextureBuffer: buffer?,
	TextureWidth: number,
	TextureHeight: number,
	WIDTH: number,
	HEIGHT: number,
	RowStride: number,
	PixelBuffer: buffer,
	ZBuffer: buffer
): (number, number)
	const MinX = math.max(0, math.min(Vertex0X, Vertex1X, Vertex2X)) :: number
	const MaxX = math.min(WIDTH - 1, math.max(Vertex0X, Vertex1X, Vertex2X)) :: number
	const MinY = math.max(0, math.min(Vertex0Y, Vertex1Y, Vertex2Y)) :: number
	const MaxY = math.min(HEIGHT - 1, math.max(Vertex0Y, Vertex1Y, Vertex2Y)) :: number

	if MinX > MaxX or MinY > MaxY then
		return HEIGHT, -1
	end

	const Edge0StepX = Vertex2Y - Vertex1Y :: number
	const Edge1StepX = Vertex0Y - Vertex2Y :: number
	const Edge2StepX = Vertex1Y - Vertex0Y :: number
	const Edge0StepY = Vertex1X - Vertex2X :: number
	const Edge1StepY = Vertex2X - Vertex0X :: number
	const Edge2StepY = Vertex0X - Vertex1X :: number

	const ScaledInverseZVector = vector.create(ScaledInverseZ0, ScaledInverseZ1, ScaledInverseZ2)
	const ScaledUOverZVector = vector.create(ScaledUOverZ0, ScaledUOverZ1, ScaledUOverZ2)
	const ScaledVOverZVector = vector.create(ScaledVOverZ0, ScaledVOverZ1, ScaledVOverZ2)
	const EdgeStepVectorX = vector.create(Edge0StepX, Edge1StepX, Edge2StepX)
	const EdgeStepVectorY = vector.create(Edge0StepY, Edge1StepY, Edge2StepY)

	const InverseZStepX = vector.dot(EdgeStepVectorX, ScaledInverseZVector) :: number
	const InverseZStepY = vector.dot(EdgeStepVectorY, ScaledInverseZVector) :: number
	const UOverZStepX = vector.dot(EdgeStepVectorX, ScaledUOverZVector) :: number
	const UOverZStepY = vector.dot(EdgeStepVectorY, ScaledUOverZVector) :: number
	const VOverZStepX = vector.dot(EdgeStepVectorX, ScaledVOverZVector) :: number
	const VOverZStepY = vector.dot(EdgeStepVectorY, ScaledVOverZVector) :: number

	const InitialEdgeWeight0 = (MinX - Vertex1X) * Edge0StepX + (MinY - Vertex1Y) * Edge0StepY :: number
	const InitialEdgeWeight1 = (MinX - Vertex2X) * Edge1StepX + (MinY - Vertex2Y) * Edge1StepY :: number
	const InitialEdgeWeight2 = (MinX - Vertex0X) * Edge2StepX + (MinY - Vertex0Y) * Edge2StepY :: number
	local RowEdgeWeights = vector.create(InitialEdgeWeight0, InitialEdgeWeight1, InitialEdgeWeight2)
	local RowInverseZ = vector.dot(RowEdgeWeights, ScaledInverseZVector) :: number
	local RowUOverZ = vector.dot(RowEdgeWeights, ScaledUOverZVector) :: number
	local RowVOverZ = vector.dot(RowEdgeWeights, ScaledVOverZVector) :: number

	const TextureWidthMask = TextureWidth - 1 :: number
	const TextureHeightMask = TextureHeight - 1 :: number

	local ShadeRed = bit32.band(PackedColor, 0xFF) :: number
	local ShadeGreen = bit32.band(bit32.rshift(PackedColor, 8), 0xFF) :: number
	local ShadeBlue = bit32.band(bit32.rshift(PackedColor, 16), 0xFF) :: number
	if ShadeRed > 0 then
		ShadeRed += 1
	end
	if ShadeGreen > 0 then
		ShadeGreen += 1
	end
	if ShadeBlue > 0 then
		ShadeBlue += 1
	end

	const MaxSpanOffsetX = MaxX - MinX :: number
	local RowOffset = (MinY * WIDTH + MinX) * 4 :: number

	for _ = MinY, MaxY do
		local SpanStartOffsetX: number, SpanEndOffsetX: number =
			MathModule.ClipSpanEdge(RowEdgeWeights.x, Edge0StepX, 0, MaxSpanOffsetX)
		if SpanStartOffsetX <= SpanEndOffsetX then
			SpanStartOffsetX, SpanEndOffsetX =
				MathModule.ClipSpanEdge(RowEdgeWeights.y, Edge1StepX, SpanStartOffsetX, SpanEndOffsetX)
		end
		if SpanStartOffsetX <= SpanEndOffsetX then
			SpanStartOffsetX, SpanEndOffsetX =
				MathModule.ClipSpanEdge(RowEdgeWeights.z, Edge2StepX, SpanStartOffsetX, SpanEndOffsetX)
		end

		if SpanStartOffsetX <= SpanEndOffsetX then
			local BufferOffset = RowOffset + SpanStartOffsetX * 4 :: number
			const EndOffset = RowOffset + SpanEndOffsetX * 4 :: number
			local InterpolatedInverseZ = RowInverseZ + SpanStartOffsetX * InverseZStepX :: number

			if TextureBuffer then
				local InterpolatedUOverZ = RowUOverZ + SpanStartOffsetX * UOverZStepX :: number
				local InterpolatedVOverZ = RowVOverZ + SpanStartOffsetX * VOverZStepX :: number

				while BufferOffset <= EndOffset do
					if InterpolatedInverseZ > buffer.readf32(ZBuffer, BufferOffset) then
						buffer.writef32(ZBuffer, BufferOffset, InterpolatedInverseZ)

						const DepthZ = 1 / InterpolatedInverseZ :: number
						const TexelX = math.clamp(math.floor(InterpolatedUOverZ * DepthZ * TextureWidth), 0, TextureWidthMask) :: number
						const TexelY = math.clamp(math.floor(InterpolatedVOverZ * DepthZ * TextureHeight), 0, TextureHeightMask) :: number
						const TexelColor = buffer.readu32(TextureBuffer, (TexelY * TextureWidth + TexelX) * 4) :: number

						const OutRed = bit32.rshift(bit32.band(TexelColor, 0xFF) * ShadeRed, 8) :: number
						const OutGreen = bit32.rshift(bit32.band(bit32.rshift(TexelColor, 8), 0xFF) * ShadeGreen, 8) :: number
						const OutBlue = bit32.rshift(bit32.band(bit32.rshift(TexelColor, 16), 0xFF) * ShadeBlue, 8) :: number

						buffer.writeu32(
							PixelBuffer,
							BufferOffset,
							bit32.bor(OutRed, bit32.lshift(OutGreen, 8), bit32.lshift(OutBlue, 16), 0xFF000000)
						)
					end

					InterpolatedInverseZ += InverseZStepX
					InterpolatedUOverZ += UOverZStepX
					InterpolatedVOverZ += VOverZStepX
					BufferOffset += 4
				end
			else
				while BufferOffset <= EndOffset do
					if InterpolatedInverseZ > buffer.readf32(ZBuffer, BufferOffset) then
						buffer.writef32(ZBuffer, BufferOffset, InterpolatedInverseZ)
						buffer.writeu32(PixelBuffer, BufferOffset, PackedColor)
					end

					InterpolatedInverseZ += InverseZStepX
					BufferOffset += 4
				end
			end
		end

		RowEdgeWeights += EdgeStepVectorY
		RowInverseZ += InverseZStepY
		RowUOverZ += UOverZStepY
		RowVOverZ += VOverZStepY
		RowOffset += RowStride
	end

	return MinY, MaxY
end

return MathModule
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="149">
              <Properties>
                <string name="Name">RenderMath</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))
const BufferHelper = require(script.Parent.BufferHelper)
const MathModule = require(script.Parent.MathModule)
const TextureHelper = require(script.Parent.TextureHelper)

-- Configs --
const NEAR_CLIP = SystemsConfigs.RenderNearClip :: number
const FAR_CLIP = SystemsConfigs.RenderFarClip :: number
const GUARD_BAND_SCALE = SystemsConfigs.GuardBandScale :: number
const BUFFER_LAYOUT_SIZE = SystemsConfigs.RenderBufferLayoutSize :: number
const BACKFACE_EPSILON = 1e-3 :: number

const PLANE_NEAR = vector.create(0, 0, 1)
const PLANE_FAR = vector.create(0, 0, -1)

local RenderMath = {}

-- ============================================================================
-- 1. FUNCTIONS - RENDERING MATH
-- ============================================================================

--[=[
	Transforms an oriented box entity into camera space, performs frustum culling, backface culling, and writes 8 corner vertices.
	@param PositionBuffer buffer -- Entity position component buffer.
	@param DirectionsBuffer buffer -- Entity basis directions buffer.
	@param SizeBuffer buffer -- Entity size component buffer.
	@param ComponentOffset number -- Byte offset in position/size buffers.
	@param DirectionOffset number -- Byte offset in directions buffer.
	@param CameraVertices buffer -- Output buffer for 8 camera-space vertices.
	@param CamPos vector -- Camera world position.
	@param CamRight vector -- Camera RightVector.
	@param CamUp vector -- Camera UpVector.
	@param CamLook vector -- Camera LookVector.
	@return number -- Bitmask of visible faces (0 if entirely culled).
]=]
function RenderMath.GetPartCameraVertices(
	PositionBuffer: buffer,
	DirectionsBuffer: buffer,
	SizeBuffer: buffer,
	ComponentOffset: number,
	DirectionOffset: number,
	CameraVertices: buffer,
	CamPos: vector,
	CamRight: vector,
	CamUp: vector,
	CamLook: vector
): number
	const PartPosition = BufferHelper.ReadVec3(PositionBuffer, ComponentOffset)
	const HalfSize = BufferHelper.ReadVec3(SizeBuffer, ComponentOffset) * 0.5
	const HalfSizeX: number, HalfSizeY: number, HalfSizeZ: number = HalfSize.x, HalfSize.y, HalfSize.z

	const RelativePosition = PartPosition - CamPos
	const CameraSpaceCenterZ = vector.dot(RelativePosition, CamLook) :: number

	const LookAxis = BufferHelper.ReadVec3(DirectionsBuffer, DirectionOffset)
	const UpAxis = BufferHelper.ReadVec3(DirectionsBuffer, DirectionOffset + 12)
	const RightAxis = BufferHelper.ReadVec3(DirectionsBuffer, DirectionOffset + 24)

	const WorldRightAxis = RightAxis * HalfSizeX
	const WorldUpAxis = UpAxis * HalfSizeY
	const WorldLookAxis = LookAxis * HalfSizeZ

	const RightAxisCameraZ = vector.dot(WorldRightAxis, CamLook) :: number
	const UpAxisCameraZ = vector.dot(WorldUpAxis, CamLook) :: number
	const LookAxisCameraZ = vector.dot(WorldLookAxis, CamLook) :: number

	const CameraSpaceExtentZ =
		math.abs(RightAxisCameraZ) + math.abs(UpAxisCameraZ) + math.abs(LookAxisCameraZ) :: number
	if CameraSpaceCenterZ + CameraSpaceExtentZ < NEAR_CLIP or CameraSpaceCenterZ - CameraSpaceExtentZ > FAR_CLIP then
		return 0
	end

	-- Object-space backface test: at most 3 of the 6 box faces can face the camera
	const LocalCameraLook = vector.dot(RelativePosition, LookAxis) :: number
	const LocalCameraUp = vector.dot(RelativePosition, UpAxis) :: number
	const LocalCameraRight = vector.dot(RelativePosition, RightAxis) :: number

	local FaceMask = 0 :: number
	if LocalCameraLook < -HalfSizeZ + BACKFACE_EPSILON then
		FaceMask += 1 -- Back (+Look)
	elseif LocalCameraLook > HalfSizeZ - BACKFACE_EPSILON then
		FaceMask += 2 -- Front (-Look)
	end

	if LocalCameraUp > HalfSizeY - BACKFACE_EPSILON then
		FaceMask += 4 -- Bottom (-Up)
	elseif LocalCameraUp < -HalfSizeY + BACKFACE_EPSILON then
		FaceMask += 8 -- Top (+Up)
	end

	if LocalCameraRight > HalfSizeX - BACKFACE_EPSILON then
		FaceMask += 16 -- Left (-Right)
	elseif LocalCameraRight < -HalfSizeX + BACKFACE_EPSILON then
		FaceMask += 32 -- Right (+Right)
	end

	if FaceMask == 0 then
		return 0
	end

	const CameraSpaceCenter = vector.create(
		vector.dot(RelativePosition, CamRight),
		vector.dot(RelativePosition, CamUp),
		CameraSpaceCenterZ
	)
	const CameraSpaceRightAxis = vector.create(
		vector.dot(WorldRightAxis, CamRight),
		vector.dot(WorldRightAxis, CamUp),
		RightAxisCameraZ
	)
	const CameraSpaceUpAxis = vector.create(
		vector.dot(WorldUpAxis, CamRight),
		vector.dot(WorldUpAxis, CamUp),
		UpAxisCameraZ
	)
	const CameraSpaceLookAxis = vector.create(
		vector.dot(WorldLookAxis, CamRight),
		vector.dot(WorldLookAxis, CamUp),
		LookAxisCameraZ
	)

	const CenterMinusUpAxis = CameraSpaceCenter - CameraSpaceUpAxis
	const CenterPlusUpAxis = CameraSpaceCenter + CameraSpaceUpAxis
	const RightPlusLookAxis = CameraSpaceRightAxis + CameraSpaceLookAxis
	const LookMinusRightAxis = CameraSpaceLookAxis - CameraSpaceRightAxis

	-- 8 corners computed with 3-wide SIMD vector add/sub
	BufferHelper.WriteVec3(CameraVertices, 0, CenterMinusUpAxis + LookMinusRightAxis)
	BufferHelper.WriteVec3(CameraVertices, 12, CenterMinusUpAxis + RightPlusLookAxis)
	BufferHelper.WriteVec3(CameraVertices, 24, CenterPlusUpAxis + RightPlusLookAxis)
	BufferHelper.WriteVec3(CameraVertices, 36, CenterPlusUpAxis + LookMinusRightAxis)
	BufferHelper.WriteVec3(CameraVertices, 48, CenterMinusUpAxis - RightPlusLookAxis)
	BufferHelper.WriteVec3(CameraVertices, 60, CenterMinusUpAxis - LookMinusRightAxis)
	BufferHelper.WriteVec3(CameraVertices, 72, CenterPlusUpAxis - LookMinusRightAxis)
	BufferHelper.WriteVec3(CameraVertices, 84, CenterPlusUpAxis - RightPlusLookAxis)

	return FaceMask
end

--[=[
	Calculates the camera focal length and frustum guardband scaling parameters.
	@param FovY number -- Vertical field of view in degrees.
	@param WIDTH number -- Viewport width in pixels.
	@param HEIGHT number -- Viewport height in pixels.
	@return (number, number, number) -- FocalLength, GuardBandX, GuardBandY.
]=]
function RenderMath.GetProjectionParameters(FovY: number, WIDTH: number, HEIGHT: number): (number, number, number)
	const FocalLength = (HEIGHT * 0.5) / math.tan(math.rad(FovY) * 0.5) :: number
	const GuardBandX = (WIDTH * 0.5 * GUARD_BAND_SCALE) / FocalLength :: number
	const GuardBandY = (HEIGHT * 0.5 * GUARD_BAND_SCALE) / FocalLength :: number
	return FocalLength, GuardBandX, GuardBandY
end

--[=[
	Clips a camera-space quad against frustum planes and projects vertices with UVs onto the screen.
	@param CameraVertices buffer -- Buffer containing camera-space vertices.
	@param V0ByteOffset number -- Byte offset for quad vertex 0.
	@param V1ByteOffset number -- Byte offset for quad vertex 1.
	@param V2ByteOffset number -- Byte offset for quad vertex 2.
	@param V3ByteOffset number -- Byte offset for quad vertex 3.
	@param ScaleU number -- Horizontal UV tile scale for the quad.
	@param ScaleV number -- Vertical UV tile scale for the quad.
	@param ProjectedVertices buffer -- Buffer to receive projected 20-byte vertices (X, Y, InvZ, U, V).
	@param ClipBufferA buffer -- Temporary scratch buffer for 20-byte polygon clipping.
	@param ClipBufferB buffer -- Secondary scratch buffer for 20-byte polygon clipping.
	@param FocalLength number -- Camera focal length.
	@param GuardBandX number -- Horizontal guardband slope factor.
	@param GuardBandY number -- Vertical guardband slope factor.
	@param HalfWidth number -- Half screen width in pixels.
	@param HalfHeight number -- Half screen height in pixels.
	@return number -- Total projected vertex count (0 if culled).
]=]
function RenderMath.ClipAndProjectQuad(
	CameraVertices: buffer,
	V0ByteOffset: number,
	V1ByteOffset: number,
	V2ByteOffset: number,
	V3ByteOffset: number,
	ScaleU: number,
	ScaleV: number,
	ProjectedVertices: buffer,
	ClipBufferA: buffer,
	ClipBufferB: buffer,
	FocalLength: number,
	GuardBandX: number,
	GuardBandY: number,
	HalfWidth: number,
	HalfHeight: number
): number
	const QuadVertex0 = BufferHelper.ReadVec3(CameraVertices, V0ByteOffset)
	const QuadVertex1 = BufferHelper.ReadVec3(CameraVertices, V1ByteOffset)
	const QuadVertex2 = BufferHelper.ReadVec3(CameraVertices, V2ByteOffset)
	const QuadVertex3 = BufferHelper.ReadVec3(CameraVertices, V3ByteOffset)

	if
		MathModule.IsVertexInside(QuadVertex0, GuardBandX, GuardBandY)
		and MathModule.IsVertexInside(QuadVertex1, GuardBandX, GuardBandY)
		and MathModule.IsVertexInside(QuadVertex2, GuardBandX, GuardBandY)
		and MathModule.IsVertexInside(QuadVertex3, GuardBandX, GuardBandY)
	then
		MathModule.ProjectVertexUV(ProjectedVertices, 0, QuadVertex0, 0, ScaleV, FocalLength, HalfWidth, HalfHeight)
		MathModule.ProjectVertexUV(ProjectedVertices, 20, QuadVertex1, 0, 0, FocalLength, HalfWidth, HalfHeight)
		MathModule.ProjectVertexUV(ProjectedVertices, 40, QuadVertex2, ScaleU, 0, FocalLength, HalfWidth, HalfHeight)
		MathModule.ProjectVertexUV(ProjectedVertices, 60, QuadVertex3, ScaleU, ScaleV, FocalLength, HalfWidth, HalfHeight)
		return 4
	end

	BufferHelper.WriteVec3(ClipBufferA, 0, QuadVertex0)
	buffer.writef32(ClipBufferA, 12, 0)
	buffer.writef32(ClipBufferA, 16, ScaleV)

	BufferHelper.WriteVec3(ClipBufferA, 20, QuadVertex1)
	buffer.writef32(ClipBufferA, 32, 0)
	buffer.writef32(ClipBufferA, 36, 0)

	BufferHelper.WriteVec3(ClipBufferA, 40, QuadVertex2)
	buffer.writef32(ClipBufferA, 52, ScaleU)
	buffer.writef32(ClipBufferA, 56, 0)

	BufferHelper.WriteVec3(ClipBufferA, 60, QuadVertex3)
	buffer.writef32(ClipBufferA, 72, ScaleU)
	buffer.writef32(ClipBufferA, 76, ScaleV)

	local VertexCount = MathModule.ClipPolygonUV(ClipBufferA, 4, ClipBufferB, PLANE_NEAR, -NEAR_CLIP)
	VertexCount = MathModule.ClipPolygonUV(ClipBufferB, VertexCount, ClipBufferA, PLANE_FAR, FAR_CLIP)
	VertexCount = MathModule.ClipPolygonUV(ClipBufferA, VertexCount, ClipBufferB, vector.create(1, 0, GuardBandX), 0)
	VertexCount = MathModule.ClipPolygonUV(ClipBufferB, VertexCount, ClipBufferA, vector.create(-1, 0, GuardBandX), 0)
	VertexCount = MathModule.ClipPolygonUV(ClipBufferA, VertexCount, ClipBufferB, vector.create(0, 1, GuardBandY), 0)
	VertexCount = MathModule.ClipPolygonUV(ClipBufferB, VertexCount, ClipBufferA, vector.create(0, -1, GuardBandY), 0)

	for i = 1, VertexCount do
		const Offset = (i - 1) * 20 :: number
		MathModule.ProjectVertexUV(
			ProjectedVertices,
			Offset,
			BufferHelper.ReadVec3(ClipBufferA, Offset),
			buffer.readf32(ClipBufferA, Offset + 12),
			buffer.readf32(ClipBufferA, Offset + 16),
			FocalLength,
			HalfWidth,
			HalfHeight
		)
	end

	return VertexCount
end

--[=[
	Clips a camera-space triangle against frustum planes and projects vertices onto the screen.
	@param CameraVertices buffer -- Buffer containing camera-space vertices.
	@param V0Index number -- 1-based index for triangle vertex 0.
	@param V1Index number -- 1-based index for triangle vertex 1.
	@param V2Index number -- 1-based index for triangle vertex 2.
	@param ProjectedVertices buffer -- Buffer to receive projected 2D vertices.
	@param ClipBufferA buffer -- Temporary scratch buffer for polygon clipping.
	@param ClipBufferB buffer -- Secondary scratch buffer for polygon clipping.
	@param FocalLength number -- Camera focal length.
	@param GuardBandX number -- Horizontal guardband slope factor.
	@param GuardBandY number -- Vertical guardband slope factor.
	@param WIDTH number -- Target screen width in pixels.
	@param HEIGHT number -- Target screen height in pixels.
	@return number -- Total projected vertex count (0 if culled).
]=]
function RenderMath.ClipAndProjectTriangle(
	CameraVertices: buffer,
	V0Index: number,
	V1Index: number,
	V2Index: number,
	ProjectedVertices: buffer,
	ClipBufferA: buffer,
	ClipBufferB: buffer,
	FocalLength: number,
	GuardBandX: number,
	GuardBandY: number,
	WIDTH: number,
	HEIGHT: number
): number
	const HalfWidth = WIDTH * 0.5 :: number
	const HalfHeight = HEIGHT * 0.5 :: number
	const TriangleVertex0 = BufferHelper.ReadVec3(CameraVertices, (V0Index - 1) * 12)
	const TriangleVertex1 = BufferHelper.ReadVec3(CameraVertices, (V1Index - 1) * 12)
	const TriangleVertex2 = BufferHelper.ReadVec3(CameraVertices, (V2Index - 1) * 12)

	if
		MathModule.IsVertexInside(TriangleVertex0, GuardBandX, GuardBandY)
		and MathModule.IsVertexInside(TriangleVertex1, GuardBandX, GuardBandY)
		and MathModule.IsVertexInside(TriangleVertex2, GuardBandX, GuardBandY)
	then
		MathModule.ProjectVertex(ProjectedVertices, 0, TriangleVertex0, FocalLength, HalfWidth, HalfHeight)
		MathModule.ProjectVertex(ProjectedVertices, 12, TriangleVertex1, FocalLength, HalfWidth, HalfHeight)
		MathModule.ProjectVertex(ProjectedVertices, 24, TriangleVertex2, FocalLength, HalfWidth, HalfHeight)
		return 3
	end

	BufferHelper.WriteVec3(ClipBufferA, 0, TriangleVertex0)
	BufferHelper.WriteVec3(ClipBufferA, 12, TriangleVertex1)
	BufferHelper.WriteVec3(ClipBufferA, 24, TriangleVertex2)

	local VertexCount = MathModule.ClipPolygon(ClipBufferA, 3, ClipBufferB, PLANE_NEAR, -NEAR_CLIP)
	VertexCount = MathModule.ClipPolygon(ClipBufferB, VertexCount, ClipBufferA, PLANE_FAR, FAR_CLIP)
	VertexCount = MathModule.ClipPolygon(ClipBufferA, VertexCount, ClipBufferB, vector.create(1, 0, GuardBandX), 0)
	VertexCount = MathModule.ClipPolygon(ClipBufferB, VertexCount, ClipBufferA, vector.create(-1, 0, GuardBandX), 0)
	VertexCount = MathModule.ClipPolygon(ClipBufferA, VertexCount, ClipBufferB, vector.create(0, 1, GuardBandY), 0)
	VertexCount = MathModule.ClipPolygon(ClipBufferB, VertexCount, ClipBufferA, vector.create(0, -1, GuardBandY), 0)

	for i = 1, VertexCount do
		const Offset = (i - 1) * 12 :: number
		MathModule.ProjectVertex(
			ProjectedVertices,
			Offset,
			BufferHelper.ReadVec3(ClipBufferA, Offset),
			FocalLength,
			HalfWidth,
			HalfHeight
		)
	end

	return VertexCount
end

-- ============================================================================
-- 2. DRAWING OBJECTS - EXACT SPAN RASTERIZATION
-- ============================================================================

--[=[
	Draws a single screen-space triangle into the color pixel and Z depth buffers.
	@param Vertex0X number -- Screen vertex 0 X.
	@param Vertex0Y number -- Screen vertex 0 Y.
	@param ScaledInverseZ0 number -- Pre-scaled 1/Z depth for vertex 0.
	@param Vertex1X number -- Screen vertex 1 X.
	@param Vertex1Y number -- Screen vertex 1 Y.
	@param ScaledInverseZ1 number -- Pre-scaled 1/Z depth for vertex 1.
	@param Vertex2X number -- Screen vertex 2 X.
	@param Vertex2Y number -- Screen vertex 2 Y.
	@param ScaledInverseZ2 number -- Pre-scaled 1/Z depth for vertex 2.
	@param PackedColor number -- Packed 32-bit RGBA color.
	@param WIDTH number -- Screen width in pixels.
	@param HEIGHT number -- Screen height in pixels.
	@param PixelBuffer buffer -- Destination color pixel buffer.
	@param ZBuffer buffer -- Destination 32-bit depth buffer.
]=]
function RenderMath.DrawTriangle(
	Vertex0X: number,
	Vertex0Y: number,
	ScaledInverseZ0: number,
	Vertex1X: number,
	Vertex1Y: number,
	ScaledInverseZ1: number,
	Vertex2X: number,
	Vertex2Y: number,
	ScaledInverseZ2: number,
	PackedColor: number,
	WIDTH: number,
	HEIGHT: number,
	PixelBuffer: buffer,
	ZBuffer: buffer
)
	const DefaultTexture: buffer, TextureWidth: number, TextureHeight: number = TextureHelper.GetDefaultTexture()
	MathModule.RasterizeTriangleSpan(
		Vertex0X,
		Vertex0Y,
		ScaledInverseZ0,
		0,
		0,
		Vertex1X,
		Vertex1Y,
		ScaledInverseZ1,
		0,
		0,
		Vertex2X,
		Vertex2Y,
		ScaledInverseZ2,
		0,
		0,
		PackedColor,
		DefaultTexture,
		TextureWidth,
		TextureHeight,
		WIDTH,
		HEIGHT,
		WIDTH * 4,
		PixelBuffer,
		ZBuffer
	)
end

--[=[
	Iterates and rasterizes a packed batch of textured triangles from a render command buffer.
	@param RenderBuffer buffer -- Source render command queue buffer.
	@param ByteCount number -- Total byte length of queued commands.
	@param TextureBuffers { [number]: buffer } -- Cached 64x64 RGBA texture buffers keyed by TextureId.
	@param DefaultTextureBuffer buffer -- Fallback 64x64 RGBA texture buffer.
	@param TextureWidth number -- Texture width in texels.
	@param TextureHeight number -- Texture height in texels.
	@param WIDTH number -- Screen width in pixels.
	@param HEIGHT number -- Screen height in pixels.
	@param PixelBuffer buffer -- Destination color pixel buffer.
	@param ZBuffer buffer -- Destination 32-bit depth buffer.
	@return (number, number) -- Modified scanline row range (DirtyMinY, DirtyMaxY).
]=]
function RenderMath.DrawTriangleBatch(
	RenderBuffer: buffer,
	ByteCount: number,
	TextureBuffers: { [number]: buffer },
	DefaultTextureBuffer: buffer,
	TextureWidth: number,
	TextureHeight: number,
	WIDTH: number,
	HEIGHT: number,
	PixelBuffer: buffer,
	ZBuffer: buffer
): (number, number)
	const RowStride = WIDTH * 4 :: number
	local DirtyMinY = HEIGHT :: number
	local DirtyMaxY = -1 :: number
	local ReadOffset = 0 :: number

	while ReadOffset < ByteCount do
		const TextureId = buffer.readu32(RenderBuffer, ReadOffset + 52) :: number
		const TriangleTextureBuffer: buffer? = if TextureId > 0 then (TextureBuffers[TextureId] or DefaultTextureBuffer) else nil

		const TriangleMinY: number, TriangleMaxY: number = MathModule.RasterizeTriangleSpan(
			buffer.readi16(RenderBuffer, ReadOffset),
			buffer.readi16(RenderBuffer, ReadOffset + 2),
			buffer.readf32(RenderBuffer, ReadOffset + 4),
			buffer.readf32(RenderBuffer, ReadOffset + 8),
			buffer.readf32(RenderBuffer, ReadOffset + 12),
			buffer.readi16(RenderBuffer, ReadOffset + 16),
			buffer.readi16(RenderBuffer, ReadOffset + 18),
			buffer.readf32(RenderBuffer, ReadOffset + 20),
			buffer.readf32(RenderBuffer, ReadOffset + 24),
			buffer.readf32(RenderBuffer, ReadOffset + 28),
			buffer.readi16(RenderBuffer, ReadOffset + 32),
			buffer.readi16(RenderBuffer, ReadOffset + 34),
			buffer.readf32(RenderBuffer, ReadOffset + 36),
			buffer.readf32(RenderBuffer, ReadOffset + 40),
			buffer.readf32(RenderBuffer, ReadOffset + 44),
			buffer.readu32(RenderBuffer, ReadOffset + 48),
			TriangleTextureBuffer,
			TextureWidth,
			TextureHeight,
			WIDTH,
			HEIGHT,
			RowStride,
			PixelBuffer,
			ZBuffer
		)

		if TriangleMinY < DirtyMinY then
			DirtyMinY = TriangleMinY
		end
		if TriangleMaxY > DirtyMaxY then
			DirtyMaxY = TriangleMaxY
		end

		ReadOffset += BUFFER_LAYOUT_SIZE
	end

	return DirtyMinY, DirtyMaxY
end

return RenderMath
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="150">
              <Properties>
                <string name="Name">TextureHelper</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const AssetService = game:GetService("AssetService")
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))

-- Configs --
const TEXTURE_SIZE = SystemsConfigs.TextureSize :: number
const DEFAULT_TEXTURE_URI = SystemsConfigs.DefaultTextureUri :: string

-- Buffers
local CachedDefaultTexture: buffer? = nil

local TextureHelper = {}

-- ============================================================================
-- 1. PROCEDURAL TEXTURES & 64x64 URL DECODING
-- ============================================================================

--[=[
	Packs RGBA channels (0-255) into a little-endian 32-bit unsigned integer.
	@param RedChannel number -- Red channel (0-255).
	@param GreenChannel number -- Green channel (0-255).
	@param BlueChannel number -- Blue channel (0-255).
	@param AlphaChannel number -- Alpha channel (0-255).
	@return number -- Packed 32-bit RGBA pixel value.
]=]
local function PackRGBA(RedChannel: number, GreenChannel: number, BlueChannel: number, AlphaChannel: number): number
	return bit32.bor(
		RedChannel,
		bit32.lshift(GreenChannel, 8),
		bit32.lshift(BlueChannel, 16),
		bit32.lshift(AlphaChannel, 24)
	)
end

--[=[
	Generates a seamlessly tileable power-of-two procedural wood plank texture with grain rings, seams, and bevels.
	@param TargetSize number -- Width and height of the square texture in texels.
	@return buffer -- RGBA pixel buffer of size TargetSize * TargetSize * 4.
]=]
function TextureHelper.CreateProceduralWoodTexture(TargetSize: number): buffer
	const PixelBuffer = buffer.create(TargetSize * TargetSize * 4) :: buffer
	const InvSize = 1 / TargetSize :: number
	const TwoPi = math.pi * 2 :: number
	const PlankHeight = math.max(8, TargetSize // 4) :: number

	for TexelY = 0, TargetSize - 1 do
		const NormV = (TexelY + 0.5) * InvSize :: number
		const AngleV = NormV * TwoPi :: number
		const CosV = math.cos(AngleV) :: number
		const SinV = math.sin(AngleV) :: number
		const PlankIndex = TexelY // PlankHeight :: number
		const PlankLocalY = TexelY % PlankHeight :: number
		const IsHorizontalSeam = (PlankLocalY == 0) :: boolean
		const RowOffset = TexelY * TargetSize * 4 :: number

		for TexelX = 0, TargetSize - 1 do
			const NormU = (TexelX + 0.5) * InvSize :: number
			const AngleU = NormU * TwoPi :: number
			const CosU = math.cos(AngleU) :: number
			const SinU = math.sin(AngleU) :: number

			-- Offset vertical plank seams per row for staggered wood planks
			const SeamX = (TexelX + PlankIndex * (TargetSize // 2)) % TargetSize :: number
			const IsVerticalSeam = (SeamX == 0) :: boolean

			-- Elongated horizontal wood grain noise
			const GrainWarp = math.noise(CosU * 1.1 + PlankIndex * 2.3, SinU * 1.1, CosV * 4.2 + SinV * 4.2) :: number
			const RingPattern = math.sin((NormV * 14 + GrainWarp * 2.4 + PlankIndex * 0.7) * math.pi) :: number
			const FineFiber = math.noise(CosU * 3.5, SinU * 3.5, NormV * 24 + PlankIndex * 5.1) :: number
			const PlankTintOffset = ((PlankIndex % 3) - 1) * 10 :: number

			local ShadeFactor = 0.5 + 0.32 * RingPattern + 0.18 * FineFiber :: number
			ShadeFactor = math.clamp(ShadeFactor, 0.12, 1.0)

			local Red = math.clamp(math.floor(110 + ShadeFactor * 92 + PlankTintOffset), 40, 220) :: number
			local Green = math.clamp(math.floor(66 + ShadeFactor * 64 + PlankTintOffset * 0.7), 24, 155) :: number
			local Blue = math.clamp(math.floor(32 + ShadeFactor * 36 + PlankTintOffset * 0.4), 12, 90) :: number

			if IsHorizontalSeam or IsVerticalSeam then
				Red = math.floor(Red * 0.42)
				Green = math.floor(Green * 0.42)
				Blue = math.floor(Blue * 0.42)
			elseif PlankLocalY == 1 or SeamX == 1 then
				Red = math.min(240, Red + 18)
				Green = math.min(185, Green + 14)
				Blue = math.min(115, Blue + 10)
			end

			buffer.writeu32(PixelBuffer, RowOffset + TexelX * 4, PackRGBA(Red, Green, Blue, 255))
		end
	end

	return PixelBuffer
end

--[=[
	Generates a high-contrast power-of-two procedural Roblox stud and checker grid template texture.
	@param TargetSize number -- Width and height of the square texture in texels.
	@return buffer -- RGBA pixel buffer of size TargetSize * TargetSize * 4.
]=]
function TextureHelper.CreateProceduralStudTexture(TargetSize: number): buffer
	const PixelBuffer = buffer.create(TargetSize * TargetSize * 4) :: buffer
	const CellSize = math.max(4, TargetSize // 2) :: number
	const HalfCell = CellSize * 0.5 :: number
	const BorderThickness = math.max(1, TargetSize // 24) :: number
	const StudOuterRadius = CellSize * 0.34 :: number
	const StudInnerRadius = CellSize * 0.22 :: number
	const StudCenterRadius = CellSize * 0.09 :: number

	for TexelY = 0, TargetSize - 1 do
		const QuadrantY = TexelY // CellSize :: number
		const CellY = TexelY % CellSize :: number
		const OffsetY = (CellY + 0.5) - HalfCell :: number
		const RowOffset = TexelY * TargetSize * 4 :: number

		for TexelX = 0, TargetSize - 1 do
			const QuadrantX = TexelX // CellSize :: number
			const CellX = TexelX % CellSize :: number
			const OffsetX = (CellX + 0.5) - HalfCell :: number
			const DistanceFromCenter = math.sqrt(OffsetX * OffsetX + OffsetY * OffsetY) :: number

			const IsLightTile = ((QuadrantX + QuadrantY) % 2 == 0) :: boolean
			local Shade = if IsLightTile then 236 else 160 :: number

			if
				CellX < BorderThickness
				or CellY < BorderThickness
				or CellX >= CellSize - BorderThickness
				or CellY >= CellSize - BorderThickness
			then
				Shade = 68
			elseif DistanceFromCenter <= StudCenterRadius then
				Shade = 95
			elseif DistanceFromCenter <= StudInnerRadius then
				Shade = if IsLightTile then 205 else 225
			elseif DistanceFromCenter <= StudOuterRadius then
				if OffsetX + OffsetY < 0 then
					Shade = 250
				else
					Shade = 60
				end
			end

			buffer.writeu32(
				PixelBuffer,
				RowOffset + TexelX * 4,
				PackRGBA(math.max(0, Shade - 8), Shade, math.min(255, Shade + 10), 255)
			)
		end
	end

	return PixelBuffer
end

--[=[
	Generates the default procedural template texture buffer (stud template).
	@param TargetSize number -- Width and height of the square texture in texels.
	@return buffer -- RGBA pixel buffer of size TargetSize * TargetSize * 4.
]=]
function TextureHelper.CreateProceduralTemplateTexture(TargetSize: number): buffer
	return TextureHelper.CreateProceduralStudTexture(TargetSize)
end

--[=[
	Resamples a source RGBA pixel buffer to a square TargetSize x TargetSize buffer using nearest-neighbor sampling.
	@param SourceBuffer buffer -- Source RGBA pixel buffer.
	@param SourceWidth number -- Source image width in pixels.
	@param SourceHeight number -- Source image height in pixels.
	@param TargetSize number -- Target square texture size in texels.
	@return buffer -- Resampled RGBA pixel buffer.
]=]
function TextureHelper.ResampleTextureBuffer(
	SourceBuffer: buffer,
	SourceWidth: number,
	SourceHeight: number,
	TargetSize: number
): buffer
	if SourceWidth == TargetSize and SourceHeight == TargetSize then
		return SourceBuffer
	end

	const DestBuffer = buffer.create(TargetSize * TargetSize * 4) :: buffer
	const ScaleX = SourceWidth / TargetSize :: number
	const ScaleY = SourceHeight / TargetSize :: number

	for DestY = 0, TargetSize - 1 do
		const SourceY = math.min(SourceHeight - 1, math.floor(DestY * ScaleY)) :: number
		const SourceRowOffset = SourceY * SourceWidth * 4 :: number
		const DestRowOffset = DestY * TargetSize * 4 :: number

		for DestX = 0, TargetSize - 1 do
			const SourceX = math.min(SourceWidth - 1, math.floor(DestX * ScaleX)) :: number
			const Texel = buffer.readu32(SourceBuffer, SourceRowOffset + SourceX * 4) :: number
			buffer.writeu32(DestBuffer, DestRowOffset + DestX * 4, Texel)
		end
	end

	return DestBuffer
end

--[=[
	Decodes a raw Roblox texture URL into a TargetSize x TargetSize RGBA buffer using EditableImage, falling back to FallbackBuffer on empty URI or load failure.
	@param RawUrl string -- Raw Roblox texture URL (e.g. "rbxassetid://..." or "rbxasset://...").
	@param FallbackBuffer buffer? -- Optional precomputed fallback buffer if decoding fails or URL is empty.
	@param TargetSize number? -- Optional square target size in texels (defaults to SystemsConfigs.TextureSize).
	@return (buffer, boolean) -- Decoded (or fallback) 64x64 RGBA buffer, and true if decoded from the URL.
]=]
function TextureHelper.DecodeUrlToBuffer(
	RawUrl: string,
	FallbackBuffer: buffer?,
	TargetSize: number?
): (buffer, boolean)
	const ResolvedSize = TargetSize or TEXTURE_SIZE :: number
	if RawUrl ~= "" then
		const Success: boolean, LoadedResult: any = pcall(function()
			return AssetService:CreateEditableImageAsync(Content.fromUri(RawUrl))
		end)

		if Success and LoadedResult then
			const EditableImage = LoadedResult :: EditableImage
			const ImageSize = EditableImage.Size :: Vector2
			const RawPixels = EditableImage:ReadPixelsBuffer(Vector2.zero, ImageSize) :: buffer
			EditableImage:Destroy()

			const Resampled = TextureHelper.ResampleTextureBuffer(RawPixels, ImageSize.X, ImageSize.Y, ResolvedSize)
			return Resampled, true
		end
	end

	if FallbackBuffer then
		return FallbackBuffer, false
	end

	return TextureHelper.CreateProceduralStudTexture(ResolvedSize), false
end

--[=[
	Returns the cached synchronous procedural default texture buffer and its dimensions.
	@return (buffer, number, number) -- TextureBuffer, TextureWidth, TextureHeight.
]=]
function TextureHelper.GetDefaultTexture(): (buffer, number, number)
	if not CachedDefaultTexture then
		CachedDefaultTexture = TextureHelper.CreateProceduralStudTexture(TEXTURE_SIZE)
	end

	return CachedDefaultTexture :: buffer, TEXTURE_SIZE, TEXTURE_SIZE
end

--[=[
	Loads an optional Roblox texture URI or returns the procedural stud template texture.
	@param TextureUri string? -- Optional asset URI override (defaults to SystemsConfigs.DefaultTextureUri).
	@param TargetSize number? -- Optional square target size in texels (defaults to SystemsConfigs.TextureSize).
	@return (buffer, number, number) -- TextureBuffer, TextureWidth, TextureHeight.
]=]
function TextureHelper.LoadRobloxTemplateTexture(TextureUri: string?, TargetSize: number?): (buffer, number, number)
	const ResolvedUri = TextureUri or DEFAULT_TEXTURE_URI :: string
	const ResolvedSize = TargetSize or TEXTURE_SIZE :: number
	const DecodedBuffer = TextureHelper.DecodeUrlToBuffer(ResolvedUri, nil, ResolvedSize)
	return DecodedBuffer, ResolvedSize, ResolvedSize
end

return TextureHelper
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="151">
              <Properties>
                <string name="Name">TextureTable</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))
const TextureHelper = require(script.Parent.TextureHelper)

-- Configs --
const TEXTURE_SIZE = SystemsConfigs.TextureSize :: number

-- Buffers
const DefaultWoodBuffer = TextureHelper.CreateProceduralWoodTexture(TEXTURE_SIZE) :: buffer
const DefaultStudBuffer = TextureHelper.CreateProceduralStudTexture(TEXTURE_SIZE) :: buffer

local NextDynamicId = 1 :: number

local TextureTable = {}

-- ============================================================================
-- 1. TEXTURE TRANSLATOR, DEDUPLICATED URL REGISTRY & 64x64 BUFFER CACHE
-- ============================================================================

-- Translator table: numeric ECS TextureId -> texture name
TextureTable.IdToName = {
	[1] = "WoodTexture",
	[2] = "StudTexture",
} :: { [number]: string }

-- Reverse translator table: texture name -> numeric ECS TextureId
TextureTable.NameToId = {
	WoodTexture = 1,
	StudTexture = 2,
} :: { [string]: number }

-- URL translator maps for deduplication and client-side decoding
TextureTable.IdToUrl = {} :: { [number]: string }
TextureTable.UrlToId = {} :: { [string]: number }

-- Cached 64x64 RGBA texture buffers indexed by numeric ECS TextureId
TextureTable.CachedBuffers = {
	[1] = DefaultWoodBuffer,
	[2] = DefaultStudBuffer,
} :: { [number]: buffer }

--[=[
	Trims surrounding whitespace from a raw Roblox asset URL.
	@param RawUrl string -- Raw Roblox texture URL.
	@return string -- Normalized URL string.
]=]
function TextureTable.NormalizeUrl(RawUrl: string): string
	return (string.match(RawUrl, "^%s*(.-)%s*$") or "") :: string
end

--[=[
	Decodes a raw Roblox texture URL into a 64x64 RGBA buffer using the renderer's EditableImage pipeline.
	@param RawUrl string -- Raw Roblox asset URL (e.g. "rbxassetid://123456789").
	@param FallbackBuffer buffer? -- Optional fallback 64x64 buffer if Url is empty or fails to load.
	@return (buffer, boolean) -- Decoded (or fallback) 64x64 RGBA buffer, and true if decoded from RawUrl.
]=]
function TextureTable.DecodeRawUrl(RawUrl: string, FallbackBuffer: buffer?): (buffer, boolean)
	return TextureHelper.DecodeUrlToBuffer(RawUrl, FallbackBuffer, TEXTURE_SIZE)
end

--[=[
	Returns a deterministic procedural 64x64 fallback buffer for a given TextureId slot.
	@param TextureId number -- Numeric TextureId slot.
	@return buffer -- Procedural 64x64 RGBA buffer.
]=]
local function GetFallbackBufferForSlot(TextureId: number): buffer
	if TextureId % 2 == 1 then
		return DefaultWoodBuffer
	end
	return DefaultStudBuffer
end

--[=[
	Clears all dynamic and default entries from TextureTable before scanning Workspace decals.
]=]
function TextureTable.ResetEntries()
	table.clear(TextureTable.IdToName)
	table.clear(TextureTable.NameToId)
	table.clear(TextureTable.IdToUrl)
	table.clear(TextureTable.UrlToId)
	table.clear(TextureTable.CachedBuffers)
	NextDynamicId = 1
end

--[=[
	Populates fallback WoodTexture (1) and StudTexture (2) entries if no decals were registered.
]=]
function TextureTable.EnsureDefaultEntries()
	if next(TextureTable.IdToName) ~= nil then
		return
	end

	TextureTable.IdToName[1] = "WoodTexture"
	TextureTable.IdToName[2] = "StudTexture"
	TextureTable.NameToId["WoodTexture"] = 1
	TextureTable.NameToId["StudTexture"] = 2
	TextureTable.CachedBuffers[1] = DefaultWoodBuffer
	TextureTable.CachedBuffers[2] = DefaultStudBuffer
	NextDynamicId = 3
end

--[=[
	Registers a texture URL into TextureTable, ignoring empty or duplicate URLs, and caches its 64x64 buffer.
	@param RawUrl string -- Raw Roblox Decal.Texture URL.
	@param TextureName string? -- Optional human-readable name for the translator table.
	@param DecodeNow boolean? -- Whether to immediately decode via AssetService (defaults to true).
	@return (number, boolean) -- Assigned (or existing) TextureId, and true if newly registered (false if empty or duplicate).
]=]
function TextureTable.RegisterUrl(RawUrl: string, TextureName: string?, DecodeNow: boolean?): (number, boolean)
	const NormalizedUrl = TextureTable.NormalizeUrl(RawUrl)
	if NormalizedUrl == "" then
		return 0, false
	end

	-- Ignore duplicate URLs and return the already-registered TextureId
	const ExistingId = TextureTable.UrlToId[NormalizedUrl]
	if ExistingId then
		return ExistingId, false
	end

	const AssignedId = NextDynamicId :: number
	NextDynamicId += 1

	const ResolvedName = if TextureName and TextureName ~= ""
		then TextureName
		else ("Decal_" .. tostring(AssignedId))

	TextureTable.IdToName[AssignedId] = ResolvedName
	if not TextureTable.NameToId[ResolvedName] then
		TextureTable.NameToId[ResolvedName] = AssignedId
	end
	TextureTable.IdToUrl[AssignedId] = NormalizedUrl
	TextureTable.UrlToId[NormalizedUrl] = AssignedId

	const FallbackBuffer = GetFallbackBufferForSlot(AssignedId)
	if DecodeNow ~= false then
		const DecodedBuffer = TextureTable.DecodeRawUrl(NormalizedUrl, FallbackBuffer)
		TextureTable.CachedBuffers[AssignedId] = DecodedBuffer
	else
		TextureTable.CachedBuffers[AssignedId] = FallbackBuffer
	end

	return AssignedId, true
end

--[=[
	Registers and decodes a replicated TextureId + URL entry into TextureTable.CachedBuffers, skipping duplicates.
	@param TextureId number -- Replicated numeric TextureId.
	@param RawUrl string -- Raw Roblox Decal.Texture URL.
	@param TextureName string? -- Optional texture name.
	@return (buffer, boolean) -- Cached 64x64 RGBA buffer, and true if newly decoded/updated.
]=]
function TextureTable.RegisterEntryWithId(TextureId: number, RawUrl: string, TextureName: string?): (buffer, boolean)
	const NormalizedUrl = TextureTable.NormalizeUrl(RawUrl)
	const FallbackBuffer = GetFallbackBufferForSlot(TextureId)
	if NormalizedUrl == "" then
		TextureTable.CachedBuffers[TextureId] = TextureTable.CachedBuffers[TextureId] or FallbackBuffer
		return TextureTable.CachedBuffers[TextureId], false
	end

	if TextureTable.IdToUrl[TextureId] == NormalizedUrl and TextureTable.CachedBuffers[TextureId] then
		return TextureTable.CachedBuffers[TextureId], false
	end

	-- If this URL was already decoded under another slot, reuse its cached 64x64 buffer without re-downloading
	const ExistingUrlId = TextureTable.UrlToId[NormalizedUrl]
	if ExistingUrlId and TextureTable.CachedBuffers[ExistingUrlId] then
		const SharedBuffer = TextureTable.CachedBuffers[ExistingUrlId]
		TextureTable.IdToUrl[TextureId] = NormalizedUrl
		TextureTable.CachedBuffers[TextureId] = SharedBuffer
		if TextureName and TextureName ~= "" then
			TextureTable.IdToName[TextureId] = TextureName
			if not TextureTable.NameToId[TextureName] then
				TextureTable.NameToId[TextureName] = TextureId
			end
		end
		return SharedBuffer, true
	end

	const ResolvedName = if TextureName and TextureName ~= ""
		then TextureName
		else ("Decal_" .. tostring(TextureId))

	TextureTable.IdToName[TextureId] = ResolvedName
	if not TextureTable.NameToId[ResolvedName] then
		TextureTable.NameToId[ResolvedName] = TextureId
	end
	TextureTable.IdToUrl[TextureId] = NormalizedUrl
	TextureTable.UrlToId[NormalizedUrl] = TextureId

	if TextureId >= NextDynamicId then
		NextDynamicId = TextureId + 1
	end

	const DecodedBuffer = TextureTable.DecodeRawUrl(NormalizedUrl, FallbackBuffer)
	TextureTable.CachedBuffers[TextureId] = DecodedBuffer
	return DecodedBuffer, true
end

--[=[
	Returns a sorted array of all currently registered TextureIds in TextureTable.
	@return { number } -- Sorted list of registered numeric TextureIds.
]=]
function TextureTable.GetRegisteredIds(): { number }
	const Ids = {} :: { number }
	for TextureId in pairs(TextureTable.IdToName) do
		table.insert(Ids, TextureId)
	end
	table.sort(Ids)
	return Ids
end

--[=[
	Translates a numeric ECS TextureId into its registered texture name.
	@param TextureId number -- Numeric TextureId stored in the ECS Properties bitfield.
	@return string -- Texture name (defaults to "WoodTexture" if unknown).
]=]
function TextureTable.TranslateIdToName(TextureId: number): string
	return TextureTable.IdToName[TextureId] or "WoodTexture"
end

--[=[
	Translates a texture name into its numeric ECS TextureId.
	@param TextureName string -- Registered texture name (e.g. "WoodTexture", "StudTexture", or Decal name).
	@return number -- Numeric TextureId (0 if not registered).
]=]
function TextureTable.TranslateNameToId(TextureName: string): number
	return TextureTable.NameToId[TextureName] or 0
end

--[=[
	Returns the cached 64x64 RGBA texture buffer for a given TextureId.
	@param TextureId number -- Numeric TextureId from the ECS Properties bitfield.
	@return buffer -- Cached 64x64 RGBA pixel buffer.
]=]
function TextureTable.GetTextureBuffer(TextureId: number): buffer
	const Cached = TextureTable.CachedBuffers[TextureId]
	if Cached then
		return Cached
	end

	return TextureTable.CachedBuffers[1] or DefaultWoodBuffer
end

--[=[
	Returns the table of all cached 64x64 RGBA texture buffers keyed by TextureId.
	@return { [number]: buffer } -- Cached texture buffer map.
]=]
function TextureTable.GetAllCachedBuffers(): { [number]: buffer }
	return TextureTable.CachedBuffers
end

return TextureTable
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="152">
              <Properties>
                <string name="Name">ViewCulling</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const Players = game:GetService("Players")
const ReplicatedStorage = game:GetService("ReplicatedStorage")
const RunService = game:GetService("RunService")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))
const CameraStore = if RunService:IsClient()
	then require(
		ReplicatedStorage:WaitForChild("Shared")
			:WaitForChild("Utilities")
			:WaitForChild("Render")
			:WaitForChild("Camera")
			:WaitForChild("CameraStore")
	)
	else nil

-- Configs --
const PADDING_AMOUNT = SystemsConfigs.CullingPaddingAmount :: number

const WIDTH = SystemsConfigs.RenderWidth :: number
const HEIGHT = SystemsConfigs.RenderHeight :: number
const ASPECT_RATIO = WIDTH / HEIGHT :: number
const BASE_TAN_Y = SystemsConfigs.CullingBaseTanY * PADDING_AMOUNT :: number
const BASE_TAN_X = BASE_TAN_Y * ASPECT_RATIO :: number

const BASE_BACK_PADDING = SystemsConfigs.CullingBaseBackPadding * PADDING_AMOUNT :: number
const RADIUS_PADDING_FACTOR = SystemsConfigs.CullingRadiusPaddingFactor * PADDING_AMOUNT :: number
const NEAR_CLIP = SystemsConfigs.CullingNearClip :: number
const FAR_CLIP = SystemsConfigs.CullingFarClip :: number
const OCCLUDER_INSCRIBED_FACTOR = SystemsConfigs.OccluderInscribedRadiusFactor :: number
const OCCLUDER_MIN_PROJ_RADIUS = SystemsConfigs.OccluderMinProjectedRadius :: number
const COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number

-- Tables --
local ViewOriginX = 0 :: number
local ViewOriginY = 0 :: number
local ViewOriginZ = 0 :: number

local ViewRightX = 1 :: number
local ViewRightY = 0 :: number
local ViewRightZ = 0 :: number

local ViewUpX = 0 :: number
local ViewUpY = 1 :: number
local ViewUpZ = 0 :: number

local ViewLookX = 0 :: number
local ViewLookY = 0 :: number
local ViewLookZ = -1 :: number

local ViewTanX = BASE_TAN_X :: number
local ViewTanY = BASE_TAN_Y :: number

local HasOccluder = false :: boolean
local OccFarZ = 0 :: number
local OccMinX = 0 :: number
local OccMaxX = 0 :: number
local OccMinY = 0 :: number
local OccMaxY = 0 :: number

local ViewCulling = {}

-- ============================================================================
-- 1. CULLING FUNCTIONS - FRUSTUM & DOMINANT OCCLUDER
-- ============================================================================

--[=[
	Resolves the observer player's character Head BasePart.
	@param TargetPlayer Player? -- Target player instance (defaults to LocalPlayer).
	@return BasePart? -- Observer Head instance (or nil).
]=]
function ViewCulling.GetObserverHead(TargetPlayer: Player?): BasePart?
	const ResolvedPlayer = TargetPlayer or Players.LocalPlayer :: Player?
	if not ResolvedPlayer then
		return nil
	end

	const Character = ResolvedPlayer.Character :: Model?
	if not Character then
		return nil
	end

	const Head = Character:FindFirstChild("Head") :: Instance?
	if Head and Head:IsA("BasePart") then
		return Head
	end

	return nil
end

--[=[
	Pulls the frustum origin backward behind the camera based on Head-to-Camera distance.
	This naturally pads both the immediate surroundings and the frustum cone without trig.
	@param Head BasePart -- Observer Head instance providing base position and orientation.
]=]
function ViewCulling.UpdateDynamicView(Head: BasePart)
	const HeadPos = Head.Position :: Vector3
	local Origin = HeadPos
	local Right = Head.CFrame.RightVector :: Vector3
	local Up = Head.CFrame.UpVector :: Vector3
	local Look = Head.CFrame.LookVector :: Vector3
	local BackPadding = BASE_BACK_PADDING :: number

	if CameraStore then
		const CamTable = CameraStore.GetCameraTable()
		const CamCFrame = CamTable.CameraCFrame :: CFrame
		const CamPos = CamCFrame.Position :: Vector3

		Origin = CamPos
		Right = CamCFrame.RightVector
		Up = CamCFrame.UpVector
		Look = CamCFrame.LookVector
		BackPadding += (CamPos - HeadPos).Magnitude * PADDING_AMOUNT

		const FovScale = (CamTable.CameraFOV or 70) / 70 :: number
		ViewTanY = BASE_TAN_Y * FovScale
		ViewTanX = ViewTanY * ASPECT_RATIO
	end

	ViewOriginX = Origin.X - Look.X * BackPadding
	ViewOriginY = Origin.Y - Look.Y * BackPadding
	ViewOriginZ = Origin.Z - Look.Z * BackPadding

	ViewRightX, ViewRightY, ViewRightZ = Right.X, Right.Y, Right.Z
	ViewUpX, ViewUpY, ViewUpZ = Up.X, Up.Y, Up.Z
	ViewLookX, ViewLookY, ViewLookZ = Look.X, Look.Y, Look.Z

	HasOccluder = false
end

--[=[
	Evaluates whether an entity is outside the view frustum or occluded by a dominant occluder.
	@param EntityIndex number -- 1-based ECS entity index.
	@param Positions buffer -- Positions buffer.
	@param Sizes buffer -- Sizes buffer.
	@return boolean -- True if the entity is culled (not visible).
]=]
function ViewCulling.IsEntityCulled(EntityIndex: number, Positions: buffer, Sizes: buffer): boolean
	const Offset = (EntityIndex - 1) * COMPONENT_STRIDE :: number

	const RelX = buffer.readf32(Positions, Offset) - ViewOriginX :: number
	const RelY = buffer.readf32(Positions, Offset + 4) - ViewOriginY :: number
	const RelZ = buffer.readf32(Positions, Offset + 8) - ViewOriginZ :: number

	const SizeX = buffer.readf32(Sizes, Offset) :: number
	const SizeY = buffer.readf32(Sizes, Offset + 4) :: number
	const SizeZ = buffer.readf32(Sizes, Offset + 8) :: number

	const Radius = (SizeX + SizeY + SizeZ) * RADIUS_PADDING_FACTOR :: number
	const ForwardZ = RelX * ViewLookX + RelY * ViewLookY + RelZ * ViewLookZ :: number

	-- 1. Near / Far plane check
	if ForwardZ + Radius < NEAR_CLIP or ForwardZ - Radius > FAR_CLIP then
		return true
	end

	const LocalX = RelX * ViewRightX + RelY * ViewRightY + RelZ * ViewRightZ :: number
	const LocalY = RelX * ViewUpX + RelY * ViewUpY + RelZ * ViewUpZ :: number

	-- 2. Horizontal / Vertical frustum cone check
	if math.abs(LocalX) - Radius > ForwardZ * ViewTanX then
		return true
	end

	if math.abs(LocalY) - Radius > ForwardZ * ViewTanY then
		return true
	end

	-- 3. O(1) Occlusion check against cached foreground occluder
	const InvZ = 1 / math.max(NEAR_CLIP, ForwardZ) :: number
	const ProjRadius = Radius * InvZ :: number
	const ProjX = LocalX * InvZ :: number
	const ProjY = LocalY * InvZ :: number

	if
		HasOccluder
		and ForwardZ - Radius > OccFarZ
		and ProjX - ProjRadius >= OccMinX
		and ProjX + ProjRadius <= OccMaxX
		and ProjY - ProjRadius >= OccMinY
		and ProjY + ProjRadius <= OccMaxY
	then
		return true
	end

	-- Register large close entities as the foreground occluder for subsequent checks
	const InscribedRadius = math.min(SizeX, SizeY, SizeZ) * OCCLUDER_INSCRIBED_FACTOR * InvZ :: number
	if InscribedRadius > OCCLUDER_MIN_PROJ_RADIUS and (not HasOccluder or ForwardZ < OccFarZ) then
		HasOccluder = true
		OccFarZ = ForwardZ + Radius
		OccMinX = ProjX - InscribedRadius
		OccMaxX = ProjX + InscribedRadius
		OccMinY = ProjY - InscribedRadius
		OccMaxY = ProjY + InscribedRadius
	end

	return false
end

return ViewCulling
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">ECSStorage</string>
              <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const ECSMain = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ECSMain"))

return ECSMain.CreateStorage(false)
]]></string>
