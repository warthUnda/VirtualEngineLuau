          <Item class="ModuleScript" referent="151">
            <Properties>
              <string name="Name">ObjectStorage</string>
              <string name="Source"><![CDATA[--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage") :: ReplicatedStorage

-- Modules --
const ECSMain = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ECSMain"))

return ECSMain.CreateStorage(false)
