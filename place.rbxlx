        <Item class="Folder" referent="92">
          <Properties>
            <string name="Name">Movement</string>
          </Properties>
          <Item class="Folder" referent="93">
            <Properties>
              <string name="Name">Dash</string>
            </Properties>
          </Item>
          <Item class="Folder" referent="94">
            <Properties>
              <string name="Name">WallHop</string>
            </Properties>
            <Item class="LocalScript" referent="95">
              <Properties>
                <string name="Name">WallHopClient</string>
                <string name="Source"><![CDATA[--!strict

const UserInputService = game:GetService("UserInputService") -- Const exists in roblox
const CollectionService = game:GetService("CollectionService")
const Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local WallHopEvents =
	require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Movement"):WaitForChild("WallHopEvents"))
local Player = Players.LocalPlayer :: Player
local Jumped: boolean = false
local AllowedClimb: boolean = false

local CameraShakeModule = require(script.Parent.Parent.Parent.CameraShake)
local cameraShake = CameraShakeModule.new()

const function ClimbLoopVerification(Character: Model, RaycastParameters: RaycastParams): boolean?
	const HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart") :: BasePart

	local Interactions: number = 0
	const PreviousY: number = HumanoidRootPart.AssemblyLinearVelocity.Y

	task.delay(1, function()
		AllowedClimb = false
	end)

	while task.wait() do
		if AllowedClimb == false then
			return nil
		end

		const RayOrigin: Vector3 = HumanoidRootPart.Position
		const RayDirection: Vector3 = HumanoidRootPart.CFrame.LookVector * 3

		const RaycastResult: RaycastResult? = workspace:Raycast(RayOrigin, RayDirection, RaycastParameters)

		const SpeedY: number = HumanoidRootPart.AssemblyLinearVelocity.Y

		if SpeedY < 0 then
			Interactions += 1

			if Interactions >= 5 then
				return false
			end
		else
			Interactions = 0
		end

		if not RaycastResult then
			return true
		end
	end

	return AllowedClimb
end

UserInputService.InputBegan:Connect(function(Input: InputObject, GameProcessedEvent: boolean)
	if GameProcessedEvent then
		return
	end

	if Input.KeyCode == Enum.KeyCode.Space then
		if Jumped == true then
			return
		end

		Jumped = true
		AllowedClimb = false

		const Character = Player.Character :: Model

		const HumanoidRootPart = Character:FindFirstChild("HumanoidRootPart") :: BasePart

		const Velocity: Vector3 = HumanoidRootPart.AssemblyLinearVelocity
		if Velocity.Y < 0 then
			return
		end

		const RayOrigin: Vector3 = HumanoidRootPart.Position
		const RayDirection: Vector3 = HumanoidRootPart.CFrame.LookVector * 3

		const RaycastParamenters: RaycastParams = RaycastParams.new()
		RaycastParamenters.FilterDescendantsInstances = { Character }
		RaycastParamenters.FilterType = Enum.RaycastFilterType.Exclude

		const RaycastResult: RaycastResult? = workspace:Raycast(RayOrigin, RayDirection, RaycastParamenters)

		if RaycastResult and CollectionService:HasTag(RaycastResult.Instance, "ClimbAllowed") then
			AllowedClimb = true

			task.spawn(function()
				const Value: boolean? = ClimbLoopVerification(Character, RaycastParamenters)

				if Value == true then
					WallHopEvents.WallHop:FireServer(HumanoidRootPart.CFrame.LookVector)
					cameraShake:new()
					cameraShake:Start()
					cameraShake:Shake("Up", 3, 0.5, 0.5)
				end
			end)
		end
	end

	task.delay(2, function()
		Jumped = false
		AllowedClimb = false
	end)
end)
]]></string>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="Folder" referent="96">
          <Properties>
            <string name="Name">SpeedController</string>
          </Properties>
          <Item class="LocalScript" referent="97">
            <Properties>
              <string name="Name">SprintController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local SprintEvents =
	require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SpeedController"):WaitForChild("SprintEvents"))

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local ANIMATION_ID = "rbxassetid://113382990828300"

local NORMAL_FOV = 70
local SPRINT_FOV = 85
local FOV_TWEEN_INFO = TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

local loadedAnimationTrack = nil

local isSprinting = false
local serverForcedStop = false

local function setFOV(targetFOV)
	local tween = TweenService:Create(camera, FOV_TWEEN_INFO, { FieldOfView = targetFOV })
	tween:Play()
end

local function updateAnimation(moving)
	if not loadedAnimationTrack then
		return
	end

	if isSprinting and moving then
		if not loadedAnimationTrack.IsPlaying then
			loadedAnimationTrack:Play(0.2)
		end
	else
		if loadedAnimationTrack.IsPlaying then
			loadedAnimationTrack:Stop(0.2)
		end
	end
end

local function toggleSprint(state)
	if isSprinting == state then
		return
	end
	isSprinting = state

	SprintEvents.SprintToggle:FireServer(isSprinting)

	if isSprinting then
		setFOV(SPRINT_FOV)
	else
		setFOV(NORMAL_FOV)
	end
end

local function setupCharacter(character)
	local humanoid = character:WaitForChild("Humanoid")
	local animator = humanoid:WaitForChild("Animator")
	local animation = Instance.new("Animation")
	animation.AnimationId = ANIMATION_ID
	loadedAnimationTrack = animator:LoadAnimation(animation)
	loadedAnimationTrack.Priority = Enum.AnimationPriority.Action2

	humanoid.Running:Connect(function(speed)
		updateAnimation(speed > 0.5)
	end)
end

if player.Character then
	setupCharacter(player.Character)
end
player.CharacterAdded:Connect(setupCharacter)

UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
	if gameProcessedEvent then
		return
	end

	if input.KeyCode == Enum.KeyCode.LeftShift then
		serverForcedStop = false
		toggleSprint(true)
	end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessedEvent)
	if input.KeyCode == Enum.KeyCode.LeftShift then
		toggleSprint(false)
	end
end)

SprintEvents.SprintToggle.OnClientEvent:Connect(function(forceStop)
	if forceStop == false then
		serverForcedStop = true
		toggleSprint(false)
	end
end)
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="98">
          <Properties>
            <string name="Name">Thermal</string>
          </Properties>
          <Item class="LocalScript" referent="99">
            <Properties>
              <string name="Name">ThermalClient</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ThermalEvents = require(ReplicatedStorage.Shared.Thermal.ThermalEvents)

local ThermalClient = {}

local isExposed = false
local exposureIntensity = 0

-- Create a screen overlay for thermal effect
local screenGui: ScreenGui
local overlayFrame: Frame

local function createOverlay()
	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "ThermalOverlay"
	screenGui.IgnoreGuiInset = true

	overlayFrame = Instance.new("Frame")
	overlayFrame.Name = "ExposureOverlay"
	overlayFrame.Size = UDim2.fromScale(1, 1)
	overlayFrame.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
	overlayFrame.BackgroundTransparency = 1
	overlayFrame.BorderSizePixel = 0
	overlayFrame.Parent = screenGui

	screenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
end

function ThermalClient.Init()
	createOverlay()

	ThermalEvents.ThermalExposure.OnClientEvent:Connect(function(exposed: boolean)
		isExposed = exposed
	end)

	-- Smoothly animate the overlay transparency
	RunService.RenderStepped:Connect(function(dt)
		local target = if isExposed then 0.85 else 1
		exposureIntensity = exposureIntensity + (target - exposureIntensity) * math.min(1, dt * 5)
		overlayFrame.BackgroundTransparency = exposureIntensity
	end)
end

return ThermalClient
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="100">
          <Properties>
            <string name="Name">TimeStop</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local timeStopEvent = ReplicatedStorage:WaitForChild("TimeStop")

-- Create or find the ColorCorrectionEffect for desaturation
local colorCorrection = Lighting:FindFirstChild("TimeStopDesaturation")
if not colorCorrection then
	colorCorrection = Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "TimeStopDesaturation"
	colorCorrection.Parent = Lighting
end

-- Default state
colorCorrection.Saturation = 0

local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

timeStopEvent.OnClientEvent:Connect(function(isTimeStopped, initiator)
	if isTimeStopped then
		-- Tween saturation to -1 (fully desaturated)
		local tween = TweenService:Create(colorCorrection, tweenInfo, { Saturation = -1 })
		tween:Play()
	else
		-- Tween saturation back to normal
		local tween = TweenService:Create(colorCorrection, tweenInfo, { Saturation = 0 })
		tween:Play()
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
