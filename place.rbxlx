        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">CombatEvents</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local combatEventsFolder
if RunService:IsServer() then
	combatEventsFolder = ReplicatedStorage:FindFirstChild("CombatEvents")
	if not combatEventsFolder then
		combatEventsFolder = Instance.new("Folder")
		combatEventsFolder.Name = "CombatEvents"
		combatEventsFolder.Parent = ReplicatedStorage
	end

	-- Ensure both RemoteEvents exist (folder may already exist from a prior session)
	if not combatEventsFolder:FindFirstChild("AttackHit") then
		local attackHit = Instance.new("RemoteEvent")
		attackHit.Name = "AttackHit"
		attackHit.Parent = combatEventsFolder
	end

	if not combatEventsFolder:FindFirstChild("BlockToggle") then
		local blockToggle = Instance.new("RemoteEvent")
		blockToggle.Name = "BlockToggle"
		blockToggle.Parent = combatEventsFolder
	end
else
	combatEventsFolder = ReplicatedStorage:WaitForChild("CombatEvents")
end

local CombatEvents = {
	AttackHit = combatEventsFolder:WaitForChild("AttackHit"),
	BlockToggle = combatEventsFolder:WaitForChild("BlockToggle"),
}

return CombatEvents
]]></string>
          </Properties>
