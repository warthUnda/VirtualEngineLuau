        <Item class="LocalScript" referent="71">
          <Properties>
            <string name="Name">Executer</string>
            <string name="Source"><![CDATA[-- Executer.client.luau
-- Scans the local player's BackPack model for ContainerPart instances
-- and applies animated water effect (blue) when opened, static red when closed.
-- Now scoped to only the local player's backpack instead of the entire game.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local SCAN_INTERVAL = 1

-- Active water effects tracked by surfaceGui reference -> connection
local activeEffects = {} -- { [SurfaceGui] = RenderStepped connection }
local lastOpenedState = {} -- { [SurfaceGui] = boolean } -- tracks to avoid re-applying every scan

-- Find the backpack model that contains this ContainerPart
local function findBackpack(containerPart: BasePart): Model?
	local current = containerPart.Parent
	while current do
		if current:IsA("Model") and (current.Name == "Backpack" or current.Name == "BackPack") then
			return current
		end
		current = current.Parent
	end
	return nil
end

-- Find BottomPart inside a backpack model (searches direct children + descendants)
local function findBottomPart(backpack: Model): BasePart?
	for _, child in backpack:GetChildren() do
		if child:IsA("BasePart") and child.Name == "BottomPart" then
			return child
		end
	end
	for _, descendant in backpack:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name == "BottomPart" then
			return descendant
		end
	end
	return nil
end

-- Check if the backpack is opened
local function isBackpackOpened(containerPart: BasePart): boolean
	local backpack = findBackpack(containerPart)
	if not backpack then
		warn("[Executer] No Backpack model found for ContainerPart:", containerPart:GetFullName())
		return false
	end

	local bottomPart = findBottomPart(backpack)
	if not bottomPart then
		warn("[Executer] No BottomPart found inside backpack:", backpack:GetFullName())
		return false
	end

	local opened = bottomPart:GetAttribute("Opened")
	return opened == true
end

-- Stop and remove any active water effect on this SurfaceGui
local function clearWaterEffect(surfaceGui: SurfaceGui)
	local conn = activeEffects[surfaceGui]
	if conn then
		conn:Disconnect()
		activeEffects[surfaceGui] = nil
	end

	local waterOverlay = surfaceGui:FindFirstChild("WaterOverlay")
	if waterOverlay then
		waterOverlay:Destroy()
	end
end

-- Apply smooth animated water effect using RenderStepped
local function applyWaterEffect(surfaceGui: SurfaceGui, isOpened: boolean)
	if lastOpenedState[surfaceGui] == isOpened then
		return
	end
	lastOpenedState[surfaceGui] = isOpened

	clearWaterEffect(surfaceGui)

	local staticFrame = surfaceGui:FindFirstChild("Frame")
	if not staticFrame then
		warn("[Executer] No Frame found inside SurfaceGui")
		return
	end

	if isOpened then
		staticFrame.BackgroundTransparency = 0.4
		staticFrame.BackgroundColor3 = Color3.fromRGB(15, 70, 160)

		local glowFrame = Instance.new("Frame")
		glowFrame.Name = "WaterOverlay"
		glowFrame.Size = UDim2.new(1, 0, 1, 0)
		glowFrame.BackgroundColor3 = Color3.fromRGB(80, 180, 255)
		glowFrame.BorderSizePixel = 0
		glowFrame.Parent = surfaceGui

		local gradient = Instance.new("UIGradient")
		gradient.Name = "WaterGradient"
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 100, 200)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(60, 200, 255)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(30, 160, 240)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 100, 200)),
		})
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(0.5, 0.0),
			NumberSequenceKeypoint.new(1, 0.6),
		})
		gradient.Parent = glowFrame

		local startTime = os.clock()
		local conn = RunService.RenderStepped:Connect(function(_dt)
			if not glowFrame:IsDescendantOf(surfaceGui) then
				local c = activeEffects[surfaceGui]
				if c then
					c:Disconnect()
					activeEffects[surfaceGui] = nil
				end
				return
			end

			local elapsed = os.clock() - startTime

			local offset = (elapsed * 0.4) % 1
			gradient.Offset = Vector2.new(0, offset)

			gradient.Rotation = (elapsed * 30) % 360

			local glowAlpha = 0.3 + math.sin(elapsed * 2.5) * 0.2
			glowFrame.BackgroundTransparency = glowAlpha
		end)

		activeEffects[surfaceGui] = conn
	else
		staticFrame.BackgroundTransparency = 0.5
		staticFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
	end
end

-- Apply SurfaceGui to a single ContainerPart
local function applySurfaceGui(part: BasePart)
	local existingGui = part:FindFirstChild("SurfaceGui")

	if existingGui then
		local isOpened = isBackpackOpened(part)
		applyWaterEffect(existingGui, isOpened)
		return
	end

	local surfaceGui = Instance.new("SurfaceGui")
	surfaceGui.Name = "SurfaceGui"
	surfaceGui.Adornee = part
	surfaceGui.Face = Enum.NormalId.Front
	surfaceGui.AlwaysOnTop = true
	surfaceGui.CanvasSize = Vector2.new(200, 200)
	surfaceGui.Parent = part

	local frame = Instance.new("Frame")
	frame.Name = "Frame"
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.Parent = surfaceGui

	local isOpened = isBackpackOpened(part)
	applyWaterEffect(surfaceGui, isOpened)
end

-- Find the local player's backpack in Workspace
local function findLocalBackpack(): Model?
	for _, child in Workspace:GetChildren() do
		if child:IsA("Model") and child.Name == "BackPack" then
			return child
		end
	end
	return nil
end

-- Scan ONLY the local player's backpack for ContainerParts and apply SurfaceGuis
local function scanAndApply()
	local backpack = findLocalBackpack()
	if not backpack then
		return
	end

	for _, descendant in backpack:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name == "ContainerPart" then
			applySurfaceGui(descendant)
		end
	end
end

-- Persistent loop: scan the local backpack every second
while true do
	scanAndApply()
	task.wait(SCAN_INTERVAL)
end
]]></string>
