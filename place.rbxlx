              <string name="Name">ClientTestRunner</string>
              <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const Players = game:GetService("Players")

-- Static References --
const LocalPlayer = Players.LocalPlayer :: Player
const PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts")
const TestsFolder = PlayerScripts:WaitForChild("Client"):WaitForChild("Tests")
const SpecsFolder = TestsFolder:WaitForChild("Specs")

-- Modules --
const TestHarness = require(script.Parent:WaitForChild("TestHarness"))

-- ============================================================================
-- 1. CLIENT MASTER TEST SUITE RUNNER
-- ============================================================================

task.spawn(function()
	task.wait(1.5) -- Allow client setup and controller actors to initialize

	print("\n========================================================")
	print("       ANTIGRAVITY CLIENT TEST SUITE RUNNER             ")
	print("========================================================\n")

	local TotalPassed = 0 :: number
	local TotalFailed = 0 :: number
	const OverallStartTime = os.clock()

	const SpecInstances = SpecsFolder:GetChildren() :: { Instance }
	table.sort(SpecInstances, function(A, B)
		return A.Name < B.Name
	end)

	for _, ChildInstance in ipairs(SpecInstances) do
		if ChildInstance:IsA("ModuleScript") and ChildInstance.Name:match("%.spec$") then
			const SuiteName = ChildInstance.Name:gsub("%.spec$", "")
			const Passed, Failed = TestHarness.RunSpec(SuiteName, ChildInstance)
			TotalPassed += Passed
			TotalFailed += Failed
		end
	end

	const TotalDurationMs = (os.clock() - OverallStartTime) * 1000

	print("\n========================================================")
	print(string.format(" [Client] TOTAL SUITES RUN: %d", #SpecInstances))
	print(string.format(" [Client] PASSED TESTS:    %d", TotalPassed))
	print(string.format(" [Client] FAILED TESTS:    %d", TotalFailed))
	print(string.format(" [Client] TIME ELAPSED:    %.2f ms", TotalDurationMs))
	print("========================================================\n")

	if TotalFailed > 0 then
		warn(string.format("[ClientTestRunner] %d test(s) failed in client suite!", TotalFailed))
	else
		print("[ClientTestRunner] All client test suites completed successfully!")
	end
end)
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="199">
            <Properties>
              <string name="Name">Specs</string>
            </Properties>
            <Item class="ModuleScript" referent="200">
              <Properties>
                <string name="Name">Camera.spec</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

return function()
	const SpecEnv = getfenv() :: {
		describe: (string, () -> ()) -> (),
		it: (string, () -> ()) -> (),
		expect: (any) -> any,
	}
	const describe = SpecEnv.describe
	const it = SpecEnv.it
	const expect = SpecEnv.expect

	const ReplicatedStorage = game:GetService("ReplicatedStorage")
	const SharedFolder = ReplicatedStorage:WaitForChild("Shared")

	const CameraHelper = require(
		SharedFolder:WaitForChild("Utilities")
			:WaitForChild("Render")
			:WaitForChild("Camera")
			:WaitForChild("CameraHelper")
	)
	const CameraStore = require(
		SharedFolder:WaitForChild("Utilities")
			:WaitForChild("Render")
			:WaitForChild("Camera")
			:WaitForChild("CameraStore")
	)

	describe("1. Camera Basis Matrix & Orthonormal CFrame Math", function()
		it("should produce identity rotation for standard forward (-Z) view", function()
			const Look = Vector3.new(0, 0, -1)
			const Up = Vector3.new(0, 1, 0)
			const Right = Vector3.new(1, 0, 0)

			const RotCF = CameraHelper.VectorsToRotation(Look, Up, Right)
			expect((RotCF.Position - Vector3.zero).Magnitude).to.be.near(0, 1e-4)
			expect((RotCF.LookVector - Look).Magnitude).to.be.near(0, 1e-4)
			expect((RotCF.UpVector - Up).Magnitude).to.be.near(0, 1e-4)
			expect((RotCF.RightVector - Right).Magnitude).to.be.near(0, 1e-4)
		end)

		it("should produce an orthogonal CFrame under 90-degree yaw rotation", function()
			const Look = Vector3.new(1, 0, 0) -- Looking along +X
			const Up = Vector3.new(0, 1, 0)
			const Right = Vector3.new(0, 0, -1)

			const RotCF = CameraHelper.VectorsToRotation(Look, Up, Right)
			expect((RotCF.LookVector - Look).Magnitude).to.be.near(0, 1e-4)
			expect((RotCF.UpVector - Up).Magnitude).to.be.near(0, 1e-4)
			expect((RotCF.RightVector - Right).Magnitude).to.be.near(0, 1e-4)
		end)
	end)

	describe("2. Camera Store State & Orientation Accessors", function()
		it("should expose valid camera state dictionary and non-zero basis directions", function()
			const StateTable = CameraStore.GetCameraTable()
			expect(StateTable ~= nil).to.equal(true)
			expect(StateTable.CameraFOV > 0).to.equal(true)

			const CamPos = CameraStore.GetCameraPosition()
			expect(typeof(CamPos)).to.equal("Vector3")

			const Look = CameraStore.GetCameraLook()
			const Right = CameraStore.GetCameraRight()
			const Up = CameraStore.GetCameraUp()

			expect(Look.Magnitude > 0.9).to.equal(true)
			expect(Right.Magnitude > 0.9).to.equal(true)
			expect(Up.Magnitude > 0.9).to.equal(true)
		end)
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="201">
              <Properties>
                <string name="Name">Cleaner.spec</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

return function()
	const SpecEnv = getfenv() :: {
		describe: (string, () -> ()) -> (),
		it: (string, () -> ()) -> (),
		expect: (any) -> any,
	}
	const describe = SpecEnv.describe
	const it = SpecEnv.it
	const expect = SpecEnv.expect

	const ReplicatedStorage = game:GetService("ReplicatedStorage")
	const SharedFolder = ReplicatedStorage:WaitForChild("Shared")

	const ECSMain = require(SharedFolder:WaitForChild("ECSMain"))
	const CleanerHelper = require(
		SharedFolder:WaitForChild("Utilities")
			:WaitForChild("Render")
			:WaitForChild("Scene")
			:WaitForChild("CleanerHelper")
	)

	describe("1. Client Scene Cleaner & Slot Compaction", function()
		it("should remove entities from render storage and update bidirectional slot maps", function()
			const RenderStorage = ECSMain.CreateStorage(false)
			const RenderECSData = RenderStorage.ECSData
			const RenderCounts = RenderECSData.ECSDataTable

			-- Register 3 render slots
			const Slot1 = RenderECSData.RegisterEntity()
			const Slot2 = RenderECSData.RegisterEntity()
			const Slot3 = RenderECSData.RegisterEntity()

			expect(RenderCounts.EntityECSCount).to.equal(3)

			-- Set up bidirectional lookup buffers for 10 entities
			const RenderSlotByObjectId = buffer.create((10 + 1) * 4)
			const ObjectIdByRenderSlot = buffer.create((10 + 1) * 4)

			-- Map Server ObjectId 101 -> Slot 1, 102 -> Slot 2, 103 -> Slot 3
			buffer.writeu32(RenderSlotByObjectId, 1 * 4, Slot1)
			buffer.writeu32(ObjectIdByRenderSlot, Slot1 * 4, 1)

			buffer.writeu32(RenderSlotByObjectId, 2 * 4, Slot2)
			buffer.writeu32(ObjectIdByRenderSlot, Slot2 * 4, 2)

			buffer.writeu32(RenderSlotByObjectId, 3 * 4, Slot3)
			buffer.writeu32(ObjectIdByRenderSlot, Slot3 * 4, 3)

			-- Despawn entity 1 (currently in Slot 1)
			CleanerHelper.RemoveRenderEntity(
				RenderECSData,
				RenderCounts,
				RenderSlotByObjectId,
				ObjectIdByRenderSlot,
				1,
				Slot1
			)

			-- Total render count must now be 2
			expect(RenderCounts.EntityECSCount).to.equal(2)

			-- Slot 1 should now be occupied by former entity 3
			expect(buffer.readu32(ObjectIdByRenderSlot, Slot1 * 4)).to.equal(3)
			expect(buffer.readu32(RenderSlotByObjectId, 3 * 4)).to.equal(Slot1)

			-- Despawned entity 1 and vacated slot 3 must be zeroed
			expect(buffer.readu32(RenderSlotByObjectId, 1 * 4)).to.equal(0)
			expect(buffer.readu32(ObjectIdByRenderSlot, Slot3 * 4)).to.equal(0)
		end)
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="202">
              <Properties>
                <string name="Name">ClientInput.spec</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

return function()
	const SpecEnv = getfenv() :: {
		describe: (string, () -> ()) -> (),
		it: (string, () -> ()) -> (),
		expect: (any) -> any,
	}
	const describe = SpecEnv.describe
	const it = SpecEnv.it
	const expect = SpecEnv.expect

	const ReplicatedStorage = game:GetService("ReplicatedStorage")
	const SharedFolder = ReplicatedStorage:WaitForChild("Shared")

	const SystemsConfigs = require(SharedFolder:WaitForChild("SystemsConfigs"))
	const PhysicsControllerHelper = require(
		SharedFolder:WaitForChild("Utilities")
			:WaitForChild("Physics")
			:WaitForChild("Controller")
			:WaitForChild("PhysicsControllerHelper")
	)

	const MAX_WISH_SCALE = SystemsConfigs.PlayerMaxWishScale :: number

	describe("1. Player Input Vector Normalization & Wish Clamping", function()
		it("should normalize raw diagonal keyboard input and clamp wish scale", function()
			-- Diagonal key press (W + D): raw wish (1, -1)
			const UnitX, UnitZ, Scale, Jump = PhysicsControllerHelper.FlushPlayerIntent(1, -1, 1.5, true)

			const Length = math.sqrt(UnitX * UnitX + UnitZ * UnitZ)
			expect(Length).to.be.near(1.0, 1e-4)
			expect(Scale <= MAX_WISH_SCALE).to.equal(true)
			expect(Jump).to.equal(true)
		end)

		it("should handle zero input gracefully without NaNs", function()
			const UnitX, UnitZ, Scale, Jump = PhysicsControllerHelper.FlushPlayerIntent(0, 0, 0, false)

			expect(UnitX).to.equal(0)
			expect(UnitZ).to.equal(0)
			expect(Scale).to.equal(0)
			expect(Jump).to.equal(false)
		end)
	end)
end
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="203">
              <Properties>
                <string name="Name">ReplicationReceiver.spec</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

return function()
	const SpecEnv = getfenv() :: {
		describe: (string, () -> ()) -> (),
		it: (string, () -> ()) -> (),
		expect: (any) -> any,
	}
	const describe = SpecEnv.describe
	const it = SpecEnv.it
	const expect = SpecEnv.expect

	const ReplicatedStorage = game:GetService("ReplicatedStorage")
	const SharedFolder = ReplicatedStorage:WaitForChild("Shared")

	const SystemsConfigs = require(SharedFolder:WaitForChild("SystemsConfigs"))
	const ECSMain = require(SharedFolder:WaitForChild("ECSMain"))

	const COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number
	const DIRECTION_STRIDE = SystemsConfigs.ECSDirectionStride :: number

	describe("1. Client Replication Delta Ingestion", function()
		it("should unpack server delta buffers and map server IDs to persistent local client slots", function()
			const ClientStorage = ECSMain.CreateStorage(false)
			const ECSData = ClientStorage.ECSData
			const LocalPositionBuffer = ClientStorage.PositionData.GetData()
			const LocalVisualBuffer = ClientStorage.VisualData.GetData()

			const ClientSlotByServerId = buffer.create((100 + 1) * 4)

			-- Create a synthetic replication batch for 2 server entities (ServerId = 10 and 20)
			const DeltaPositions = buffer.create(COMPONENT_STRIDE * 2)
			const _DeltaOrientations = buffer.create(COMPONENT_STRIDE * 2)
			const DeltaVisuals = buffer.create(COMPONENT_STRIDE * 2)
			const _DeltaSizes = buffer.create(COMPONENT_STRIDE * 2)
			const _DeltaDirections = buffer.create(DIRECTION_STRIDE * 2)

			-- Entity 1: ServerId = 10, Pos = (15, 25, 35)
			buffer.writef32(DeltaPositions, 0, 15)
			buffer.writef32(DeltaPositions, 4, 25)
			buffer.writef32(DeltaPositions, 8, 35)
			buffer.writeu32(DeltaVisuals, 4, 10) -- Embedded ServerId = 10

			-- Entity 2: ServerId = 20, Pos = (50, 60, 70)
			buffer.writef32(DeltaPositions, COMPONENT_STRIDE, 50)
			buffer.writef32(DeltaPositions, COMPONENT_STRIDE + 4, 60)
			buffer.writef32(DeltaPositions, COMPONENT_STRIDE + 8, 70)
			buffer.writeu32(DeltaVisuals, COMPONENT_STRIDE + 4, 20) -- Embedded ServerId = 20

			-- Ingest batch 1 (simulating ReplicationReceiver logic)
			local LocalCount = ECSData.GetCounts().EntityECSCount
			for i = 1, 2 do
				const ReadOffset = (i - 1) * COMPONENT_STRIDE
				const ServerId = buffer.readu32(DeltaVisuals, ReadOffset + 4)
				local TargetSlot = buffer.readu32(ClientSlotByServerId, ServerId * 4)

				if TargetSlot == 0 then
					LocalCount = ECSData.RegisterEntity()
					TargetSlot = LocalCount
					buffer.writeu32(ClientSlotByServerId, ServerId * 4, TargetSlot)
				end

				const WriteOffset = (TargetSlot - 1) * COMPONENT_STRIDE
				buffer.copy(LocalPositionBuffer, WriteOffset, DeltaPositions, ReadOffset, COMPONENT_STRIDE)
				buffer.copy(LocalVisualBuffer, WriteOffset, DeltaVisuals, ReadOffset, COMPONENT_STRIDE)
			end

			expect(LocalCount).to.equal(2)
			expect(buffer.readu32(ClientSlotByServerId, 10 * 4)).to.equal(1)
			expect(buffer.readu32(ClientSlotByServerId, 20 * 4)).to.equal(2)
			expect(buffer.readf32(LocalPositionBuffer, 0)).to.equal(15)
			expect(buffer.readf32(LocalPositionBuffer, COMPONENT_STRIDE)).to.equal(50)

			-- Now ingest batch 2: updating ServerId 10 with new position (99, 99, 99)
			buffer.writef32(DeltaPositions, 0, 99)
			buffer.writef32(DeltaPositions, 4, 99)
			buffer.writef32(DeltaPositions, 8, 99)

			const ReadOffset = 0
			const ServerId = buffer.readu32(DeltaVisuals, ReadOffset + 4)
			const ExistingSlot = buffer.readu32(ClientSlotByServerId, ServerId * 4)

			expect(ExistingSlot).to.equal(1) -- Must reuse existing slot 1!

			const WriteOffset = (ExistingSlot - 1) * COMPONENT_STRIDE
			buffer.copy(LocalPositionBuffer, WriteOffset, DeltaPositions, ReadOffset, COMPONENT_STRIDE)

			-- Entity count must still be 2, and slot 1 position must be updated
			expect(ECSData.GetCounts().EntityECSCount).to.equal(2)
			expect(buffer.readf32(LocalPositionBuffer, 0)).to.equal(99)
		end)
	end)
end
]]></string>
              </Properties>
