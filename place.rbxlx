            <string name="Name">SprintEvents</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local sprintEventsFolder
if RunService:IsServer() then
	sprintEventsFolder = ReplicatedStorage:FindFirstChild("SprintEvents")
	if not sprintEventsFolder then
		sprintEventsFolder = Instance.new("Folder")
		sprintEventsFolder.Name = "SprintEvents"
		sprintEventsFolder.Parent = ReplicatedStorage
	end

	if not sprintEventsFolder:FindFirstChild("SprintToggle") then
		local sprintToggle = Instance.new("RemoteEvent")
		sprintToggle.Name = "SprintToggle"
		sprintToggle.Parent = sprintEventsFolder
	end

	if not sprintEventsFolder:FindFirstChild("StaminaUpdate") then
		local staminaUpdate = Instance.new("RemoteEvent")
		staminaUpdate.Name = "StaminaUpdate"
		staminaUpdate.Parent = sprintEventsFolder
	end
else
	sprintEventsFolder = ReplicatedStorage:WaitForChild("SprintEvents")
end

local SprintEvents = {
	SprintToggle = sprintEventsFolder:WaitForChild("SprintToggle"),
	StaminaUpdate = sprintEventsFolder:WaitForChild("StaminaUpdate"),
}

return SprintEvents
]]></string>
