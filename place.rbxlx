    <Item class="Folder" referent="117">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="118">
        <Properties>
          <string name="Name">DynamicObjectsMain</string>
          <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))
const ECSMain = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ECSMain"))

-- Configs --
const MAX_DYNAMIC_OBJECTS = SystemsConfigs.DynamicObjectsMaxCount :: number
const PROPERTIES_STRIDE = SystemsConfigs.ECSPropertiesStride :: number

export type DynamicListCounts = {
	ActiveCount: number,
	NextId: number,
}

local DynamicObjectsMain = {}

-- ============================================================================
-- 1. DYNAMIC OOP / OBJECTS LIST OPERATIONS
-- ============================================================================

--[=[
	Registers an OOP dynamic object instance and optionally binds it to an ECS entity ID.
	@param ObjectsTable { [number]: any } -- Hash map storing active dynamic objects by ID.
	@param FreeIds { number } -- Stack of recycled dynamic IDs.
	@param Counts DynamicListCounts -- State tracking active and high-water IDs.
	@param EntityIdByDynamicId buffer -- Mapping buffer from DynamicId to EntityId.
	@param ObjectInstance any -- OOP object reference or user data.
	@param EntityId number? -- Optional ECS entity ID to link.
	@param PropertiesBuffer buffer? -- Optional properties buffer to stamp with dynamic ID.
	@return number -- Allocated dynamic ID (or 0 if capacity exceeded).
]=]
function DynamicObjectsMain.AddObject(
	ObjectsTable: { [number]: any },
	FreeIds: { number },
	Counts: DynamicListCounts,
	EntityIdByDynamicId: buffer,
	ObjectInstance: any,
	EntityId: number?,
	PropertiesBuffer: buffer?
): number
	local DynamicId = 0 :: number
	const FreeCount = (#FreeIds) :: number

	if FreeCount > 0 then
		DynamicId = FreeIds[FreeCount]
		FreeIds[FreeCount] = nil
	else
		const CandidateId = Counts.NextId + 1 :: number
		if CandidateId > MAX_DYNAMIC_OBJECTS then
			return 0
		end
		Counts.NextId = CandidateId
		DynamicId = CandidateId
	end

	ObjectsTable[DynamicId] = ObjectInstance
	Counts.ActiveCount += 1

	if EntityId and EntityId > 0 then
		buffer.writeu32(EntityIdByDynamicId, DynamicId * 4, EntityId)
		if PropertiesBuffer then
			ECSMain.SetEntityDynamicId(PropertiesBuffer, EntityId, DynamicId)
		end
	end

	return DynamicId
end

--[=[
	Retrieves an OOP object instance by its allocated dynamic ID.
	@param ObjectsTable { [number]: any } -- Dynamic objects hash map.
	@param DynamicId number -- Target dynamic object ID.
	@return any -- Stored OOP object (or nil).
]=]
function DynamicObjectsMain.GetObject(ObjectsTable: { [number]: any }, DynamicId: number): any
	if DynamicId <= 0 or DynamicId > MAX_DYNAMIC_OBJECTS then
		return nil
	end

	return ObjectsTable[DynamicId]
end

--[=[
	Retrieves an OOP object instance directly from an entity's 32-bit property register.
	@param ObjectsTable { [number]: any } -- Dynamic objects hash map.
	@param Register number -- 32-bit property register containing packed dynamic ID.
	@return any -- Stored OOP object (or nil).
]=]
function DynamicObjectsMain.GetObjectFromRegister(ObjectsTable: { [number]: any }, Register: number): any
	const DynamicId = ECSMain.GetEntityDynamicId(Register) :: number
	if DynamicId <= 0 then
		return nil
	end

	return ObjectsTable[DynamicId]
end

--[=[
	Retrieves an OOP object instance bound to an ECS entity ID.
	@param ObjectsTable { [number]: any } -- Dynamic objects hash map.
	@param PropertiesBuffer buffer -- Entity properties buffer.
	@param EntityId number -- Target ECS entity ID.
	@return any -- Stored OOP object (or nil).
]=]
function DynamicObjectsMain.GetObjectByEntityId(
	ObjectsTable: { [number]: any },
	PropertiesBuffer: buffer,
	EntityId: number
): any
	if EntityId < 1 then
		return nil
	end

	const Register = buffer.readu32(PropertiesBuffer, (EntityId - 1) * PROPERTIES_STRIDE) :: number
	const DynamicId = ECSMain.GetEntityDynamicId(Register) :: number
	if DynamicId <= 0 then
		return nil
	end

	return ObjectsTable[DynamicId]
end

--[=[
	Binds a dynamic OOP object to an ECS entity ID bi-directionally.
	@param EntityIdByDynamicId buffer -- Mapping buffer from DynamicId to EntityId.
	@param PropertiesBuffer buffer -- Properties buffer storing entity flags and dynamic ID.
	@param DynamicId number -- Target dynamic ID.
	@param EntityId number -- Target ECS entity ID.
]=]
function DynamicObjectsMain.BindEntity(
	EntityIdByDynamicId: buffer,
	PropertiesBuffer: buffer,
	DynamicId: number,
	EntityId: number
)
	if DynamicId <= 0 or DynamicId > MAX_DYNAMIC_OBJECTS or EntityId < 1 then
		return
	end

	buffer.writeu32(EntityIdByDynamicId, DynamicId * 4, EntityId)
	ECSMain.SetEntityDynamicId(PropertiesBuffer, EntityId, DynamicId)
end

--[=[
	Returns the ECS entity ID bound to a dynamic OOP object.
	@param EntityIdByDynamicId buffer -- Mapping buffer from DynamicId to EntityId.
	@param DynamicId number -- Target dynamic ID.
	@return number -- Bound ECS entity ID (or 0 if unbound).
]=]
function DynamicObjectsMain.GetBoundEntityId(EntityIdByDynamicId: buffer, DynamicId: number): number
	if DynamicId <= 0 or DynamicId > MAX_DYNAMIC_OBJECTS then
		return 0
	end

	return buffer.readu32(EntityIdByDynamicId, DynamicId * 4)
end

--[=[
	Unregisters an OOP dynamic object and unlinks its bound entity ID.
	@param ObjectsTable { [number]: any } -- Dynamic objects hash map.
	@param FreeIds { number } -- Recycled dynamic ID stack.
	@param Counts DynamicListCounts -- State tracking active count.
	@param EntityIdByDynamicId buffer -- Mapping buffer from DynamicId to EntityId.
	@param DynamicId number -- Dynamic ID to remove.
	@param PropertiesBuffer buffer? -- Optional properties buffer to clear dynamic ID from entity.
]=]
function DynamicObjectsMain.RemoveObject(
	ObjectsTable: { [number]: any },
	FreeIds: { number },
	Counts: DynamicListCounts,
	EntityIdByDynamicId: buffer,
	DynamicId: number,
	PropertiesBuffer: buffer?
)
	if DynamicId <= 0 or DynamicId > MAX_DYNAMIC_OBJECTS then
		return
	end

	if ObjectsTable[DynamicId] == nil then
		return
	end

	const BoundEntityId = buffer.readu32(EntityIdByDynamicId, DynamicId * 4) :: number
	if BoundEntityId > 0 then
		buffer.writeu32(EntityIdByDynamicId, DynamicId * 4, 0)
		if PropertiesBuffer then
			ECSMain.SetEntityDynamicId(PropertiesBuffer, BoundEntityId, 0)
		end
	end

	ObjectsTable[DynamicId] = nil
	Counts.ActiveCount = math.max(0, Counts.ActiveCount - 1)
	table.insert(FreeIds, DynamicId)
end

return DynamicObjectsMain
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="119">
        <Properties>
          <string name="Name">ECSMain</string>
          <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))

-- Configs --
const COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number
const DIRECTION_STRIDE = SystemsConfigs.ECSDirectionStride :: number
const PROPERTIES_STRIDE = SystemsConfigs.ECSPropertiesStride :: number
const COMPONENT_BUFFER_SIZE = SystemsConfigs.ECSComponentBufferSize :: number
const DIRECTION_BUFFER_SIZE = SystemsConfigs.ECSDirectionBufferSize :: number
const PROPERTIES_BUFFER_SIZE = SystemsConfigs.ECSPropertiesBufferSize :: number
const MAX_ENTITIES = SystemsConfigs.ECSMaxEntities :: number
const MAX_DYNAMIC_ID = SystemsConfigs.DynamicObjectsMaxCount :: number

const FLAG_CAN_COLLIDE = bit32.lshift(1, 1) :: number
const FLAG_IS_VISIBLE = bit32.lshift(1, 2) :: number
const FLAG_ANCHORED = bit32.lshift(1, 3) :: number
const FLAG_HAS_DYNAMIC_ID = bit32.lshift(1, 4) :: number
const TEXTURE_ID_SHIFT = 5 :: number
const MAX_TEXTURE_ID = 255 :: number
const TEXTURE_ID_MASK = bit32.lshift(MAX_TEXTURE_ID, TEXTURE_ID_SHIFT) :: number
const DYNAMIC_ID_SHIFT = 20 :: number
const LOWER_FLAGS_MASK = 0x000FFFFF :: number

export type ECSTable = {
	OrientationECSCount: number,
	PositionECSCount: number,
	VisualECSCount: number,
	SizeECSCount: number,
	DirectionsECSCount: number,
	PropertiesECSCount: number?,
	EntityECSCount: number,
}

export type DynamicListCounts = {
	ActiveCount: number,
	NextId: number,
}

export type Vector3Component = {
	CreateLayout: (MemoryOffset: number, X: number, Y: number, Z: number) -> number,
	GetData: () -> buffer,
}

export type VisualComponent = {
	CreateLayout: (MemoryOffset: number, R: number, G: number, B: number) -> number,
	GetData: () -> buffer,
}

export type DirectionsComponent = {
	CreateLayout: (
		MemoryOffset: number,
		LookX: number,
		LookY: number,
		LookZ: number,
		UpX: number,
		UpY: number,
		UpZ: number,
		RightX: number,
		RightY: number,
		RightZ: number
	) -> number,
	GetData: () -> buffer,
}

export type PropertiesComponent = {
	CreateLayout: (
		MemoryOffset: number,
		CanCollide: boolean?,
		IsVisible: boolean?,
		Anchored: boolean?,
		DynamicId: number?,
		TextureId: number?
	) -> number,
	GetData: () -> buffer,
}

export type ECSDataComponent = {
	ECSDataTable: ECSTable,
	GetCounts: () -> ECSTable,
	GetStaticData: () -> buffer,
	RegisterEntity: (IsStatic: boolean?) -> number,
	SetEntityCount: (EntityCount: number) -> (),
	DeleteEntity: (EntityId: number) -> (),
}

export type DynamicObjectsComponent = {
	ObjectsTable: { [number]: any },
	Counts: DynamicListCounts,
	AddObject: (ObjectInstance: any, EntityId: number?) -> number,
	GetObject: (DynamicId: number) -> any,
	GetObjectFromRegister: (Register: number) -> any,
	GetObjectByEntityId: (EntityId: number) -> any,
	BindEntity: (DynamicId: number, EntityId: number) -> (),
	GetBoundEntityId: (DynamicId: number) -> number,
	RemoveObject: (DynamicId: number) -> (),
	GetData: () -> { [number]: any },
}

export type ECSStorage = {
	PositionData: Vector3Component,
	OrientationData: Vector3Component,
	VisualData: VisualComponent,
	SizeData: Vector3Component,
	DirectionsData: DirectionsComponent,
	PropertiesData: PropertiesComponent,
	ECSData: ECSDataComponent,
	DynamicObjectsList: DynamicObjectsComponent,
}

local ECSMain = {}

-- ============================================================================
-- 1. COMPONENT LAYOUT WRITERS & BITPACKED PROPERTIES HELPERS
-- ============================================================================

--[=[
	Writes 3D Vector3 float components (X, Y, Z) into a component buffer.
	@param TargetBuffer buffer -- Target ECS component buffer.
	@param MemoryOffset number -- Byte offset in buffer.
	@param X number -- Vector component X.
	@param Y number -- Vector component Y.
	@param Z number -- Vector component Z.
	@return number -- Next component byte offset.
]=]
function ECSMain.CreateVector3Layout(
	TargetBuffer: buffer,
	MemoryOffset: number,
	X: number,
	Y: number,
	Z: number
): number
	buffer.writef32(TargetBuffer, MemoryOffset, X)
	buffer.writef32(TargetBuffer, MemoryOffset + 4, Y)
	buffer.writef32(TargetBuffer, MemoryOffset + 8, Z)

	return MemoryOffset + COMPONENT_STRIDE
end

--[=[
	Writes 8-bit RGB color channels into a component buffer.
	@param TargetBuffer buffer -- Target visual component buffer.
	@param MemoryOffset number -- Byte offset in buffer.
	@param R number -- Red color channel (0-255).
	@param G number -- Green color channel (0-255).
	@param B number -- Blue color channel (0-255).
	@return number -- Next component byte offset.
]=]
function ECSMain.CreateVisualLayout(
	TargetBuffer: buffer,
	MemoryOffset: number,
	R: number,
	G: number,
	B: number
): number
	buffer.writeu8(TargetBuffer, MemoryOffset, R)
	buffer.writeu8(TargetBuffer, MemoryOffset + 1, G)
	buffer.writeu8(TargetBuffer, MemoryOffset + 2, B)

	return MemoryOffset + COMPONENT_STRIDE
end

--[=[
	Writes orientation direction unit vectors (Look, Up, Right) into a direction buffer.
	@param TargetBuffer buffer -- Target directions buffer.
	@param MemoryOffset number -- Byte offset in buffer.
	@param LookX number -- LookVector X.
	@param LookY number -- LookVector Y.
	@param LookZ number -- LookVector Z.
	@param UpX number -- UpVector X.
	@param UpY number -- UpVector Y.
	@param UpZ number -- UpVector Z.
	@param RightX number -- RightVector X.
	@param RightY number -- RightVector Y.
	@param RightZ number -- RightVector Z.
	@return number -- Next direction byte offset.
]=]
function ECSMain.CreateDirectionsLayout(
	TargetBuffer: buffer,
	MemoryOffset: number,
	LookX: number,
	LookY: number,
	LookZ: number,
	UpX: number,
	UpY: number,
	UpZ: number,
	RightX: number,
	RightY: number,
	RightZ: number
): number
	buffer.writef32(TargetBuffer, MemoryOffset, LookX)
	buffer.writef32(TargetBuffer, MemoryOffset + 4, LookY)
	buffer.writef32(TargetBuffer, MemoryOffset + 8, LookZ)

	buffer.writef32(TargetBuffer, MemoryOffset + 12, UpX)
	buffer.writef32(TargetBuffer, MemoryOffset + 16, UpY)
	buffer.writef32(TargetBuffer, MemoryOffset + 20, UpZ)

	buffer.writef32(TargetBuffer, MemoryOffset + 24, RightX)
	buffer.writef32(TargetBuffer, MemoryOffset + 28, RightY)
	buffer.writef32(TargetBuffer, MemoryOffset + 32, RightZ)

	return MemoryOffset + DIRECTION_STRIDE
end

--[=[
	Packs boolean flags, texture ID, and dynamic object ID into a single 32-bit property register.
	@param CanCollide boolean? -- Collision enabled flag.
	@param IsVisible boolean? -- Visibility flag.
	@param Anchored boolean? -- Anchored physics state flag.
	@param DynamicId number? -- Bound dynamic OOP object ID.
	@param TextureId number? -- TextureTable ID (bits 5-12, 0-255).
	@return number -- Packed 32-bit register.
]=]
function ECSMain.PackProperties(
	CanCollide: boolean?,
	IsVisible: boolean?,
	Anchored: boolean?,
	DynamicId: number?,
	TextureId: number?
): number
	const CollideBit = if CanCollide ~= false then 1 else 0 :: number
	const VisibleBit = if IsVisible ~= false then 1 else 0 :: number
	const AnchoredBit = if Anchored ~= false then 1 else 0 :: number
	const ClampedDynamicId = if DynamicId and DynamicId > 0
		then math.min(DynamicId, MAX_DYNAMIC_ID)
		else 0 :: number
	const HasDynamicBit = if ClampedDynamicId > 0 then 1 else 0 :: number
	const ClampedTextureId = if TextureId and TextureId > 0
		then math.clamp(math.floor(TextureId), 0, MAX_TEXTURE_ID)
		else 0 :: number

	return bit32.bor(
		0,
		bit32.lshift(CollideBit, 1), -- CanCollide
		bit32.lshift(VisibleBit, 2), -- IsVisible
		bit32.lshift(AnchoredBit, 3), -- Anchored
		bit32.lshift(HasDynamicBit, 4), -- Has dynamic oop / object list id?
		bit32.lshift(ClampedTextureId, TEXTURE_ID_SHIFT), -- TextureTable ID (bits 5-12)
		bit32.lshift(ClampedDynamicId, DYNAMIC_ID_SHIFT) -- DYNAMIC OOP / OBJECTS LIST ID
	)
end

--[=[
	Packs and writes an entity's 32-bit property register into the properties buffer.
	@param TargetBuffer buffer -- Target properties buffer.
	@param MemoryOffset number -- Byte offset in buffer.
	@param CanCollide boolean? -- Collision enabled flag.
	@param IsVisible boolean? -- Visibility flag.
	@param Anchored boolean? -- Anchored physics state flag.
	@param DynamicId number? -- Bound dynamic OOP object ID.
	@param TextureId number? -- TextureTable ID (0-255).
	@return number -- Next properties byte offset.
]=]
function ECSMain.CreatePropertiesLayout(
	TargetBuffer: buffer,
	MemoryOffset: number,
	CanCollide: boolean?,
	IsVisible: boolean?,
	Anchored: boolean?,
	DynamicId: number?,
	TextureId: number?
): number
	const Register = ECSMain.PackProperties(CanCollide, IsVisible, Anchored, DynamicId, TextureId) :: number
	buffer.writeu32(TargetBuffer, MemoryOffset, Register)

	return MemoryOffset + PROPERTIES_STRIDE
end

--[=[
	Checks whether the CanCollide bit is set in a 32-bit property register.
	@param Register number -- 32-bit property register.
	@return boolean -- True if collidable.
]=]
function ECSMain.CanEntityCollide(Register: number): boolean
	return bit32.btest(Register, FLAG_CAN_COLLIDE)
end

--[=[
	Checks whether the IsVisible bit is set in a 32-bit property register.
	@param Register number -- 32-bit property register.
	@return boolean -- True if visible.
]=]
function ECSMain.IsEntityVisible(Register: number): boolean
	return bit32.btest(Register, FLAG_IS_VISIBLE)
end

--[=[
	Checks whether the Anchored bit is set in a 32-bit property register.
	@param Register number -- 32-bit property register.
	@return boolean -- True if anchored.
]=]
function ECSMain.IsEntityAnchored(Register: number): boolean
	return bit32.btest(Register, FLAG_ANCHORED)
end

--[=[
	Checks whether an entity has a bound dynamic OOP object ID in its register.
	@param Register number -- 32-bit property register.
	@return boolean -- True if a dynamic ID is present.
]=]
function ECSMain.HasEntityDynamicId(Register: number): boolean
	return bit32.btest(Register, FLAG_HAS_DYNAMIC_ID)
end

--[=[
	Extracts the bound dynamic OOP object ID from a 32-bit property register.
	@param Register number -- 32-bit property register.
	@return number -- Extracted dynamic ID (or 0 if none).
]=]
function ECSMain.GetEntityDynamicId(Register: number): number
	if not bit32.btest(Register, FLAG_HAS_DYNAMIC_ID) then
		return 0
	end

	return bit32.rshift(Register, DYNAMIC_ID_SHIFT)
end

--[=[
	Updates an entity's dynamic OOP ID in-place inside the properties buffer.
	@param PropertiesBuffer buffer -- Properties buffer.
	@param EntityId number -- Target entity ID.
	@param DynamicId number -- New dynamic OOP object ID (0 to clear).
]=]
function ECSMain.SetEntityDynamicId(PropertiesBuffer: buffer, EntityId: number, DynamicId: number)
	const Offset = (EntityId - 1) * PROPERTIES_STRIDE :: number
	const CurrentRegister = buffer.readu32(PropertiesBuffer, Offset) :: number
	const BaseFlags = bit32.band(CurrentRegister, LOWER_FLAGS_MASK) :: number

	if DynamicId <= 0 then
		buffer.writeu32(PropertiesBuffer, Offset, bit32.band(BaseFlags, bit32.bnot(FLAG_HAS_DYNAMIC_ID)))
		return
	end

	const ClampedId = math.min(DynamicId, MAX_DYNAMIC_ID) :: number
	const UpdatedRegister = bit32.bor(BaseFlags, FLAG_HAS_DYNAMIC_ID, bit32.lshift(ClampedId, DYNAMIC_ID_SHIFT)) :: number
	buffer.writeu32(PropertiesBuffer, Offset, UpdatedRegister)
end

--[=[
	Extracts the TextureTable ID (bits 5-12) from a 32-bit property register.
	@param Register number -- 32-bit property register.
	@return number -- Extracted texture ID (0-255).
]=]
function ECSMain.GetEntityTextureId(Register: number): number
	return bit32.band(bit32.rshift(Register, TEXTURE_ID_SHIFT), MAX_TEXTURE_ID)
end

--[=[
	Updates an entity's TextureTable ID in-place inside the properties buffer without altering other flags or DynamicId.
	@param PropertiesBuffer buffer -- Properties buffer.
	@param EntityId number -- Target entity ID.
	@param TextureId number -- New TextureTable ID (0-255).
]=]
function ECSMain.SetEntityTextureId(PropertiesBuffer: buffer, EntityId: number, TextureId: number)
	const Offset = (EntityId - 1) * PROPERTIES_STRIDE :: number
	const CurrentRegister = buffer.readu32(PropertiesBuffer, Offset) :: number
	const ClearedRegister = bit32.band(CurrentRegister, bit32.bnot(TEXTURE_ID_MASK)) :: number
	const ClampedTextureId = math.clamp(math.floor(TextureId), 0, MAX_TEXTURE_ID) :: number

	buffer.writeu32(PropertiesBuffer, Offset, bit32.bor(ClearedRegister, bit32.lshift(ClampedTextureId, TEXTURE_ID_SHIFT)))
end

-- ============================================================================
-- 2. ENTITY REGISTRATION & LIFECYCLE FUNCTIONS
-- ============================================================================

--[=[
	Registers a new entity slot across the synchronized ECS count table.
	@param Counts ECSTable -- Table tracking active component counts.
	@param StaticBuffer buffer? -- Optional static entity marker buffer.
	@param IsStatic boolean? -- True if entity is unmoving static geometry.
	@return number -- New unique EntityId.
]=]
function ECSMain.RegisterEntity(Counts: ECSTable, StaticBuffer: buffer?, IsStatic: boolean?): number
	const NextCount = Counts.EntityECSCount + 1 :: number

	Counts.EntityECSCount = NextCount
	Counts.OrientationECSCount = NextCount
	Counts.PositionECSCount = NextCount
	Counts.VisualECSCount = NextCount
	Counts.SizeECSCount = NextCount
	Counts.DirectionsECSCount = NextCount
	Counts.PropertiesECSCount = NextCount

	if StaticBuffer and NextCount <= MAX_ENTITIES then
		buffer.writeu8(StaticBuffer, NextCount - 1, if IsStatic then 1 else 0)
	end

	return NextCount
end

--[=[
	Directly resets all component count fields in the ECS table.
	@param Counts ECSTable -- Table tracking active component counts.
	@param EntityCount number -- Desired entity count.
]=]
function ECSMain.SetEntityCount(Counts: ECSTable, EntityCount: number)
	Counts.EntityECSCount = EntityCount
	Counts.OrientationECSCount = EntityCount
	Counts.PositionECSCount = EntityCount
	Counts.VisualECSCount = EntityCount
	Counts.SizeECSCount = EntityCount
	Counts.DirectionsECSCount = EntityCount
	Counts.PropertiesECSCount = EntityCount
end

--[=[
	Deletes an entity using O(1) swap-and-pop compaction to keep buffers contiguous.
	@param EntityId number -- Entity ID to remove.
	@param Counts ECSTable -- Component count table.
	@param PositionBuffer buffer -- World position buffer.
	@param OrientationBuffer buffer -- Orientation vector buffer.
	@param VisualBuffer buffer -- Visual color buffer.
	@param SizeBuffer buffer -- Part bounding size buffer.
	@param DirectionsBuffer buffer -- Basis unit vectors buffer.
	@param StaticBuffer buffer? -- Optional static marker buffer.
	@param PropertiesBuffer buffer? -- Optional bitpacked properties buffer.
]=]
function ECSMain.DeleteEntity(
	EntityId: number,
	Counts: ECSTable,
	PositionBuffer: buffer,
	OrientationBuffer: buffer,
	VisualBuffer: buffer,
	SizeBuffer: buffer,
	DirectionsBuffer: buffer,
	StaticBuffer: buffer?,
	PropertiesBuffer: buffer?
)
	const LastEntityId = Counts.EntityECSCount :: number
	if EntityId < 1 or EntityId > LastEntityId then
		return
	end

	if EntityId ~= LastEntityId then
		const TargetOffset = (EntityId - 1) * COMPONENT_STRIDE :: number
		const LastOffset = (LastEntityId - 1) * COMPONENT_STRIDE :: number

		buffer.copy(PositionBuffer, TargetOffset, PositionBuffer, LastOffset, COMPONENT_STRIDE)
		buffer.copy(OrientationBuffer, TargetOffset, OrientationBuffer, LastOffset, COMPONENT_STRIDE)
		buffer.copy(VisualBuffer, TargetOffset, VisualBuffer, LastOffset, COMPONENT_STRIDE)
		buffer.copy(SizeBuffer, TargetOffset, SizeBuffer, LastOffset, COMPONENT_STRIDE)

		const TargetDirOffset = (EntityId - 1) * DIRECTION_STRIDE :: number
		const LastDirOffset = (LastEntityId - 1) * DIRECTION_STRIDE :: number
		buffer.copy(DirectionsBuffer, TargetDirOffset, DirectionsBuffer, LastDirOffset, DIRECTION_STRIDE)

		if PropertiesBuffer then
			const TargetPropOffset = (EntityId - 1) * PROPERTIES_STRIDE :: number
			const LastPropOffset = (LastEntityId - 1) * PROPERTIES_STRIDE :: number
			buffer.writeu32(PropertiesBuffer, TargetPropOffset, buffer.readu32(PropertiesBuffer, LastPropOffset))
		end

		if StaticBuffer then
			buffer.writeu8(StaticBuffer, EntityId - 1, buffer.readu8(StaticBuffer, LastEntityId - 1))
		end
	end

	if PropertiesBuffer then
		buffer.writeu32(PropertiesBuffer, (LastEntityId - 1) * PROPERTIES_STRIDE, 0)
	end

	if StaticBuffer then
		buffer.writeu8(StaticBuffer, LastEntityId - 1, 0)
	end

	const NewCount = LastEntityId - 1 :: number
	Counts.EntityECSCount = NewCount
	Counts.OrientationECSCount = NewCount
	Counts.PositionECSCount = NewCount
	Counts.VisualECSCount = NewCount
	Counts.SizeECSCount = NewCount
	Counts.DirectionsECSCount = NewCount
	Counts.PropertiesECSCount = NewCount
end

-- ============================================================================
-- 3. COMPONENT & UNIFIED STORAGE FACTORIES
-- ============================================================================

--[=[
	Creates an isolated Vector3 component storage buffer and accessor interface.
	@return Vector3Component -- Initialized Vector3 component interface.
]=]
function ECSMain.CreateVector3Component(): Vector3Component
	const ComponentBuffer = buffer.create(COMPONENT_BUFFER_SIZE) :: buffer
	local Component = {}

	function Component.CreateLayout(MemoryOffset: number, X: number, Y: number, Z: number): number
		return ECSMain.CreateVector3Layout(ComponentBuffer, MemoryOffset, X, Y, Z)
	end

	function Component.GetData(): buffer
		return ComponentBuffer
	end

	return Component
end

--[=[
	Creates an isolated Visual RGB component storage buffer and accessor interface.
	@return VisualComponent -- Initialized Visual component interface.
]=]
function ECSMain.CreateVisualComponent(): VisualComponent
	const VisualBuffer = buffer.create(COMPONENT_BUFFER_SIZE) :: buffer
	local Component = {}

	function Component.CreateLayout(MemoryOffset: number, R: number, G: number, B: number): number
		return ECSMain.CreateVisualLayout(VisualBuffer, MemoryOffset, R, G, B)
	end

	function Component.GetData(): buffer
		return VisualBuffer
	end

	return Component
end

--[=[
	Creates an isolated basis directions component buffer and accessor interface.
	@return DirectionsComponent -- Initialized directions component interface.
]=]
function ECSMain.CreateDirectionsComponent(): DirectionsComponent
	const DirectionsBuffer = buffer.create(DIRECTION_BUFFER_SIZE) :: buffer
	local Component = {}

	function Component.CreateLayout(
		MemoryOffset: number,
		LookX: number,
		LookY: number,
		LookZ: number,
		UpX: number,
		UpY: number,
		UpZ: number,
		RightX: number,
		RightY: number,
		RightZ: number
	): number
		return ECSMain.CreateDirectionsLayout(
			DirectionsBuffer,
			MemoryOffset,
			LookX,
			LookY,
			LookZ,
			UpX,
			UpY,
			UpZ,
			RightX,
			RightY,
			RightZ
		)
	end

	function Component.GetData(): buffer
		return DirectionsBuffer
	end

	return Component
end

--[=[
	Creates or writes into a bitpacked properties component buffer.
	@param TargetBuffer buffer? -- Optional target buffer (if writing directly).
	@param MemoryOffset number? -- Optional byte offset (if writing directly).
	@param CanCollide boolean? -- Collision flag.
	@param IsVisible boolean? -- Visibility flag.
	@param Anchored boolean? -- Anchored flag.
	@param DynamicId number? -- Dynamic OOP ID.
	@return any -- Returns component table if creating, or next offset if writing.
]=]
function ECSMain.CreatePropertiesComponent(
	TargetBuffer: buffer?,
	MemoryOffset: number?,
	CanCollide: boolean?,
	IsVisible: boolean?,
	Anchored: boolean?,
	DynamicId: number?,
	TextureId: number?
): any
	if TargetBuffer and MemoryOffset then
		return ECSMain.CreatePropertiesLayout(TargetBuffer, MemoryOffset, CanCollide, IsVisible, Anchored, DynamicId, TextureId)
	end

	const PropertiesBuffer = buffer.create(PROPERTIES_BUFFER_SIZE) :: buffer
	local PropertiesComponent = {}

	function PropertiesComponent.CreateLayout(
		Offset: number,
		Collide: boolean?,
		Visible: boolean?,
		IsAnchored: boolean?,
		DynId: number?,
		TexId: number?
	): number
		return ECSMain.CreatePropertiesLayout(PropertiesBuffer, Offset, Collide, Visible, IsAnchored, DynId, TexId)
	end

	function PropertiesComponent.GetData(): buffer
		return PropertiesBuffer
	end

	return PropertiesComponent
end

--[=[
	Creates a dynamic OOP objects table linked to entity property registers.
	@param PropertiesBuffer buffer -- The entity properties buffer to link IDs into.
	@return DynamicObjectsComponent -- Initialized dynamic objects registry.
]=]
function ECSMain.CreateDynamicObjectsComponent(PropertiesBuffer: buffer): DynamicObjectsComponent
	local ObjectsTable = {} :: { [number]: any }
	local FreeIds = {} :: { number }
	const EntityIdByDynamicId = buffer.create((MAX_DYNAMIC_ID + 1) * 4) :: buffer

	local Counts: DynamicListCounts = {
		ActiveCount = 0,
		NextId = 0,
	}

	local DynamicObjectsList = {}
	DynamicObjectsList.ObjectsTable = ObjectsTable
	DynamicObjectsList.Counts = Counts

	function DynamicObjectsList.AddObject(ObjectInstance: any, EntityId: number?): number
		local DynamicId = 0 :: number
		const FreeCount = (#FreeIds) :: number

		if FreeCount > 0 then
			DynamicId = FreeIds[FreeCount]
			FreeIds[FreeCount] = nil
		else
			const CandidateId = Counts.NextId + 1 :: number
			if CandidateId > MAX_DYNAMIC_ID then
				return 0
			end
			Counts.NextId = CandidateId
			DynamicId = CandidateId
		end

		ObjectsTable[DynamicId] = ObjectInstance
		Counts.ActiveCount += 1

		if EntityId and EntityId > 0 then
			buffer.writeu32(EntityIdByDynamicId, DynamicId * 4, EntityId)
			ECSMain.SetEntityDynamicId(PropertiesBuffer, EntityId, DynamicId)
		end

		return DynamicId
	end

	function DynamicObjectsList.GetObject(DynamicId: number): any
		if DynamicId <= 0 or DynamicId > MAX_DYNAMIC_ID then
			return nil
		end

		return ObjectsTable[DynamicId]
	end

	function DynamicObjectsList.GetObjectFromRegister(Register: number): any
		const DynamicId = ECSMain.GetEntityDynamicId(Register) :: number
		if DynamicId <= 0 then
			return nil
		end

		return ObjectsTable[DynamicId]
	end

	function DynamicObjectsList.GetObjectByEntityId(EntityId: number): any
		if EntityId < 1 then
			return nil
		end

		const Register = buffer.readu32(PropertiesBuffer, (EntityId - 1) * PROPERTIES_STRIDE) :: number
		const DynamicId = ECSMain.GetEntityDynamicId(Register) :: number
		if DynamicId <= 0 then
			return nil
		end

		return ObjectsTable[DynamicId]
	end

	function DynamicObjectsList.BindEntity(DynamicId: number, EntityId: number)
		if DynamicId <= 0 or DynamicId > MAX_DYNAMIC_ID or EntityId < 1 then
			return
		end

		buffer.writeu32(EntityIdByDynamicId, DynamicId * 4, EntityId)
		ECSMain.SetEntityDynamicId(PropertiesBuffer, EntityId, DynamicId)
	end

	function DynamicObjectsList.GetBoundEntityId(DynamicId: number): number
		if DynamicId <= 0 or DynamicId > MAX_DYNAMIC_ID then
			return 0
		end

		return buffer.readu32(EntityIdByDynamicId, DynamicId * 4)
	end

	function DynamicObjectsList.RemoveObject(DynamicId: number)
		if DynamicId <= 0 or DynamicId > MAX_DYNAMIC_ID then
			return
		end

		if ObjectsTable[DynamicId] == nil then
			return
		end

		const BoundEntityId = buffer.readu32(EntityIdByDynamicId, DynamicId * 4) :: number
		if BoundEntityId > 0 then
			buffer.writeu32(EntityIdByDynamicId, DynamicId * 4, 0)
			ECSMain.SetEntityDynamicId(PropertiesBuffer, BoundEntityId, 0)
		end

		ObjectsTable[DynamicId] = nil
		Counts.ActiveCount = math.max(0, Counts.ActiveCount - 1)
		table.insert(FreeIds, DynamicId)
	end

	function DynamicObjectsList.GetData(): { [number]: any }
		return ObjectsTable
	end

	return DynamicObjectsList
end

--[=[
	Constructs a complete, unified ECS storage container with all component buffers.
	@param IncludeStaticBuffer boolean? -- Whether to allocate a static geometry marker buffer.
	@return ECSStorage -- Fully initialized ECS storage structure.
]=]
function ECSMain.CreateStorage(IncludeStaticBuffer: boolean?): ECSStorage
	const PositionData = ECSMain.CreateVector3Component()
	const OrientationData = ECSMain.CreateVector3Component()
	const VisualData = ECSMain.CreateVisualComponent()
	const SizeData = ECSMain.CreateVector3Component()
	const DirectionsData = ECSMain.CreateDirectionsComponent()
	const PropertiesData = ECSMain.CreatePropertiesComponent() :: PropertiesComponent

	const PositionBuffer = PositionData.GetData() :: buffer
	const OrientationBuffer = OrientationData.GetData() :: buffer
	const VisualBuffer = VisualData.GetData() :: buffer
	const SizeBuffer = SizeData.GetData() :: buffer
	const DirectionsBuffer = DirectionsData.GetData() :: buffer
	const PropertiesBuffer = PropertiesData.GetData() :: buffer
	const StaticBuffer = if IncludeStaticBuffer then buffer.create(MAX_ENTITIES) else nil :: buffer?

	const ECSDataTable: ECSTable = {
		OrientationECSCount = 0,
		PositionECSCount = 0,
		VisualECSCount = 0,
		SizeECSCount = 0,
		DirectionsECSCount = 0,
		PropertiesECSCount = 0,
		EntityECSCount = 0,
	}

	local ECSData = {}
	ECSData.ECSDataTable = ECSDataTable

	function ECSData.GetCounts(): ECSTable
		return ECSDataTable
	end

	function ECSData.GetStaticData(): buffer
		return StaticBuffer :: buffer
	end

	function ECSData.RegisterEntity(IsStatic: boolean?): number
		return ECSMain.RegisterEntity(ECSDataTable, StaticBuffer, IsStatic)
	end

	function ECSData.SetEntityCount(EntityCount: number)
		ECSMain.SetEntityCount(ECSDataTable, EntityCount)
	end

	function ECSData.DeleteEntity(EntityId: number)
		ECSMain.DeleteEntity(
			EntityId,
			ECSDataTable,
			PositionBuffer,
			OrientationBuffer,
			VisualBuffer,
			SizeBuffer,
			DirectionsBuffer,
			StaticBuffer,
			PropertiesBuffer
		)
	end

	const DynamicObjectsList = ECSMain.CreateDynamicObjectsComponent(PropertiesBuffer)

	return {
		PositionData = PositionData,
		OrientationData = OrientationData,
		VisualData = VisualData,
		SizeData = SizeData,
		DirectionsData = DirectionsData,
		PropertiesData = PropertiesData,
		ECSData = ECSData,
		DynamicObjectsList = DynamicObjectsList,
	}
end

return ECSMain
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="120">
        <Properties>
          <string name="Name">SystemsConfigs</string>
          <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

local SystemsConfigs = {}

-- Here, are the configs for all systems, say frustum cullers or replication or even rendering, both client and server

-- Each config should have a SystemsConfigs.Whatever = whatever type
-- Make sure to type them and to in the next line give documentation as to what it does

-- Im thinking about making the virtual engine open source for those that are curious
-- For the renderer ive showed you, it can handle 400 x 400 comfortably while having alot of stress on my intel core 3U
-- if there is no such stress it can easily go 600 x 600

-- i will soon add OOP to my ECS storage here, it will just use a numerical pointer for that to reference its parent OOP object

-- Client --

SystemsConfigs.RenderWidth = 300 :: number
-- Horizontal pixel resolution of the renderer's EditableImage and frame buffers.

SystemsConfigs.RenderHeight = 300 :: number
-- Vertical pixel resolution of the renderer's EditableImage and frame buffers.

SystemsConfigs.RenderTotalPixels = SystemsConfigs.RenderWidth * SystemsConfigs.RenderHeight :: number
-- Total pixel count of the renderer canvas (RenderWidth * RenderHeight).

SystemsConfigs.ActorCount = 3 :: number
-- Number of parallel worker Actors spawned to rasterize triangles across frames.

SystemsConfigs.WorkerBufferMultiplier = 4 :: number
-- Per-pixel byte multiplier used to allocate each worker's triangle command buffer.

SystemsConfigs.RenderBufferLayoutSize = 56 :: number
-- Byte stride of a single serialized textured triangle in the worker render buffer (three 16-byte vertices, one 4-byte packed RGBA color, and one 4-byte texture ID).

SystemsConfigs.TextureSize = 64 :: number
-- Power-of-two width and height in texels for the software renderer's cached texture buffers.

SystemsConfigs.TextureStudsPerTile = 0 :: number
-- World-space studs covered by one texture tile on part faces (set <= 0 to stretch 1x1 across each face instead of repeating).

SystemsConfigs.DefaultEntityTextureId = 0 :: number
-- Default TextureTable ID used when an ECS entity has no Decal or texture attribute (0 = untextured solid part color).

SystemsConfigs.TextureRegistryFolderName = "TextureRegistry" :: string
-- Name of the ReplicatedStorage folder where ECSBuilder publishes discovered Decal URLs for client 64x64 decoding.

SystemsConfigs.DefaultTextureUri = "" :: string
-- Optional Roblox asset URI override for textures; leave empty to populate from Workspace Decals via ECSBuilder.

SystemsConfigs.ClearColorR = 15 :: number
-- Red channel (0-255) of the background clear color filled into the pixel buffer each frame.

SystemsConfigs.ClearColorG = 15 :: number
-- Green channel (0-255) of the background clear color filled into the pixel buffer each frame.

SystemsConfigs.ClearColorB = 20 :: number
-- Blue channel (0-255) of the background clear color filled into the pixel buffer each frame.

SystemsConfigs.SunDirection = Vector3.new(-0.4, 0.85, -0.35).Unit :: Vector3
-- Normalized world-space directional light vector used to compute per-face illumination.

SystemsConfigs.AmbientLight = 0.3 :: number
-- Minimum ambient illumination factor (0-1) applied to all rendered part faces.

SystemsConfigs.MinTriangleArea = 0.5 :: number
-- Minimum screen-space signed edge area (2x pixel area; >= 0.5 keeps all visible 1-pixel triangles while culling degenerate slivers).

SystemsConfigs.RenderNearClip = 0.4 :: number
-- Near clipping plane distance in studs for camera-space part rejection and polygon clipping.

SystemsConfigs.RenderFarClip = 200 :: number
-- Far clipping plane distance in studs for camera-space part rejection and polygon clipping (matched to CullingFarClip).

SystemsConfigs.GuardBandScale = 1.25 :: number
-- 25% screen-space frustum guard-band scale so edge-straddling quads use fast-path projection without boundary pop-in.

SystemsConfigs.ScriptableCameraParkPosition = Vector3.new(0, -50000, 0) :: Vector3
-- World position where the client's Workspace Camera is initially parked when switched to Scriptable.

SystemsConfigs.CameraFixedPosition = Vector3.new(0, 1000, -5000) :: Vector3
-- Fixed distant world position where CameraStore locks the Workspace Camera every frame to avoid rendering default Roblox geometry.

SystemsConfigs.DefaultCameraCFrame = CFrame.new(5, 5, 5) :: CFrame
-- Initial virtual camera CFrame in CameraStore before the camera host updates it.

SystemsConfigs.DefaultCameraFOV = 70 :: number
-- Default vertical field of view in degrees for the virtual camera and projection math.

SystemsConfigs.DefaultCameraView = "FirstPerson" :: string
-- Initial CameraService view preset activated when the render controller starts.

SystemsConfigs.CameraMaxVerticalAngle = 60 :: number
-- Default maximum vertical look angle in degrees (up/down pitch clamp) in CameraService.

SystemsConfigs.CleanerTickInterval = 0 :: number
-- Yield duration in seconds between client RendererCleaner culling passes.

-- Server --

SystemsConfigs.ReplicationTickInterval = 0 :: number
-- Yield duration in seconds between server replication delta broadcast passes.

SystemsConfigs.StaticObjectsFolderName = "Static" :: string
-- Name of the Workspace folder whose descendant BaseParts are flagged as static entities in the server ECS.

SystemsConfigs.WorkspaceCleanupDelay = 5 :: number
-- Delay in seconds after server startup before original Workspace BaseParts are destroyed once registered in the ECS.

-- Shared --

SystemsConfigs.CoreEventsFolderName = "CoreEvents" :: string
-- Name of the ReplicatedStorage folder containing networking RemoteEvents.

SystemsConfigs.ReplicateRemoteEventName = "ReplicateEvent" :: string
-- Name of the RemoteEvent used to replicate ECS component delta buffers from server to client.

SystemsConfigs.CullingPaddingAmount = 1.03 :: number
-- Master frustum culling padding multiplier; 1.03 adds a ~1.2-degree angular buffer over the 70-degree FOV to absorb 1-frame task.wait() rotation lag.

SystemsConfigs.CullingBaseTanY = 0.7002 :: number
-- Exact vertical frustum half-angle tangent at the reference 70-degree FOV (tan(35 deg) = 0.7002).

SystemsConfigs.CullingBaseBackPadding = 3.5 :: number
-- 3.5-stud backward origin shift so adjacent parts do not pop in when turning while still rejecting geometry behind the camera.

SystemsConfigs.CullingRadiusPaddingFactor = 0.35 :: number
-- Secant-corrected L1 cube circumradius factor ((sqrt(3)/6) * sec(35 deg) = 0.2887 * 1.2208 = 0.3524) so rotated corners never pop at frustum planes.

SystemsConfigs.CullingNearClip = 0.4 :: number
-- Near clipping plane distance in studs for view frustum culling (matched to RenderNearClip).

SystemsConfigs.CullingFarClip = 200 :: number
-- Far clipping plane distance in studs for view frustum culling (matched to RenderFarClip).

SystemsConfigs.OccluderInscribedRadiusFactor = 0.32 :: number
-- Conservative scale factor applied to an entity's smallest axis so foreground occluders never overestimate back-face coverage.

SystemsConfigs.OccluderMinProjectedRadius = 0.26 :: number
-- Minimum projected screen-space radius required for a foreground entity to become the active dominant occluder without false edge pop-in.

SystemsConfigs.ECSComponentStride = 12 :: number
-- Byte stride per entity for 3-float ECS component buffers (Position, Orientation, Visual, and Size: 3 x f32 = 12 bytes).

SystemsConfigs.ECSDirectionStride = 36 :: number
-- Byte stride per entity for the Directions ECS buffer (LookVector, UpVector, and RightVector: 9 x f32 = 36 bytes).

SystemsConfigs.ECSComponentBufferSize = 100000 :: number
-- Allocated byte capacity for each 12-byte-stride ECS component buffer (Position, Orientation, Visual, Size).

SystemsConfigs.ECSDirectionBufferSize = 300000 :: number
-- Allocated byte capacity for each 36-byte-stride Directions ECS buffer.

SystemsConfigs.ECSMaxEntities = SystemsConfigs.ECSComponentBufferSize // SystemsConfigs.ECSComponentStride :: number
-- Maximum number of entities that can be stored in the preallocated ECS component buffers.

SystemsConfigs.ECSPropertiesStride = 4 :: number
-- Byte stride per entity for the bitpacked u32 Properties ECS buffer (CanCollide, IsVisible, Anchored, HasDynamicId, DynamicId).

SystemsConfigs.ECSPropertiesBufferSize = 40000 :: number
-- Allocated byte capacity for each 4-byte-stride Properties ECS buffer.

SystemsConfigs.DynamicObjectsMaxCount = 4095 :: number
-- Maximum 12-bit ID capacity (bits 20-31 of the Properties u32 register) for the Dynamic OOP / Objects List.

-- Physics --

SystemsConfigs.PhysicsGravity = 98.0 :: number
-- Downward gravitational acceleration in studs per second squared.

SystemsConfigs.PhysicsFallGravityMultiplier = 1.2 :: number
-- Multiplier applied to downward gravity when falling so jump arcs feel grounded rather than floaty.

SystemsConfigs.PhysicsMaxDeltaTime = 0.05 :: number
-- Maximum clamped frame delta time in seconds to prevent tunneling during frame spikes.

SystemsConfigs.PhysicsSubsteps = 2 :: number
-- Number of physics integration and collision substeps executed per frame.

SystemsConfigs.PlayerDefaultSpawnPosition = Vector3.new(0, 12, 0) :: Vector3
-- Fallback world spawn position for the player physics body when no character root part is present.

SystemsConfigs.PlayerVoidResetY = -500.0 :: number
-- World Y threshold below which the player physics body resets back to its spawn position.

SystemsConfigs.PlayerMass = 80.0 :: number
-- Mass of the player physics body in kilograms used for force acceleration and collision impulses.

SystemsConfigs.PlayerHalfExtents = Vector3.new(1.0, 2.5, 1.0) :: Vector3
-- Collision box half-extents (X, Y, Z) in studs for the player physics body.

SystemsConfigs.PlayerMoveForce = 4400.0 :: number
-- Horizontal driving force in Newtons applied to accelerate the player on grounded surfaces.

SystemsConfigs.PlayerMaxGroundSpeed = 60 :: number
-- Target maximum horizontal ground speed in studs per second.

SystemsConfigs.PlayerGroundFriction = 10.0 :: number
-- Ground traction damping rate per second applied to lateral drift and coasting velocity.

SystemsConfigs.PlayerBrakeMultiplier = 1.65 :: number
-- Extra braking multiplier applied when releasing movement input or counter-steering against momentum.

SystemsConfigs.PlayerStopSpeed = 4.0 :: number
-- Minimum speed reference in studs per second used to bring low-speed coasting cleanly to rest.

SystemsConfigs.PlayerAirControlMultiplier = 0.2 :: number
-- Fraction of ground driving force available while airborne so jumps preserve takeoff inertia.

SystemsConfigs.PlayerAirDrag = 0.45 :: number
-- Linear aerodynamic drag per second applied while the player is airborne.

SystemsConfigs.PlayerJumpImpulse = 2600.0 :: number
-- Upward impulse in Newton-seconds applied when jumping from grounded contact.

SystemsConfigs.PlayerWalkableNormalY = 0.65 :: number
-- Minimum surface normal Y component required for a contact to count as walkable ground.

SystemsConfigs.ObjectDefaultDensity = 1.2 :: number
-- Default mass per cubic stud used to derive dynamic ECS entity mass from bounding volume.

SystemsConfigs.ObjectLinearDrag = 0.6 :: number
-- Linear air damping per second applied to dynamic ECS object velocities.

SystemsConfigs.ObjectSurfaceFriction = 6.5 :: number
-- Tangential surface friction rate per second applied to dynamic ECS objects in contact.

SystemsConfigs.ObjectRestitution = 0.15 :: number
-- Normal impact restitution (0-1) for dynamic ECS object collisions.

SystemsConfigs.ObjectSleepSpeedThreshold = 0.08 :: number
-- Velocity magnitude threshold in studs per second below which grounded dynamic objects settle to sleep.

SystemsConfigs.PhysicsBroadphasePadding = 2.0 :: number
-- World-space AABB padding in studs around a moving body when querying the BVH for collision candidates.

SystemsConfigs.PlayerMaxWishScale = 2.5 :: number
-- Maximum movement speed multiplier allowed when combining directional player movement inputs.

-- BVH --

SystemsConfigs.BVHStackCapacity = 64 :: number
-- Maximum depth of the iterative BVH traversal stack for raycasting and spatial queries.

SystemsConfigs.BVHMaxLeafEntities = 1 :: number
-- Maximum number of entities grouped into a single BVH leaf node during tree construction.

SystemsConfigs.BVHMutationScanBudget = 256 :: number
-- Number of static entities scanned per query to detect silent buffer mutations without full-array scans.

return SystemsConfigs
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="121">
        <Properties>
          <string name="Name">TextureTable</string>
          <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

return require(script.Parent.Utilities.Render.Core.TextureTable)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="122">
        <Properties>
          <string name="Name">Utilities</string>
        </Properties>
        <Item class="ModuleScript" referent="123">
          <Properties>
            <string name="Name">BVH</string>
            <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))
const ECSMain = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ECSMain"))
const BVHHelper = require(script.BVHHelper)
const BVHMath = require(script.BVHMath)

-- Configs --
const COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number
const DIRECTION_STRIDE = SystemsConfigs.ECSDirectionStride :: number
const PROPERTIES_STRIDE = SystemsConfigs.ECSPropertiesStride :: number
const MAX_ENTITIES = SystemsConfigs.ECSMaxEntities :: number
const STACK_CAPACITY = SystemsConfigs.BVHStackCapacity :: number

const NODE_STRIDE = 32 :: number
const ITEM_BOUNDS_STRIDE = 36 :: number
const CACHED_STATE_STRIDE = 28 :: number
const MAX_BVH_NODES = MAX_ENTITIES * 2 :: number
const MAX_NODE_BYTES = MAX_BVH_NODES * NODE_STRIDE :: number

const FLAG_CAN_COLLIDE = bit32.lshift(1, 1) :: number
const FLAG_ANCHORED = bit32.lshift(1, 3) :: number
const FLAG_HAS_DYNAMIC_ID = bit32.lshift(1, 4) :: number
const DYNAMIC_ID_SHIFT = 20 :: number

-- Buffers
const NodeBuffer = buffer.create(MAX_NODE_BYTES) :: buffer
const ItemBoundsBuffer = buffer.create(MAX_ENTITIES * ITEM_BOUNDS_STRIDE) :: buffer
const CachedStateBuffer = buffer.create(MAX_ENTITIES * CACHED_STATE_STRIDE) :: buffer
const ItemIndicesBuffer = buffer.create(MAX_ENTITIES * 4) :: buffer
const DynamicEntitiesBuffer = buffer.create(MAX_ENTITIES * 4) :: buffer
const EntityIsDynamicBuffer = buffer.create(MAX_ENTITIES + 1) :: buffer
const TestedGenBuffer = buffer.create((MAX_ENTITIES + 1) * 4) :: buffer
const TraversalStackBuffer = buffer.create(STACK_CAPACITY * 4) :: buffer

-- Tables --
local ActiveStorage: ECSMain.ECSStorage? = nil

local AllocatedNodeBytes = 0 :: number
local DynamicEntityCount = 0 :: number
local LastBuiltEntityCount = -1 :: number
local LastDynamicNextId = -1 :: number
local LastDynamicActiveCount = -1 :: number
local MutationScanCursor = 1 :: number
local RayGeneration = 0 :: number

local BVH = {}

-- ============================================================================
-- 1. FLAT-BUFFER TREE BUILDER
-- ============================================================================

--[=[
	Rebuilds the static and dynamic BVH hierarchy over the given ECS storage.
	@param ProvidedStorage ECSMain.ECSStorage? -- Target ECS storage; if nil, resolves default.
]=]
function BVH.Rebuild(ProvidedStorage: ECSMain.ECSStorage?)
	const Storage = BVHHelper.ResolveStorage(ProvidedStorage)
	if not Storage then
		return
	end

	const RawCount = Storage.ECSData.GetCounts().EntityECSCount :: number
	const EntityCount = math.clamp(RawCount, 0, MAX_ENTITIES) :: number
	ActiveStorage = Storage
	LastBuiltEntityCount = EntityCount
	AllocatedNodeBytes = 0
	DynamicEntityCount = 0
	MutationScanCursor = 1

	const DynList = Storage.DynamicObjectsList
	if DynList then
		LastDynamicActiveCount = DynList.Counts.ActiveCount
		LastDynamicNextId = DynList.Counts.NextId
	else
		LastDynamicActiveCount = 0
		LastDynamicNextId = 0
	end

	if EntityCount <= 0 then
		return
	end

	const PositionBuffer = Storage.PositionData.GetData() :: buffer
	const SizeBuffer = Storage.SizeData.GetData() :: buffer
	const DirectionsBuffer = Storage.DirectionsData.GetData() :: buffer
	const PropertiesBuffer = Storage.PropertiesData.GetData() :: buffer
	const StaticBuffer = Storage.ECSData.GetStaticData() :: buffer?

	local StaticItemCount = 0 :: number

	for EntityId = 1, EntityCount do
		const CompOffset = (EntityId - 1) * COMPONENT_STRIDE :: number
		const DirOffset = (EntityId - 1) * DIRECTION_STRIDE :: number
		const PropOffset = (EntityId - 1) * PROPERTIES_STRIDE :: number
		const StateOffset = (EntityId - 1) * CACHED_STATE_STRIDE :: number

		const PropRegister = buffer.readu32(PropertiesBuffer, PropOffset) :: number
		const RawSizeX = buffer.readf32(SizeBuffer, CompOffset) :: number
		const RawSizeY = buffer.readf32(SizeBuffer, CompOffset + 4) :: number
		const RawSizeZ = buffer.readf32(SizeBuffer, CompOffset + 8) :: number

		buffer.writef32(CachedStateBuffer, StateOffset, RawSizeX)
		buffer.writef32(CachedStateBuffer, StateOffset + 4, RawSizeY)
		buffer.writef32(CachedStateBuffer, StateOffset + 8, RawSizeZ)
		buffer.writef32(CachedStateBuffer, StateOffset + 12, buffer.readf32(DirectionsBuffer, DirOffset))
		buffer.writef32(CachedStateBuffer, StateOffset + 16, buffer.readf32(DirectionsBuffer, DirOffset + 16))
		buffer.writef32(CachedStateBuffer, StateOffset + 20, buffer.readf32(DirectionsBuffer, DirOffset + 32))
		buffer.writeu32(CachedStateBuffer, StateOffset + 24, PropRegister)

		if PropRegister ~= 0 and not bit32.btest(PropRegister, FLAG_CAN_COLLIDE) then
			buffer.writeu8(EntityIsDynamicBuffer, EntityId, 1)
			continue
		end

		const HasDynamicObject = bit32.btest(PropRegister, FLAG_HAS_DYNAMIC_ID) :: boolean
		const IsDynamic = (
			HasDynamicObject
			or (StaticBuffer ~= nil and buffer.readu8(StaticBuffer, EntityId - 1) == 0)
			or (PropRegister ~= 0 and not bit32.btest(PropRegister, FLAG_ANCHORED))
		) :: boolean

		if IsDynamic then
			buffer.writeu8(EntityIsDynamicBuffer, EntityId, 1)
			buffer.writeu32(DynamicEntitiesBuffer, DynamicEntityCount * 4, EntityId)
			DynamicEntityCount += 1
		else
			buffer.writeu8(EntityIsDynamicBuffer, EntityId, 0)
		end

		const PositionX = buffer.readf32(PositionBuffer, CompOffset) :: number
		const PositionY = buffer.readf32(PositionBuffer, CompOffset + 4) :: number
		const PositionZ = buffer.readf32(PositionBuffer, CompOffset + 8) :: number

		const HalfSizeX = math.abs(RawSizeX) * 0.5 :: number
		const HalfSizeY = math.abs(RawSizeY) * 0.5 :: number
		const HalfSizeZ = math.abs(RawSizeZ) * 0.5 :: number

		local LookX = buffer.readf32(DirectionsBuffer, DirOffset) :: number
		local LookY = buffer.readf32(DirectionsBuffer, DirOffset + 4) :: number
		local LookZ = buffer.readf32(DirectionsBuffer, DirOffset + 8) :: number

		local UpX = buffer.readf32(DirectionsBuffer, DirOffset + 12) :: number
		local UpY = buffer.readf32(DirectionsBuffer, DirOffset + 16) :: number
		local UpZ = buffer.readf32(DirectionsBuffer, DirOffset + 20) :: number

		local RightX = buffer.readf32(DirectionsBuffer, DirOffset + 24) :: number
		local RightY = buffer.readf32(DirectionsBuffer, DirOffset + 28) :: number
		local RightZ = buffer.readf32(DirectionsBuffer, DirOffset + 32) :: number

		if RightX * RightX + RightY * RightY + RightZ * RightZ < 0.5 then
			LookX, LookY, LookZ = 0, 0, -1
			UpX, UpY, UpZ = 0, 1, 0
			RightX, RightY, RightZ = 1, 0, 0
		end

		const WorldExtentX =
			math.abs(RightX) * HalfSizeX + math.abs(UpX) * HalfSizeY + math.abs(LookX) * HalfSizeZ :: number
		const WorldExtentY =
			math.abs(RightY) * HalfSizeX + math.abs(UpY) * HalfSizeY + math.abs(LookY) * HalfSizeZ :: number
		const WorldExtentZ =
			math.abs(RightZ) * HalfSizeX + math.abs(UpZ) * HalfSizeY + math.abs(LookZ) * HalfSizeZ :: number

		const BoundsOffset = (EntityId - 1) * ITEM_BOUNDS_STRIDE :: number
		buffer.writef32(ItemBoundsBuffer, BoundsOffset, PositionX - WorldExtentX)
		buffer.writef32(ItemBoundsBuffer, BoundsOffset + 4, PositionY - WorldExtentY)
		buffer.writef32(ItemBoundsBuffer, BoundsOffset + 8, PositionZ - WorldExtentZ)
		buffer.writef32(ItemBoundsBuffer, BoundsOffset + 12, PositionX + WorldExtentX)
		buffer.writef32(ItemBoundsBuffer, BoundsOffset + 16, PositionY + WorldExtentY)
		buffer.writef32(ItemBoundsBuffer, BoundsOffset + 20, PositionZ + WorldExtentZ)
		buffer.writef32(ItemBoundsBuffer, BoundsOffset + 24, PositionX)
		buffer.writef32(ItemBoundsBuffer, BoundsOffset + 28, PositionY)
		buffer.writef32(ItemBoundsBuffer, BoundsOffset + 32, PositionZ)

		if not IsDynamic then
			StaticItemCount += 1
			buffer.writeu32(ItemIndicesBuffer, (StaticItemCount - 1) * 4, EntityId)
		end
	end

	if StaticItemCount > 0 then
		const _, NextAllocatedNodeBytes = BVHHelper.BuildSubtree(
			NodeBuffer,
			ItemBoundsBuffer,
			ItemIndicesBuffer,
			0,
			1,
			StaticItemCount,
			0
		)
		AllocatedNodeBytes = NextAllocatedNodeBytes
	end
end

-- ============================================================================
-- 2. UNIFIED 1-CALL RAYCAST (STATIC BVH + LIVE DYNAMIC OOP OBJECTS)
-- ============================================================================

--[=[
	Casts a ray through the BVH hierarchy returning the closest hit entity and OOP object.
	Accepts both (Origin, Direction, MaxDistance, IgnoreFilter, Storage) and (Storage, Origin, Direction, ...) calling styles.
	@param Arg1 any -- Ray origin (Vector3) or ECSStorage.
	@param Arg2 any -- Ray direction (Vector3) or Ray origin (Vector3).
	@param Arg3 any? -- MaxDistance (number), ECSStorage, or IgnoreFilter.
	@param Arg4 any? -- IgnoreFilter, MaxDistance (number), or ECSStorage.
	@param Arg5 any? -- ECSStorage or IgnoreFilter.
	@return number? -- Hit ECS entity ID (or nil).
	@return any? -- Hit dynamic OOP object (or nil).
	@return number -- Hit distance along ray.
	@return Vector3? -- Hit world position.
	@return Vector3? -- Hit surface outward normal.
]=]
function BVH.Raycast(
	Arg1: any,
	Arg2: any,
	Arg3: any?,
	Arg4: any?,
	Arg5: any?
): (number?, any?, number, Vector3?, Vector3?)
	local Origin: Vector3? = nil
	local DirectionVector: Vector3? = nil
	local MaxDistanceArg: number? = nil
	local IgnoreFilter: any = nil
	local ProvidedStorage: ECSMain.ECSStorage? = nil

	if typeof(Arg1) == "Vector3" then
		Origin = Arg1
		DirectionVector = if typeof(Arg2) == "Vector3" then Arg2 else nil
		if type(Arg3) == "number" then
			MaxDistanceArg = Arg3
			if BVHHelper.IsECSStorage(Arg4) then
				ProvidedStorage = Arg4
				IgnoreFilter = Arg5
			else
				IgnoreFilter = Arg4
				ProvidedStorage = if BVHHelper.IsECSStorage(Arg5) then Arg5 else nil
			end
		elseif BVHHelper.IsECSStorage(Arg3) then
			ProvidedStorage = Arg3
			if type(Arg4) == "number" then
				MaxDistanceArg = Arg4
				IgnoreFilter = Arg5
			else
				IgnoreFilter = Arg4
			end
		else
			IgnoreFilter = Arg3
			ProvidedStorage = if BVHHelper.IsECSStorage(Arg4)
				then Arg4
				elseif BVHHelper.IsECSStorage(Arg5) then Arg5
				else nil
		end
	elseif BVHHelper.IsECSStorage(Arg1) then
		ProvidedStorage = Arg1
		Origin = if typeof(Arg2) == "Vector3" then Arg2 else nil
		DirectionVector = if typeof(Arg3) == "Vector3" then Arg3 else nil
		if type(Arg4) == "number" then
			MaxDistanceArg = Arg4
			IgnoreFilter = Arg5
		else
			IgnoreFilter = Arg4
		end
	end

	if not Origin or not DirectionVector then
		return nil, nil, 0, nil, nil
	end

	const OriginX: number, OriginY: number, OriginZ: number = Origin.X, Origin.Y, Origin.Z
	if
		OriginX ~= OriginX
		or OriginY ~= OriginY
		or OriginZ ~= OriginZ
		or math.abs(OriginX) == math.huge
		or math.abs(OriginY) == math.huge
		or math.abs(OriginZ) == math.huge
	then
		return nil, nil, 0, nil, nil
	end

	const DirectionLength = DirectionVector.Magnitude :: number
	if not (DirectionLength > 1e-8 and DirectionLength < math.huge) then
		return nil, nil, 0, nil, nil
	end

	if MaxDistanceArg ~= nil and not (MaxDistanceArg > 0) then
		return nil, nil, 0, nil, nil
	end

	const InverseDirectionLength = 1 / DirectionLength :: number
	const DirectionX = DirectionVector.X * InverseDirectionLength :: number
	const DirectionY = DirectionVector.Y * InverseDirectionLength :: number
	const DirectionZ = DirectionVector.Z * InverseDirectionLength :: number
	const MaxDistance = if MaxDistanceArg then math.min(MaxDistanceArg, 1e15) else DirectionLength :: number

	const Storage = BVHHelper.ResolveStorage(ProvidedStorage)
	if not Storage then
		return nil, nil, MaxDistance, nil, nil
	end

	const RawEntityCount = Storage.ECSData.GetCounts().EntityECSCount :: number
	const EntityCount = math.clamp(RawEntityCount, 0, MAX_ENTITIES) :: number
	local ShouldRebuild: boolean
	ShouldRebuild, MutationScanCursor = BVHHelper.NeedsRebuild(
		Storage,
		ActiveStorage,
		EntityCount,
		LastBuiltEntityCount,
		LastDynamicActiveCount,
		LastDynamicNextId,
		MutationScanCursor,
		CachedStateBuffer,
		EntityIsDynamicBuffer,
		ItemBoundsBuffer
	)
	if ShouldRebuild then
		BVH.Rebuild(Storage)
	end

	const InverseDirectionX = if math.abs(DirectionX) > 1e-8
		then 1 / DirectionX
		else (if DirectionX >= 0 then 1e30 else -1e30) :: number
	const InverseDirectionY = if math.abs(DirectionY) > 1e-8
		then 1 / DirectionY
		else (if DirectionY >= 0 then 1e30 else -1e30) :: number
	const InverseDirectionZ = if math.abs(DirectionZ) > 1e-8
		then 1 / DirectionZ
		else (if DirectionZ >= 0 then 1e30 else -1e30) :: number

	const PositionBuffer = Storage.PositionData.GetData() :: buffer
	const SizeBuffer = Storage.SizeData.GetData() :: buffer
	const DirectionsBuffer = Storage.DirectionsData.GetData() :: buffer
	const PropertiesBuffer = Storage.PropertiesData.GetData() :: buffer
	const DynamicObjectsList = Storage.DynamicObjectsList

	RayGeneration += 1
	const CurrentRayGen = RayGeneration :: number
	const IgnoredId = if type(IgnoreFilter) == "number" then IgnoreFilter else 0 :: number
	const HasComplexIgnore = (IgnoreFilter ~= nil and type(IgnoreFilter) ~= "number") :: boolean

	local ClosestDistance = MaxDistance :: number
	local HitEntityId = 0 :: number
	local HitDynamicObject: any = nil
	local BestNormalX: number, BestNormalY: number, BestNormalZ: number = 0, 1, 0

	-- 1. Traverse Flat-Buffer Static BVH (Near-First Child Ordering)
	if AllocatedNodeBytes > 0 then
		const RootHit, _ = BVHMath.TestNodeAABB(
			NodeBuffer,
			0,
			OriginX,
			OriginY,
			OriginZ,
			InverseDirectionX,
			InverseDirectionY,
			InverseDirectionZ,
			ClosestDistance
		)
		if RootHit then
			local StackTop = 1 :: number
			buffer.writeu32(TraversalStackBuffer, 0, 0)

			while StackTop > 0 do
				StackTop -= 1
				const NodeOffset = buffer.readu32(TraversalStackBuffer, StackTop * 4) :: number
				const RightOffset = buffer.readu32(NodeBuffer, NodeOffset + 28) :: number

				if RightOffset == 0 then
					const EntityId = buffer.readu32(NodeBuffer, NodeOffset + 12) :: number
					if EntityId == IgnoredId or EntityId < 1 or EntityId > EntityCount then
						continue
					end

					if HasComplexIgnore then
						const EntityObj = if DynamicObjectsList
							then DynamicObjectsList.GetObjectByEntityId(EntityId)
							else nil
						if BVHHelper.IsIgnored(EntityId, EntityObj, IgnoredId, IgnoreFilter) then
							continue
						end
					end

					buffer.writeu32(TestedGenBuffer, EntityId * 4, CurrentRayGen)

					const Hit, HitDistance, NormalX, NormalY, NormalZ = BVHMath.TestEntityOBB(
						EntityId,
						OriginX,
						OriginY,
						OriginZ,
						DirectionX,
						DirectionY,
						DirectionZ,
						ClosestDistance,
						PositionBuffer,
						SizeBuffer,
						DirectionsBuffer,
						PropertiesBuffer
					)
					if Hit then
						ClosestDistance = HitDistance
						HitEntityId = EntityId
						HitDynamicObject = nil
						BestNormalX, BestNormalY, BestNormalZ = NormalX, NormalY, NormalZ
					end
				else
					const LeftOffset = buffer.readu32(NodeBuffer, NodeOffset + 12) :: number
					const HitLeft, DistanceLeft = BVHMath.TestNodeAABB(
						NodeBuffer,
						LeftOffset,
						OriginX,
						OriginY,
						OriginZ,
						InverseDirectionX,
						InverseDirectionY,
						InverseDirectionZ,
						ClosestDistance
					)
					const HitRight, DistanceRight = BVHMath.TestNodeAABB(
						NodeBuffer,
						RightOffset,
						OriginX,
						OriginY,
						OriginZ,
						InverseDirectionX,
						InverseDirectionY,
						InverseDirectionZ,
						ClosestDistance
					)

					if HitLeft and HitRight then
						if StackTop + 2 <= STACK_CAPACITY then
							if DistanceLeft < DistanceRight then
								buffer.writeu32(TraversalStackBuffer, StackTop * 4, RightOffset)
								buffer.writeu32(TraversalStackBuffer, (StackTop + 1) * 4, LeftOffset)
							else
								buffer.writeu32(TraversalStackBuffer, StackTop * 4, LeftOffset)
								buffer.writeu32(TraversalStackBuffer, (StackTop + 1) * 4, RightOffset)
							end
							StackTop += 2
						end
					elseif HitLeft and StackTop < STACK_CAPACITY then
						buffer.writeu32(TraversalStackBuffer, StackTop * 4, LeftOffset)
						StackTop += 1
					elseif HitRight and StackTop < STACK_CAPACITY then
						buffer.writeu32(TraversalStackBuffer, StackTop * 4, RightOffset)
						StackTop += 1
					end
				end
			end
		end
	end

	-- 2. Live Pass for Dynamic Entities
	for i = 0, DynamicEntityCount - 1 do
		const EntityId = buffer.readu32(DynamicEntitiesBuffer, i * 4) :: number
		if EntityId == IgnoredId or EntityId < 1 or EntityId > EntityCount then
			continue
		end
		if buffer.readu32(TestedGenBuffer, EntityId * 4) == CurrentRayGen then
			continue
		end

		if HasComplexIgnore then
			const EntityObj = if DynamicObjectsList then DynamicObjectsList.GetObjectByEntityId(EntityId) else nil
			if BVHHelper.IsIgnored(EntityId, EntityObj, IgnoredId, IgnoreFilter) then
				continue
			end
		end

		buffer.writeu32(TestedGenBuffer, EntityId * 4, CurrentRayGen)

		const Hit, HitDistance, NormalX, NormalY, NormalZ = BVHMath.TestEntityOBB(
			EntityId,
			OriginX,
			OriginY,
			OriginZ,
			DirectionX,
			DirectionY,
			DirectionZ,
			ClosestDistance,
			PositionBuffer,
			SizeBuffer,
			DirectionsBuffer,
			PropertiesBuffer
		)
		if Hit then
			ClosestDistance = HitDistance
			HitEntityId = EntityId
			HitDynamicObject = nil
			BestNormalX, BestNormalY, BestNormalZ = NormalX, NormalY, NormalZ
		end
	end

	-- 3. Live Pass for Registered Dynamic OOP Objects (Bound or Standalone)
	if DynamicObjectsList and DynamicObjectsList.Counts.ActiveCount > 0 then
		const ObjectsTable = DynamicObjectsList.ObjectsTable
		const MaxDynId = DynamicObjectsList.Counts.NextId :: number

		for DynId = 1, MaxDynId do
			const DynObject = ObjectsTable[DynId]
			if DynObject == nil then
				continue
			end

			const BoundEntityId = DynamicObjectsList.GetBoundEntityId(DynId) :: number
			if BoundEntityId > 0 and BoundEntityId <= EntityCount then
				if BoundEntityId == IgnoredId or buffer.readu32(TestedGenBuffer, BoundEntityId * 4) == CurrentRayGen then
					continue
				end
				if HasComplexIgnore and BVHHelper.IsIgnored(BoundEntityId, DynObject, IgnoredId, IgnoreFilter) then
					continue
				end

				buffer.writeu32(TestedGenBuffer, BoundEntityId * 4, CurrentRayGen)

				const Hit, HitDistance, NormalX, NormalY, NormalZ = BVHMath.TestEntityOBB(
					BoundEntityId,
					OriginX,
					OriginY,
					OriginZ,
					DirectionX,
					DirectionY,
					DirectionZ,
					ClosestDistance,
					PositionBuffer,
					SizeBuffer,
					DirectionsBuffer,
					PropertiesBuffer
				)
				if Hit then
					ClosestDistance = HitDistance
					HitEntityId = BoundEntityId
					HitDynamicObject = DynObject
					BestNormalX, BestNormalY, BestNormalZ = NormalX, NormalY, NormalZ
				end
			elseif type(DynObject) == "table" or typeof(DynObject) == "Instance" then
				const ObjEntityId = if type(DynObject) == "table" and type((DynObject :: any).EntityId) == "number"
					then (DynObject :: any).EntityId :: number
					else 0
				if BVHHelper.IsIgnored(ObjEntityId, DynObject, IgnoredId, IgnoreFilter) then
					continue
				end
				if type(DynObject) == "table" and (DynObject :: any).CanCollide == false then
					continue
				end

				const ObjCFrame: CFrame? = (DynObject :: any).CFrame
				const ObjPos: Vector3? = if typeof(ObjCFrame) == "CFrame"
					then ObjCFrame.Position
					else (DynObject :: any).Position
				const ObjSize: Vector3? = (DynObject :: any).Size

				if typeof(ObjPos) == "Vector3" and typeof(ObjSize) == "Vector3" then
					const HalfSizeX = math.abs(ObjSize.X) * 0.5 :: number
					const HalfSizeY = math.abs(ObjSize.Y) * 0.5 :: number
					const HalfSizeZ = math.abs(ObjSize.Z) * 0.5 :: number

					local RightX: number, RightY: number, RightZ: number = 1, 0, 0
					local UpX: number, UpY: number, UpZ: number = 0, 1, 0
					local LookX: number, LookY: number, LookZ: number = 0, 0, -1

					if typeof(ObjCFrame) == "CFrame" then
						const Right = ObjCFrame.RightVector
						const Up = ObjCFrame.UpVector
						const Look = ObjCFrame.LookVector
						RightX, RightY, RightZ = Right.X, Right.Y, Right.Z
						UpX, UpY, UpZ = Up.X, Up.Y, Up.Z
						LookX, LookY, LookZ = Look.X, Look.Y, Look.Z
					end

					const Hit, HitDistance, NormalX, NormalY, NormalZ = BVHMath.TestBoxOBB(
						OriginX,
						OriginY,
						OriginZ,
						DirectionX,
						DirectionY,
						DirectionZ,
						ObjPos.X,
						ObjPos.Y,
						ObjPos.Z,
						HalfSizeX,
						HalfSizeY,
						HalfSizeZ,
						RightX,
						RightY,
						RightZ,
						UpX,
						UpY,
						UpZ,
						LookX,
						LookY,
						LookZ,
						ClosestDistance
					)
					if Hit then
						ClosestDistance = HitDistance
						HitEntityId = ObjEntityId
						HitDynamicObject = DynObject
						BestNormalX, BestNormalY, BestNormalZ = NormalX, NormalY, NormalZ
					end
				end
			end
		end
	end

	if HitEntityId == 0 and HitDynamicObject == nil then
		return nil, nil, MaxDistance, nil, nil
	end

	if HitDynamicObject == nil and HitEntityId > 0 and DynamicObjectsList then
		const PropRegister = buffer.readu32(PropertiesBuffer, (HitEntityId - 1) * PROPERTIES_STRIDE) :: number
		if bit32.btest(PropRegister, FLAG_HAS_DYNAMIC_ID) then
			const DynId = bit32.rshift(PropRegister, DYNAMIC_ID_SHIFT) :: number
			HitDynamicObject = DynamicObjectsList.ObjectsTable[DynId]
		end
	end

	const HitPosition = Vector3.new(
		OriginX + DirectionX * ClosestDistance,
		OriginY + DirectionY * ClosestDistance,
		OriginZ + DirectionZ * ClosestDistance
	) :: Vector3
	const HitNormal = Vector3.new(BestNormalX, BestNormalY, BestNormalZ) :: Vector3

	return if HitEntityId > 0 then HitEntityId else nil, HitDynamicObject, ClosestDistance, HitPosition, HitNormal
end

-- ============================================================================
-- 3. FAST AABB SPATIAL QUERY
-- ============================================================================

--[=[
	Queries the spatial tree for all entities whose bounding boxes overlap the given AABB.
	@param QueryMin Vector3 -- Minimum query bounds corner.
	@param QueryMax Vector3 -- Maximum query bounds corner.
	@param ResultsTable { number }? -- Optional reusable table to fill with hit entity IDs.
	@param ProvidedStorage ECSMain.ECSStorage? -- Target ECS storage.
	@return number -- Total count of overlapping entities found.
]=]
function BVH.QueryAABB(
	QueryMin: Vector3,
	QueryMax: Vector3,
	ResultsTable: { number }?,
	ProvidedStorage: ECSMain.ECSStorage?
): number
	if typeof(QueryMin) ~= "Vector3" or typeof(QueryMax) ~= "Vector3" then
		return 0
	end

	const Storage = BVHHelper.ResolveStorage(ProvidedStorage)
	if not Storage then
		return 0
	end

	const RawEntityCount = Storage.ECSData.GetCounts().EntityECSCount :: number
	const EntityCount = math.clamp(RawEntityCount, 0, MAX_ENTITIES) :: number
	local ShouldRebuild: boolean
	ShouldRebuild, MutationScanCursor = BVHHelper.NeedsRebuild(
		Storage,
		ActiveStorage,
		EntityCount,
		LastBuiltEntityCount,
		LastDynamicActiveCount,
		LastDynamicNextId,
		MutationScanCursor,
		CachedStateBuffer,
		EntityIsDynamicBuffer,
		ItemBoundsBuffer
	)
	if ShouldRebuild then
		BVH.Rebuild(Storage)
	end

	const QueryMinX = math.min(QueryMin.X, QueryMax.X) :: number
	const QueryMinY = math.min(QueryMin.Y, QueryMax.Y) :: number
	const QueryMinZ = math.min(QueryMin.Z, QueryMax.Z) :: number
	const QueryMaxX = math.max(QueryMin.X, QueryMax.X) :: number
	const QueryMaxY = math.max(QueryMin.Y, QueryMax.Y) :: number
	const QueryMaxZ = math.max(QueryMin.Z, QueryMax.Z) :: number

	local ResultCount = 0 :: number

	if AllocatedNodeBytes > 0 then
		local StackTop = 1 :: number
		buffer.writeu32(TraversalStackBuffer, 0, 0)

		while StackTop > 0 do
			StackTop -= 1
			const NodeOffset = buffer.readu32(TraversalStackBuffer, StackTop * 4) :: number

			if
				buffer.readf32(NodeBuffer, NodeOffset) > QueryMaxX
				or buffer.readf32(NodeBuffer, NodeOffset + 16) < QueryMinX
				or buffer.readf32(NodeBuffer, NodeOffset + 4) > QueryMaxY
				or buffer.readf32(NodeBuffer, NodeOffset + 20) < QueryMinY
				or buffer.readf32(NodeBuffer, NodeOffset + 8) > QueryMaxZ
				or buffer.readf32(NodeBuffer, NodeOffset + 24) < QueryMinZ
			then
				continue
			end

			const RightOffset = buffer.readu32(NodeBuffer, NodeOffset + 28) :: number
			if RightOffset == 0 then
				const EntityId = buffer.readu32(NodeBuffer, NodeOffset + 12) :: number
				if EntityId >= 1 and EntityId <= EntityCount then
					ResultCount += 1
					if ResultsTable then
						ResultsTable[ResultCount] = EntityId
					end
				end
			else
				const LeftOffset = buffer.readu32(NodeBuffer, NodeOffset + 12) :: number
				if StackTop + 2 <= STACK_CAPACITY then
					buffer.writeu32(TraversalStackBuffer, StackTop * 4, LeftOffset)
					buffer.writeu32(TraversalStackBuffer, (StackTop + 1) * 4, RightOffset)
					StackTop += 2
				end
			end
		end
	end

	const PositionBuffer = Storage.PositionData.GetData() :: buffer
	const SizeBuffer = Storage.SizeData.GetData() :: buffer
	const DirectionsBuffer = Storage.DirectionsData.GetData() :: buffer
	const PropertiesBuffer = Storage.PropertiesData.GetData() :: buffer

	for i = 0, DynamicEntityCount - 1 do
		const EntityId = buffer.readu32(DynamicEntitiesBuffer, i * 4) :: number
		if EntityId < 1 or EntityId > EntityCount then
			continue
		end

		const PropRegister = buffer.readu32(PropertiesBuffer, (EntityId - 1) * PROPERTIES_STRIDE) :: number
		if PropRegister ~= 0 and not bit32.btest(PropRegister, FLAG_CAN_COLLIDE) then
			continue
		end

		const CompOffset = (EntityId - 1) * COMPONENT_STRIDE :: number
		const DirOffset = (EntityId - 1) * DIRECTION_STRIDE :: number

		const PositionX = buffer.readf32(PositionBuffer, CompOffset) :: number
		const PositionY = buffer.readf32(PositionBuffer, CompOffset + 4) :: number
		const PositionZ = buffer.readf32(PositionBuffer, CompOffset + 8) :: number

		const HalfSizeX = math.abs(buffer.readf32(SizeBuffer, CompOffset)) * 0.5 :: number
		const HalfSizeY = math.abs(buffer.readf32(SizeBuffer, CompOffset + 4)) * 0.5 :: number
		const HalfSizeZ = math.abs(buffer.readf32(SizeBuffer, CompOffset + 8)) * 0.5 :: number

		local LookX = buffer.readf32(DirectionsBuffer, DirOffset) :: number
		local LookY = buffer.readf32(DirectionsBuffer, DirOffset + 4) :: number
		local LookZ = buffer.readf32(DirectionsBuffer, DirOffset + 8) :: number

		local UpX = buffer.readf32(DirectionsBuffer, DirOffset + 12) :: number
		local UpY = buffer.readf32(DirectionsBuffer, DirOffset + 16) :: number
		local UpZ = buffer.readf32(DirectionsBuffer, DirOffset + 20) :: number

		local RightX = buffer.readf32(DirectionsBuffer, DirOffset + 24) :: number
		local RightY = buffer.readf32(DirectionsBuffer, DirOffset + 28) :: number
		local RightZ = buffer.readf32(DirectionsBuffer, DirOffset + 32) :: number

		if RightX * RightX + RightY * RightY + RightZ * RightZ < 0.5 then
			LookX, LookY, LookZ = 0, 0, -1
			UpX, UpY, UpZ = 0, 1, 0
			RightX, RightY, RightZ = 1, 0, 0
		end

		const WorldExtentX =
			math.abs(RightX) * HalfSizeX + math.abs(UpX) * HalfSizeY + math.abs(LookX) * HalfSizeZ :: number
		const WorldExtentY =
			math.abs(RightY) * HalfSizeX + math.abs(UpY) * HalfSizeY + math.abs(LookY) * HalfSizeZ :: number
		const WorldExtentZ =
			math.abs(RightZ) * HalfSizeX + math.abs(UpZ) * HalfSizeY + math.abs(LookZ) * HalfSizeZ :: number

		if
			PositionX - WorldExtentX <= QueryMaxX
			and PositionX + WorldExtentX >= QueryMinX
			and PositionY - WorldExtentY <= QueryMaxY
			and PositionY + WorldExtentY >= QueryMinY
			and PositionZ - WorldExtentZ <= QueryMaxZ
			and PositionZ + WorldExtentZ >= QueryMinZ
		then
			ResultCount += 1
			if ResultsTable then
				ResultsTable[ResultCount] = EntityId
			end
		end
	end

	return ResultCount
end

setmetatable(BVH, {
	__call = function(_, ...: any)
		return BVH.Raycast(...)
	end,
})

return BVH
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">BVHHelper</string>
              <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const Players = game:GetService("Players")
const ReplicatedStorage = game:GetService("ReplicatedStorage")
const RunService = game:GetService("RunService")
const ServerScriptService = game:GetService("ServerScriptService")

-- Static References --
const IS_SERVER = RunService:IsServer() :: boolean
const SelfActor = script:GetActor() :: Actor?

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))
const ECSMain = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ECSMain"))

-- Configs --
const COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number
const DIRECTION_STRIDE = SystemsConfigs.ECSDirectionStride :: number
const PROPERTIES_STRIDE = SystemsConfigs.ECSPropertiesStride :: number
const MAX_ENTITIES = SystemsConfigs.ECSMaxEntities :: number
const STACK_CAPACITY = SystemsConfigs.BVHStackCapacity :: number
const MUTATION_SCAN_BUDGET = SystemsConfigs.BVHMutationScanBudget :: number

const NODE_STRIDE = 32 :: number
const ITEM_BOUNDS_STRIDE = 36 :: number
const CACHED_STATE_STRIDE = 28 :: number
const MAX_BVH_NODES = MAX_ENTITIES * 2 :: number
const MAX_NODE_BYTES = MAX_BVH_NODES * NODE_STRIDE :: number
const SAFE_BALANCED_DEPTH = math.max(16, STACK_CAPACITY - 16) :: number

-- Tables --
local DefaultServerStorage: ECSMain.ECSStorage? = nil
local DefaultClientStorage: ECSMain.ECSStorage? = nil
local DefaultRenderStorage: ECSMain.ECSStorage? = nil

local BVHHelper = {}

-- ============================================================================
-- 1. STORAGE RESOLUTION, MUTATION DETECTION & SUBTREE BUILDER HELPERS
-- ============================================================================

--[=[
	Validates whether a table matches the ECSStorage structure.
	@param Candidate any -- Object to validate.
	@return boolean -- True if table has required ECSStorage components.
]=]
function BVHHelper.IsECSStorage(Candidate: any): boolean
	return type(Candidate) == "table"
		and Candidate.ECSData ~= nil
		and Candidate.PositionData ~= nil
		and Candidate.SizeData ~= nil
		and Candidate.DirectionsData ~= nil
end

--[=[
	Resolves the appropriate active ECS storage instance on client or server.
	@param ProvidedStorage ECSMain.ECSStorage? -- Explicit storage override.
	@return ECSMain.ECSStorage? -- Resolved ECSStorage structure.
]=]
function BVHHelper.ResolveStorage(ProvidedStorage: ECSMain.ECSStorage?): ECSMain.ECSStorage?
	if ProvidedStorage and BVHHelper.IsECSStorage(ProvidedStorage) then
		return ProvidedStorage
	end

	if IS_SERVER then
		if not DefaultServerStorage then
			const ServerFolder = ServerScriptService:FindFirstChild("Server")
			const ObjectsFolder = if ServerFolder then ServerFolder:FindFirstChild("Objects") else nil
			const ObjectsECS = if ObjectsFolder then ObjectsFolder:FindFirstChild("ObjectsECS") else nil
			const StorageModule = if ObjectsECS then ObjectsECS:FindFirstChild("Storage") else nil
			if StorageModule and StorageModule:IsA("ModuleScript") then
				DefaultServerStorage = (require :: any)(StorageModule) :: ECSMain.ECSStorage
			end
		end
		return DefaultServerStorage
	end

	if not DefaultClientStorage then
		const ActorStorage = if SelfActor then SelfActor:FindFirstChild("ObjectStorage") else nil
		if ActorStorage and ActorStorage:IsA("ModuleScript") then
			DefaultClientStorage = (require :: any)(ActorStorage) :: ECSMain.ECSStorage
		else
			const LocalPlayer = Players.LocalPlayer :: Player?
			const PlayerScripts = if LocalPlayer then LocalPlayer:FindFirstChild("PlayerScripts") else nil
			const ControllerActor = if PlayerScripts then PlayerScripts:FindFirstChild("Controller") else nil
			const ControllerStorage = if ControllerActor then ControllerActor:FindFirstChild("ObjectStorage") else nil
			if ControllerStorage and ControllerStorage:IsA("ModuleScript") then
				DefaultClientStorage = (require :: any)(ControllerStorage) :: ECSMain.ECSStorage
			elseif PlayerScripts then
				const ClientFolder = PlayerScripts:FindFirstChild("Client")
				const ObjectsFolder = if ClientFolder then ClientFolder:FindFirstChild("Objects") else nil
				const ObjStorage = if ObjectsFolder then ObjectsFolder:FindFirstChild("ObjectStorage") else nil
				if ObjStorage and ObjStorage:IsA("ModuleScript") then
					DefaultClientStorage = (require :: any)(ObjStorage) :: ECSMain.ECSStorage
				end
			end
		end
	end

	if DefaultClientStorage and DefaultClientStorage.ECSData.GetCounts().EntityECSCount > 0 then
		return DefaultClientStorage
	end

	if not DefaultRenderStorage then
		const SharedFolder = ReplicatedStorage:FindFirstChild("Shared")
		const UtilitiesFolder = if SharedFolder then SharedFolder:FindFirstChild("Utilities") else nil
		const RenderFolder = if UtilitiesFolder then UtilitiesFolder:FindFirstChild("Render") else nil
		const RenderStorageModule = if RenderFolder then RenderFolder:FindFirstChild("ECSStorage") else nil
		if RenderStorageModule and RenderStorageModule:IsA("ModuleScript") then
			DefaultRenderStorage = (require :: any)(RenderStorageModule) :: ECSMain.ECSStorage
		end
	end

	return DefaultRenderStorage or DefaultClientStorage
end

--[=[
	Checks whether the BVH hierarchy requires a rebuild due to count or entity transform mutations.
	@param Storage ECSMain.ECSStorage -- Active ECS storage.
	@param ActiveStorage ECSMain.ECSStorage? -- Last built storage reference.
	@param EntityCount number -- Current entity count.
	@param LastBuiltEntityCount number -- Entity count from last build.
	@param LastDynamicActiveCount number -- Dynamic count from last build.
	@param LastDynamicNextId number -- Dynamic NextId from last build.
	@param MutationScanCursor number -- Scanning cursor offset.
	@param CachedStateBuffer buffer -- Cached entity transform buffer.
	@param EntityIsDynamicBuffer buffer -- Dynamic entity boolean buffer.
	@param ItemBoundsBuffer buffer -- Item bounding boxes buffer.
	@return (boolean, number) -- NeedsRebuild, NextMutationScanCursor.
]=]
function BVHHelper.NeedsRebuild(
	Storage: ECSMain.ECSStorage,
	ActiveStorage: ECSMain.ECSStorage?,
	EntityCount: number,
	LastBuiltEntityCount: number,
	LastDynamicActiveCount: number,
	LastDynamicNextId: number,
	MutationScanCursor: number,
	CachedStateBuffer: buffer,
	EntityIsDynamicBuffer: buffer,
	ItemBoundsBuffer: buffer
): (boolean, number)
	if Storage ~= ActiveStorage or EntityCount ~= LastBuiltEntityCount then
		return true, MutationScanCursor
	end

	const DynList = Storage.DynamicObjectsList
	if DynList then
		if DynList.Counts.ActiveCount ~= LastDynamicActiveCount or DynList.Counts.NextId ~= LastDynamicNextId then
			return true, MutationScanCursor
		end
	end

	if EntityCount <= 0 then
		return false, MutationScanCursor
	end

	const PositionBuffer = Storage.PositionData.GetData() :: buffer
	const SizeBuffer = Storage.SizeData.GetData() :: buffer
	const DirectionsBuffer = Storage.DirectionsData.GetData() :: buffer
	const PropertiesBuffer = Storage.PropertiesData.GetData() :: buffer

	const CheckCount = math.min(EntityCount, MUTATION_SCAN_BUDGET) :: number
	local EntityId = MutationScanCursor :: number
	if EntityId < 1 or EntityId > EntityCount then
		EntityId = 1
	end

	for _ = 1, CheckCount do
		const StateOffset = (EntityId - 1) * CACHED_STATE_STRIDE :: number
		const PropOffset = (EntityId - 1) * PROPERTIES_STRIDE :: number
		const CurrentProp = buffer.readu32(PropertiesBuffer, PropOffset) :: number

		if CurrentProp ~= buffer.readu32(CachedStateBuffer, StateOffset + 24) then
			return true, EntityId
		end

		if buffer.readu8(EntityIsDynamicBuffer, EntityId) == 0 then
			const CompOffset = (EntityId - 1) * COMPONENT_STRIDE :: number
			const DirOffset = (EntityId - 1) * DIRECTION_STRIDE :: number
			const BoundsOffset = (EntityId - 1) * ITEM_BOUNDS_STRIDE :: number

			if
				buffer.readf32(PositionBuffer, CompOffset) ~= buffer.readf32(ItemBoundsBuffer, BoundsOffset + 24)
				or buffer.readf32(PositionBuffer, CompOffset + 4) ~= buffer.readf32(ItemBoundsBuffer, BoundsOffset + 28)
				or buffer.readf32(PositionBuffer, CompOffset + 8) ~= buffer.readf32(ItemBoundsBuffer, BoundsOffset + 32)
				or buffer.readf32(SizeBuffer, CompOffset) ~= buffer.readf32(CachedStateBuffer, StateOffset)
				or buffer.readf32(SizeBuffer, CompOffset + 4) ~= buffer.readf32(CachedStateBuffer, StateOffset + 4)
				or buffer.readf32(SizeBuffer, CompOffset + 8) ~= buffer.readf32(CachedStateBuffer, StateOffset + 8)
				or buffer.readf32(DirectionsBuffer, DirOffset) ~= buffer.readf32(CachedStateBuffer, StateOffset + 12)
				or buffer.readf32(DirectionsBuffer, DirOffset + 16)
					~= buffer.readf32(CachedStateBuffer, StateOffset + 16)
				or buffer.readf32(DirectionsBuffer, DirOffset + 32)
					~= buffer.readf32(CachedStateBuffer, StateOffset + 20)
			then
				return true, EntityId
			end
		end

		EntityId += 1
		if EntityId > EntityCount then
			EntityId = 1
		end
	end

	return false, EntityId
end

--[=[
	Recursively partitions entity bounding boxes and builds a flat binary BVH subtree into the node buffer.
	@param NodeBuffer buffer -- Destination BVH tree node buffer.
	@param ItemBoundsBuffer buffer -- Item bounding boxes buffer.
	@param ItemIndicesBuffer buffer -- Array of entity indices being partitioned.
	@param AllocatedNodeBytes number -- Current byte offset in node buffer.
	@param StartIdx number -- Start index in item indices buffer.
	@param EndIdx number -- End index in item indices buffer.
	@param Depth number -- Current tree recursion depth.
	@return (number, number) -- NodeOffset, NextAllocatedBytes.
]=]
function BVHHelper.BuildSubtree(
	NodeBuffer: buffer,
	ItemBoundsBuffer: buffer,
	ItemIndicesBuffer: buffer,
	AllocatedNodeBytes: number,
	StartIdx: number,
	EndIdx: number,
	Depth: number
): (number, number)
	const NodeOffset = AllocatedNodeBytes :: number
	local NextAllocatedBytes = AllocatedNodeBytes + NODE_STRIDE :: number

	local MinX: number, MinY: number, MinZ: number = math.huge, math.huge, math.huge
	local MaxX: number, MaxY: number, MaxZ: number = -math.huge, -math.huge, -math.huge
	local CenterMinX: number, CenterMinY: number, CenterMinZ: number = math.huge, math.huge, math.huge
	local CenterMaxX: number, CenterMaxY: number, CenterMaxZ: number = -math.huge, -math.huge, -math.huge

	for i = StartIdx, EndIdx do
		const EntityId = buffer.readu32(ItemIndicesBuffer, (i - 1) * 4) :: number
		const BoundsOffset = (EntityId - 1) * ITEM_BOUNDS_STRIDE :: number

		const BoundMinX = buffer.readf32(ItemBoundsBuffer, BoundsOffset) :: number
		const BoundMinY = buffer.readf32(ItemBoundsBuffer, BoundsOffset + 4) :: number
		const BoundMinZ = buffer.readf32(ItemBoundsBuffer, BoundsOffset + 8) :: number
		const BoundMaxX = buffer.readf32(ItemBoundsBuffer, BoundsOffset + 12) :: number
		const BoundMaxY = buffer.readf32(ItemBoundsBuffer, BoundsOffset + 16) :: number
		const BoundMaxZ = buffer.readf32(ItemBoundsBuffer, BoundsOffset + 20) :: number
		const CenterX = buffer.readf32(ItemBoundsBuffer, BoundsOffset + 24) :: number
		const CenterY = buffer.readf32(ItemBoundsBuffer, BoundsOffset + 28) :: number
		const CenterZ = buffer.readf32(ItemBoundsBuffer, BoundsOffset + 32) :: number

		if BoundMinX < MinX then MinX = BoundMinX end
		if BoundMinY < MinY then MinY = BoundMinY end
		if BoundMinZ < MinZ then MinZ = BoundMinZ end
		if BoundMaxX > MaxX then MaxX = BoundMaxX end
		if BoundMaxY > MaxY then MaxY = BoundMaxY end
		if BoundMaxZ > MaxZ then MaxZ = BoundMaxZ end

		if CenterX < CenterMinX then CenterMinX = CenterX end
		if CenterY < CenterMinY then CenterMinY = CenterY end
		if CenterZ < CenterMinZ then CenterMinZ = CenterZ end
		if CenterX > CenterMaxX then CenterMaxX = CenterX end
		if CenterY > CenterMaxY then CenterMaxY = CenterY end
		if CenterZ > CenterMaxZ then CenterMaxZ = CenterZ end
	end

	buffer.writef32(NodeBuffer, NodeOffset, MinX)
	buffer.writef32(NodeBuffer, NodeOffset + 4, MinY)
	buffer.writef32(NodeBuffer, NodeOffset + 8, MinZ)
	buffer.writef32(NodeBuffer, NodeOffset + 16, MaxX)
	buffer.writef32(NodeBuffer, NodeOffset + 20, MaxY)
	buffer.writef32(NodeBuffer, NodeOffset + 24, MaxZ)

	if StartIdx >= EndIdx or NextAllocatedBytes + (NODE_STRIDE * 2) > MAX_NODE_BYTES then
		const LeafEntityId = buffer.readu32(ItemIndicesBuffer, (StartIdx - 1) * 4) :: number
		buffer.writeu32(NodeBuffer, NodeOffset + 12, LeafEntityId)
		buffer.writeu32(NodeBuffer, NodeOffset + 28, 0)
		return NodeOffset, NextAllocatedBytes
	end

	const ExtentX = CenterMaxX - CenterMinX :: number
	const ExtentY = CenterMaxY - CenterMinY :: number
	const ExtentZ = CenterMaxZ - CenterMinZ :: number

	local AxisOffset = 24 :: number
	local SplitPosition = (CenterMinX + CenterMaxX) * 0.5 :: number
	local MaxExtent = ExtentX :: number

	if ExtentY > MaxExtent then
		AxisOffset = 28
		SplitPosition = (CenterMinY + CenterMaxY) * 0.5
		MaxExtent = ExtentY
	end
	if ExtentZ > MaxExtent then
		AxisOffset = 32
		SplitPosition = (CenterMinZ + CenterMaxZ) * 0.5
		MaxExtent = ExtentZ
	end

	local MidIndex = (StartIdx + EndIdx) // 2 :: number
	if MaxExtent > 1e-4 and Depth < SAFE_BALANCED_DEPTH then
		local LeftIndex = StartIdx :: number
		local RightIndex = EndIdx :: number

		while LeftIndex <= RightIndex do
			const LeftEntity = buffer.readu32(ItemIndicesBuffer, (LeftIndex - 1) * 4) :: number
			const CenterValue =
				buffer.readf32(ItemBoundsBuffer, (LeftEntity - 1) * ITEM_BOUNDS_STRIDE + AxisOffset) :: number
			if CenterValue < SplitPosition then
				LeftIndex += 1
			else
				const RightEntity = buffer.readu32(ItemIndicesBuffer, (RightIndex - 1) * 4) :: number
				buffer.writeu32(ItemIndicesBuffer, (LeftIndex - 1) * 4, RightEntity)
				buffer.writeu32(ItemIndicesBuffer, (RightIndex - 1) * 4, LeftEntity)
				RightIndex -= 1
			end
		end

		if LeftIndex > StartIdx and LeftIndex <= EndIdx then
			MidIndex = LeftIndex - 1
		end
	end

	const NextDepth = Depth + 1 :: number
	local LeftNodeOffset: number
	LeftNodeOffset, NextAllocatedBytes = BVHHelper.BuildSubtree(
		NodeBuffer,
		ItemBoundsBuffer,
		ItemIndicesBuffer,
		NextAllocatedBytes,
		StartIdx,
		MidIndex,
		NextDepth
	)

	local RightNodeOffset: number
	RightNodeOffset, NextAllocatedBytes = BVHHelper.BuildSubtree(
		NodeBuffer,
		ItemBoundsBuffer,
		ItemIndicesBuffer,
		NextAllocatedBytes,
		MidIndex + 1,
		EndIdx,
		NextDepth
	)

	buffer.writeu32(NodeBuffer, NodeOffset + 12, LeftNodeOffset)
	buffer.writeu32(NodeBuffer, NodeOffset + 28, RightNodeOffset)

	return NodeOffset, NextAllocatedBytes
end

--[=[
	Evaluates whether an entity or OOP object matches an ignore filter.
	@param EntityId number -- Target ECS entity ID.
	@param DynObject any -- Bound OOP object reference (or nil).
	@param IgnoredId number -- Single explicit ignored entity ID.
	@param IgnoreFilter any -- Ignore filter (nil, number, OOP object, or table).
	@return boolean -- True if entity/object should be skipped.
]=]
function BVHHelper.IsIgnored(
	EntityId: number,
	DynObject: any,
	IgnoredId: number,
	IgnoreFilter: any
): boolean
	if EntityId > 0 and EntityId == IgnoredId then
		return true
	end
	if IgnoreFilter == nil then
		return false
	end
	if DynObject ~= nil and IgnoreFilter == DynObject then
		return true
	end
	if type(IgnoreFilter) == "table" then
		if EntityId > 0 and IgnoreFilter[EntityId] == true then
			return true
		end
		for _, Item in ipairs(IgnoreFilter) do
			if (EntityId > 0 and Item == EntityId) or (DynObject ~= nil and Item == DynObject) then
				return true
			end
		end
	end
	return false
end

return BVHHelper
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">BVHMath</string>
              <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))

-- Configs --
const COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number
const DIRECTION_STRIDE = SystemsConfigs.ECSDirectionStride :: number
const PROPERTIES_STRIDE = SystemsConfigs.ECSPropertiesStride :: number

const FLAG_CAN_COLLIDE = bit32.lshift(1, 1) :: number

local BVHMath = {}

-- ============================================================================
-- 1. SCALAR RAY-AABB & RAY-OBB INTERSECTION KERNELS
-- ============================================================================

--[=[
	Tests ray intersection against an axis-aligned bounding box node in the BVH tree buffer.
	@param NodeBuffer buffer -- BVH tree nodes buffer.
	@param NodeOffset number -- Byte offset of the BVH node.
	@param OriginX number -- Ray origin X.
	@param OriginY number -- Ray origin Y.
	@param OriginZ number -- Ray origin Z.
	@param InverseDirectionX number -- Precomputed 1 / direction X.
	@param InverseDirectionY number -- Precomputed 1 / direction Y.
	@param InverseDirectionZ number -- Precomputed 1 / direction Z.
	@param MaxDistance number -- Maximum valid raycast distance.
	@return (boolean, number) -- Hits, EntryDistance.
]=]
function BVHMath.TestNodeAABB(
	NodeBuffer: buffer,
	NodeOffset: number,
	OriginX: number,
	OriginY: number,
	OriginZ: number,
	InverseDirectionX: number,
	InverseDirectionY: number,
	InverseDirectionZ: number,
	MaxDistance: number
): (boolean, number)
	const MinX = buffer.readf32(NodeBuffer, NodeOffset) :: number
	const MinY = buffer.readf32(NodeBuffer, NodeOffset + 4) :: number
	const MinZ = buffer.readf32(NodeBuffer, NodeOffset + 8) :: number
	const MaxX = buffer.readf32(NodeBuffer, NodeOffset + 16) :: number
	const MaxY = buffer.readf32(NodeBuffer, NodeOffset + 20) :: number
	const MaxZ = buffer.readf32(NodeBuffer, NodeOffset + 24) :: number

	const SlabEnterX = (MinX - OriginX) * InverseDirectionX :: number
	const SlabExitX = (MaxX - OriginX) * InverseDirectionX :: number
	local NearHitDistance = math.min(SlabEnterX, SlabExitX) :: number
	local FarHitDistance = math.max(SlabEnterX, SlabExitX) :: number

	const SlabEnterY = (MinY - OriginY) * InverseDirectionY :: number
	const SlabExitY = (MaxY - OriginY) * InverseDirectionY :: number
	NearHitDistance = math.max(NearHitDistance, math.min(SlabEnterY, SlabExitY))
	FarHitDistance = math.min(FarHitDistance, math.max(SlabEnterY, SlabExitY))

	const SlabEnterZ = (MinZ - OriginZ) * InverseDirectionZ :: number
	const SlabExitZ = (MaxZ - OriginZ) * InverseDirectionZ :: number
	NearHitDistance = math.max(NearHitDistance, math.min(SlabEnterZ, SlabExitZ))
	FarHitDistance = math.min(FarHitDistance, math.max(SlabEnterZ, SlabExitZ))

	const EntryDistance = math.max(0, NearHitDistance) :: number
	return (FarHitDistance >= EntryDistance) and (EntryDistance < MaxDistance), EntryDistance
end

--[=[
	Calculates exact ray intersection, hit distance, and outward normal against an oriented bounding box (OBB).
	@param OriginX number -- Ray origin X.
	@param OriginY number -- Ray origin Y.
	@param OriginZ number -- Ray origin Z.
	@param DirectionX number -- Normalized ray direction X.
	@param DirectionY number -- Normalized ray direction Y.
	@param DirectionZ number -- Normalized ray direction Z.
	@param PositionX number -- OBB center position X.
	@param PositionY number -- OBB center position Y.
	@param PositionZ number -- OBB center position Z.
	@param HalfSizeX number -- OBB half extent X.
	@param HalfSizeY number -- OBB half extent Y.
	@param HalfSizeZ number -- OBB half extent Z.
	@param RightX number -- Basis RightVector X.
	@param RightY number -- Basis RightVector Y.
	@param RightZ number -- Basis RightVector Z.
	@param UpX number -- Basis UpVector X.
	@param UpY number -- Basis UpVector Y.
	@param UpZ number -- Basis UpVector Z.
	@param LookX number -- Basis LookVector X.
	@param LookY number -- Basis LookVector Y.
	@param LookZ number -- Basis LookVector Z.
	@param MaxDistance number -- Maximum valid raycast distance.
	@return (boolean, number, number, number, number) -- Hits, HitDistance, NormalX, NormalY, NormalZ.
]=]
function BVHMath.TestBoxOBB(
	OriginX: number,
	OriginY: number,
	OriginZ: number,
	DirectionX: number,
	DirectionY: number,
	DirectionZ: number,
	PositionX: number,
	PositionY: number,
	PositionZ: number,
	HalfSizeX: number,
	HalfSizeY: number,
	HalfSizeZ: number,
	RightX: number,
	RightY: number,
	RightZ: number,
	UpX: number,
	UpY: number,
	UpZ: number,
	LookX: number,
	LookY: number,
	LookZ: number,
	MaxDistance: number
): (boolean, number, number, number, number)
	const DeltaX = OriginX - PositionX :: number
	const DeltaY = OriginY - PositionY :: number
	const DeltaZ = OriginZ - PositionZ :: number

	const LocalOriginX = DeltaX * RightX + DeltaY * RightY + DeltaZ * RightZ :: number
	const LocalOriginY = DeltaX * UpX + DeltaY * UpY + DeltaZ * UpZ :: number
	const LocalOriginZ = DeltaX * LookX + DeltaY * LookY + DeltaZ * LookZ :: number

	const LocalDirectionX = DirectionX * RightX + DirectionY * RightY + DirectionZ * RightZ :: number
	const LocalDirectionY = DirectionX * UpX + DirectionY * UpY + DirectionZ * UpZ :: number
	const LocalDirectionZ = DirectionX * LookX + DirectionY * LookY + DirectionZ * LookZ :: number

	const InverseLocalX = if math.abs(LocalDirectionX) > 1e-8
		then 1 / LocalDirectionX
		else (if LocalDirectionX >= 0 then 1e30 else -1e30) :: number
	const InverseLocalY = if math.abs(LocalDirectionY) > 1e-8
		then 1 / LocalDirectionY
		else (if LocalDirectionY >= 0 then 1e30 else -1e30) :: number
	const InverseLocalZ = if math.abs(LocalDirectionZ) > 1e-8
		then 1 / LocalDirectionZ
		else (if LocalDirectionZ >= 0 then 1e30 else -1e30) :: number

	const SlabEnterX = (-HalfSizeX - LocalOriginX) * InverseLocalX :: number
	const SlabExitX = (HalfSizeX - LocalOriginX) * InverseLocalX :: number
	local NearHitDistance = math.min(SlabEnterX, SlabExitX) :: number
	local FarHitDistance = math.max(SlabEnterX, SlabExitX) :: number
	local HitAxis = 0 :: number

	const SlabEnterY = (-HalfSizeY - LocalOriginY) * InverseLocalY :: number
	const SlabExitY = (HalfSizeY - LocalOriginY) * InverseLocalY :: number
	const SlabMinY = math.min(SlabEnterY, SlabExitY) :: number
	const SlabMaxY = math.max(SlabEnterY, SlabExitY) :: number
	if SlabMinY > NearHitDistance then
		NearHitDistance = SlabMinY
		HitAxis = 1
	end
	if SlabMaxY < FarHitDistance then
		FarHitDistance = SlabMaxY
	end

	const SlabEnterZ = (-HalfSizeZ - LocalOriginZ) * InverseLocalZ :: number
	const SlabExitZ = (HalfSizeZ - LocalOriginZ) * InverseLocalZ :: number
	const SlabMinZ = math.min(SlabEnterZ, SlabExitZ) :: number
	const SlabMaxZ = math.max(SlabEnterZ, SlabExitZ) :: number
	if SlabMinZ > NearHitDistance then
		NearHitDistance = SlabMinZ
		HitAxis = 2
	end
	if SlabMaxZ < FarHitDistance then
		FarHitDistance = SlabMaxZ
	end

	const EntryDistance = math.max(0, NearHitDistance) :: number
	if FarHitDistance < EntryDistance or EntryDistance >= MaxDistance then
		return false, MaxDistance, 0, 0, 0
	end

	if HitAxis == 0 then
		const AxisSign = if LocalDirectionX > 0 then -1 else 1 :: number
		return true, EntryDistance, RightX * AxisSign, RightY * AxisSign, RightZ * AxisSign
	elseif HitAxis == 1 then
		const AxisSign = if LocalDirectionY > 0 then -1 else 1 :: number
		return true, EntryDistance, UpX * AxisSign, UpY * AxisSign, UpZ * AxisSign
	else
		const AxisSign = if LocalDirectionZ > 0 then -1 else 1 :: number
		return true, EntryDistance, LookX * AxisSign, LookY * AxisSign, LookZ * AxisSign
	end
end

--[=[
	Casts a ray against an ECS entity's OBB using bounding sphere early-out.
	@param EntityId number -- Target ECS entity ID.
	@param OriginX number -- Ray origin X.
	@param OriginY number -- Ray origin Y.
	@param OriginZ number -- Ray origin Z.
	@param DirectionX number -- Normalized ray direction X.
	@param DirectionY number -- Normalized ray direction Y.
	@param DirectionZ number -- Normalized ray direction Z.
	@param MaxDistance number -- Maximum valid raycast distance.
	@param PositionBuffer buffer -- ECS positions buffer.
	@param SizeBuffer buffer -- ECS sizes buffer.
	@param DirectionsBuffer buffer -- ECS directions buffer.
	@param PropertiesBuffer buffer -- ECS properties buffer.
	@return (boolean, number, number, number, number) -- Hits, HitDistance, NormalX, NormalY, NormalZ.
]=]
function BVHMath.TestEntityOBB(
	EntityId: number,
	OriginX: number,
	OriginY: number,
	OriginZ: number,
	DirectionX: number,
	DirectionY: number,
	DirectionZ: number,
	MaxDistance: number,
	PositionBuffer: buffer,
	SizeBuffer: buffer,
	DirectionsBuffer: buffer,
	PropertiesBuffer: buffer
): (boolean, number, number, number, number)
	const PropRegister = buffer.readu32(PropertiesBuffer, (EntityId - 1) * PROPERTIES_STRIDE) :: number
	if PropRegister ~= 0 and not bit32.btest(PropRegister, FLAG_CAN_COLLIDE) then
		return false, MaxDistance, 0, 0, 0
	end

	const CompOffset = (EntityId - 1) * COMPONENT_STRIDE :: number

	const PositionX = buffer.readf32(PositionBuffer, CompOffset) :: number
	const PositionY = buffer.readf32(PositionBuffer, CompOffset + 4) :: number
	const PositionZ = buffer.readf32(PositionBuffer, CompOffset + 8) :: number

	const HalfSizeX = math.abs(buffer.readf32(SizeBuffer, CompOffset)) * 0.5 :: number
	const HalfSizeY = math.abs(buffer.readf32(SizeBuffer, CompOffset + 4)) * 0.5 :: number
	const HalfSizeZ = math.abs(buffer.readf32(SizeBuffer, CompOffset + 8)) * 0.5 :: number

	const RelativeX = PositionX - OriginX :: number
	const RelativeY = PositionY - OriginY :: number
	const RelativeZ = PositionZ - OriginZ :: number
	const BoundingRadiusSquared = HalfSizeX * HalfSizeX + HalfSizeY * HalfSizeY + HalfSizeZ * HalfSizeZ :: number
	const RayProjection = RelativeX * DirectionX + RelativeY * DirectionY + RelativeZ * DirectionZ :: number
	const PerpendicularDistanceSquared = (RelativeX * RelativeX + RelativeY * RelativeY + RelativeZ * RelativeZ)
		- (RayProjection * RayProjection) :: number
	if PerpendicularDistanceSquared > BoundingRadiusSquared + 1e-5 then
		return false, MaxDistance, 0, 0, 0
	end

	const BoundingRadius = math.sqrt(BoundingRadiusSquared) :: number
	if RayProjection < -BoundingRadius or (RayProjection - BoundingRadius) >= MaxDistance then
		return false, MaxDistance, 0, 0, 0
	end

	const DirOffset = (EntityId - 1) * DIRECTION_STRIDE :: number

	local LookX = buffer.readf32(DirectionsBuffer, DirOffset) :: number
	local LookY = buffer.readf32(DirectionsBuffer, DirOffset + 4) :: number
	local LookZ = buffer.readf32(DirectionsBuffer, DirOffset + 8) :: number

	local UpX = buffer.readf32(DirectionsBuffer, DirOffset + 12) :: number
	local UpY = buffer.readf32(DirectionsBuffer, DirOffset + 16) :: number
	local UpZ = buffer.readf32(DirectionsBuffer, DirOffset + 20) :: number

	local RightX = buffer.readf32(DirectionsBuffer, DirOffset + 24) :: number
	local RightY = buffer.readf32(DirectionsBuffer, DirOffset + 28) :: number
	local RightZ = buffer.readf32(DirectionsBuffer, DirOffset + 32) :: number

	if RightX * RightX + RightY * RightY + RightZ * RightZ < 0.5 then
		LookX, LookY, LookZ = 0, 0, -1
		UpX, UpY, UpZ = 0, 1, 0
		RightX, RightY, RightZ = 1, 0, 0
	end

	return BVHMath.TestBoxOBB(
		OriginX,
		OriginY,
		OriginZ,
		DirectionX,
		DirectionY,
		DirectionZ,
		PositionX,
		PositionY,
		PositionZ,
		HalfSizeX,
		HalfSizeY,
		HalfSizeZ,
		RightX,
		RightY,
		RightZ,
		UpX,
		UpY,
		UpZ,
		LookX,
		LookY,
		LookZ,
		MaxDistance
	)
end

return BVHMath
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="126">
          <Properties>
            <string name="Name">Physics</string>
          </Properties>
          <Item class="Folder" referent="127">
            <Properties>
              <string name="Name">Controller</string>
            </Properties>
            <Item class="ModuleScript" referent="128">
              <Properties>
                <string name="Name">PhysicsController</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const Players = game:GetService("Players")
const ReplicatedStorage = game:GetService("ReplicatedStorage")
const RunService = game:GetService("RunService")

-- Static References --
const IS_CLIENT = RunService:IsClient() :: boolean
const SharedFolder = ReplicatedStorage:WaitForChild("Shared")
const UtilitiesFolder = SharedFolder:WaitForChild("Utilities")
const PhysicsFolder = UtilitiesFolder:WaitForChild("Physics")

-- Modules --
const SystemsConfigs = require(SharedFolder:WaitForChild("SystemsConfigs"))
const PhysicsMath = require(PhysicsFolder:WaitForChild("Core"):WaitForChild("PhysicsMath"))
const PhysicsControllerHelper = require(script.Parent.PhysicsControllerHelper)

-- Configs --
const MAX_DELTA_TIME = SystemsConfigs.PhysicsMaxDeltaTime :: number
const SUBSTEPS = math.max(1, SystemsConfigs.PhysicsSubsteps) :: number

const DEFAULT_SPAWN = SystemsConfigs.PlayerDefaultSpawnPosition :: Vector3
const VOID_RESET_Y = SystemsConfigs.PlayerVoidResetY :: number
const PLAYER_MASS = SystemsConfigs.PlayerMass :: number
const PLAYER_INV_MASS = 1 / PLAYER_MASS :: number

const PLAYER_HALF_EXTENTS = SystemsConfigs.PlayerHalfExtents :: Vector3
const PLAYER_HX = PLAYER_HALF_EXTENTS.X :: number
const PLAYER_HY = PLAYER_HALF_EXTENTS.Y :: number
const PLAYER_HZ = PLAYER_HALF_EXTENTS.Z :: number

const COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number
const MAX_ENTITIES = SystemsConfigs.ECSMaxEntities :: number

const FLAG_CAN_COLLIDE = bit32.lshift(1, 1) :: number
const FLAG_IS_VISIBLE = bit32.lshift(1, 2) :: number
const FLAG_ANCHORED = bit32.lshift(1, 3) :: number

-- Tables --
local Initialized = false :: boolean
local ActiveForceCount = 0 :: number

local SpawnPosX = DEFAULT_SPAWN.X :: number
local SpawnPosY = DEFAULT_SPAWN.Y :: number
local SpawnPosZ = DEFAULT_SPAWN.Z :: number

local PlayerPosX = DEFAULT_SPAWN.X :: number
local PlayerPosY = DEFAULT_SPAWN.Y :: number
local PlayerPosZ = DEFAULT_SPAWN.Z :: number

local PlayerVelX = 0 :: number
local PlayerVelY = 0 :: number
local PlayerVelZ = 0 :: number
local PlayerGrounded = false :: boolean

local PendingWishX = 0 :: number
local PendingWishZ = 0 :: number
local PendingMaxScale = 0 :: number
local PendingJumpRequested = false :: boolean

local HostRootPart: BasePart? = nil
local ECSDataModule: any = nil

-- Buffers
local ECSPositionBuffer: buffer? = nil
local ECSSizeBuffer: buffer? = nil
local ECSDirectionsBuffer: buffer? = nil
local ECSPropertiesBuffer: buffer? = nil

const DynamicFlags = buffer.create(MAX_ENTITIES) :: buffer -- 0 = static, 1 = awake dynamic, 2 = sleeping dynamic
const ObjectGroundedFlags = buffer.create(MAX_ENTITIES) :: buffer
const ObjectVelocityBuffer = buffer.create(MAX_ENTITIES * COMPONENT_STRIDE) :: buffer
const ObjectForceBuffer = buffer.create(MAX_ENTITIES * COMPONENT_STRIDE) :: buffer
const ObjectInvMassBuffer = buffer.create(MAX_ENTITIES * 4) :: buffer
const ActiveForceSlots = buffer.create(MAX_ENTITIES * 4) :: buffer

local PhysicsController = {}

-- ============================================================================
-- 1. PUBLIC CONTROLLER API - INITIALIZATION, DIRECT ACTIONS & SIMULATION
-- ============================================================================

function PhysicsController.BindCharacter(Character: Model)
	const RootPart, StartX, StartY, StartZ = PhysicsControllerHelper.ConfigureCharacterInstance(Character)
	if not RootPart or not StartX or not StartY or not StartZ then
		return
	end

	HostRootPart = RootPart
	SpawnPosX, SpawnPosY, SpawnPosZ = StartX, StartY, StartZ
	PlayerPosX, PlayerPosY, PlayerPosZ = StartX, StartY, StartZ
	PlayerVelX, PlayerVelY, PlayerVelZ = 0, 0, 0
end

function PhysicsController.InitializePhysics()
	if Initialized then
		return
	end

	const ObjectStorageModule = PhysicsControllerHelper.ResolveObjectStorage()
	if ObjectStorageModule then
		const ObjectStorage = (require :: any)(ObjectStorageModule)
		ECSDataModule = ObjectStorage.ECSData
		ECSPositionBuffer = ObjectStorage.PositionData.GetData()
		ECSSizeBuffer = ObjectStorage.SizeData.GetData()
		ECSDirectionsBuffer = ObjectStorage.DirectionsData.GetData()
		ECSPropertiesBuffer = ObjectStorage.PropertiesData.GetData()
	end

	Initialized = true

	if not IS_CLIENT then
		return
	end

	const LocalPlayer = Players.LocalPlayer :: Player?
	if not LocalPlayer then
		return
	end

	if LocalPlayer.Character then
		task.spawn(PhysicsController.BindCharacter, LocalPlayer.Character)
	end
	LocalPlayer.CharacterAdded:Connect(PhysicsController.BindCharacter)
end

function PhysicsController.AddPlayerMovement(
	DirX: number,
	DirY: number,
	DirZ: number,
	Scale: number?,
	Jump: boolean?,
	IsImpulse: boolean?
)
	const ResolvedScale = if Scale ~= nil then Scale else 1.0 :: number

	if Jump then
		PendingJumpRequested = true
	end

	if IsImpulse then
		PlayerVelX += DirX * ResolvedScale * PLAYER_INV_MASS
		PlayerVelY += DirY * ResolvedScale * PLAYER_INV_MASS
		PlayerVelZ += DirZ * ResolvedScale * PLAYER_INV_MASS
		return
	end

	PendingWishX += DirX * ResolvedScale
	PendingWishZ += DirZ * ResolvedScale
	PendingMaxScale = math.max(PendingMaxScale, math.abs(ResolvedScale))
end

function PhysicsController.AddObjectMovement(
	EntityId: number,
	DirX: number,
	DirY: number,
	DirZ: number,
	Magnitude: number,
	IsImpulse: boolean?
)
	if not Initialized then
		PhysicsController.InitializePhysics()
	end

	if EntityId < 1 or EntityId > MAX_ENTITIES then
		return
	end

	const InverseMass = PhysicsControllerHelper.EnsureDynamicEntityMass(
		EntityId,
		ObjectInvMassBuffer,
		ECSSizeBuffer,
		ECSPropertiesBuffer,
		nil
	) :: number
	const FlagIndex = EntityId - 1 :: number
	const CompOffset = FlagIndex * COMPONENT_STRIDE :: number

	buffer.writeu8(DynamicFlags, FlagIndex, 1)

	if IsImpulse then
		const DeltaVelocity = Magnitude * InverseMass :: number
		buffer.writef32(
			ObjectVelocityBuffer,
			CompOffset,
			buffer.readf32(ObjectVelocityBuffer, CompOffset) + DirX * DeltaVelocity
		)
		buffer.writef32(
			ObjectVelocityBuffer,
			CompOffset + 4,
			buffer.readf32(ObjectVelocityBuffer, CompOffset + 4) + DirY * DeltaVelocity
		)
		buffer.writef32(
			ObjectVelocityBuffer,
			CompOffset + 8,
			buffer.readf32(ObjectVelocityBuffer, CompOffset + 8) + DirZ * DeltaVelocity
		)
		return
	end

	const PrevForceX = buffer.readf32(ObjectForceBuffer, CompOffset) :: number
	const PrevForceY = buffer.readf32(ObjectForceBuffer, CompOffset + 4) :: number
	const PrevForceZ = buffer.readf32(ObjectForceBuffer, CompOffset + 8) :: number

	if PrevForceX == 0 and PrevForceY == 0 and PrevForceZ == 0 and ActiveForceCount < MAX_ENTITIES then
		buffer.writeu32(ActiveForceSlots, ActiveForceCount * 4, CompOffset)
		ActiveForceCount += 1
	end

	buffer.writef32(ObjectForceBuffer, CompOffset, PrevForceX + DirX * Magnitude)
	buffer.writef32(ObjectForceBuffer, CompOffset + 4, PrevForceY + DirY * Magnitude)
	buffer.writef32(ObjectForceBuffer, CompOffset + 8, PrevForceZ + DirZ * Magnitude)
end

function PhysicsController.SimulatePhysicsFrame(DeltaTime: number?)
	if not Initialized then
		PhysicsController.InitializePhysics()
	end

	const PositionBuffer = ECSPositionBuffer
	const SizeBuffer = ECSSizeBuffer
	const DirectionsBuffer = ECSDirectionsBuffer
	if not PositionBuffer or not SizeBuffer or not DirectionsBuffer or not ECSDataModule then
		PendingWishX = 0
		PendingWishZ = 0
		PendingMaxScale = 0
		PendingJumpRequested = false
		ActiveForceCount = PhysicsControllerHelper.ClearAccumulatedForces(
			ActiveForceCount,
			ActiveForceSlots,
			ObjectForceBuffer
		)
		return
	end

	const EntityCount = math.min(ECSDataModule.GetCounts().EntityECSCount :: number, MAX_ENTITIES) :: number
	if EntityCount <= 0 then
		PendingWishX = 0
		PendingWishZ = 0
		PendingMaxScale = 0
		PendingJumpRequested = false
		ActiveForceCount = PhysicsControllerHelper.ClearAccumulatedForces(
			ActiveForceCount,
			ActiveForceSlots,
			ObjectForceBuffer
		)
		return
	end

	PendingWishX, PendingWishZ, PendingMaxScale, PendingJumpRequested =
		PhysicsControllerHelper.SampleKeyboardInput(
			PendingWishX,
			PendingWishZ,
			PendingMaxScale,
			PendingJumpRequested
		)

	const WishX: number, WishZ: number, WishScale: number, JumpRequested: boolean =
		PhysicsControllerHelper.FlushPlayerIntent(
			PendingWishX,
			PendingWishZ,
			PendingMaxScale,
			PendingJumpRequested
		)
	PendingWishX = 0
	PendingWishZ = 0
	PendingMaxScale = 0
	PendingJumpRequested = false

	const ClampedDeltaTime = math.clamp(DeltaTime or (1 / 60), 1e-4, MAX_DELTA_TIME) :: number
	const StepDeltaTime = ClampedDeltaTime / SUBSTEPS :: number
	local PendingJump = JumpRequested :: boolean

	for _ = 1, SUBSTEPS do
		const WasGrounded = PlayerGrounded :: boolean
		PlayerVelX, PlayerVelY, PlayerVelZ, PlayerGrounded = PhysicsMath.StepPlayerVelocity(
			PlayerVelX,
			PlayerVelY,
			PlayerVelZ,
			WishX,
			WishZ,
			WishScale,
			PendingJump,
			PlayerGrounded,
			StepDeltaTime
		)

		if WasGrounded and PendingJump then
			PendingJump = false
		end

		PlayerPosX += PlayerVelX * StepDeltaTime
		PlayerPosY += PlayerVelY * StepDeltaTime
		PlayerPosZ += PlayerVelZ * StepDeltaTime

		PlayerPosX, PlayerPosY, PlayerPosZ, PlayerVelX, PlayerVelY, PlayerVelZ, PlayerGrounded =
			PhysicsMath.ResolveBodyWorldCollisions(
				PlayerPosX,
				PlayerPosY,
				PlayerPosZ,
				PLAYER_HX,
				PLAYER_HY,
				PLAYER_HZ,
				PlayerVelX,
				PlayerVelY,
				PlayerVelZ,
				PLAYER_INV_MASS,
				0,
				0,
				EntityCount,
				PositionBuffer,
				SizeBuffer,
				DirectionsBuffer,
				DynamicFlags,
				ObjectVelocityBuffer,
				ObjectInvMassBuffer
			)

		for EntityId = 1, EntityCount do
			if buffer.readu8(DynamicFlags, EntityId - 1) == 1 then
				PhysicsControllerHelper.StepSingleDynamicObject(
					EntityId,
					EntityCount,
					StepDeltaTime,
					PositionBuffer,
					SizeBuffer,
					DirectionsBuffer,
					DynamicFlags,
					ObjectGroundedFlags,
					ObjectVelocityBuffer,
					ObjectForceBuffer,
					ObjectInvMassBuffer
				)
			end
		end
	end

	ActiveForceCount = PhysicsControllerHelper.ClearAccumulatedForces(
		ActiveForceCount,
		ActiveForceSlots,
		ObjectForceBuffer
	)

	if PlayerPosY < VOID_RESET_Y then
		PlayerPosX, PlayerPosY, PlayerPosZ = SpawnPosX, SpawnPosY, SpawnPosZ
		PlayerVelX, PlayerVelY, PlayerVelZ = 0, 0, 0
		PlayerGrounded = false
	end

	if HostRootPart and HostRootPart.Parent then
		HostRootPart.CFrame = HostRootPart.CFrame.Rotation + Vector3.new(PlayerPosX, PlayerPosY, PlayerPosZ)
	end
end

function PhysicsController.SetEntityDynamic(EntityId: number, IsDynamic: boolean, CustomMass: number?)
	if EntityId < 1 or EntityId > MAX_ENTITIES then
		return
	end

	const FlagIndex = EntityId - 1 :: number
	if not IsDynamic then
		buffer.writeu8(DynamicFlags, FlagIndex, 0)
		buffer.writef32(ObjectInvMassBuffer, FlagIndex * 4, 0)
		if ECSPropertiesBuffer then
			const PropReg = buffer.readu32(ECSPropertiesBuffer, FlagIndex * 4) :: number
			buffer.writeu32(
				ECSPropertiesBuffer,
				FlagIndex * 4,
				bit32.bor(PropReg, FLAG_CAN_COLLIDE, FLAG_IS_VISIBLE, FLAG_ANCHORED)
			)
		end
		return
	end

	PhysicsControllerHelper.EnsureDynamicEntityMass(
		EntityId,
		ObjectInvMassBuffer,
		ECSSizeBuffer,
		ECSPropertiesBuffer,
		CustomMass
	)
	buffer.writeu8(DynamicFlags, FlagIndex, 1)
end

function PhysicsController.GetPlayerPosition(): Vector3
	return Vector3.new(PlayerPosX, PlayerPosY, PlayerPosZ)
end

function PhysicsController.SetPlayerPosition(NewPosition: Vector3)
	PlayerPosX, PlayerPosY, PlayerPosZ = NewPosition.X, NewPosition.Y, NewPosition.Z
	if HostRootPart and HostRootPart.Parent then
		HostRootPart.CFrame = HostRootPart.CFrame.Rotation + NewPosition
	end
end

function PhysicsController.GetPlayerVelocity(): Vector3
	return Vector3.new(PlayerVelX, PlayerVelY, PlayerVelZ)
end

function PhysicsController.SetPlayerVelocity(NewVelocity: Vector3)
	PlayerVelX, PlayerVelY, PlayerVelZ = NewVelocity.X, NewVelocity.Y, NewVelocity.Z
end

function PhysicsController.IsPlayerGrounded(): boolean
	return PlayerGrounded
end

return PhysicsController
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="129">
              <Properties>
                <string name="Name">PhysicsControllerHelper</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const Players = game:GetService("Players")
const ReplicatedStorage = game:GetService("ReplicatedStorage")
const RunService = game:GetService("RunService")
const UserInputService = game:GetService("UserInputService")

-- Static References --
const IS_CLIENT = RunService:IsClient() :: boolean
const SharedFolder = ReplicatedStorage:WaitForChild("Shared")
const UtilitiesFolder = SharedFolder:WaitForChild("Utilities")
const PhysicsFolder = UtilitiesFolder:WaitForChild("Physics")

-- Modules --
const SystemsConfigs = require(SharedFolder:WaitForChild("SystemsConfigs"))
const PhysicsMath = require(PhysicsFolder:WaitForChild("Core"):WaitForChild("PhysicsMath"))

const CameraStore = if IS_CLIENT
	then require(UtilitiesFolder:WaitForChild("Render"):WaitForChild("Camera"):WaitForChild("CameraStore"))
	else nil

-- Configs --
const OBJECT_DEFAULT_DENSITY = SystemsConfigs.ObjectDefaultDensity :: number
const OBJECT_RESTITUTION = SystemsConfigs.ObjectRestitution :: number
const SLEEP_SPEED_THRESHOLD = SystemsConfigs.ObjectSleepSpeedThreshold :: number
const SLEEP_SPEED_SQ = SLEEP_SPEED_THRESHOLD * SLEEP_SPEED_THRESHOLD :: number
const PLAYER_MAX_WISH_SCALE = SystemsConfigs.PlayerMaxWishScale :: number
const COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number

const FLAG_CAN_COLLIDE = bit32.lshift(1, 1) :: number
const FLAG_IS_VISIBLE = bit32.lshift(1, 2) :: number
const FLAG_ANCHORED = bit32.lshift(1, 3) :: number

local PhysicsControllerHelper = {}

-- ============================================================================
-- 1. STORAGE RESOLUTION, INPUT SAMPLING & DYNAMIC OBJECT STEPPING HELPERS
-- ============================================================================

--[=[
	Resolves the active client ObjectStorage module reference.
	@return Instance? -- Resolved ObjectStorage instance (or nil on server).
]=]
function PhysicsControllerHelper.ResolveObjectStorage(): Instance?
	if not IS_CLIENT then
		return nil
	end

	const LocalPlayer = Players.LocalPlayer :: Player?
	if not LocalPlayer then
		return nil
	end

	const PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts") :: PlayerScripts
	const ControllerActor = PlayerScripts:FindFirstChild("Controller") :: Actor?
	if ControllerActor then
		const ActorStorage = ControllerActor:FindFirstChild("ObjectStorage")
		if ActorStorage then
			return ActorStorage
		end
	end

	return PlayerScripts:WaitForChild("Client"):WaitForChild("Objects"):WaitForChild("ObjectStorage")
end

--[=[
	Configures a Roblox character model for virtualized kinematic physics simulation.
	@param Character Model -- Character model instance.
	@return (BasePart?, number?, number?, number?) -- RootPart, InitialX, InitialY, InitialZ.
]=]
function PhysicsControllerHelper.ConfigureCharacterInstance(
	Character: Model
): (BasePart?, number?, number?, number?)
	const Humanoid = Character:FindFirstChildWhichIsA("Humanoid") :: Humanoid?
	if Humanoid then
		Humanoid.PlatformStand = true
	end

	for _, Descendant: Instance in ipairs(Character:GetDescendants()) do
		if Descendant:IsA("BasePart") then
			Descendant.CanCollide = false
		end
	end

	const RootPartCandidate = Character:FindFirstChild("HumanoidRootPart")
		or Character:WaitForChild("HumanoidRootPart", 5)
	if not RootPartCandidate or not RootPartCandidate:IsA("BasePart") then
		return nil, nil, nil, nil
	end
	const RootPart = RootPartCandidate :: BasePart

	RootPart.Anchored = true
	RootPart.CanCollide = false

	const StartPos = RootPart.Position :: Vector3
	return RootPart, StartPos.X, StartPos.Y + 0.5, StartPos.Z
end

--[=[
	Samples WASD and Space keyboard inputs relative to camera orientation.
	@param PendingWishX number -- Accumulated wish direction X.
	@param PendingWishZ number -- Accumulated wish direction Z.
	@param PendingMaxScale number -- Accumulated wish scale.
	@param PendingJumpRequested boolean -- Accumulated jump flag.
	@return (number, number, number, boolean) -- WishX, WishZ, MaxScale, JumpRequested.
]=]
function PhysicsControllerHelper.SampleKeyboardInput(
	PendingWishX: number,
	PendingWishZ: number,
	PendingMaxScale: number,
	PendingJumpRequested: boolean
): (number, number, number, boolean)
	if not IS_CLIENT or not CameraStore then
		return PendingWishX, PendingWishZ, PendingMaxScale, PendingJumpRequested
	end

	if UserInputService:GetFocusedTextBox() ~= nil then
		return PendingWishX, PendingWishZ, PendingMaxScale, PendingJumpRequested
	end

	const CamLook = CameraStore.GetCameraLook() :: Vector3
	const CamRight = CameraStore.GetCameraRight() :: Vector3

	local ForwardX: number, ForwardZ: number = CamLook.X, CamLook.Z
	const ForwardLen = math.sqrt(ForwardX * ForwardX + ForwardZ * ForwardZ) :: number
	if ForwardLen > 1e-5 then
		ForwardX /= ForwardLen
		ForwardZ /= ForwardLen
	end

	local RightX: number, RightZ: number = CamRight.X, CamRight.Z
	const RightLen = math.sqrt(RightX * RightX + RightZ * RightZ) :: number
	if RightLen > 1e-5 then
		RightX /= RightLen
		RightZ /= RightLen
	end

	local MoveX = 0 :: number
	local MoveZ = 0 :: number

	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		MoveX += ForwardX
		MoveZ += ForwardZ
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		MoveX -= ForwardX
		MoveZ -= ForwardZ
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		MoveX += RightX
		MoveZ += RightZ
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		MoveX -= RightX
		MoveZ -= RightZ
	end

	local NextWishX = PendingWishX :: number
	local NextWishZ = PendingWishZ :: number
	local NextMaxScale = PendingMaxScale :: number
	local NextJumpRequested = PendingJumpRequested :: boolean

	const MoveLen = math.sqrt(MoveX * MoveX + MoveZ * MoveZ) :: number
	if MoveLen > 1e-5 then
		NextWishX += MoveX / MoveLen
		NextWishZ += MoveZ / MoveLen
		NextMaxScale = math.max(NextMaxScale, 1.0)
	end

	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		NextJumpRequested = true
	end

	return NextWishX, NextWishZ, NextMaxScale, NextJumpRequested
end

--[=[
	Normalizes and clamps accumulated player wish-direction intent.
	@param RawWishX number -- Raw accumulated wish direction X.
	@param RawWishZ number -- Raw accumulated wish direction Z.
	@param MaxScale number -- Accumulated wish scale.
	@param JumpRequested boolean -- Whether jump was requested.
	@return (number, number, number, boolean) -- UnitWishX, UnitWishZ, ClampedScale, JumpRequested.
]=]
function PhysicsControllerHelper.FlushPlayerIntent(
	RawWishX: number,
	RawWishZ: number,
	MaxScale: number,
	JumpRequested: boolean
): (number, number, number, boolean)
	const WishLen = math.sqrt(RawWishX * RawWishX + RawWishZ * RawWishZ) :: number
	if WishLen <= 1e-5 then
		return 0, 0, 0, JumpRequested
	end

	return RawWishX / WishLen, RawWishZ / WishLen, math.min(MaxScale, PLAYER_MAX_WISH_SCALE), JumpRequested
end

--[=[
	Calculates and writes dynamic entity mass and inverse mass into storage buffers.
	@param EntityId number -- Target ECS entity ID.
	@param ObjectInvMassBuffer buffer -- Dynamic inverse mass buffer.
	@param SizeBuffer buffer? -- ECS part sizes buffer.
	@param PropertiesBuffer buffer? -- ECS properties buffer.
	@param CustomMass number? -- Optional explicit mass override in kg.
	@return number -- Inverted mass (1 / mass).
]=]
function PhysicsControllerHelper.EnsureDynamicEntityMass(
	EntityId: number,
	ObjectInvMassBuffer: buffer,
	SizeBuffer: buffer?,
	PropertiesBuffer: buffer?,
	CustomMass: number?
): number
	const MassOffset = (EntityId - 1) * 4 :: number
	const ExistingInvMass = buffer.readf32(ObjectInvMassBuffer, MassOffset) :: number
	if ExistingInvMass > 0 and CustomMass == nil then
		return ExistingInvMass
	end

	local ResolvedMass = CustomMass :: number?
	if not ResolvedMass or ResolvedMass <= 0 then
		if SizeBuffer then
			const CompOffset = (EntityId - 1) * COMPONENT_STRIDE :: number
			const SizeX = math.max(0.1, buffer.readf32(SizeBuffer, CompOffset)) :: number
			const SizeY = math.max(0.1, buffer.readf32(SizeBuffer, CompOffset + 4)) :: number
			const SizeZ = math.max(0.1, buffer.readf32(SizeBuffer, CompOffset + 8)) :: number
			ResolvedMass = SizeX * SizeY * SizeZ * OBJECT_DEFAULT_DENSITY
		else
			ResolvedMass = OBJECT_DEFAULT_DENSITY
		end
	end

	const InverseMass = 1 / (ResolvedMass :: number) :: number
	buffer.writef32(ObjectInvMassBuffer, MassOffset, InverseMass)

	if PropertiesBuffer then
		const PropReg = buffer.readu32(PropertiesBuffer, MassOffset) :: number
		const UpdatedReg =
			bit32.bor(bit32.band(PropReg, bit32.bnot(FLAG_ANCHORED)), FLAG_CAN_COLLIDE, FLAG_IS_VISIBLE) :: number
		buffer.writeu32(PropertiesBuffer, MassOffset, UpdatedReg)
	end

	return InverseMass
end

--[=[
	Simulates a single substepped physics frame for an active dynamic ECS object.
	@param EntityId number -- Target entity ID.
	@param EntityCount number -- Total active ECS entity count.
	@param StepDeltaTime number -- Substep delta time in seconds.
	@param PositionBuffer buffer -- ECS positions buffer.
	@param SizeBuffer buffer -- ECS sizes buffer.
	@param DirectionsBuffer buffer -- ECS directions buffer.
	@param DynamicFlags buffer -- ECS dynamic state buffer.
	@param ObjectGroundedFlags buffer -- ECS grounded state buffer.
	@param ObjectVelocityBuffer buffer -- Dynamic objects velocity buffer.
	@param ObjectForceBuffer buffer -- Dynamic objects force buffer.
	@param ObjectInvMassBuffer buffer -- Dynamic objects inverse mass buffer.
]=]
function PhysicsControllerHelper.StepSingleDynamicObject(
	EntityId: number,
	EntityCount: number,
	StepDeltaTime: number,
	PositionBuffer: buffer,
	SizeBuffer: buffer,
	DirectionsBuffer: buffer,
	DynamicFlags: buffer,
	ObjectGroundedFlags: buffer,
	ObjectVelocityBuffer: buffer,
	ObjectForceBuffer: buffer,
	ObjectInvMassBuffer: buffer
)
	const FlagIndex = EntityId - 1 :: number
	const CompOffset = FlagIndex * COMPONENT_STRIDE :: number

	const InverseMass = buffer.readf32(ObjectInvMassBuffer, FlagIndex * 4) :: number
	if InverseMass <= 0 then
		buffer.writeu8(DynamicFlags, FlagIndex, 0)
		return
	end

	const WasGrounded = (buffer.readu8(ObjectGroundedFlags, FlagIndex) == 1) :: boolean
	const ForceX = buffer.readf32(ObjectForceBuffer, CompOffset) :: number
	const ForceY = buffer.readf32(ObjectForceBuffer, CompOffset + 4) :: number
	const ForceZ = buffer.readf32(ObjectForceBuffer, CompOffset + 8) :: number

	local VelocityX: number, VelocityY: number, VelocityZ: number = PhysicsMath.StepObjectVelocity(
		buffer.readf32(ObjectVelocityBuffer, CompOffset),
		buffer.readf32(ObjectVelocityBuffer, CompOffset + 4),
		buffer.readf32(ObjectVelocityBuffer, CompOffset + 8),
		ForceX,
		ForceY,
		ForceZ,
		InverseMass,
		WasGrounded,
		StepDeltaTime
	)

	local PosX = buffer.readf32(PositionBuffer, CompOffset) + VelocityX * StepDeltaTime :: number
	local PosY = buffer.readf32(PositionBuffer, CompOffset + 4) + VelocityY * StepDeltaTime :: number
	local PosZ = buffer.readf32(PositionBuffer, CompOffset + 8) + VelocityZ * StepDeltaTime :: number

	const HalfSizeX = buffer.readf32(SizeBuffer, CompOffset) * 0.5 :: number
	const HalfSizeY = buffer.readf32(SizeBuffer, CompOffset + 4) * 0.5 :: number
	const HalfSizeZ = buffer.readf32(SizeBuffer, CompOffset + 8) * 0.5 :: number

	local Grounded: boolean
	PosX, PosY, PosZ, VelocityX, VelocityY, VelocityZ, Grounded = PhysicsMath.ResolveBodyWorldCollisions(
		PosX,
		PosY,
		PosZ,
		HalfSizeX,
		HalfSizeY,
		HalfSizeZ,
		VelocityX,
		VelocityY,
		VelocityZ,
		InverseMass,
		OBJECT_RESTITUTION,
		EntityId,
		EntityCount,
		PositionBuffer,
		SizeBuffer,
		DirectionsBuffer,
		DynamicFlags,
		ObjectVelocityBuffer,
		ObjectInvMassBuffer
	)

	buffer.writef32(PositionBuffer, CompOffset, PosX)
	buffer.writef32(PositionBuffer, CompOffset + 4, PosY)
	buffer.writef32(PositionBuffer, CompOffset + 8, PosZ)
	buffer.writeu8(ObjectGroundedFlags, FlagIndex, if Grounded then 1 else 0)

	const SpeedSquared = VelocityX * VelocityX + VelocityY * VelocityY + VelocityZ * VelocityZ :: number
	const HasAppliedForce = (ForceX ~= 0 or ForceY ~= 0 or ForceZ ~= 0) :: boolean
	if Grounded and not HasAppliedForce and SpeedSquared < SLEEP_SPEED_SQ then
		buffer.writef32(ObjectVelocityBuffer, CompOffset, 0)
		buffer.writef32(ObjectVelocityBuffer, CompOffset + 4, 0)
		buffer.writef32(ObjectVelocityBuffer, CompOffset + 8, 0)
		buffer.writeu8(DynamicFlags, FlagIndex, 2)
		return
	end

	buffer.writef32(ObjectVelocityBuffer, CompOffset, VelocityX)
	buffer.writef32(ObjectVelocityBuffer, CompOffset + 4, VelocityY)
	buffer.writef32(ObjectVelocityBuffer, CompOffset + 8, VelocityZ)
end

--[=[
	Clears accumulated continuous force vectors for dynamic entities.
	@param ActiveForceCount number -- Number of entities with active forces.
	@param ActiveForceSlots buffer -- Buffer storing component byte offsets of entities with forces.
	@param ObjectForceBuffer buffer -- Force component buffer.
	@return number -- Reset active force count (0).
]=]
function PhysicsControllerHelper.ClearAccumulatedForces(
	ActiveForceCount: number,
	ActiveForceSlots: buffer,
	ObjectForceBuffer: buffer
): number
	for i = 0, ActiveForceCount - 1 do
		const CompOffset = buffer.readu32(ActiveForceSlots, i * 4) :: number
		buffer.writef32(ObjectForceBuffer, CompOffset, 0)
		buffer.writef32(ObjectForceBuffer, CompOffset + 4, 0)
		buffer.writef32(ObjectForceBuffer, CompOffset + 8, 0)
	end
	return 0
end

return PhysicsControllerHelper
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="130">
            <Properties>
              <string name="Name">Core</string>
            </Properties>
            <Item class="ModuleScript" referent="131">
              <Properties>
                <string name="Name">PhysicsMath</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))
const BVH = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Utilities"):WaitForChild("BVH"))
const PhysicsMathHelper = require(script.Parent.PhysicsMathHelper)

-- Configs --
const GRAVITY = SystemsConfigs.PhysicsGravity :: number
const FALL_GRAVITY_MULTIPLIER = SystemsConfigs.PhysicsFallGravityMultiplier :: number

const PLAYER_MASS = SystemsConfigs.PlayerMass :: number
const PLAYER_JUMP_VELOCITY = SystemsConfigs.PlayerJumpImpulse / PLAYER_MASS :: number
const WALKABLE_NORMAL_Y = SystemsConfigs.PlayerWalkableNormalY :: number

const OBJECT_LINEAR_DRAG = SystemsConfigs.ObjectLinearDrag :: number
const OBJECT_SURFACE_FRICTION = SystemsConfigs.ObjectSurfaceFriction :: number

const COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number
const DIRECTION_STRIDE = SystemsConfigs.ECSDirectionStride :: number
const MAX_ENTITIES = SystemsConfigs.ECSMaxEntities :: number
const BROADPHASE_PADDING = SystemsConfigs.PhysicsBroadphasePadding :: number

-- Tables --
const BroadphaseCandidates = table.create(MAX_ENTITIES, 0) :: { number }

local PhysicsMath = {}

-- ============================================================================
-- 1. VELOCITY & INERTIA INTEGRATION
-- ============================================================================

--[=[
	Steps player linear velocity forward by DeltaTime, applying ground or airborne wish drive, friction, jump, and gravity.
	@param VelocityX number -- Current velocity X.
	@param VelocityY number -- Current velocity Y.
	@param VelocityZ number -- Current velocity Z.
	@param WishX number -- Normalized horizontal wish direction X.
	@param WishZ number -- Normalized horizontal wish direction Z.
	@param WishScale number -- Desired movement speed scalar.
	@param JumpRequested boolean -- True if jump button is active.
	@param IsGrounded boolean -- True if resting on a walkable surface.
	@param DeltaTime number -- Elapsed frame time in seconds.
	@return (number, number, number, boolean) -- NextVelocityX, NextVelocityY, NextVelocityZ, NextGrounded.
]=]
function PhysicsMath.StepPlayerVelocity(
	VelocityX: number,
	VelocityY: number,
	VelocityZ: number,
	WishX: number,
	WishZ: number,
	WishScale: number,
	JumpRequested: boolean,
	IsGrounded: boolean,
	DeltaTime: number
): (number, number, number, boolean)
	local NextVelocityX = VelocityX :: number
	local NextVelocityY = VelocityY :: number
	local NextVelocityZ = VelocityZ :: number
	local NextGrounded = IsGrounded :: boolean

	if NextGrounded then
		NextVelocityX, NextVelocityZ = PhysicsMathHelper.IntegrateGroundedDrive(
			NextVelocityX,
			NextVelocityZ,
			WishX,
			WishZ,
			WishScale,
			DeltaTime
		)
		if JumpRequested then
			NextVelocityY = math.max(NextVelocityY, PLAYER_JUMP_VELOCITY)
			NextGrounded = false
		end
	else
		NextVelocityX, NextVelocityZ = PhysicsMathHelper.IntegrateAirborneDrive(
			NextVelocityX,
			NextVelocityZ,
			WishX,
			WishZ,
			WishScale,
			DeltaTime
		)
	end

	const GravityScale = if NextVelocityY < 0 then FALL_GRAVITY_MULTIPLIER else 1.0 :: number
	NextVelocityY -= GRAVITY * GravityScale * DeltaTime

	return NextVelocityX, NextVelocityY, NextVelocityZ, NextGrounded
end

--[=[
	Integrates external forces, gravity, and drag onto a dynamic object's linear velocity.
	@param VelocityX number -- Current velocity X.
	@param VelocityY number -- Current velocity Y.
	@param VelocityZ number -- Current velocity Z.
	@param ForceX number -- Net force X in Newtons.
	@param ForceY number -- Net force Y in Newtons.
	@param ForceZ number -- Net force Z in Newtons.
	@param InverseMass number -- 1 / mass in kg.
	@param IsGrounded boolean -- Whether resting on a surface.
	@param DeltaTime number -- Elapsed frame time in seconds.
	@return (number, number, number) -- NextVelocityX, NextVelocityY, NextVelocityZ.
]=]
function PhysicsMath.StepObjectVelocity(
	VelocityX: number,
	VelocityY: number,
	VelocityZ: number,
	ForceX: number,
	ForceY: number,
	ForceZ: number,
	InverseMass: number,
	IsGrounded: boolean,
	DeltaTime: number
): (number, number, number)
	const AccelerationScale = InverseMass * DeltaTime :: number
	local NextVelocityX = VelocityX + ForceX * AccelerationScale :: number
	local NextVelocityY = VelocityY + ForceY * AccelerationScale - GRAVITY * DeltaTime :: number
	local NextVelocityZ = VelocityZ + ForceZ * AccelerationScale :: number

	const LinearDecay = math.max(0, 1 - OBJECT_LINEAR_DRAG * DeltaTime) :: number
	NextVelocityX *= LinearDecay
	NextVelocityY *= LinearDecay
	NextVelocityZ *= LinearDecay

	if IsGrounded then
		const SurfaceDecay = math.max(0, 1 - OBJECT_SURFACE_FRICTION * DeltaTime) :: number
		NextVelocityX *= SurfaceDecay
		NextVelocityZ *= SurfaceDecay
	end

	return NextVelocityX, NextVelocityY, NextVelocityZ
end

-- ============================================================================
-- 2. COLLISION DETECTION & IMPULSE RESOLUTION (BOX VS ECS OBB)
-- ============================================================================

--[=[
	Performs a Separating Axis Theorem (SAT) collision test between an axis-aligned box body and an oriented ECS box.
	@param BodyX number -- Center position X of the testing body.
	@param BodyY number -- Center position Y of the testing body.
	@param BodyZ number -- Center position Z of the testing body.
	@param BodyHalfSizeX number -- Half size X of the testing body.
	@param BodyHalfSizeY number -- Half size Y of the testing body.
	@param BodyHalfSizeZ number -- Half size Z of the testing body.
	@param CompOffset number -- Byte offset in position/size buffers for the target entity.
	@param DirOffset number -- Byte offset in directions buffer for the target entity.
	@param PositionBuffer buffer -- ECS positions buffer.
	@param SizeBuffer buffer -- ECS sizes buffer.
	@param DirectionsBuffer buffer -- ECS directions buffer.
	@return (boolean, number, number, number, number) -- Overlaps, NormalX, NormalY, NormalZ, Penetration.
]=]
function PhysicsMath.TestBoxVsOBB(
	BodyX: number,
	BodyY: number,
	BodyZ: number,
	BodyHalfSizeX: number,
	BodyHalfSizeY: number,
	BodyHalfSizeZ: number,
	CompOffset: number,
	DirOffset: number,
	PositionBuffer: buffer,
	SizeBuffer: buffer,
	DirectionsBuffer: buffer
): (boolean, number, number, number, number)
	const SizeX = buffer.readf32(SizeBuffer, CompOffset) :: number
	const SizeY = buffer.readf32(SizeBuffer, CompOffset + 4) :: number
	const SizeZ = buffer.readf32(SizeBuffer, CompOffset + 8) :: number
	if SizeX <= 0 or SizeY <= 0 or SizeZ <= 0 then
		return false, 0, 0, 0, 0
	end

	const DeltaX = BodyX - buffer.readf32(PositionBuffer, CompOffset) :: number
	const DeltaY = BodyY - buffer.readf32(PositionBuffer, CompOffset + 4) :: number
	const DeltaZ = BodyZ - buffer.readf32(PositionBuffer, CompOffset + 8) :: number

	-- Broadphase rejection before reading the 36-byte orientation basis
	const BroadphaseRadius = (SizeX + SizeY + SizeZ) * 0.5 :: number
	if
		math.abs(DeltaX) > BodyHalfSizeX + BroadphaseRadius
		or math.abs(DeltaY) > BodyHalfSizeY + BroadphaseRadius
		or math.abs(DeltaZ) > BodyHalfSizeZ + BroadphaseRadius
	then
		return false, 0, 0, 0, 0
	end

	local LookX = buffer.readf32(DirectionsBuffer, DirOffset) :: number
	local LookY = buffer.readf32(DirectionsBuffer, DirOffset + 4) :: number
	local LookZ = buffer.readf32(DirectionsBuffer, DirOffset + 8) :: number

	local UpX = buffer.readf32(DirectionsBuffer, DirOffset + 12) :: number
	local UpY = buffer.readf32(DirectionsBuffer, DirOffset + 16) :: number
	local UpZ = buffer.readf32(DirectionsBuffer, DirOffset + 20) :: number

	local RightX = buffer.readf32(DirectionsBuffer, DirOffset + 24) :: number
	local RightY = buffer.readf32(DirectionsBuffer, DirOffset + 28) :: number
	local RightZ = buffer.readf32(DirectionsBuffer, DirOffset + 32) :: number

	if RightX * RightX + RightY * RightY + RightZ * RightZ < 0.5 then
		LookX, LookY, LookZ = 0, 0, -1
		UpX, UpY, UpZ = 0, 1, 0
		RightX, RightY, RightZ = 1, 0, 0
	end

	const HalfSizeX: number, HalfSizeY: number, HalfSizeZ: number = SizeX * 0.5, SizeY * 0.5, SizeZ * 0.5

	const WorldExtentX =
		math.abs(RightX) * HalfSizeX + math.abs(UpX) * HalfSizeY + math.abs(LookX) * HalfSizeZ :: number
	const OverlapX = (BodyHalfSizeX + WorldExtentX) - math.abs(DeltaX) :: number
	if OverlapX <= 0 then
		return false, 0, 0, 0, 0
	end

	const WorldExtentY =
		math.abs(RightY) * HalfSizeX + math.abs(UpY) * HalfSizeY + math.abs(LookY) * HalfSizeZ :: number
	const OverlapY = (BodyHalfSizeY + WorldExtentY) - math.abs(DeltaY) :: number
	if OverlapY <= 0 then
		return false, 0, 0, 0, 0
	end

	const WorldExtentZ =
		math.abs(RightZ) * HalfSizeX + math.abs(UpZ) * HalfSizeY + math.abs(LookZ) * HalfSizeZ :: number
	const OverlapZ = (BodyHalfSizeZ + WorldExtentZ) - math.abs(DeltaZ) :: number
	if OverlapZ <= 0 then
		return false, 0, 0, 0, 0
	end

	local MinOverlap = OverlapY :: number
	local BestNormalX = 0 :: number
	local BestNormalY = if DeltaY >= 0 then 1 else -1 :: number
	local BestNormalZ = 0 :: number

	if OverlapX < MinOverlap then
		MinOverlap = OverlapX
		BestNormalX = if DeltaX >= 0 then 1 else -1
		BestNormalY = 0
		BestNormalZ = 0
	end

	if OverlapZ < MinOverlap then
		MinOverlap = OverlapZ
		BestNormalX = 0
		BestNormalY = 0
		BestNormalZ = if DeltaZ >= 0 then 1 else -1
	end

	const UpAxisDistance = DeltaX * UpX + DeltaY * UpY + DeltaZ * UpZ :: number
	const BodyProjectedUp =
		math.abs(UpX) * BodyHalfSizeX + math.abs(UpY) * BodyHalfSizeY + math.abs(UpZ) * BodyHalfSizeZ :: number
	const OverlapUp = (BodyProjectedUp + HalfSizeY) - math.abs(UpAxisDistance) :: number
	if OverlapUp <= 0 then
		return false, 0, 0, 0, 0
	end

	if OverlapUp < MinOverlap then
		const UpAxisSign = if UpAxisDistance >= 0 then 1 else -1 :: number
		MinOverlap = OverlapUp
		BestNormalX, BestNormalY, BestNormalZ = UpX * UpAxisSign, UpY * UpAxisSign, UpZ * UpAxisSign
	end

	const RightAxisDistance = DeltaX * RightX + DeltaY * RightY + DeltaZ * RightZ :: number
	const BodyProjectedRight =
		math.abs(RightX) * BodyHalfSizeX + math.abs(RightY) * BodyHalfSizeY + math.abs(RightZ) * BodyHalfSizeZ :: number
	const OverlapRight = (BodyProjectedRight + HalfSizeX) - math.abs(RightAxisDistance) :: number
	if OverlapRight <= 0 then
		return false, 0, 0, 0, 0
	end

	if OverlapRight < MinOverlap then
		const RightAxisSign = if RightAxisDistance >= 0 then 1 else -1 :: number
		MinOverlap = OverlapRight
		BestNormalX, BestNormalY, BestNormalZ = RightX * RightAxisSign, RightY * RightAxisSign, RightZ * RightAxisSign
	end

	const LookAxisDistance = DeltaX * LookX + DeltaY * LookY + DeltaZ * LookZ :: number
	const BodyProjectedLook =
		math.abs(LookX) * BodyHalfSizeX + math.abs(LookY) * BodyHalfSizeY + math.abs(LookZ) * BodyHalfSizeZ :: number
	const OverlapLook = (BodyProjectedLook + HalfSizeZ) - math.abs(LookAxisDistance) :: number
	if OverlapLook <= 0 then
		return false, 0, 0, 0, 0
	end

	if OverlapLook < MinOverlap then
		const LookAxisSign = if LookAxisDistance >= 0 then 1 else -1 :: number
		MinOverlap = OverlapLook
		BestNormalX, BestNormalY, BestNormalZ = LookX * LookAxisSign, LookY * LookAxisSign, LookZ * LookAxisSign
	end

	return true, BestNormalX, BestNormalY, BestNormalZ, MinOverlap
end

--[=[
	Resolves broadphase and narrowphase collisions between a dynamic body and the world using BVH and SAT.
	@param BodyX number -- Body center position X.
	@param BodyY number -- Body center position Y.
	@param BodyZ number -- Body center position Z.
	@param BodyHalfSizeX number -- Body half extent X.
	@param BodyHalfSizeY number -- Body half extent Y.
	@param BodyHalfSizeZ number -- Body half extent Z.
	@param VelocityX number -- Body linear velocity X.
	@param VelocityY number -- Body linear velocity Y.
	@param VelocityZ number -- Body linear velocity Z.
	@param BodyInverseMass number -- 1 / mass in kg.
	@param Restitution number -- Coefficient of restitution.
	@param IgnoreEntityId number -- Entity ID to ignore during collision.
	@param EntityCount number -- Total active ECS entity count.
	@param PositionBuffer buffer -- ECS positions buffer.
	@param SizeBuffer buffer -- ECS sizes buffer.
	@param DirectionsBuffer buffer -- ECS directions buffer.
	@param DynamicFlags buffer -- ECS dynamic flags buffer.
	@param ObjectVelocityBuffer buffer -- Dynamic objects velocity buffer.
	@param ObjectInvMassBuffer buffer -- Dynamic objects inverse mass buffer.
	@return (number, number, number, number, number, number, boolean) -- NextX, NextY, NextZ, NextVelX, NextVelY, NextVelZ, Grounded.
]=]
function PhysicsMath.ResolveBodyWorldCollisions(
	BodyX: number,
	BodyY: number,
	BodyZ: number,
	BodyHalfSizeX: number,
	BodyHalfSizeY: number,
	BodyHalfSizeZ: number,
	VelocityX: number,
	VelocityY: number,
	VelocityZ: number,
	BodyInverseMass: number,
	Restitution: number,
	IgnoreEntityId: number,
	EntityCount: number,
	PositionBuffer: buffer,
	SizeBuffer: buffer,
	DirectionsBuffer: buffer,
	DynamicFlags: buffer,
	ObjectVelocityBuffer: buffer,
	ObjectInvMassBuffer: buffer
): (number, number, number, number, number, number, boolean)
	local NextX = BodyX :: number
	local NextY = BodyY :: number
	local NextZ = BodyZ :: number
	local NextVelocityX = VelocityX :: number
	local NextVelocityY = VelocityY :: number
	local NextVelocityZ = VelocityZ :: number
	local Grounded = false :: boolean

	const QueryPadX = BodyHalfSizeX + BROADPHASE_PADDING :: number
	const QueryPadY = BodyHalfSizeY + BROADPHASE_PADDING :: number
	const QueryPadZ = BodyHalfSizeZ + BROADPHASE_PADDING :: number
	const CandidateCount = BVH.QueryAABB(
		Vector3.new(NextX - QueryPadX, NextY - QueryPadY, NextZ - QueryPadZ),
		Vector3.new(NextX + QueryPadX, NextY + QueryPadY, NextZ + QueryPadZ),
		BroadphaseCandidates
	) :: number

	for CandidateIdx = 1, CandidateCount do
		const EntityId = BroadphaseCandidates[CandidateIdx] :: number
		if EntityId == IgnoreEntityId or EntityId < 1 or EntityId > EntityCount then
			continue
		end

		const CompOffset = (EntityId - 1) * COMPONENT_STRIDE :: number
		const DirOffset = (EntityId - 1) * DIRECTION_STRIDE :: number

		const Hit: boolean, NormalX: number, NormalY: number, NormalZ: number, Penetration: number =
			PhysicsMath.TestBoxVsOBB(
				NextX,
				NextY,
				NextZ,
				BodyHalfSizeX,
				BodyHalfSizeY,
				BodyHalfSizeZ,
				CompOffset,
				DirOffset,
				PositionBuffer,
				SizeBuffer,
				DirectionsBuffer
			)

		if not Hit then
			continue
		end

		if NormalY >= WALKABLE_NORMAL_Y then
			Grounded = true
		end

		const OtherDynamicState = buffer.readu8(DynamicFlags, EntityId - 1) :: number
		if OtherDynamicState > 0 then
			NextX, NextY, NextZ, NextVelocityX, NextVelocityY, NextVelocityZ =
				PhysicsMathHelper.ResolveDynamicPairContact(
					NextX,
					NextY,
					NextZ,
					NextVelocityX,
					NextVelocityY,
					NextVelocityZ,
					BodyInverseMass,
					EntityId,
					NormalX,
					NormalY,
					NormalZ,
					Penetration,
					PositionBuffer,
					DynamicFlags,
					ObjectVelocityBuffer,
					ObjectInvMassBuffer
				)
			continue
		end

		NextX += NormalX * Penetration
		NextY += NormalY * Penetration
		NextZ += NormalZ * Penetration

		const NormalVelocity = NextVelocityX * NormalX + NextVelocityY * NormalY + NextVelocityZ * NormalZ :: number
		if NormalVelocity < 0 then
			const BounceScale = -(1 + Restitution) * NormalVelocity :: number
			NextVelocityX += NormalX * BounceScale
			NextVelocityY += NormalY * BounceScale
			NextVelocityZ += NormalZ * BounceScale
		end
	end

	return NextX, NextY, NextZ, NextVelocityX, NextVelocityY, NextVelocityZ, Grounded
end

return PhysicsMath
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="132">
              <Properties>
                <string name="Name">PhysicsMathHelper</string>
                <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))

-- Configs --
const PLAYER_MASS = SystemsConfigs.PlayerMass :: number
const PLAYER_INV_MASS = 1 / PLAYER_MASS :: number
const PLAYER_MOVE_FORCE = SystemsConfigs.PlayerMoveForce :: number
const PLAYER_MAX_GROUND_SPEED = SystemsConfigs.PlayerMaxGroundSpeed :: number
const PLAYER_GROUND_FRICTION = SystemsConfigs.PlayerGroundFriction :: number
const PLAYER_BRAKE_MULTIPLIER = SystemsConfigs.PlayerBrakeMultiplier :: number
const PLAYER_STOP_SPEED = SystemsConfigs.PlayerStopSpeed :: number
const PLAYER_AIR_CONTROL = SystemsConfigs.PlayerAirControlMultiplier :: number
const PLAYER_AIR_DRAG = SystemsConfigs.PlayerAirDrag :: number
const OBJECT_RESTITUTION = SystemsConfigs.ObjectRestitution :: number
const COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number

local PhysicsMathHelper = {}

-- ============================================================================
-- 1. FRICTION, DRIVE INTEGRATION & PAIR CONTACT RESOLUTION HELPERS
-- ============================================================================

--[=[
	Applies ground stopping friction to bring horizontal velocity smoothly to rest.
	@param VelocityX number -- Current horizontal velocity X.
	@param VelocityZ number -- Current horizontal velocity Z.
	@param FrictionRate number -- Rate of ground friction decay.
	@param DeltaTime number -- Elapsed frame time in seconds.
	@return (number, number) -- Decelerated (VelocityX, VelocityZ).
]=]
function PhysicsMathHelper.ApplyStopFriction(
	VelocityX: number,
	VelocityZ: number,
	FrictionRate: number,
	DeltaTime: number
): (number, number)
	const HorizontalSpeed = math.sqrt(VelocityX * VelocityX + VelocityZ * VelocityZ) :: number
	if HorizontalSpeed <= 1e-5 then
		return 0, 0
	end

	const ControlSpeed = math.max(HorizontalSpeed, PLAYER_STOP_SPEED) :: number
	const SpeedDrop = ControlSpeed * FrictionRate * DeltaTime :: number
	const RetainedScale = math.max(0, HorizontalSpeed - SpeedDrop) / HorizontalSpeed :: number
	return VelocityX * RetainedScale, VelocityZ * RetainedScale
end

--[=[
	Integrates player horizontal ground acceleration and directional braking against wish intent.
	@param VelocityX number -- Current horizontal velocity X.
	@param VelocityZ number -- Current horizontal velocity Z.
	@param WishX number -- Desired unit wish direction X.
	@param WishZ number -- Desired unit wish direction Z.
	@param WishScale number -- Wish speed multiplier.
	@param DeltaTime number -- Elapsed frame time in seconds.
	@return (number, number) -- Next (VelocityX, VelocityZ).
]=]
function PhysicsMathHelper.IntegrateGroundedDrive(
	VelocityX: number,
	VelocityZ: number,
	WishX: number,
	WishZ: number,
	WishScale: number,
	DeltaTime: number
): (number, number)
	if WishScale <= 1e-4 then
		return PhysicsMathHelper.ApplyStopFriction(
			VelocityX,
			VelocityZ,
			PLAYER_GROUND_FRICTION * PLAYER_BRAKE_MULTIPLIER,
			DeltaTime
		)
	end

	local ParallelSpeed = VelocityX * WishX + VelocityZ * WishZ :: number
	const LateralDecay = math.max(0, 1 - PLAYER_GROUND_FRICTION * DeltaTime) :: number
	const LateralVelocityX = (VelocityX - ParallelSpeed * WishX) * LateralDecay :: number
	const LateralVelocityZ = (VelocityZ - ParallelSpeed * WishZ) * LateralDecay :: number

	const TargetSpeed = PLAYER_MAX_GROUND_SPEED * WishScale :: number
	const DriveStep = (PLAYER_MOVE_FORCE * PLAYER_INV_MASS) * WishScale * DeltaTime :: number

	if ParallelSpeed < 0 then
		const BrakeDecay = math.max(0, 1 - PLAYER_GROUND_FRICTION * PLAYER_BRAKE_MULTIPLIER * DeltaTime) :: number
		ParallelSpeed = math.min(TargetSpeed, ParallelSpeed * BrakeDecay + DriveStep)
	elseif ParallelSpeed < TargetSpeed then
		ParallelSpeed = math.min(TargetSpeed, ParallelSpeed + DriveStep)
	else
		ParallelSpeed = math.max(TargetSpeed, ParallelSpeed - ParallelSpeed * PLAYER_GROUND_FRICTION * DeltaTime)
	end

	return LateralVelocityX + WishX * ParallelSpeed, LateralVelocityZ + WishZ * ParallelSpeed
end

--[=[
	Integrates player airborne velocity, applying air resistance and responsive air-control steering.
	@param VelocityX number -- Current horizontal velocity X.
	@param VelocityZ number -- Current horizontal velocity Z.
	@param WishX number -- Desired unit wish direction X.
	@param WishZ number -- Desired unit wish direction Z.
	@param WishScale number -- Wish speed multiplier.
	@param DeltaTime number -- Elapsed frame time in seconds.
	@return (number, number) -- Next (VelocityX, VelocityZ).
]=]
function PhysicsMathHelper.IntegrateAirborneDrive(
	VelocityX: number,
	VelocityZ: number,
	WishX: number,
	WishZ: number,
	WishScale: number,
	DeltaTime: number
): (number, number)
	const AirDecay = math.max(0, 1 - PLAYER_AIR_DRAG * DeltaTime) :: number
	local NextVelocityX = VelocityX * AirDecay :: number
	local NextVelocityZ = VelocityZ * AirDecay :: number

	if WishScale <= 1e-4 then
		return NextVelocityX, NextVelocityZ
	end

	const ProjectedSpeed = NextVelocityX * WishX + NextVelocityZ * WishZ :: number
	const TargetSpeed = PLAYER_MAX_GROUND_SPEED * WishScale :: number
	const MaxAirStep = (PLAYER_MOVE_FORCE * PLAYER_INV_MASS * PLAYER_AIR_CONTROL) * WishScale * DeltaTime :: number
	const AirAddedSpeed = math.clamp(TargetSpeed - ProjectedSpeed, 0, MaxAirStep) :: number

	return NextVelocityX + WishX * AirAddedSpeed, NextVelocityZ + WishZ * AirAddedSpeed
end

--[=[
	Resolves penetration and dynamic impulse transfer between two intersecting moving bodies.
	@param BodyX number -- Primary body center position X.
	@param BodyY number -- Primary body center position Y.
	@param BodyZ number -- Primary body center position Z.
	@param VelocityX number -- Primary body velocity X.
	@param VelocityY number -- Primary body velocity Y.
	@param VelocityZ number -- Primary body velocity Z.
	@param BodyInverseMass number -- 1 / mass of primary body.
	@param OtherEntityIndex number -- Target colliding entity index.
	@param NormalX number -- Contact surface normal X.
	@param NormalY number -- Contact surface normal Y.
	@param NormalZ number -- Contact surface normal Z.
	@param Penetration number -- Overlap depth along contact normal.
	@param PositionBuffer buffer -- ECS positions buffer.
	@param DynamicFlags buffer -- ECS dynamic state buffer.
	@param ObjectVelocityBuffer buffer -- Dynamic objects velocity buffer.
	@param ObjectInvMassBuffer buffer -- Dynamic objects inverse mass buffer.
	@return (number, number, number, number, number, number) -- NextBodyX, NextBodyY, NextBodyZ, NextVelX, NextVelY, NextVelZ.
]=]
function PhysicsMathHelper.ResolveDynamicPairContact(
	BodyX: number,
	BodyY: number,
	BodyZ: number,
	VelocityX: number,
	VelocityY: number,
	VelocityZ: number,
	BodyInverseMass: number,
	OtherEntityIndex: number,
	NormalX: number,
	NormalY: number,
	NormalZ: number,
	Penetration: number,
	PositionBuffer: buffer,
	DynamicFlags: buffer,
	ObjectVelocityBuffer: buffer,
	ObjectInvMassBuffer: buffer
): (number, number, number, number, number, number)
	const FlagIndex = OtherEntityIndex - 1 :: number
	const OtherCompOffset = FlagIndex * COMPONENT_STRIDE :: number
	const OtherInverseMass = buffer.readf32(ObjectInvMassBuffer, FlagIndex * 4) :: number
	const TotalInverseMass = BodyInverseMass + OtherInverseMass :: number

	if TotalInverseMass <= 1e-6 then
		return BodyX + NormalX * Penetration,
			BodyY + NormalY * Penetration,
			BodyZ + NormalZ * Penetration,
			VelocityX,
			VelocityY,
			VelocityZ
	end

	buffer.writeu8(DynamicFlags, FlagIndex, 1)

	const BodyShare = BodyInverseMass / TotalInverseMass :: number
	const OtherShare = OtherInverseMass / TotalInverseMass :: number

	const NextBodyX = BodyX + NormalX * (Penetration * BodyShare) :: number
	const NextBodyY = BodyY + NormalY * (Penetration * BodyShare) :: number
	const NextBodyZ = BodyZ + NormalZ * (Penetration * BodyShare) :: number

	buffer.writef32(
		PositionBuffer,
		OtherCompOffset,
		buffer.readf32(PositionBuffer, OtherCompOffset) - NormalX * (Penetration * OtherShare)
	)
	buffer.writef32(
		PositionBuffer,
		OtherCompOffset + 4,
		buffer.readf32(PositionBuffer, OtherCompOffset + 4) - NormalY * (Penetration * OtherShare)
	)
	buffer.writef32(
		PositionBuffer,
		OtherCompOffset + 8,
		buffer.readf32(PositionBuffer, OtherCompOffset + 8) - NormalZ * (Penetration * OtherShare)
	)

	const OtherVelocityX = buffer.readf32(ObjectVelocityBuffer, OtherCompOffset) :: number
	const OtherVelocityY = buffer.readf32(ObjectVelocityBuffer, OtherCompOffset + 4) :: number
	const OtherVelocityZ = buffer.readf32(ObjectVelocityBuffer, OtherCompOffset + 8) :: number

	const RelativeNormalVelocity = (VelocityX - OtherVelocityX) * NormalX
		+ (VelocityY - OtherVelocityY) * NormalY
		+ (VelocityZ - OtherVelocityZ) * NormalZ :: number
	if RelativeNormalVelocity >= 0 then
		return NextBodyX, NextBodyY, NextBodyZ, VelocityX, VelocityY, VelocityZ
	end

	const ImpulseScalar = -(1 + OBJECT_RESTITUTION) * RelativeNormalVelocity / TotalInverseMass :: number
	const BodyImpulse = ImpulseScalar * BodyInverseMass :: number
	const OtherImpulse = ImpulseScalar * OtherInverseMass :: number

	buffer.writef32(ObjectVelocityBuffer, OtherCompOffset, OtherVelocityX - NormalX * OtherImpulse)
	buffer.writef32(ObjectVelocityBuffer, OtherCompOffset + 4, OtherVelocityY - NormalY * OtherImpulse)
	buffer.writef32(ObjectVelocityBuffer, OtherCompOffset + 8, OtherVelocityZ - NormalZ * OtherImpulse)

	return NextBodyX,
		NextBodyY,
		NextBodyZ,
		VelocityX + NormalX * BodyImpulse,
		VelocityY + NormalY * BodyImpulse,
		VelocityZ + NormalZ * BodyImpulse
end

return PhysicsMathHelper
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">PhysicsLibrary</string>
              <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Static References --
const PhysicsFolder = ReplicatedStorage:WaitForChild("Shared")
	:WaitForChild("Utilities")
	:WaitForChild("Physics")

-- Modules --
const PhysicsController = require(PhysicsFolder:WaitForChild("Controller"):WaitForChild("PhysicsController"))

local PhysicsLibrary = {}

-- ============================================================================
-- 1. DYNAMIC ENTITY & OBJECT SIMULATION CALLS
-- ============================================================================

--[=[
	Sets whether an ECS entity is dynamically simulated in the physics engine.
	@param EntityId number -- Target ECS entity index.
	@param IsDynamic boolean -- Whether the entity should be dynamic.
	@param CustomMass number? -- Optional explicit mass override in kg.
]=]
function PhysicsLibrary.SetEntityDynamic(EntityId: number, IsDynamic: boolean, CustomMass: number?)
	PhysicsController.SetEntityDynamic(EntityId, IsDynamic, CustomMass)
end

--[=[
	Enables physics simulation for a registered entity.
	@param EntityId number -- Target ECS entity index.
	@param CustomMass number? -- Optional explicit mass override in kg.
]=]
function PhysicsLibrary.SimulateInstance(EntityId: number, CustomMass: number?)
	PhysicsController.SetEntityDynamic(EntityId, true, CustomMass)
end

--[=[
	Disables dynamic physics simulation for a registered entity.
	@param EntityId number -- Target ECS entity index.
]=]
function PhysicsLibrary.StopSimulatingInstance(EntityId: number)
	PhysicsController.SetEntityDynamic(EntityId, false)
end

--[=[
	Directly queues continuous force or instantaneous impulse movement on an object.
	@param EntityId number -- Target ECS entity index.
	@param DirX number -- Unit force or impulse direction X.
	@param DirY number -- Unit force or impulse direction Y.
	@param DirZ number -- Unit force or impulse direction Z.
	@param Magnitude number -- Force (Newtons) or impulse (kg*m/s) magnitude.
	@param IsImpulse boolean? -- True if instantaneous impulse; false if continuous force.
]=]
function PhysicsLibrary.AddObjectMovement(
	EntityId: number,
	DirX: number,
	DirY: number,
	DirZ: number,
	Magnitude: number,
	IsImpulse: boolean?
)
	PhysicsController.AddObjectMovement(EntityId, DirX, DirY, DirZ, Magnitude, IsImpulse)
end

--[=[
	Applies a continuous world-space force to a dynamic object.
	@param EntityId number -- Target ECS entity index.
	@param Direction Vector3 -- Force direction vector.
	@param Magnitude number -- Force magnitude in Newtons.
]=]
function PhysicsLibrary.ApplyObjectForce(EntityId: number, Direction: Vector3, Magnitude: number)
	const DirLen = Direction.Magnitude :: number
	if DirLen <= 1e-6 or Magnitude == 0 then
		return
	end

	const InvLen = 1 / DirLen :: number
	PhysicsController.AddObjectMovement(
		EntityId,
		Direction.X * InvLen,
		Direction.Y * InvLen,
		Direction.Z * InvLen,
		Magnitude,
		false
	)
end

--[=[
	Applies an instantaneous world-space impulse to a dynamic object.
	@param EntityId number -- Target ECS entity index.
	@param Direction Vector3 -- Impulse direction vector.
	@param Magnitude number -- Impulse magnitude in kg*m/s.
]=]
function PhysicsLibrary.ApplyObjectImpulse(EntityId: number, Direction: Vector3, Magnitude: number)
	const DirLen = Direction.Magnitude :: number
	if DirLen <= 1e-6 or Magnitude == 0 then
		return
	end

	const InvLen = 1 / DirLen :: number
	PhysicsController.AddObjectMovement(
		EntityId,
		Direction.X * InvLen,
		Direction.Y * InvLen,
		Direction.Z * InvLen,
		Magnitude,
		true
	)
end

-- ============================================================================
-- 2. PLAYER MOVEMENT & STATE CALLS
-- ============================================================================

--[=[
	Directly queues wish-direction intent, jumping, or impulses on the local player.
	@param DirX number -- Wish-direction component X.
	@param DirY number -- Wish-direction component Y.
	@param DirZ number -- Wish-direction component Z.
	@param Scale number? -- Movement speed scale factor (defaults to 1).
	@param Jump boolean? -- Whether jump intent is triggered.
	@param IsImpulse boolean? -- True if instantaneous impulse.
]=]
function PhysicsLibrary.AddPlayerMovement(
	DirX: number,
	DirY: number,
	DirZ: number,
	Scale: number?,
	Jump: boolean?,
	IsImpulse: boolean?
)
	PhysicsController.AddPlayerMovement(DirX, DirY, DirZ, Scale, Jump, IsImpulse)
end

--[=[
	Moves the local player along a world-space direction vector with optional jump.
	@param Direction Vector3 -- Desired movement direction.
	@param Scale number? -- Movement speed scale factor.
	@param Jump boolean? -- Whether jump intent is active.
]=]
function PhysicsLibrary.MovePlayer(Direction: Vector3, Scale: number?, Jump: boolean?)
	const DirLen = Direction.Magnitude :: number
	if DirLen <= 1e-6 then
		if Jump then
			PhysicsController.AddPlayerMovement(0, 0, 0, 0, true, false)
		end
		return
	end

	const InvLen = 1 / DirLen :: number
	PhysicsController.AddPlayerMovement(
		Direction.X * InvLen,
		Direction.Y * InvLen,
		Direction.Z * InvLen,
		Scale,
		Jump,
		false
	)
end

--[=[
	Applies an instantaneous velocity impulse to the local player.
	@param Direction Vector3 -- Impulse direction vector.
	@param Magnitude number -- Impulse magnitude.
]=]
function PhysicsLibrary.ApplyPlayerImpulse(Direction: Vector3, Magnitude: number)
	const DirLen = Direction.Magnitude :: number
	if DirLen <= 1e-6 or Magnitude == 0 then
		return
	end

	const InvLen = 1 / DirLen :: number
	PhysicsController.AddPlayerMovement(
		Direction.X * InvLen,
		Direction.Y * InvLen,
		Direction.Z * InvLen,
		Magnitude,
		false,
		true
	)
end

--[=[
	Triggers an instantaneous jump for the local player.
]=]
function PhysicsLibrary.JumpPlayer()
	PhysicsController.AddPlayerMovement(0, 0, 0, 0, true, false)
end

--[=[
	Returns the current simulated position of the local player character.
	@return Vector3 -- Current position.
]=]
function PhysicsLibrary.GetPlayerPosition(): Vector3
	return PhysicsController.GetPlayerPosition()
end

--[=[
	Teleports the local player character to a new world position.
	@param NewPosition Vector3 -- Target world position.
]=]
function PhysicsLibrary.SetPlayerPosition(NewPosition: Vector3)
	PhysicsController.SetPlayerPosition(NewPosition)
end

--[=[
	Returns the current linear velocity of the local player character.
	@return Vector3 -- Current linear velocity.
]=]
function PhysicsLibrary.GetPlayerVelocity(): Vector3
	return PhysicsController.GetPlayerVelocity()
end

--[=[
	Sets the linear velocity of the local player character.
	@param NewVelocity Vector3 -- Target linear velocity.
]=]
function PhysicsLibrary.SetPlayerVelocity(NewVelocity: Vector3)
	PhysicsController.SetPlayerVelocity(NewVelocity)
end

--[=[
	Checks whether the local player character is currently resting on ground.
	@return boolean -- True if grounded.
]=]
function PhysicsLibrary.IsPlayerGrounded(): boolean
	return PhysicsController.IsPlayerGrounded()
end

return PhysicsLibrary
]]></string>
            </Properties>
          </Item>
        </Item>
