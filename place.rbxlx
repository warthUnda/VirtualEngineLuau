            <Item class="ModuleScript" referent="107">
              <Properties>
                <string name="Name">PhysicsController</string>
                <string name="Source"><![CDATA[--!native
--!optimize 2

-- Services --
const Players = game:GetService("Players") :: Players
const ReplicatedStorage = game:GetService("ReplicatedStorage") :: ReplicatedStorage
const RunService = game:GetService("RunService") :: RunService
const UserInputService = game:GetService("UserInputService") :: UserInputService

-- Static References --
const IS_CLIENT = RunService:IsClient() :: boolean
const SharedFolder = ReplicatedStorage:WaitForChild("Shared") :: Folder
const UtilitiesFolder = SharedFolder:WaitForChild("Utilities") :: Folder
const PhysicsFolder = UtilitiesFolder:WaitForChild("Physics") :: Folder

-- Modules --
const SystemsConfigs = require(SharedFolder:WaitForChild("SystemsConfigs"))
const PhysicsMovementQueue = require(PhysicsFolder:WaitForChild("PhysicsMovementQueue"))
const PhysicsLibrary = require(PhysicsFolder:WaitForChild("Core"):WaitForChild("PhysicsLIbrary"))

const CameraStore = if IS_CLIENT
	then require(
		UtilitiesFolder:WaitForChild("Render")
			:WaitForChild("Camera")
			:WaitForChild("CameraStore")
	)
	else nil

-- Configs --
const MAX_DELTA_TIME = SystemsConfigs.PhysicsMaxDeltaTime :: number
const SUBSTEPS = math.max(1, SystemsConfigs.PhysicsSubsteps) :: number

const DEFAULT_SPAWN = SystemsConfigs.PlayerDefaultSpawnPosition :: Vector3
const VOID_RESET_Y = SystemsConfigs.PlayerVoidResetY :: number
const PLAYER_MASS = SystemsConfigs.PlayerMass :: number
const PLAYER_INV_MASS = 1 / PLAYER_MASS :: number

const PLAYER_HALF_EXTENTS = SystemsConfigs.PlayerHalfExtents :: Vector3
const PLAYER_HX = PLAYER_HALF_EXTENTS.X :: number
const PLAYER_HY = PLAYER_HALF_EXTENTS.Y :: number
const PLAYER_HZ = PLAYER_HALF_EXTENTS.Z :: number

const OBJECT_DEFAULT_DENSITY = SystemsConfigs.ObjectDefaultDensity :: number
const OBJECT_RESTITUTION = SystemsConfigs.ObjectRestitution :: number
const SLEEP_SPEED_THRESHOLD = SystemsConfigs.ObjectSleepSpeedThreshold :: number
const SLEEP_SPEED_SQ = SLEEP_SPEED_THRESHOLD * SLEEP_SPEED_THRESHOLD :: number

const COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number
const MAX_ENTITIES = SystemsConfigs.ECSMaxEntities :: number
const PLAYER_CMD_STRIDE = PhysicsMovementQueue.PlayerCommandStride :: number
const OBJECT_CMD_STRIDE = PhysicsMovementQueue.ObjectCommandStride :: number

-- Tables --
local Initialized = false :: boolean
local ActiveForceCount = 0 :: number

local SpawnPosX = DEFAULT_SPAWN.X :: number
local SpawnPosY = DEFAULT_SPAWN.Y :: number
local SpawnPosZ = DEFAULT_SPAWN.Z :: number

local PlayerPosX = DEFAULT_SPAWN.X :: number
local PlayerPosY = DEFAULT_SPAWN.Y :: number
local PlayerPosZ = DEFAULT_SPAWN.Z :: number

local PlayerVelX = 0 :: number
local PlayerVelY = 0 :: number
local PlayerVelZ = 0 :: number
local PlayerGrounded = false :: boolean

local HostRootPart: BasePart? = nil
local ECSDataModule: any = nil

-- Buffers
local ECSPositionBuffer: buffer? = nil
local ECSSizeBuffer: buffer? = nil
local ECSDirectionsBuffer: buffer? = nil
local ECSPropertiesBuffer: buffer? = nil

const FLAG_CAN_COLLIDE = bit32.lshift(1, 1) :: number
const FLAG_IS_VISIBLE = bit32.lshift(1, 2) :: number
const FLAG_ANCHORED = bit32.lshift(1, 3) :: number

const DynamicFlags = buffer.create(MAX_ENTITIES) :: buffer -- 0 = static, 1 = awake dynamic, 2 = sleeping dynamic
const ObjectGroundedFlags = buffer.create(MAX_ENTITIES) :: buffer
const ObjectVelocityBuffer = buffer.create(MAX_ENTITIES * COMPONENT_STRIDE) :: buffer
const ObjectForceBuffer = buffer.create(MAX_ENTITIES * COMPONENT_STRIDE) :: buffer
const ObjectInvMassBuffer = buffer.create(MAX_ENTITIES * 4) :: buffer
const ActiveForceSlots = buffer.create(MAX_ENTITIES * 4) :: buffer

local PhysicsController = {}

-- ============================================================================
-- 1. INTERNAL HELPERS - STORAGE BINDING, INPUT & QUEUE CONSUMPTION
-- ============================================================================

local function ResolveObjectStorage(): Instance?
	if not IS_CLIENT then
		return nil
	end

	const LocalPlayer = Players.LocalPlayer :: Player?
	if not LocalPlayer then
		return nil
	end

	const PlayerScripts = LocalPlayer:WaitForChild("PlayerScripts") :: PlayerScripts
	const ControllerActor = PlayerScripts:FindFirstChild("Controller") :: Actor?
	if ControllerActor then
		const ActorStorage = ControllerActor:FindFirstChild("ObjectStorage")
		if ActorStorage then
			return ActorStorage
		end
	end

	return PlayerScripts:WaitForChild("Client")
		:WaitForChild("Objects")
		:WaitForChild("ObjectStorage")
end

local function ConfigureCharacterInstance(Character: Model)
	const Humanoid = Character:FindFirstChildWhichIsA("Humanoid") :: Humanoid?
	if Humanoid then
		Humanoid.PlatformStand = true
	end

	for _, Descendant: Instance in ipairs(Character:GetDescendants()) do
		if Descendant:IsA("BasePart") then
			Descendant.CanCollide = false
		end
	end

	const RootPart = (Character:FindFirstChild("HumanoidRootPart") or Character:WaitForChild("HumanoidRootPart", 5)) :: BasePart?
	if not RootPart then
		return
	end

	RootPart.Anchored = true
	RootPart.CanCollide = false
	HostRootPart = RootPart

	const StartPos = RootPart.Position :: Vector3
	SpawnPosX, SpawnPosY, SpawnPosZ = StartPos.X, StartPos.Y + 0.5, StartPos.Z
	PlayerPosX, PlayerPosY, PlayerPosZ = SpawnPosX, SpawnPosY, SpawnPosZ
	PlayerVelX, PlayerVelY, PlayerVelZ = 0, 0, 0
end

local function SampleKeyboardInput()
	if not IS_CLIENT or not CameraStore then
		return
	end

	if UserInputService:GetFocusedTextBox() ~= nil then
		return
	end

	const CamLook = CameraStore.GetCameraLook() :: Vector3
	const CamRight = CameraStore.GetCameraRight() :: Vector3

	local ForwardX: number, ForwardZ: number = CamLook.X, CamLook.Z
	const ForwardLen = math.sqrt(ForwardX * ForwardX + ForwardZ * ForwardZ) :: number
	if ForwardLen > 1e-5 then
		ForwardX /= ForwardLen
		ForwardZ /= ForwardLen
	end

	local RightX: number, RightZ: number = CamRight.X, CamRight.Z
	const RightLen = math.sqrt(RightX * RightX + RightZ * RightZ) :: number
	if RightLen > 1e-5 then
		RightX /= RightLen
		RightZ /= RightLen
	end

	local MoveX = 0 :: number
	local MoveZ = 0 :: number

	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		MoveX += ForwardX
		MoveZ += ForwardZ
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		MoveX -= ForwardX
		MoveZ -= ForwardZ
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		MoveX += RightX
		MoveZ += RightZ
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		MoveX -= RightX
		MoveZ -= RightZ
	end

	const MoveLen = math.sqrt(MoveX * MoveX + MoveZ * MoveZ) :: number
	if MoveLen > 1e-5 then
		MoveX /= MoveLen
		MoveZ /= MoveLen
	end

	const JumpPressed = UserInputService:IsKeyDown(Enum.KeyCode.Space) :: boolean
	if MoveLen > 1e-5 or JumpPressed then
		PhysicsMovementQueue.AddMovement(MoveX, 0, MoveZ, 1.0, JumpPressed, false)
	end
end

local function EnsureDynamicEntityMass(EntityId: number, SizeBuffer: buffer, CustomMass: number?): number
	const MassOffset = (EntityId - 1) * 4 :: number
	const ExistingInvMass = buffer.readf32(ObjectInvMassBuffer, MassOffset) :: number
	if ExistingInvMass > 0 and CustomMass == nil then
		return ExistingInvMass
	end

	local ResolvedMass = CustomMass :: number?
	if not ResolvedMass or ResolvedMass <= 0 then
		const CompOffset = (EntityId - 1) * COMPONENT_STRIDE :: number
		const Sx = math.max(0.1, buffer.readf32(SizeBuffer, CompOffset)) :: number
		const Sy = math.max(0.1, buffer.readf32(SizeBuffer, CompOffset + 4)) :: number
		const Sz = math.max(0.1, buffer.readf32(SizeBuffer, CompOffset + 8)) :: number
		ResolvedMass = Sx * Sy * Sz * OBJECT_DEFAULT_DENSITY
	end

	const InvMass = 1 / (ResolvedMass :: number) :: number
	buffer.writef32(ObjectInvMassBuffer, MassOffset, InvMass)

	if ECSPropertiesBuffer then
		const PropReg = buffer.readu32(ECSPropertiesBuffer, MassOffset) :: number
		const UpdatedReg = bit32.bor(
			bit32.band(PropReg, bit32.bnot(FLAG_ANCHORED)),
			FLAG_CAN_COLLIDE,
			FLAG_IS_VISIBLE
		) :: number
		buffer.writeu32(ECSPropertiesBuffer, MassOffset, UpdatedReg)
	end

	return InvMass
end

local function ConsumePlayerQueue(): (number, number, number, boolean)
	local WishX = 0 :: number
	local WishZ = 0 :: number
	local MaxScale = 0 :: number
	local JumpRequested = false :: boolean

	const PlayerBuffer = PhysicsMovementQueue.PlayerBuffer :: buffer
	const CmdCount = PhysicsMovementQueue.GetPlayerCommandCount() :: number

	for i = 1, CmdCount do
		const Offset = (i - 1) * PLAYER_CMD_STRIDE :: number
		const DirX = buffer.readf32(PlayerBuffer, Offset) :: number
		const DirY = buffer.readf32(PlayerBuffer, Offset + 4) :: number
		const DirZ = buffer.readf32(PlayerBuffer, Offset + 8) :: number
		const Scale = buffer.readf32(PlayerBuffer, Offset + 12) :: number
		const Flags = buffer.readu8(PlayerBuffer, Offset + 16) :: number

		if bit32.band(Flags, 1) ~= 0 then
			JumpRequested = true
		end

		if bit32.band(Flags, 2) ~= 0 then
			PlayerVelX += DirX * Scale * PLAYER_INV_MASS
			PlayerVelY += DirY * Scale * PLAYER_INV_MASS
			PlayerVelZ += DirZ * Scale * PLAYER_INV_MASS
			continue
		end

		WishX += DirX * Scale
		WishZ += DirZ * Scale
		MaxScale = math.max(MaxScale, math.abs(Scale))
	end

	for _, Entry in ipairs(PhysicsMovementQueue.PlayerQueue) do
		const Scale = Entry.Scale or 1.0 :: number
		if Entry.Jump then
			JumpRequested = true
		end

		if Entry.IsImpulse then
			PlayerVelX += Entry.DirX * Scale * PLAYER_INV_MASS
			PlayerVelY += Entry.DirY * Scale * PLAYER_INV_MASS
			PlayerVelZ += Entry.DirZ * Scale * PLAYER_INV_MASS
			continue
		end

		WishX += Entry.DirX * Scale
		WishZ += Entry.DirZ * Scale
		MaxScale = math.max(MaxScale, math.abs(Scale))
	end

	const WishLen = math.sqrt(WishX * WishX + WishZ * WishZ) :: number
	if WishLen <= 1e-5 then
		return 0, 0, 0, JumpRequested
	end

	return WishX / WishLen, WishZ / WishLen, math.min(MaxScale, 2.5), JumpRequested
end

local function ConsumeObjectQueue(EntityCount: number, SizeBuffer: buffer)
	const ObjectQueueBuffer = PhysicsMovementQueue.ObjectQueue :: buffer
	const CmdCount = PhysicsMovementQueue.GetObjectCommandCount() :: number

	for i = 1, CmdCount do
		const Offset = (i - 1) * OBJECT_CMD_STRIDE :: number
		const EntityId = buffer.readu32(ObjectQueueBuffer, Offset) :: number
		if EntityId < 1 or EntityId > EntityCount then
			continue
		end

		const DirX = buffer.readf32(ObjectQueueBuffer, Offset + 4) :: number
		const DirY = buffer.readf32(ObjectQueueBuffer, Offset + 8) :: number
		const DirZ = buffer.readf32(ObjectQueueBuffer, Offset + 12) :: number
		const Magnitude = buffer.readf32(ObjectQueueBuffer, Offset + 16) :: number
		const IsImpulse = (buffer.readu8(ObjectQueueBuffer, Offset + 20) == 1) :: boolean

		const InvMass = EnsureDynamicEntityMass(EntityId, SizeBuffer, nil) :: number
		const FlagIndex = EntityId - 1 :: number
		const CompOffset = FlagIndex * COMPONENT_STRIDE :: number

		buffer.writeu8(DynamicFlags, FlagIndex, 1)

		if IsImpulse then
			const DeltaV = Magnitude * InvMass :: number
			buffer.writef32(ObjectVelocityBuffer, CompOffset, buffer.readf32(ObjectVelocityBuffer, CompOffset) + DirX * DeltaV)
			buffer.writef32(ObjectVelocityBuffer, CompOffset + 4, buffer.readf32(ObjectVelocityBuffer, CompOffset + 4) + DirY * DeltaV)
			buffer.writef32(ObjectVelocityBuffer, CompOffset + 8, buffer.readf32(ObjectVelocityBuffer, CompOffset + 8) + DirZ * DeltaV)
			continue
		end

		const PrevFx = buffer.readf32(ObjectForceBuffer, CompOffset) :: number
		const PrevFy = buffer.readf32(ObjectForceBuffer, CompOffset + 4) :: number
		const PrevFz = buffer.readf32(ObjectForceBuffer, CompOffset + 8) :: number

		if PrevFx == 0 and PrevFy == 0 and PrevFz == 0 and ActiveForceCount < MAX_ENTITIES then
			buffer.writeu32(ActiveForceSlots, ActiveForceCount * 4, CompOffset)
			ActiveForceCount += 1
		end

		buffer.writef32(ObjectForceBuffer, CompOffset, PrevFx + DirX * Magnitude)
		buffer.writef32(ObjectForceBuffer, CompOffset + 4, PrevFy + DirY * Magnitude)
		buffer.writef32(ObjectForceBuffer, CompOffset + 8, PrevFz + DirZ * Magnitude)
	end
end

local function StepSingleDynamicObject(
	EntityId: number,
	EntityCount: number,
	StepDt: number,
	PositionBuffer: buffer,
	SizeBuffer: buffer,
	DirectionsBuffer: buffer
)
	const FlagIndex = EntityId - 1 :: number
	const CompOffset = FlagIndex * COMPONENT_STRIDE :: number

	const InvMass = buffer.readf32(ObjectInvMassBuffer, FlagIndex * 4) :: number
	if InvMass <= 0 then
		buffer.writeu8(DynamicFlags, FlagIndex, 0)
		return
	end

	const WasGrounded = (buffer.readu8(ObjectGroundedFlags, FlagIndex) == 1) :: boolean
	const Fx = buffer.readf32(ObjectForceBuffer, CompOffset) :: number
	const Fy = buffer.readf32(ObjectForceBuffer, CompOffset + 4) :: number
	const Fz = buffer.readf32(ObjectForceBuffer, CompOffset + 8) :: number

	local Vx: number, Vy: number, Vz: number = PhysicsLibrary.StepObjectVelocity(
		buffer.readf32(ObjectVelocityBuffer, CompOffset),
		buffer.readf32(ObjectVelocityBuffer, CompOffset + 4),
		buffer.readf32(ObjectVelocityBuffer, CompOffset + 8),
		Fx,
		Fy,
		Fz,
		InvMass,
		WasGrounded,
		StepDt
	)

	local PosX = buffer.readf32(PositionBuffer, CompOffset) + Vx * StepDt :: number
	local PosY = buffer.readf32(PositionBuffer, CompOffset + 4) + Vy * StepDt :: number
	local PosZ = buffer.readf32(PositionBuffer, CompOffset + 8) + Vz * StepDt :: number

	const Hx = buffer.readf32(SizeBuffer, CompOffset) * 0.5 :: number
	const Hy = buffer.readf32(SizeBuffer, CompOffset + 4) * 0.5 :: number
	const Hz = buffer.readf32(SizeBuffer, CompOffset + 8) * 0.5 :: number

	local Grounded: boolean
	PosX, PosY, PosZ, Vx, Vy, Vz, Grounded = PhysicsLibrary.ResolveBodyWorldCollisions(
		PosX,
		PosY,
		PosZ,
		Hx,
		Hy,
		Hz,
		Vx,
		Vy,
		Vz,
		InvMass,
		OBJECT_RESTITUTION,
		EntityId,
		EntityCount,
		PositionBuffer,
		SizeBuffer,
		DirectionsBuffer,
		DynamicFlags,
		ObjectVelocityBuffer,
		ObjectInvMassBuffer
	)

	buffer.writef32(PositionBuffer, CompOffset, PosX)
	buffer.writef32(PositionBuffer, CompOffset + 4, PosY)
	buffer.writef32(PositionBuffer, CompOffset + 8, PosZ)
	buffer.writeu8(ObjectGroundedFlags, FlagIndex, if Grounded then 1 else 0)

	const SpeedSq = Vx * Vx + Vy * Vy + Vz * Vz :: number
	const HasAppliedForce = (Fx ~= 0 or Fy ~= 0 or Fz ~= 0) :: boolean
	if Grounded and not HasAppliedForce and SpeedSq < SLEEP_SPEED_SQ then
		buffer.writef32(ObjectVelocityBuffer, CompOffset, 0)
		buffer.writef32(ObjectVelocityBuffer, CompOffset + 4, 0)
		buffer.writef32(ObjectVelocityBuffer, CompOffset + 8, 0)
		buffer.writeu8(DynamicFlags, FlagIndex, 2)
		return
	end

	buffer.writef32(ObjectVelocityBuffer, CompOffset, Vx)
	buffer.writef32(ObjectVelocityBuffer, CompOffset + 4, Vy)
	buffer.writef32(ObjectVelocityBuffer, CompOffset + 8, Vz)
end

local function ClearAccumulatedForces()
	for i = 0, ActiveForceCount - 1 do
		const CompOffset = buffer.readu32(ActiveForceSlots, i * 4) :: number
		buffer.writef32(ObjectForceBuffer, CompOffset, 0)
		buffer.writef32(ObjectForceBuffer, CompOffset + 4, 0)
		buffer.writef32(ObjectForceBuffer, CompOffset + 8, 0)
	end
	ActiveForceCount = 0
end

-- ============================================================================
-- 2. PUBLIC CONTROLLER API - INITIALIZATION & FRAME SIMULATION
-- ============================================================================

function PhysicsController.InitializePhysics()
	if Initialized then
		return
	end

	const ObjectStorageModule = ResolveObjectStorage()
	if ObjectStorageModule then
		const ObjectStorage = require(ObjectStorageModule)
		ECSDataModule = ObjectStorage.ECSData
		ECSPositionBuffer = ObjectStorage.PositionData.GetData()
		ECSSizeBuffer = ObjectStorage.SizeData.GetData()
		ECSDirectionsBuffer = ObjectStorage.DirectionsData.GetData()
		ECSPropertiesBuffer = ObjectStorage.PropertiesData.GetData()
	end

	Initialized = true

	if not IS_CLIENT then
		return
	end

	const LocalPlayer = Players.LocalPlayer :: Player?
	if not LocalPlayer then
		return
	end

	if LocalPlayer.Character then
		task.spawn(ConfigureCharacterInstance, LocalPlayer.Character)
	end
	LocalPlayer.CharacterAdded:Connect(ConfigureCharacterInstance)
end

function PhysicsController.SimulatePhysicsFrame(DeltaTime: number?)
	if not Initialized then
		PhysicsController.InitializePhysics()
	end

	const PositionBuffer = ECSPositionBuffer
	const SizeBuffer = ECSSizeBuffer
	const DirectionsBuffer = ECSDirectionsBuffer
	if not PositionBuffer or not SizeBuffer or not DirectionsBuffer or not ECSDataModule then
		PhysicsMovementQueue.Clear()
		return
	end

	const EntityCount = math.min(ECSDataModule.GetCounts().EntityECSCount :: number, MAX_ENTITIES) :: number
	if EntityCount <= 0 then
		PhysicsMovementQueue.Clear()
		return
	end

	SampleKeyboardInput()
	const WishX: number, WishZ: number, WishScale: number, JumpRequested: boolean = ConsumePlayerQueue()
	ConsumeObjectQueue(EntityCount, SizeBuffer)

	const ClampedDt = math.clamp(DeltaTime or (1 / 60), 1e-4, MAX_DELTA_TIME) :: number
	const StepDt = ClampedDt / SUBSTEPS :: number
	local PendingJump = JumpRequested :: boolean

	for _ = 1, SUBSTEPS do
		const WasGrounded = PlayerGrounded :: boolean
		PlayerVelX, PlayerVelY, PlayerVelZ, PlayerGrounded = PhysicsLibrary.StepPlayerVelocity(
			PlayerVelX,
			PlayerVelY,
			PlayerVelZ,
			WishX,
			WishZ,
			WishScale,
			PendingJump,
			PlayerGrounded,
			StepDt
		)

		if WasGrounded and PendingJump then
			PendingJump = false
		end

		PlayerPosX += PlayerVelX * StepDt
		PlayerPosY += PlayerVelY * StepDt
		PlayerPosZ += PlayerVelZ * StepDt

		PlayerPosX, PlayerPosY, PlayerPosZ, PlayerVelX, PlayerVelY, PlayerVelZ, PlayerGrounded =
			PhysicsLibrary.ResolveBodyWorldCollisions(
				PlayerPosX,
				PlayerPosY,
				PlayerPosZ,
				PLAYER_HX,
				PLAYER_HY,
				PLAYER_HZ,
				PlayerVelX,
				PlayerVelY,
				PlayerVelZ,
				PLAYER_INV_MASS,
				0,
				0,
				EntityCount,
				PositionBuffer,
				SizeBuffer,
				DirectionsBuffer,
				DynamicFlags,
				ObjectVelocityBuffer,
				ObjectInvMassBuffer
			)

		for EntityId = 1, EntityCount do
			if buffer.readu8(DynamicFlags, EntityId - 1) == 1 then
				StepSingleDynamicObject(EntityId, EntityCount, StepDt, PositionBuffer, SizeBuffer, DirectionsBuffer)
			end
		end
	end

	ClearAccumulatedForces()

	if PlayerPosY < VOID_RESET_Y then
		PlayerPosX, PlayerPosY, PlayerPosZ = SpawnPosX, SpawnPosY, SpawnPosZ
		PlayerVelX, PlayerVelY, PlayerVelZ = 0, 0, 0
		PlayerGrounded = false
	end

	if HostRootPart and HostRootPart.Parent then
		HostRootPart.CFrame = HostRootPart.CFrame.Rotation + Vector3.new(PlayerPosX, PlayerPosY, PlayerPosZ)
	end

	PhysicsMovementQueue.Clear()
end

function PhysicsController.SetEntityDynamic(EntityId: number, IsDynamic: boolean, CustomMass: number?)
	if EntityId < 1 or EntityId > MAX_ENTITIES then
		return
	end

	const FlagIndex = EntityId - 1 :: number
	if not IsDynamic then
		buffer.writeu8(DynamicFlags, FlagIndex, 0)
		buffer.writef32(ObjectInvMassBuffer, FlagIndex * 4, 0)
		if ECSPropertiesBuffer then
			const PropReg = buffer.readu32(ECSPropertiesBuffer, FlagIndex * 4) :: number
			buffer.writeu32(
				ECSPropertiesBuffer,
				FlagIndex * 4,
				bit32.bor(PropReg, FLAG_CAN_COLLIDE, FLAG_IS_VISIBLE, FLAG_ANCHORED)
			)
		end
		return
	end

	if ECSSizeBuffer then
		EnsureDynamicEntityMass(EntityId, ECSSizeBuffer, CustomMass)
	end
	buffer.writeu8(DynamicFlags, FlagIndex, 1)
end

function PhysicsController.GetPlayerPosition(): Vector3
	return Vector3.new(PlayerPosX, PlayerPosY, PlayerPosZ)
end

function PhysicsController.SetPlayerPosition(NewPosition: Vector3)
	PlayerPosX, PlayerPosY, PlayerPosZ = NewPosition.X, NewPosition.Y, NewPosition.Z
	if HostRootPart and HostRootPart.Parent then
		HostRootPart.CFrame = HostRootPart.CFrame.Rotation + NewPosition
	end
end

function PhysicsController.GetPlayerVelocity(): Vector3
	return Vector3.new(PlayerVelX, PlayerVelY, PlayerVelZ)
end

function PhysicsController.SetPlayerVelocity(NewVelocity: Vector3)
	PlayerVelX, PlayerVelY, PlayerVelZ = NewVelocity.X, NewVelocity.Y, NewVelocity.Z
end

function PhysicsController.IsPlayerGrounded(): boolean
	return PlayerGrounded
end

return PhysicsController
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="Folder" referent="108">
            <Properties>
              <string name="Name">Core</string>
            </Properties>
            <Item class="ModuleScript" referent="109">
              <Properties>
                <string name="Name">PhysicsLibrary</string>
                <string name="Source"><![CDATA[--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage") :: ReplicatedStorage

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))
const BVH = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Utilities"):WaitForChild("BVH"))

-- Configs --
const GRAVITY = SystemsConfigs.PhysicsGravity :: number
const FALL_GRAVITY_MULTIPLIER = SystemsConfigs.PhysicsFallGravityMultiplier :: number

const PLAYER_MASS = SystemsConfigs.PlayerMass :: number
const PLAYER_INV_MASS = 1 / PLAYER_MASS :: number
const PLAYER_MOVE_FORCE = SystemsConfigs.PlayerMoveForce :: number
const PLAYER_MAX_GROUND_SPEED = SystemsConfigs.PlayerMaxGroundSpeed :: number
const PLAYER_GROUND_FRICTION = SystemsConfigs.PlayerGroundFriction :: number
const PLAYER_BRAKE_MULTIPLIER = SystemsConfigs.PlayerBrakeMultiplier :: number
const PLAYER_STOP_SPEED = SystemsConfigs.PlayerStopSpeed :: number
const PLAYER_AIR_CONTROL = SystemsConfigs.PlayerAirControlMultiplier :: number
const PLAYER_AIR_DRAG = SystemsConfigs.PlayerAirDrag :: number
const PLAYER_JUMP_VELOCITY = SystemsConfigs.PlayerJumpImpulse / PLAYER_MASS :: number
const WALKABLE_NORMAL_Y = SystemsConfigs.PlayerWalkableNormalY :: number

const OBJECT_LINEAR_DRAG = SystemsConfigs.ObjectLinearDrag :: number
const OBJECT_SURFACE_FRICTION = SystemsConfigs.ObjectSurfaceFriction :: number
const OBJECT_RESTITUTION = SystemsConfigs.ObjectRestitution :: number

const COMPONENT_STRIDE = SystemsConfigs.ECSComponentStride :: number
const DIRECTION_STRIDE = SystemsConfigs.ECSDirectionStride :: number
const MAX_ENTITIES = SystemsConfigs.ECSMaxEntities :: number
const BROADPHASE_PADDING = 2.0 :: number

-- Tables --
const BroadphaseCandidates = table.create(MAX_ENTITIES, 0) :: { number }

local PhysicsLibrary = {}

-- ============================================================================
-- 1. VELOCITY & INERTIA INTEGRATION
-- ============================================================================

local function ApplyStopFriction(Vx: number, Vz: number, FrictionRate: number, Dt: number): (number, number)
	const HorizSpeed = math.sqrt(Vx * Vx + Vz * Vz) :: number
	if HorizSpeed <= 1e-5 then
		return 0, 0
	end

	const Control = math.max(HorizSpeed, PLAYER_STOP_SPEED) :: number
	const Drop = Control * FrictionRate * Dt :: number
	const Scale = math.max(0, HorizSpeed - Drop) / HorizSpeed :: number
	return Vx * Scale, Vz * Scale
end

local function IntegrateGroundedDrive(
	Vx: number,
	Vz: number,
	WishX: number,
	WishZ: number,
	WishScale: number,
	Dt: number
): (number, number)
	if WishScale <= 1e-4 then
		return ApplyStopFriction(Vx, Vz, PLAYER_GROUND_FRICTION * PLAYER_BRAKE_MULTIPLIER, Dt)
	end

	local ParallelSpeed = Vx * WishX + Vz * WishZ :: number
	const LateralDecay = math.max(0, 1 - PLAYER_GROUND_FRICTION * Dt) :: number
	const LateralX = (Vx - ParallelSpeed * WishX) * LateralDecay :: number
	const LateralZ = (Vz - ParallelSpeed * WishZ) * LateralDecay :: number

	const TargetSpeed = PLAYER_MAX_GROUND_SPEED * WishScale :: number
	const DriveStep = (PLAYER_MOVE_FORCE * PLAYER_INV_MASS) * WishScale * Dt :: number

	if ParallelSpeed < 0 then
		const BrakeDecay = math.max(0, 1 - PLAYER_GROUND_FRICTION * PLAYER_BRAKE_MULTIPLIER * Dt) :: number
		ParallelSpeed = math.min(TargetSpeed, ParallelSpeed * BrakeDecay + DriveStep)
	elseif ParallelSpeed < TargetSpeed then
		ParallelSpeed = math.min(TargetSpeed, ParallelSpeed + DriveStep)
	else
		ParallelSpeed = math.max(TargetSpeed, ParallelSpeed - ParallelSpeed * PLAYER_GROUND_FRICTION * Dt)
	end

	return LateralX + WishX * ParallelSpeed, LateralZ + WishZ * ParallelSpeed
end

local function IntegrateAirborneDrive(
	Vx: number,
	Vz: number,
	WishX: number,
	WishZ: number,
	WishScale: number,
	Dt: number
): (number, number)
	const AirDecay = math.max(0, 1 - PLAYER_AIR_DRAG * Dt) :: number
	local NextVx = Vx * AirDecay :: number
	local NextVz = Vz * AirDecay :: number

	if WishScale <= 1e-4 then
		return NextVx, NextVz
	end

	const ProjectedSpeed = NextVx * WishX + NextVz * WishZ :: number
	const TargetSpeed = PLAYER_MAX_GROUND_SPEED * WishScale :: number
	const MaxAirStep = (PLAYER_MOVE_FORCE * PLAYER_INV_MASS * PLAYER_AIR_CONTROL) * WishScale * Dt :: number
	const AirAdd = math.clamp(TargetSpeed - ProjectedSpeed, 0, MaxAirStep) :: number

	return NextVx + WishX * AirAdd, NextVz + WishZ * AirAdd
end

function PhysicsLibrary.StepPlayerVelocity(
	Vx: number,
	Vy: number,
	Vz: number,
	WishX: number,
	WishZ: number,
	WishScale: number,
	JumpRequested: boolean,
	IsGrounded: boolean,
	Dt: number
): (number, number, number, boolean)
	local NextVx = Vx :: number
	local NextVy = Vy :: number
	local NextVz = Vz :: number
	local NextGrounded = IsGrounded :: boolean

	if NextGrounded then
		NextVx, NextVz = IntegrateGroundedDrive(NextVx, NextVz, WishX, WishZ, WishScale, Dt)
		if JumpRequested then
			NextVy = math.max(NextVy, PLAYER_JUMP_VELOCITY)
			NextGrounded = false
		end
	else
		NextVx, NextVz = IntegrateAirborneDrive(NextVx, NextVz, WishX, WishZ, WishScale, Dt)
	end

	const GravityScale = if NextVy < 0 then FALL_GRAVITY_MULTIPLIER else 1.0 :: number
	NextVy -= GRAVITY * GravityScale * Dt

	return NextVx, NextVy, NextVz, NextGrounded
end

function PhysicsLibrary.StepObjectVelocity(
	Vx: number,
	Vy: number,
	Vz: number,
	ForceX: number,
	ForceY: number,
	ForceZ: number,
	InvMass: number,
	IsGrounded: boolean,
	Dt: number
): (number, number, number)
	const AccelScale = InvMass * Dt :: number
	local NextVx = Vx + ForceX * AccelScale :: number
	local NextVy = Vy + ForceY * AccelScale - GRAVITY * Dt :: number
	local NextVz = Vz + ForceZ * AccelScale :: number

	const LinearDecay = math.max(0, 1 - OBJECT_LINEAR_DRAG * Dt) :: number
	NextVx *= LinearDecay
	NextVy *= LinearDecay
	NextVz *= LinearDecay

	if IsGrounded then
		const SurfaceDecay = math.max(0, 1 - OBJECT_SURFACE_FRICTION * Dt) :: number
		NextVx *= SurfaceDecay
		NextVz *= SurfaceDecay
	end

	return NextVx, NextVy, NextVz
end

-- ============================================================================
-- 2. COLLISION DETECTION & IMPULSE RESOLUTION (BOX VS ECS OBB)
-- ============================================================================

function PhysicsLibrary.TestBoxVsOBB(
	BodyX: number,
	BodyY: number,
	BodyZ: number,
	BodyHx: number,
	BodyHy: number,
	BodyHz: number,
	CompOffset: number,
	DirOffset: number,
	PositionBuffer: buffer,
	SizeBuffer: buffer,
	DirectionsBuffer: buffer
): (boolean, number, number, number, number)
	const SizeX = buffer.readf32(SizeBuffer, CompOffset) :: number
	const SizeY = buffer.readf32(SizeBuffer, CompOffset + 4) :: number
	const SizeZ = buffer.readf32(SizeBuffer, CompOffset + 8) :: number
	if SizeX <= 0 or SizeY <= 0 or SizeZ <= 0 then
		return false, 0, 0, 0, 0
	end

	const Dx = BodyX - buffer.readf32(PositionBuffer, CompOffset) :: number
	const Dy = BodyY - buffer.readf32(PositionBuffer, CompOffset + 4) :: number
	const Dz = BodyZ - buffer.readf32(PositionBuffer, CompOffset + 8) :: number

	-- Broadphase rejection before reading the 36-byte orientation basis
	const BroadRadius = (SizeX + SizeY + SizeZ) * 0.5 :: number
	if
		math.abs(Dx) > BodyHx + BroadRadius
		or math.abs(Dy) > BodyHy + BroadRadius
		or math.abs(Dz) > BodyHz + BroadRadius
	then
		return false, 0, 0, 0, 0
	end

	local LookX = buffer.readf32(DirectionsBuffer, DirOffset) :: number
	local LookY = buffer.readf32(DirectionsBuffer, DirOffset + 4) :: number
	local LookZ = buffer.readf32(DirectionsBuffer, DirOffset + 8) :: number

	local UpX = buffer.readf32(DirectionsBuffer, DirOffset + 12) :: number
	local UpY = buffer.readf32(DirectionsBuffer, DirOffset + 16) :: number
	local UpZ = buffer.readf32(DirectionsBuffer, DirOffset + 20) :: number

	local RightX = buffer.readf32(DirectionsBuffer, DirOffset + 24) :: number
	local RightY = buffer.readf32(DirectionsBuffer, DirOffset + 28) :: number
	local RightZ = buffer.readf32(DirectionsBuffer, DirOffset + 32) :: number

	if RightX * RightX + RightY * RightY + RightZ * RightZ < 0.5 then
		LookX, LookY, LookZ = 0, 0, -1
		UpX, UpY, UpZ = 0, 1, 0
		RightX, RightY, RightZ = 1, 0, 0
	end

	const Hx: number, Hy: number, Hz: number = SizeX * 0.5, SizeY * 0.5, SizeZ * 0.5

	const WorldHx = math.abs(RightX) * Hx + math.abs(UpX) * Hy + math.abs(LookX) * Hz :: number
	const OverlapX = (BodyHx + WorldHx) - math.abs(Dx) :: number
	if OverlapX <= 0 then
		return false, 0, 0, 0, 0
	end

	const WorldHy = math.abs(RightY) * Hx + math.abs(UpY) * Hy + math.abs(LookY) * Hz :: number
	const OverlapY = (BodyHy + WorldHy) - math.abs(Dy) :: number
	if OverlapY <= 0 then
		return false, 0, 0, 0, 0
	end

	const WorldHz = math.abs(RightZ) * Hx + math.abs(UpZ) * Hy + math.abs(LookZ) * Hz :: number
	const OverlapZ = (BodyHz + WorldHz) - math.abs(Dz) :: number
	if OverlapZ <= 0 then
		return false, 0, 0, 0, 0
	end

	local MinOverlap = OverlapY :: number
	local BestNx = 0 :: number
	local BestNy = if Dy >= 0 then 1 else -1 :: number
	local BestNz = 0 :: number

	if OverlapX < MinOverlap then
		MinOverlap = OverlapX
		BestNx = if Dx >= 0 then 1 else -1
		BestNy = 0
		BestNz = 0
	end

	if OverlapZ < MinOverlap then
		MinOverlap = OverlapZ
		BestNx = 0
		BestNy = 0
		BestNz = if Dz >= 0 then 1 else -1
	end

	const DistU = Dx * UpX + Dy * UpY + Dz * UpZ :: number
	const BodyProjU = math.abs(UpX) * BodyHx + math.abs(UpY) * BodyHy + math.abs(UpZ) * BodyHz :: number
	const OverlapU = (BodyProjU + Hy) - math.abs(DistU) :: number
	if OverlapU <= 0 then
		return false, 0, 0, 0, 0
	end

	if OverlapU < MinOverlap then
		const SignU = if DistU >= 0 then 1 else -1 :: number
		MinOverlap = OverlapU
		BestNx, BestNy, BestNz = UpX * SignU, UpY * SignU, UpZ * SignU
	end

	const DistR = Dx * RightX + Dy * RightY + Dz * RightZ :: number
	const BodyProjR = math.abs(RightX) * BodyHx + math.abs(RightY) * BodyHy + math.abs(RightZ) * BodyHz :: number
	const OverlapR = (BodyProjR + Hx) - math.abs(DistR) :: number
	if OverlapR <= 0 then
		return false, 0, 0, 0, 0
	end

	if OverlapR < MinOverlap then
		const SignR = if DistR >= 0 then 1 else -1 :: number
		MinOverlap = OverlapR
		BestNx, BestNy, BestNz = RightX * SignR, RightY * SignR, RightZ * SignR
	end

	const DistL = Dx * LookX + Dy * LookY + Dz * LookZ :: number
	const BodyProjL = math.abs(LookX) * BodyHx + math.abs(LookY) * BodyHy + math.abs(LookZ) * BodyHz :: number
	const OverlapL = (BodyProjL + Hz) - math.abs(DistL) :: number
	if OverlapL <= 0 then
		return false, 0, 0, 0, 0
	end

	if OverlapL < MinOverlap then
		const SignL = if DistL >= 0 then 1 else -1 :: number
		MinOverlap = OverlapL
		BestNx, BestNy, BestNz = LookX * SignL, LookY * SignL, LookZ * SignL
	end

	return true, BestNx, BestNy, BestNz, MinOverlap
end

local function ResolveDynamicPairContact(
	BodyX: number,
	BodyY: number,
	BodyZ: number,
	Vx: number,
	Vy: number,
	Vz: number,
	BodyInvMass: number,
	OtherEntityIndex: number,
	Nx: number,
	Ny: number,
	Nz: number,
	Penetration: number,
	PositionBuffer: buffer,
	DynamicFlags: buffer,
	ObjectVelocityBuffer: buffer,
	ObjectInvMassBuffer: buffer
): (number, number, number, number, number, number)
	const FlagIndex = OtherEntityIndex - 1 :: number
	const OtherCompOffset = FlagIndex * COMPONENT_STRIDE :: number
	const OtherInvMass = buffer.readf32(ObjectInvMassBuffer, FlagIndex * 4) :: number
	const TotalInvMass = BodyInvMass + OtherInvMass :: number

	if TotalInvMass <= 1e-6 then
		return BodyX + Nx * Penetration, BodyY + Ny * Penetration, BodyZ + Nz * Penetration, Vx, Vy, Vz
	end

	buffer.writeu8(DynamicFlags, FlagIndex, 1)

	const BodyShare = BodyInvMass / TotalInvMass :: number
	const OtherShare = OtherInvMass / TotalInvMass :: number

	const NextBodyX = BodyX + Nx * (Penetration * BodyShare) :: number
	const NextBodyY = BodyY + Ny * (Penetration * BodyShare) :: number
	const NextBodyZ = BodyZ + Nz * (Penetration * BodyShare) :: number

	buffer.writef32(
		PositionBuffer,
		OtherCompOffset,
		buffer.readf32(PositionBuffer, OtherCompOffset) - Nx * (Penetration * OtherShare)
	)
	buffer.writef32(
		PositionBuffer,
		OtherCompOffset + 4,
		buffer.readf32(PositionBuffer, OtherCompOffset + 4) - Ny * (Penetration * OtherShare)
	)
	buffer.writef32(
		PositionBuffer,
		OtherCompOffset + 8,
		buffer.readf32(PositionBuffer, OtherCompOffset + 8) - Nz * (Penetration * OtherShare)
	)

	const OtherVx = buffer.readf32(ObjectVelocityBuffer, OtherCompOffset) :: number
	const OtherVy = buffer.readf32(ObjectVelocityBuffer, OtherCompOffset + 4) :: number
	const OtherVz = buffer.readf32(ObjectVelocityBuffer, OtherCompOffset + 8) :: number

	const RelVn = (Vx - OtherVx) * Nx + (Vy - OtherVy) * Ny + (Vz - OtherVz) * Nz :: number
	if RelVn >= 0 then
		return NextBodyX, NextBodyY, NextBodyZ, Vx, Vy, Vz
	end

	const ImpulseScalar = -(1 + OBJECT_RESTITUTION) * RelVn / TotalInvMass :: number
	const BodyImpulse = ImpulseScalar * BodyInvMass :: number
	const OtherImpulse = ImpulseScalar * OtherInvMass :: number

	buffer.writef32(ObjectVelocityBuffer, OtherCompOffset, OtherVx - Nx * OtherImpulse)
	buffer.writef32(ObjectVelocityBuffer, OtherCompOffset + 4, OtherVy - Ny * OtherImpulse)
	buffer.writef32(ObjectVelocityBuffer, OtherCompOffset + 8, OtherVz - Nz * OtherImpulse)

	return NextBodyX, NextBodyY, NextBodyZ, Vx + Nx * BodyImpulse, Vy + Ny * BodyImpulse, Vz + Nz * BodyImpulse
end

function PhysicsLibrary.ResolveBodyWorldCollisions(
	BodyX: number,
	BodyY: number,
	BodyZ: number,
	BodyHx: number,
	BodyHy: number,
	BodyHz: number,
	Vx: number,
	Vy: number,
	Vz: number,
	BodyInvMass: number,
	Restitution: number,
	IgnoreEntityId: number,
	EntityCount: number,
	PositionBuffer: buffer,
	SizeBuffer: buffer,
	DirectionsBuffer: buffer,
	DynamicFlags: buffer,
	ObjectVelocityBuffer: buffer,
	ObjectInvMassBuffer: buffer
): (number, number, number, number, number, number, boolean)
	local NextX = BodyX :: number
	local NextY = BodyY :: number
	local NextZ = BodyZ :: number
	local NextVx = Vx :: number
	local NextVy = Vy :: number
	local NextVz = Vz :: number
	local Grounded = false :: boolean

	const QueryPadX = BodyHx + BROADPHASE_PADDING :: number
	const QueryPadY = BodyHy + BROADPHASE_PADDING :: number
	const QueryPadZ = BodyHz + BROADPHASE_PADDING :: number
	const CandidateCount = BVH.QueryAABB(
		Vector3.new(NextX - QueryPadX, NextY - QueryPadY, NextZ - QueryPadZ),
		Vector3.new(NextX + QueryPadX, NextY + QueryPadY, NextZ + QueryPadZ),
		BroadphaseCandidates
	) :: number

	for CandidateIdx = 1, CandidateCount do
		const i = BroadphaseCandidates[CandidateIdx] :: number
		if i == IgnoreEntityId or i < 1 or i > EntityCount then
			continue
		end

		const CompOffset = (i - 1) * COMPONENT_STRIDE :: number
		const DirOffset = (i - 1) * DIRECTION_STRIDE :: number

		const Hit: boolean, Nx: number, Ny: number, Nz: number, Penetration: number = PhysicsLibrary.TestBoxVsOBB(
			NextX,
			NextY,
			NextZ,
			BodyHx,
			BodyHy,
			BodyHz,
			CompOffset,
			DirOffset,
			PositionBuffer,
			SizeBuffer,
			DirectionsBuffer
		)

		if not Hit then
			continue
		end

		if Ny >= WALKABLE_NORMAL_Y then
			Grounded = true
		end

		const OtherDynamicState = buffer.readu8(DynamicFlags, i - 1) :: number
		if OtherDynamicState > 0 then
			NextX, NextY, NextZ, NextVx, NextVy, NextVz = ResolveDynamicPairContact(
				NextX,
				NextY,
				NextZ,
				NextVx,
				NextVy,
				NextVz,
				BodyInvMass,
				i,
				Nx,
				Ny,
				Nz,
				Penetration,
				PositionBuffer,
				DynamicFlags,
				ObjectVelocityBuffer,
				ObjectInvMassBuffer
			)
			continue
		end

		NextX += Nx * Penetration
		NextY += Ny * Penetration
		NextZ += Nz * Penetration

		const Vn = NextVx * Nx + NextVy * Ny + NextVz * Nz :: number
		if Vn < 0 then
			const BounceScale = -(1 + Restitution) * Vn :: number
			NextVx += Nx * BounceScale
			NextVy += Ny * BounceScale
			NextVz += Nz * BounceScale
		end
	end

	return NextX, NextY, NextZ, NextVx, NextVy, NextVz, Grounded
end

return PhysicsLibrary
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">PhysicsMovementQueue</string>
              <string name="Source"><![CDATA[--!native
--!optimize 2

-- Services --
const ReplicatedStorage = game:GetService("ReplicatedStorage") :: ReplicatedStorage

-- Modules --
const SystemsConfigs = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SystemsConfigs"))

-- Configs --
const MAX_PLAYER_COMMANDS = SystemsConfigs.PlayerQueueMaxCommands :: number
const MAX_OBJECT_COMMANDS = SystemsConfigs.ObjectQueueMaxCommands :: number

const PLAYER_COMMAND_STRIDE = 20 :: number -- DirX, DirY, DirZ, Scale (4 x f32) + Flags (u8 + 3 pad)
const OBJECT_COMMAND_STRIDE = 24 :: number -- EntityId (u32) + DirX, DirY, DirZ, Magnitude (4 x f32) + Flags (u8 + 3 pad)

export type PlayerMovementEntry = {
	DirX: number,
	DirY: number,
	DirZ: number,
	Scale: number?,
	Jump: boolean?,
	IsImpulse: boolean?,
}

-- Tables --
local PlayerCommandCount = 0 :: number
local ObjectCommandCount = 0 :: number

local Queue = {}

Queue.PlayerQueue = {} :: { PlayerMovementEntry }
Queue.PlayerCommandStride = PLAYER_COMMAND_STRIDE :: number
Queue.ObjectCommandStride = OBJECT_COMMAND_STRIDE :: number

-- Buffers
Queue.PlayerBuffer = buffer.create(MAX_PLAYER_COMMANDS * PLAYER_COMMAND_STRIDE) :: buffer
Queue.ObjectQueue = buffer.create(MAX_OBJECT_COMMANDS * OBJECT_COMMAND_STRIDE) :: buffer

-- ============================================================================
-- 1. QUEUE OPERATIONS - ENQUEUE & FLUSH MOVEMENT INTENTS
-- ============================================================================

function Queue.AddMovement(
	DirX: number,
	DirY: number,
	DirZ: number,
	Scale: number?,
	Jump: boolean?,
	IsImpulse: boolean?
)
	if PlayerCommandCount >= MAX_PLAYER_COMMANDS then
		return
	end

	const Offset = PlayerCommandCount * PLAYER_COMMAND_STRIDE :: number
	const ResolvedScale = if Scale ~= nil then Scale else 1.0 :: number
	local Flags = if Jump then 1 else 0 :: number
	if IsImpulse then
		Flags += 2
	end

	buffer.writef32(Queue.PlayerBuffer, Offset, DirX)
	buffer.writef32(Queue.PlayerBuffer, Offset + 4, DirY)
	buffer.writef32(Queue.PlayerBuffer, Offset + 8, DirZ)
	buffer.writef32(Queue.PlayerBuffer, Offset + 12, ResolvedScale)
	buffer.writeu8(Queue.PlayerBuffer, Offset + 16, Flags)

	PlayerCommandCount += 1
end

function Queue.AddObjectMovement(
	EntityId: number,
	DirX: number,
	DirY: number,
	DirZ: number,
	Magnitude: number,
	IsImpulse: boolean?
)
	if EntityId < 1 or ObjectCommandCount >= MAX_OBJECT_COMMANDS then
		return
	end

	const Offset = ObjectCommandCount * OBJECT_COMMAND_STRIDE :: number
	const Flags = if IsImpulse then 1 else 0 :: number

	buffer.writeu32(Queue.ObjectQueue, Offset, EntityId)
	buffer.writef32(Queue.ObjectQueue, Offset + 4, DirX)
	buffer.writef32(Queue.ObjectQueue, Offset + 8, DirY)
	buffer.writef32(Queue.ObjectQueue, Offset + 12, DirZ)
	buffer.writef32(Queue.ObjectQueue, Offset + 16, Magnitude)
	buffer.writeu8(Queue.ObjectQueue, Offset + 20, Flags)

	ObjectCommandCount += 1
end

function Queue.GetPlayerCommandCount(): number
	return PlayerCommandCount
end

function Queue.GetObjectCommandCount(): number
	return ObjectCommandCount
end

function Queue.Clear()
	PlayerCommandCount = 0
	ObjectCommandCount = 0
	table.clear(Queue.PlayerQueue)
end

return Queue
]]></string>
            </Properties>
