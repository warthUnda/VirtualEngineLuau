{
  "name": "RobloxProjects",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": "Packages"
      },
      "DevPackages": {
        "$path": "DevPackages"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "PlayerScriptsLoader": {
          "$path": "src/character/scripts/PlayerScriptsLoader.client.luau"
        },
        "RbxCharacterSounds": {
          "$path": "src/character/scripts/RbxCharacterSounds.client.luau"
        },
        "PlayerModule": {
          "$path": "src/character/scripts/PlayerModule.luau"
        }
      },
      "StarterCharacterScripts": {
        "Animate": {
          "$path": "src/character/scripts/Animate.client.luau"
        },
        "Health": {
          "$path": "src/character/scripts/Health.server.luau"
        }
      }
    },
    "StarterGui": {
      "GuiScripts": {
        "$path": "src/gui"
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}