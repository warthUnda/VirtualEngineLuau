      <Item class="Folder" referent="37">
        <Properties>
          <string name="Name">Combat</string>
        </Properties>
        <Item class="Script" referent="38">
          <Properties>
            <string name="Name">CombatInitilizer</string>
            <token name="RunContext">0</token>
            <string name="Source"><![CDATA[-- Init is called from Bootstrapper.server.luau
require(script.Parent.CombatServer)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">CombatServer</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local CombatEvents = require(ReplicatedStorage.Shared.Combat.CombatEvents)
local HungerServer = require(script.Parent.Parent.Hunger.HungerServer)

local CombatServer = {}

local MAX_HIT_DISTANCE = 15
local HITBOX_SIZE = Vector3.new(6, 6, 6)
local DAMAGE = 15
local SWEEP_SAMPLES = 5

local function SmoothSpeedPenalty(humanoid, penaltySpeed, normalSpeed, dropDuration, recoveryWait, recoveryDuration)
	local dropInfo = TweenInfo.new(dropDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	local dropTween = TweenService:Create(humanoid, dropInfo, { WalkSpeed = penaltySpeed })

	local recoverInfo = TweenInfo.new(recoveryDuration, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
	local recoverTween = TweenService:Create(humanoid, recoverInfo, { WalkSpeed = normalSpeed })

	dropTween:Play()

	task.delay(dropDuration + recoveryWait, function()
		if humanoid and humanoid.Parent then
			recoverTween:Play()
		end
	end)
end

local function sweptBoxOverlap(startCFrame, endCFrame, boxSize, filterParams, samples)
	local distanceMoved = (endCFrame.Position - startCFrame.Position).Magnitude
	if distanceMoved < 0.01 then
		return Workspace:GetPartBoundsInBox(startCFrame, boxSize, filterParams)
	end

	local seenParts = {}
	local results = {}

	for i = 0, samples - 1 do
		local t = i / (samples - 1)
		local sampleCFrame = startCFrame:Lerp(endCFrame, t)

		local partsAtSample = Workspace:GetPartBoundsInBox(sampleCFrame, boxSize, filterParams)
		for _, part in ipairs(partsAtSample) do
			if not seenParts[part] then
				seenParts[part] = true
				table.insert(results, part)
			end
		end
	end

	return results
end

local function validateHit(attackerPlayer, targetModel, startCFrame, endCFrame)
	local attackerCharacter = attackerPlayer.Character
	if not attackerCharacter or not targetModel then
		return false
	end

	local targetRoot = targetModel:FindFirstChild("HumanoidRootPart")
	local attackerRoot = attackerCharacter:FindFirstChild("HumanoidRootPart")
	if not targetRoot or not attackerRoot then
		return false
	end

	local distance = (attackerRoot.Position - targetRoot.Position).Magnitude
	if distance > MAX_HIT_DISTANCE then
		return false
	end

	local overlapParams = OverlapParams.new()
	overlapParams.FilterDescendantsInstances = { attackerCharacter }
	overlapParams.FilterType = Enum.RaycastFilterType.Exclude

	local partsInSweep = sweptBoxOverlap(startCFrame, endCFrame, HITBOX_SIZE, overlapParams, SWEEP_SAMPLES)

	for _, part in ipairs(partsInSweep) do
		if part:IsDescendantOf(targetModel) then
			return true
		end
	end

	return false
end

function CombatServer.Init()
	CombatEvents.BlockToggle.OnServerEvent:Connect(function(player, isBlocking)
		local character = player.Character
		if not character then
			return
		end
		character:SetAttribute("Blocking", isBlocking)
	end)

	CombatEvents.AttackHit.OnServerEvent:Connect(function(player, targetModel, startCFrame, endCFrame)
		local Character = player.Character
		if not Character then
			return
		end

		local Humanoid = Character:WaitForChild("Humanoid")

		local isValid = validateHit(player, targetModel, startCFrame, endCFrame)

		if isValid then
			if targetModel:GetAttribute("Blocking") then
				print("Server: Hit blocked! No damage dealt to " .. targetModel.Name)
				return
			end

			local humanoid = targetModel:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid:TakeDamage(DAMAGE)
				SmoothSpeedPenalty(Humanoid, 3, 8, 3, 1, 2)
			end

			HungerServer.ConsumeAttack(player)
		end
	end)
end

return CombatServer
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">GameState</string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">PlayerState</string>
            <string name="Source"><![CDATA[local PlayerData = {}
local Data = {}

local ReflectionMath = require(game.ReplicatedStorage.Shared.Math.ModelMath)

function Data.GET(plr)
	if not PlayerData[plr] then
		PlayerData[plr] = {
			Desperation = 40,
			Willpower = 60,

			DesperationMultiplier = 1,
		}
	end
	return PlayerData[plr]
end

local function AmbushCheck(plr, Enemy, Data)
	local origin = Enemy.HumanoidRootPart.Position
	local direction = plr.Character.HumanoidRootPart.Position - origin

	local raycastResult = workspace:Raycast(origin, direction)

	if raycastResult then
		local hitPart = raycastResult.Instance
		if hitPart and hitPart:IsDescendantOf(Enemy.Character) then
			local DotProduct = ReflectionMath.DotProduct(Enemy.HumanoidRootPart, plr.Character.HumanoidRootPart)

			if DotProduct == "NotFacing" then
				Data.DesperationMultiplier = 3

				task.delay(3, function()
					Data.DesperationMultiplier = 1
				end)
			end
			return false
		end
	end
	return true
end

function Data.DesperationGain(plr, data)
	for _, player in pairs(game.Players:GetPlayers()) do
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

		local OwnHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
		if hrp and (hrp.Position - OwnHrp.Position).Magnitude <= 50 then
			AmbushCheck(plr, player, data)

			local EnemyTier = hrp:GetAttribute("ThreatTier")
			local OwnTier = OwnHrp:GetAttribute("ThreatTier")

			local EnemyIntimidating = hrp:GetAttribute("Intimidating")

			local TotalTier = EnemyTier - OwnTier + 1
			if EnemyIntimidating and TotalTier > 0 then
				local DesperationGain = 0
				DesperationGain = 0.1 * TotalTier * data.DesperationMultiplier

				OwnHrp:SetAttribute("DesperationGain", DesperationGain)

				data.Desperation += DesperationGain
			end
		end
	end
end

function Data.REM(plr)
	PlayerData[plr] = nil
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="Script" referent="42">
          <Properties>
            <string name="Name">TimeRewind</string>
            <token name="RunContext">0</token>
            <string name="Source"><![CDATA[local replicated = game:GetService("ReplicatedStorage")
local timeRewindEvent = replicated:FindFirstChild("TimeRewind")

local TweenService = game:GetService("TweenService")

local PlayerData = {}

local function RecordTime(DataTable, player)
	if not DataTable[player].rewinding then
		local hrp = player.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			table.insert(DataTable[player].positions, 1, hrp.CFrame)
			if #DataTable[player].positions > 500 then
				table.remove(DataTable[player].positions)
			end

			table.insert(DataTable[player].Health, 1, DataTable[player].humanoid.Health)
			if #DataTable[player].Health > 500 then
				table.remove(DataTable[player].Health)
			end
		end
	end
end

local function smoothMove(part, targetCFrame, duration)
	local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local tween = TweenService:Create(part, tweenInfo, { CFrame = targetCFrame })
	tween:Play()
	return tween
end

game.Players.PlayerAdded:Connect(function(player)
	PlayerData[player] = { positions = {}, health = {}, rewinding = false }

	player.CharacterAdded:Connect(function(character)
		task.spawn(function()
			while player.Character do
				RecordTime(PlayerData, player)
				task.wait(0.05)
				if player.Character.Humanoid.Health <= 0 then
					break
				end
			end
		end)
	end)
end)

timeRewindEvent.OnServerEvent:Connect(function(player, shouldRewind)
	local data = PlayerData[player]

	if not data then
		return
	end
	data.rewinding = shouldRewind

	local char = player.Character
	if not char then
		return
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")

	if shouldRewind then
		task.spawn(function()
			if data.isTimeStopped then
				return
			end
			while data.rewinding do
				if #data.positions > 1 and hrp then
					smoothMove(hrp, data.positions[1], 0.03)
					table.remove(data.positions, 1)
				end
				task.wait(0.01)
			end
		end)

		task.spawn(function()
			while data.rewinding do
				if #data.health > 1 and hrp then
					humanoid.Health = data.health[1]
					table.remove(data.health, 1)
				end
				task.wait(0.01)
			end
		end)
	else
		if data.reverseAnim then
			data.reverseAnim:Stop()
		end
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="43">
        <Properties>
          <string name="Name">Hunger</string>
        </Properties>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">HungerServer</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local HungerServer = {}

local MAX_HUNGER = 100
local STARTING_HUNGER = 100
local TICK_INTERVAL = 1
local DECREASE_AMOUNT = 0.5
local SPRINT_DECREASE_AMOUNT = 1.5
local ATTACK_DECREASE_AMOUNT = 2.0

local PlayerHunger = {}
local PlayerSprinting = {}

function HungerServer.Init()
	Players.PlayerAdded:Connect(function(Player)
		PlayerHunger[Player] = STARTING_HUNGER
		PlayerSprinting[Player] = false

		Player:SetAttribute("Hunger", STARTING_HUNGER)
		Player:SetAttribute("MaxHunger", MAX_HUNGER)

		Player.CharacterAdded:Connect(function()
			PlayerHunger[Player] = STARTING_HUNGER
			PlayerSprinting[Player] = false
			Player:SetAttribute("Hunger", STARTING_HUNGER)
			Player:SetAttribute("MaxHunger", MAX_HUNGER)
		end)
	end)

	Players.PlayerRemoving:Connect(function(Player)
		PlayerHunger[Player] = nil
		PlayerSprinting[Player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(TICK_INTERVAL)
			for _, Player in ipairs(Players:GetPlayers()) do
				local Current = PlayerHunger[Player]
				if not Current then
					continue
				end

				local IsSprinting = PlayerSprinting[Player] or false
				local Amount = IsSprinting and SPRINT_DECREASE_AMOUNT or DECREASE_AMOUNT
				local NewHunger = math.max(0, Current - Amount)

				PlayerHunger[Player] = NewHunger
				Player:SetAttribute("Hunger", NewHunger)
			end
		end
	end)
end

function HungerServer.ConsumeAttack(Player: Player)
	local Current = PlayerHunger[Player]
	if Current then
		local NewHunger = math.max(0, Current - ATTACK_DECREASE_AMOUNT)
		PlayerHunger[Player] = NewHunger
		Player:SetAttribute("Hunger", NewHunger)
	end
end

function HungerServer.SetSprinting(Player: Player, IsSprinting: boolean)
	PlayerSprinting[Player] = IsSprinting
end

return HungerServer
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="45">
        <Properties>
          <string name="Name">MapGeneration</string>
        </Properties>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">BiomeColorsModule</string>
            <string name="Source"><![CDATA[local BiomeColorsModule = {}

local Biomes = {
	{
		Name = "Tundra",
		Threshold = -0.3,
		Multiplier = 0.8,
		Color = BrickColor.new("White"),
		Material = Enum.Material.Ice,
		Variants = {
			{ Color = BrickColor.new("White"), Material = Enum.Material.Ice },
			{ Color = BrickColor.new("Institutional white"), Material = Enum.Material.Snow },
			{ Color = BrickColor.new("Light blue"), Material = Enum.Material.Glacier },
		},
	},
	{
		Name = "Desert",
		Threshold = -0.15,
		Multiplier = 0.9,
		Color = BrickColor.new("Brick yellow"),
		Material = Enum.Material.Sand,
		Variants = {
			{ Color = BrickColor.new("Brick yellow"), Material = Enum.Material.Sand },
			{ Color = BrickColor.new("Light orange"), Material = Enum.Material.Sand },
			{ Color = BrickColor.new("Gold"), Material = Enum.Material.Sand },
		},
	},
	{
		Name = "Plains",
		Threshold = 0.0,
		Multiplier = 1.5,
		Color = BrickColor.new("Earth green"),
		Material = Enum.Material.Grass,
		Variants = {
			{ Color = BrickColor.new("Earth green"), Material = Enum.Material.Grass },
			{ Color = BrickColor.new("Dark green"), Material = Enum.Material.Grass },
			{ Color = BrickColor.new("Green"), Material = Enum.Material.Grass },
		},
	},
	{
		Name = "Forest",
		Threshold = 0.1,
		Multiplier = 1.8,
		Color = BrickColor.new("Dark green"),
		Material = Enum.Material.Wood,
		Variants = {
			{ Color = BrickColor.new("Dark green"), Material = Enum.Material.Wood },
			{ Color = BrickColor.new("Earth green"), Material = Enum.Material.Wood },
			{ Color = BrickColor.new("Green"), Material = Enum.Material.LeafyGrass },
		},
	},
	{
		Name = "Grassland",
		Threshold = 0.2,
		Multiplier = 2.2,
		Color = BrickColor.new("Bright green"),
		Material = Enum.Material.Grass,
		Variants = {
			{ Color = BrickColor.new("Bright green"), Material = Enum.Material.Grass },
			{ Color = BrickColor.new("Green"), Material = Enum.Material.Grass },
			{ Color = BrickColor.new("Lime green"), Material = Enum.Material.Grass },
		},
	},
	{
		Name = "Mountains",
		Threshold = 0.35,
		Multiplier = 3.0,
		Color = BrickColor.new("Medium stone grey"),
		Material = Enum.Material.Slate,
		Variants = {
			{ Color = BrickColor.new("Medium stone grey"), Material = Enum.Material.Slate },
			{ Color = BrickColor.new("Cool grey"), Material = Enum.Material.Rock },
			{ Color = BrickColor.new("Light stone grey"), Material = Enum.Material.Slate },
			{ Color = BrickColor.new("Dark stone grey"), Material = Enum.Material.Slate },
		},
	},
}

local function PickRandomVariant(biome)
	local variant = biome.Variants[math.random(1, #biome.Variants)]
	biome.Color = variant.Color
	biome.Material = variant.Material
end

function BiomeColorsModule.ResolveVariant(biome)
	PickRandomVariant(biome)
end

function BiomeColorsModule.GetBiomeByNoise(noiseValue: number)
	local selected = Biomes[1]
	for _, biome in ipairs(Biomes) do
		if noiseValue >= biome.Threshold then
			selected = biome
		end
	end
	PickRandomVariant(selected)
	return selected
end

function BiomeColorsModule.GetBiomeByName(name: string)
	for _, biome in ipairs(Biomes) do
		if biome.Name == name then
			PickRandomVariant(biome)
			return biome
		end
	end
	return nil
end

function BiomeColorsModule.GetBiomes()
	return Biomes
end

function BiomeColorsModule.GetBiomeNames()
	local names = {}
	for _, biome in ipairs(Biomes) do
		table.insert(names, biome.Name)
	end
	return names
end

return BiomeColorsModule
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">ChunkGeneration</string>
            <string name="Source"><![CDATA[local ChunkModule = {}

local BiomeColorsModule = require(script.Parent.BiomeColorsModule)
local MapGenExecuter = require(script.Parent.MapGenExecuter)

local BiomeCores = {}

local ChunkTable = {}

local CHUNK_SIZE = 15
local BLOCK_SIZE = 3
local MAX_MOVE_FAILURES = 5

local mapFolder = nil

local function MovePartChunk(part: BasePart): number
	local RandomChance = math.random(1, 4)
	local offsetX = 0
	local offsetZ = 0

	if RandomChance == 1 then
		offsetX = CHUNK_SIZE
	elseif RandomChance == 2 then
		offsetZ = CHUNK_SIZE
	elseif RandomChance == 3 then
		offsetX = -CHUNK_SIZE
	else
		offsetZ = -CHUNK_SIZE
	end

	local directionVector = Vector3.new(offsetX, 0, offsetZ)
	local raycastOrigin = part.Position + Vector3.new(0, 2, 0)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = { part }
	if mapFolder then
		table.insert(filter, mapFolder)
	end
	params.FilterDescendantsInstances = filter

	local hit = workspace:Raycast(raycastOrigin, directionVector, params)

	if hit and hit.Instance then
		local hitBiome = hit.Instance:GetAttribute("BiomeIndex")
		local myBiome = part:GetAttribute("BiomeIndex")

		if hitBiome and hitBiome == myBiome then
			part.CFrame = part.CFrame + directionVector
			return 0.5
		else
			return 1
		end
	end

	part.CFrame = part.CFrame + directionVector
	return 0
end

local function CreateBorderWalls()
	local wallFolder = Instance.new("Folder")
	wallFolder.Name = "BorderWalls"
	wallFolder.Parent = workspace

	local wallThickness = 50
	local wallHeight = 200
	local wallY = 60
	local xMin, xMax = 0, 170 * BLOCK_SIZE
	local zMin, zMax = 0, 360 * BLOCK_SIZE
	local borderOffset = CHUNK_SIZE / 2 -- 30

	-- Helper to create a wall segment
	local function createSegment(size, cf)
		local part = Instance.new("Part")
		part.Size = size
		part.CFrame = cf
		part.Anchored = true
		part.BrickColor = BrickColor.new("Dark stone grey")
		part.Material = Enum.Material.Slate
		part.Parent = wallFolder
	end

	-- LEFT WALL (3 segments along Z to stay under the 2048 size limit)
	local leftX = xMin - borderOffset
	local zSpan = zMax - zMin + CHUNK_SIZE -- 4380
	local zSegments = 3
	local zSegLength = zSpan / zSegments -- 1460 each
	for i = 1, zSegments do
		local zStart = zMin + (i - 1) * zSegLength
		-- Extend each segment by wallThickness so they overlap slightly
		local sizeZ = zSegLength + wallThickness
		local centerZ = zStart + zSegLength / 2
		createSegment(Vector3.new(wallThickness, wallHeight, sizeZ), CFrame.new(leftX, wallY + wallHeight / 2, centerZ))
	end

	-- RIGHT WALL (3 segments along Z)
	local rightX = xMax + borderOffset
	for i = 1, zSegments do
		local zStart = zMin + (i - 1) * zSegLength
		local sizeZ = zSegLength + wallThickness
		local centerZ = zStart + zSegLength / 2
		createSegment(
			Vector3.new(wallThickness, wallHeight, sizeZ),
			CFrame.new(rightX, wallY + wallHeight / 2, centerZ)
		)
	end

	-- FRONT WALL (2 segments along X)
	local frontZ = zMin - borderOffset
	local xSpan = xMax - xMin + CHUNK_SIZE -- 2100
	local xSegments = 2
	local xSegLength = xSpan / xSegments -- 1050 each
	for i = 1, xSegments do
		local xStart = xMin + (i - 1) * xSegLength
		local sizeX = xSegLength + wallThickness
		local centerX = xStart + xSegLength / 2
		createSegment(
			Vector3.new(sizeX, wallHeight, wallThickness),
			CFrame.new(centerX, wallY + wallHeight / 2, frontZ)
		)
	end

	-- BACK WALL (2 segments along X)
	local backZ = zMax + borderOffset
	for i = 1, xSegments do
		local xStart = xMin + (i - 1) * xSegLength
		local sizeX = xSegLength + wallThickness
		local centerX = xStart + xSegLength / 2
		createSegment(Vector3.new(sizeX, wallHeight, wallThickness), CFrame.new(centerX, wallY + wallHeight / 2, backZ))
	end

	print("Border walls created: 10 segments (3+3 sides, 2+2 front/back)")
end

function ChunkModule.GenerateChunk()
	mapFolder = Instance.new("Folder")
	mapFolder.Name = "GeneratedMap"
	mapFolder.Parent = workspace

	local baseBlock = game.ReplicatedStorage.BaseBlock

	local YieldOfWait = 0
	for xIndex = 0, 170 do
		for zIndex = 0, 360 do
			local newBlock = baseBlock:Clone()
			newBlock.Parent = mapFolder

			local xPosition = xIndex * BLOCK_SIZE
			local zPosition = zIndex * BLOCK_SIZE

			newBlock.Position = Vector3.new(xPosition, 60, zPosition)
			newBlock.Anchored = true

			local RandomChanceBiome = math.random(1, 250)
			if RandomChanceBiome == 125 then
				local tooClose = false
				for _, core in ipairs(BiomeCores) do
					if (newBlock.Position - core.Position).Magnitude < 125 then
						tooClose = true
						break
					end
				end

				if not tooClose then
					table.insert(BiomeCores, newBlock)
				end
			end

			YieldOfWait += 1
			if YieldOfWait > 500 then
				task.wait()
				YieldOfWait = 0
			end
		end
	end

	CreateBorderWalls()

	local lastChunkPart = nil

	local totalCores = #BiomeCores
	local coresFinished = 0

	for coreIndex, biomeCore in ipairs(BiomeCores) do
		local allBiomes = BiomeColorsModule.GetBiomes()
		local biomeIndex = math.random(1, #allBiomes)
		local biomeEntry = allBiomes[biomeIndex]

		BiomeColorsModule.ResolveVariant(biomeEntry)

		local seedChunk = Instance.new("Part")
		seedChunk.Size = Vector3.new(CHUNK_SIZE, BLOCK_SIZE, CHUNK_SIZE)
		local snappedX = math.round(biomeCore.Position.X / CHUNK_SIZE) * CHUNK_SIZE
		local snappedZ = math.round(biomeCore.Position.Z / CHUNK_SIZE) * CHUNK_SIZE
		seedChunk.Position = Vector3.new(snappedX, biomeCore.Position.Y, snappedZ)
		seedChunk.BrickColor = biomeEntry.Color
		seedChunk.Material = biomeEntry.Material
		seedChunk.Anchored = true
		seedChunk.CastShadow = false
		seedChunk.Parent = workspace
		seedChunk:SetAttribute("MoveFailures", 0)
		seedChunk:SetAttribute("BiomeIndex", biomeIndex)
		seedChunk:SetAttribute("BiomeName", biomeEntry.Name)
		seedChunk:SetAttribute("Locked", false)

		local biomeChunkTable = { seedChunk }
		table.insert(ChunkTable, seedChunk)
		lastChunkPart = seedChunk

		task.spawn(function()
			local Iteration = 0
			while #biomeChunkTable > 0 do
				local snapshot = table.clone(biomeChunkTable)

				for _, chunk in ipairs(snapshot) do
					if not (chunk and chunk.Parent) then
						continue
					end

					local directions = {
						Vector3.new(CHUNK_SIZE, 0, 0),
						Vector3.new(-CHUNK_SIZE, 0, 0),
						Vector3.new(0, 0, CHUNK_SIZE),
						Vector3.new(0, 0, -CHUNK_SIZE),
					}

					for _, dir in ipairs(directions) do
						local params = RaycastParams.new()
						params.FilterType = Enum.RaycastFilterType.Exclude
						params.FilterDescendantsInstances = { chunk, biomeCore, mapFolder }
						local hit = workspace:Raycast(
							chunk.Position + Vector3.new(0, 2, 0),
							dir.Unit * (CHUNK_SIZE - 1),
							params
						)

						if not hit then
							local clone = Instance.new("Part")
							clone.Size = Vector3.new(CHUNK_SIZE, BLOCK_SIZE, CHUNK_SIZE)
							clone.Position = chunk.Position + dir
							clone.BrickColor = biomeEntry.Color
							clone.Material = biomeEntry.Material
							clone.Anchored = true
							clone.CastShadow = false
							clone.Parent = workspace
							clone:SetAttribute("MoveFailures", 0)
							clone:SetAttribute("BiomeIndex", biomeIndex)
							clone:SetAttribute("BiomeName", biomeEntry.Name)
							clone:SetAttribute("Locked", false)
							table.insert(biomeChunkTable, clone)
							table.insert(ChunkTable, clone)
						end
					end

					if chunk:GetAttribute("Locked") then
						continue
					end

					if math.random(1, 2) ~= 1 then
						continue
					end

					local OldPosition = chunk.Position
					local FailureIncrement = MovePartChunk(chunk)

					if chunk.Position ~= OldPosition then
						local Clone = Instance.new("Part")
						Clone.Size = Vector3.new(CHUNK_SIZE, BLOCK_SIZE, CHUNK_SIZE)
						Clone.Position = OldPosition
						Clone.BrickColor = biomeEntry.Color
						Clone.Material = biomeEntry.Material
						Clone.Anchored = true
						Clone.CastShadow = false
						Clone.Parent = workspace
						Clone:SetAttribute("MoveFailures", 0)
						Clone:SetAttribute("BiomeIndex", biomeIndex)
						Clone:SetAttribute("BiomeName", biomeEntry.Name)
						Clone:SetAttribute("Locked", true)
						table.insert(biomeChunkTable, Clone)
						table.insert(ChunkTable, Clone)
					end

					if FailureIncrement == 0 then
						chunk:SetAttribute("MoveFailures", 0)
						continue
					end

					local Failures = (chunk:GetAttribute("MoveFailures") or 0) + FailureIncrement
					chunk:SetAttribute("MoveFailures", Failures)

					if Failures < MAX_MOVE_FAILURES then
						continue
					end

					chunk:SetAttribute("Locked", true)
					warn(string.format("[Biome %d] Chunk locked after %.1f failures", biomeIndex, Failures), chunk)
				end

				Iteration += 1
				print(Iteration)
				if Iteration >= 8 then
					coresFinished += 1
					if coresFinished == totalCores then
						mapFolder:Destroy()
						MapGenExecuter:GenerateBlocks()
					end
					break
				end
				task.wait(0.5)
			end
		end)
	end

	return lastChunkPart
end

return ChunkModule
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">MapGenExecuter</string>
            <string name="Source"><![CDATA[local BuildBlock = game.ReplicatedStorage:WaitForChild("BaseBlock")
local BiomeColorsModule = require(script.Parent.BiomeColorsModule)

local MapGenExecuter = {}

MapGenExecuter.Width = 170
MapGenExecuter.Length = 360
MapGenExecuter.BlockSize = 2
MapGenExecuter.Seed = math.random(1, 999999)

local function CalculateNextBlock(xPosition, zPosition, mapFolder, newBlock)
	local heightNoise = math.noise(xPosition * 0.04, zPosition * 0.04, MapGenExecuter.Seed)
	local yPosition = math.floor(heightNoise * 12) * MapGenExecuter.BlockSize

	return heightNoise, yPosition
end

function MapGenExecuter:GenerateBlocks()
	local mapFolder = Instance.new("Folder")
	mapFolder.Name = "GeneratedMap"
	mapFolder.Parent = workspace

	local iteration = 0

	for xIndex = 0, self.Width do
		for zIndex = 0, self.Length do
			local newBlock = BuildBlock:Clone()
			newBlock.Parent = mapFolder

			local xPosition = xIndex * self.BlockSize
			local zPosition = zIndex * self.BlockSize

			local raycastParams = RaycastParams.new()
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude
			raycastParams.FilterDescendantsInstances = { newBlock }

			local MIN_HEIGHT = self.BlockSize
			local heightNoise, yPosition = CalculateNextBlock(xPosition, zPosition, mapFolder, newBlock)
			newBlock.Position = Vector3.new(xPosition, yPosition, zPosition)
			local baseHeight = math.max(heightNoise * 4, MIN_HEIGHT)
			newBlock.Size = Vector3.new(self.BlockSize, baseHeight, self.BlockSize)
			newBlock.Anchored = true

			MapGenExecuter:MapHeightApplicator(newBlock, heightNoise, baseHeight)

			local UpwardParams = RaycastParams.new()
			UpwardParams.FilterType = Enum.RaycastFilterType.Exclude
			UpwardParams.FilterDescendantsInstances = { newBlock }

			local UpwardResult = workspace:Raycast(newBlock.Position, Vector3.new(0, 60, 0), UpwardParams)
			if UpwardResult then
				local HitChunk = UpwardResult.Instance
				local BiomeIndex = HitChunk and HitChunk:GetAttribute("BiomeIndex")
				if BiomeIndex ~= nil then
					local AllBiomes = BiomeColorsModule.GetBiomes()
					local SelectedBiome = AllBiomes[BiomeIndex]
					if SelectedBiome then
						newBlock.BrickColor = SelectedBiome.Color
						newBlock.Material = SelectedBiome.Material
						newBlock.Size =
							Vector3.new(newBlock.Size.X, baseHeight * SelectedBiome.Multiplier, newBlock.Size.Z)
					end
				end
			end

			local origin = newBlock.Position
			local direction = newBlock.CFrame.RightVector * 2

			local raycastResult = workspace:Raycast(origin, direction, raycastParams)

			if raycastResult then
				local hitPart = raycastResult.Instance
				if hitPart and hitPart:GetAttribute("BlockerUnit") then
					newBlock:Destroy()
				end
			end

			iteration += 1
			if iteration >= 20000 then
				task.wait()
			end
		end
	end
end

function MapGenExecuter:MapHeightApplicator(block, noiseValue, baseHeight)
	local biome = BiomeColorsModule.GetBiomeByNoise(noiseValue)
	block.BrickColor = biome.Color
	block.Material = biome.Material
	block.Size = Vector3.new(block.Size.X, baseHeight * biome.Multiplier, block.Size.Z)
end

function MapGenExecuter:ClearMap()
	if workspace:FindFirstChild("GeneratedMap") then
		workspace.GeneratedMap:Destroy()
	end
end

return MapGenExecuter
]]></string>
          </Properties>
        </Item>
